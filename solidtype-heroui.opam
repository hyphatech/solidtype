# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "HeroUI for solidtype: HeroUI's design on Kobalte's components"
description:
  "HeroUI's components, ported by hand to solidtype on Kobalte: HeroUI's classes and the state its styles read, Kobalte's behaviour and accessibility."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/solidtype"
bug-reports: "https://github.com/hyphatech/solidtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "melange" {>= "7.0.1-55"}
  "solidtype" {= version}
  "solidtype-kobalte" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/solidtype.git"
x-maintenance-intent: ["(latest)"]
