---
// One example, as HeroUI's documentation frames one: the component live, and
// its code beneath, the code the preview runs.
import { Code } from "@astrojs/starlight/components";

interface Props {
  code: string;
  title: string;
}

const { code, title } = Astro.props;
---

<figure class="not-content example">
  <div class="preview"><slot /></div>
  <Code code={code} lang="ocaml" title={title} />
</figure>

<style>
  .example {
    margin-block: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    overflow: hidden;
  }
  .preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: 3rem 1.5rem;
  }
  .example :global(.expressive-code) {
    margin: 0;
  }
  .example :global(.expressive-code .frame) {
    border-radius: 0;
    box-shadow: none;
    border-top: 1px solid var(--sl-color-gray-5);
  }
</style>
