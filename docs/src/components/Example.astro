---
// One example: the component live, on HeroUI's own ground, so it looks as
// it does on heroui.com, and its code beneath, the code the preview runs, in
// a frame of the site's rule.
import { Code } from "@astrojs/starlight/components";

interface Props {
  code: string;
  title: string;
}

const { code, title } = Astro.props;
---

<figure class="not-content example">
  <div class="preview heroui-ground"><slot /></div>
  <Code code={code} lang="ocaml" title={title} />
</figure>

<style>
  .example {
    margin-block: 1.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }
  .preview {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: 3rem 1.5rem;
    background: var(--background);
  }
  /* On a phone, to the screen's edges, as hypha.pub's code is: the gutter
     is room the preview needs more. */
  @media (max-width: 39.99rem) {
    .example {
      margin-inline: calc(-1 * var(--gutter));
      border-inline: 0;
      border-radius: 0;
    }
  }
  /* The frame's rule is the code's: none of its own inside it. */
  .example :global(.expressive-code) {
    margin: 0;
    --ec-brdCol: transparent;
    --ec-brdRad: 0;
    --ec-frm-edTabBarBrdCol: transparent;
  }
  .example :global(.expressive-code .frame) {
    border: none;
    border-radius: 0;
    box-shadow: none;
    border-top: 1px solid var(--rule);
  }
</style>
