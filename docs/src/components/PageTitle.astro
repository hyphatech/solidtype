---
// A page's title with its description beneath, as HeroUI's documentation
// heads a page.
// The id Starlight's own title takes, which its table of contents links to
// as "Overview"; Starlight does not export it.
const PAGE_TITLE_ID = "_top";
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id={PAGE_TITLE_ID}>{title}</h1>
{description && <p class="page-description">{description}</p>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
