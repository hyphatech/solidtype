---
// The page a missing address shows, in Starlight's own words, drawn by
// Starlight: its own route reads a 404 entry that would also be a page of
// the docs, which Astro builds twice and warns of.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "404",
    template: "splash",
    editUrl: false,
    hero: { title: "404", tagline: "Page not found. Check the URL or try using the search bar." },
  }}
/>
