---
// The demo's front page: HTML alone, no island of its own.
import Layout from "./_Layout.astro";
import { teas } from "./_teas";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/demo/teas`;
---

<Layout title="All teas">
  <h1 class="mb-6 text-3xl font-semibold tracking-tight">Teas</h1>
  <ul class="flex flex-col gap-3">
    {
      teas.map((tea) => (
        <li>
          <a class="link text-lg" href={`${base}/${tea.slug}/`}>{tea.name}</a>
          <span class="text-muted"> from {tea.origin}</span>
        </li>
      ))
    }
  </ul>
</Layout>
