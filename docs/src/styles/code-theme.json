{
  "name": "hypha-night",
  "type": "dark",
  "colors": {
    "editor.background": "#1c1915",
    "editor.foreground": "#e9e3d8"
  },
  "tokenColors": [
    { "settings": { "foreground": "#e9e3d8" } },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#9a9289", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "keyword.operator.new", "keyword.operator.logical.sql", "support.type.sql"],
      "settings": { "foreground": "#e3a868" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string", "markup.inline.raw"],
      "settings": { "foreground": "#b3c78f" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant", "constant.other"],
      "settings": { "foreground": "#df9a83" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "entity.name.command", "support.function.builtin"],
      "settings": { "foreground": "#8ebfd1" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#c6aedb" }
    },
    {
      "scope": ["variable.parameter", "variable.other.normal", "variable.other.positional", "punctuation.definition.variable", "variable.language"],
      "settings": { "foreground": "#e8c48e" }
    },
    {
      "scope": ["constant.other.option", "variable.other.option"],
      "settings": { "foreground": "#c9bfb1" }
    },
    {
      "scope": ["punctuation", "keyword.operator", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#a39b91" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#8ebfd1" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#e3a868" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#e3a868" }
    }
  ]
}
