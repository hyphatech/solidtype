module Button = Solidtype_heroui.Button
module Button_group = Solidtype_heroui.Button_group

let group ~label ~variant =
  <div class_="flex flex-col gap-2">
    <p class_="text-sm text-muted">(fun () -> Solidtype.Jsx.string label)</p>
    <Button_group variant=(fun () -> variant)>
      <Button>"First"</Button>
      <Button><Button_group.Separator /> "Second"</Button>
      <Button><Button_group.Separator /> "Third"</Button>
    </Button_group>
  </div>

let make () =
  <div class_="flex flex-col gap-6">
    (fun () -> Solidtype.Jsx.element (group ~label:"Primary" ~variant:`primary))
    (fun () ->
      Solidtype.Jsx.element (group ~label:"Secondary" ~variant:`secondary))
    (fun () ->
      Solidtype.Jsx.element (group ~label:"Tertiary" ~variant:`tertiary))
    (fun () -> Solidtype.Jsx.element (group ~label:"Outline" ~variant:`outline))
    (fun () -> Solidtype.Jsx.element (group ~label:"Ghost" ~variant:`ghost))
    (fun () -> Solidtype.Jsx.element (group ~label:"Danger" ~variant:`danger))
  </div>
