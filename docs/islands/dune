; The documentation's islands: each example of Solid's and Kobalte's
; bindings, each demo of a HeroUI port, and the port beside the same
; component in React, which react/ renders.

(library
 (name docs_islands)
 (modes melange)
 (libraries
  solidtype
  solidtype-heroui
  solidtype-kobalte
  solidtype-rhp
  melange.dom)
 (preprocess
  (pps melange.ppx ppx_solidtype)))

(melange.emit
 (target out)
 (modules)
 (libraries docs_islands)
 (runtime_deps
  (glob_files react/*.tsx))
 (module_systems
  (es6 jsx)))
