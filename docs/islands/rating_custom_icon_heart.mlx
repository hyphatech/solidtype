module Rating = Solidtype_heroui.Rating
module Gravity = Solidtype_gravity_icons

let make () =
  <Rating aria_label="Favorites" default_value=3. icon=(<Gravity.Heart_fill />)>
    <Rating.Item value=1. />
    <Rating.Item value=2. />
    <Rating.Item value=3. />
    <Rating.Item value=4. />
    <Rating.Item value=5. />
  </Rating>
