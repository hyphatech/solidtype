(* An icon of an Iconify set, from its @iconify-icons module, drawn as
   @iconify/react's Icon draws it: the body in an svg of its size, an em
   wide. *)
type iconify

external body : iconify -> string = "body" [@@mel.get]
external width : iconify -> int = "width" [@@mel.get]
external height : iconify -> int = "height" [@@mel.get]

module Iconify (I : sig
  val data : iconify
end) =
struct
  let%component make ?(class_ : string option) () =
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1em"
      height="1em"
      view_box=(fun () ->
                 "0 0 "
                 ^ string_of_int (width I.data)
                 ^ " "
                 ^ string_of_int (height I.data))
      ?class_=(fun () -> Solidtype.Solid.get class_)
      inner_html=(fun () -> body I.data)
    />
end
