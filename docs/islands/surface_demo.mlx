module S = Solidtype.Solid
module Surface = Solidtype_heroui.Surface
module Select = Controls.Select

(* Each choice with the name HeroUI's React component takes for it. *)
let variants =
  [|
    (`default, "default");
    (`secondary, "secondary");
    (`tertiary, "tertiary");
    (`transparent, "transparent");
  |]

let make () =
  let variant, set_variant = S.create_signal (`default, "default") in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="variant"
        choices=(fun () -> variants)
        picked=(fun () -> S.get variant)
        on_pick=(Controls.choose variants set_variant)
      />
    </div>
    <Side_by_side
      solidtype=(<Surface
                   variant=(fun () -> fst (S.get variant))
                   class_="rounded-3xl p-6">
                   "Surface Content"
                 </Surface>)
      react=(fun host ->
              Heroui_react.surface host
                (Heroui_react.surface_props
                   ~variant:(snd (S.get variant))
                   ~class_name:"rounded-3xl p-6" ()))
    />
  </section>
