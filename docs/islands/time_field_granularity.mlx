module Label = Solidtype_heroui.Label
module Time_field = Solidtype_heroui.Time_field

let make () =
  <Time_field class_="w-64" granularity=`second hour_cycle=`h24 name="time">
    <Label>"Time, to the second"</Label>
    <Time_field.Group>
      <Time_field.Input>
        (fun segment ->
          <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment) />)
      </Time_field.Input>
    </Time_field.Group>
  </Time_field>
