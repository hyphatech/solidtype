module Toggle_button = Solidtype_heroui.Toggle_button

let make () =
  <div class_="flex items-center gap-3">
    <Toggle_button is_icon_only=true aria_label="Like">
      <Icons.Heart />
    </Toggle_button>
    <Toggle_button is_icon_only=true aria_label="Bookmark" variant=`ghost>
      <Icons.Bookmark />
    </Toggle_button>
  </div>
