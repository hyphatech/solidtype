module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Calendar = Solidtype_heroui.Calendar
module I18n = Solidtype_kobalte.I18n
module Toggle = Controls.Toggle
module D = Solidtype_internationalized_date

let make () =
  let disabled, set_disabled = S.create_signal false in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Toggle
        label="disabled" on=(S.get disabled) on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      compared="[data-slot=calendar]"
      solidtype=(<I18n.I18nProvider locale="en-US">
                   <Calendar
                     aria_label="Event date"
                     is_disabled=(S.get disabled)
                     default_focused_value=(D.parse_date "2026-11-21")>
                     <Calendar.Header>
                       <Calendar.Heading />
                       <Calendar.Nav_button slot=`previous />
                       <Calendar.Nav_button slot=`next />
                     </Calendar.Header>
                     <Calendar.Grid>
                       <Calendar.Grid_header>
                         (fun day ->
                           <Calendar.Header_cell>
                             (Jsx.string (S.get day))
                           </Calendar.Header_cell>)
                       </Calendar.Grid_header>
                       <Calendar.Grid_body>
                         (fun date -> <Calendar.Cell date=(S.get date) />)
                       </Calendar.Grid_body>
                     </Calendar.Grid>
                   </Calendar>
                 </I18n.I18nProvider>)
      react=(fun host ->
              Heroui_react.calendar host
                (Heroui_react.calendar_props ~is_disabled:(S.get disabled) ()))
    />
  </section>
