module Disclosure = Solidtype_heroui.Disclosure

let make () =
  <div class_="w-full max-w-md">
    <Disclosure>
      <Disclosure.Heading>
        <Disclosure.Trigger>
          "What does shipping cost?" <Disclosure.Indicator />
        </Disclosure.Trigger>
      </Disclosure.Heading>
      <Disclosure.Content>
        <Disclosure.Body>
          "Standard shipping is free; express is priced at checkout."
        </Disclosure.Body>
      </Disclosure.Content>
    </Disclosure>
  </div>
