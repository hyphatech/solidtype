module Tabs = Solidtype_heroui.Tabs

let months =
  [|
    "January";
    "February";
    "March";
    "April";
    "May";
    "June";
    "July";
    "August";
    "September";
    "October";
    "November";
    "December";
  |]

let make () =
  <Tabs class_="w-full max-w-sm">
    <Tabs.List_container>
      <Tabs.List aria_label="Months">
        <Solidtype.For each=(fun () -> months)>
          (fun month _ ->
            <Tabs.Tab id=(fun () -> month)>
              (fun () -> Solidtype.Jsx.string month) <Tabs.Indicator />
            </Tabs.Tab>)
        </Solidtype.For>
      </Tabs.List>
    </Tabs.List_container>
    <Solidtype.For each=(fun () -> months)>
      (fun month _ ->
        <Tabs.Panel id=(fun () -> month)>
          (fun () -> Solidtype.Jsx.string ("The report for " ^ month ^ "."))
        </Tabs.Panel>)
    </Solidtype.For>
  </Tabs>
