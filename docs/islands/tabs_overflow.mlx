module Tabs = Solidtype_heroui.Tabs

let items =
  [|
    ("overview", "Overview");
    ("analytics", "Analytics");
    ("reports", "Reports");
    ("performance", "Performance");
    ("engagement", "Engagement");
    ("audience", "Audience");
    ("acquisition", "Acquisition");
    ("retention", "Retention");
    ("settings", "Settings");
  |]

let make () =
  <div class_="w-[400px]">
    <Tabs>
      <Tabs.List_container>
        <Tabs.List aria_label="Overflow options">
          <Solidtype.For each=(fun () -> items)>
            (fun (id, label) _ ->
              <Tabs.Tab id=(fun () -> id)>
                (fun () -> Solidtype.Jsx.string label) <Tabs.Indicator />
              </Tabs.Tab>)
          </Solidtype.For>
        </Tabs.List>
      </Tabs.List_container>
      <Solidtype.For each=(fun () -> items)>
        (fun (id, label) _ ->
          <Tabs.Panel class_="pt-4" id=(fun () -> id)>
            <p>(fun () -> Solidtype.Jsx.string (label ^ " panel content."))</p>
          </Tabs.Panel>)
      </Solidtype.For>
    </Tabs>
  </div>
