(* A row, and the rows it holds written inside it; its chevron in the tree
   column while it holds rows, turned while it is expanded, as HeroUI's
   example draws it from its cell's render function. *)
let rec expandable_row item =
  <Table.Row id=(fun () -> item.id)>
    <Table.Cell>
      (fun () ->
        let row = Table.use_row_context () in
        let cell = Table.use_cell_context () in
        Jsx.element
          <span class_="flex items-center gap-1">
            <Show
              when_=(fun () ->
                      S.get row.has_child_items && S.get cell.is_tree_column)>
              <Button
                is_icon_only=true
                aria_label="Toggle row"
                is_disabled=(fun () -> S.get row.is_disabled)
                size=`sm
                slot=`chevron
                variant=`ghost>
                <Gravity.Chevron_right
                  class_=(fun () ->
                             "size-4 text-muted transition-transform \
                              duration-150 "
                             ^
                             if S.get row.is_expanded then "rotate-90"
                             else "rtl:rotate-180")
                />
              </Button>
            </Show>
            <span>(fun () -> Jsx.string item.title)</span>
          </span>)
    </Table.Cell>
    <Table.Cell>(fun () -> Jsx.string item.kind)</Table.Cell>
    <Table.Cell>(fun () -> Jsx.string item.date)</Table.Cell>
    <For each=(fun () -> item.children)>
      (fun child _ -> expandable_row child)
    </For>
  </Table.Row>

let make () =
  let expanded, set_expanded = S.create_signal [| "1" |] in
  <Table>
    <Table.Scroll_container>
      <Table.Content
        aria_label="Files"
        class_="min-w-[520px]"
        expanded_keys=(fun () -> S.get expanded)
        tree_column="name"
        on_expanded_change=(fun keys -> S.set set_expanded keys)>
        <Table.Header>
          <Table.Column is_row_header=true id="name">"Name"</Table.Column>
          <Table.Column id="type">"Type"</Table.Column>
          <Table.Column id="date">"Date Modified"</Table.Column>
        </Table.Header>
        <Table.Body>
          <For each=(fun () -> data)>(fun item _ -> expandable_row item)</For>
        </Table.Body>
      </Table.Content>
    </Table.Scroll_container>
  </Table>
