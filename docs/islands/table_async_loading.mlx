let items_per_page = 6

(* How long the fetch it stands in for takes. *)
let load_ms = 1500

let columns =
  [|
    ("name", "Name"); ("role", "Role"); ("status", "Status"); ("email", "Email");
  |]

let make () =
  let count, set_count = S.create_signal items_per_page in
  let loading, set_loading = S.create_signal false in
  let has_more () = S.get count < Array.length all_users in
  let timer = ref None in
  S.on_cleanup (fun () -> Option.iter Js.Global.clearTimeout !timer);
  (* The table asks for more only while it is not loading. *)
  let load_more () =
    if has_more () then begin
      S.set set_loading true;
      timer :=
        Some
          (Js.Global.setTimeout
             ~f:(fun () ->
               S.batch (fun () ->
                   S.set set_count
                     (min (Array.length all_users)
                        (S.get count + items_per_page));
                   S.set set_loading false))
             load_ms)
    end
  in
  <Table>
    <Table.Scroll_container class_="h-[280px] overflow-y-auto">
      <Table.Content aria_label="Async loading table" class_="min-w-[600px]">
        <Table.Header class_="sticky top-0 z-10 bg-surface-secondary">
          <For each=(fun () -> columns)>
            (fun (id, name) _ ->
              <Table.Column
                id=(fun () -> id)
                is_row_header=(fun () -> String.equal id "name")>
                (fun () -> Jsx.string name)
              </Table.Column>)
          </For>
        </Table.Header>
        <Table.Body>
          <For each=(fun () -> Array.sub all_users 0 (S.get count))>
            (fun user _ ->
              <Table.Row id=(fun () -> string_of_int user.id)>
                <Table.Cell>(fun () -> Jsx.string user.name)</Table.Cell>
                <Table.Cell>(fun () -> Jsx.string user.role)</Table.Cell>
                <Table.Cell>
                  <Chip
                    color=(fun () -> status_color user.status)
                    size=`sm
                    variant=`soft>
                    (fun () -> Jsx.string user.status)
                  </Chip>
                </Table.Cell>
                <Table.Cell>(fun () -> Jsx.string user.email)</Table.Cell>
              </Table.Row>)
          </For>
          <Show when_=(fun () -> has_more ())>
            <Table.Load_more
              is_loading=(fun () -> S.get loading)
              scroll_offset=0.
              on_load_more=load_more>
              <Table.Load_more_content>
                <Spinner size=`md />
              </Table.Load_more_content>
            </Table.Load_more>
          </Show>
        </Table.Body>
      </Table.Content>
    </Table.Scroll_container>
  </Table>
