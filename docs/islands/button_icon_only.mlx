module Button = Solidtype_heroui.Button

let make () =
  <div class_="flex flex-wrap items-center gap-3">
    <Button is_icon_only=true>
      <Icons.Plus /> <span class_="sr-only">"New file"</span>
    </Button>
    <Button is_icon_only=true variant=`secondary>
      <Icons.Check /> <span class_="sr-only">"Approve"</span>
    </Button>
    <Button is_icon_only=true variant=`danger>
      <Icons.Trash /> <span class_="sr-only">"Delete"</span>
    </Button>
  </div>
