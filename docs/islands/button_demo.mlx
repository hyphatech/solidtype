module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Button = Solidtype_heroui.Button

external target : Dom.event -> Dom.htmlInputElement = "target" [@@mel.get]
external value : Dom.htmlInputElement -> string = "value" [@@mel.get]
external checked : Dom.htmlInputElement -> bool = "checked" [@@mel.get]

(* Each choice with the name HeroUI's React component takes for it. *)
let variants =
  [|
    (`primary, "primary");
    (`secondary, "secondary");
    (`tertiary, "tertiary");
    (`outline, "outline");
    (`ghost, "ghost");
    (`danger, "danger");
    (`danger_soft, "danger-soft");
  |]

let sizes = [| (`sm, "sm"); (`md, "md"); (`lg, "lg") |]

let choose choices set e =
  let picked = value (target e) in
  Array.find_opt (fun (_, name) -> String.equal name picked) choices
  |> Option.iter (S.set set)

module Select = struct
  let%component make ~(label : string) ~(choices : ('a * string) array)
      ~(picked : 'a * string) ~(on_pick : Dom.event -> unit) () =
    <label class_="flex flex-col gap-1 text-xs text-muted">
      (fun () -> Jsx.string (label ()))
      <select
        class_="rounded-lg border border-separator bg-surface px-2 py-1 \
                text-sm text-foreground"
        on_change=on_pick>
        <For each=(fun () -> choices ())>
          (fun (_, name) _ ->
            <option
              value=name
              selected=(fun () -> String.equal name (snd (picked ())))>
              (fun () -> Jsx.string name)
            </option>)
        </For>
      </select>
    </label>
end

module Toggle = struct
  let%component make ~(label : string) ~(on : bool) ~(on_toggle : bool -> unit)
      () =
    <label class_="flex items-center gap-2 text-sm">
      <input
        type_="checkbox"
        checked=(fun () -> on ())
        on_change=(fun e -> on_toggle (checked (target e)))
      />
      (fun () -> Jsx.string (label ()))
    </label>
end

let make () =
  let variant, set_variant = S.create_signal (`primary, "primary") in
  let size, set_size = S.create_signal (`md, "md") in
  let full_width, set_full_width = S.create_signal false in
  let icon_only, set_icon_only = S.create_signal false in
  let disabled, set_disabled = S.create_signal false in
  let label () = if S.get icon_only then {js|★|js} else "Save" in
  <section class_="flex flex-col gap-4">
    <h2 class_="text-lg font-semibold">"Button"</h2>
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="variant"
        choices=(fun () -> variants)
        picked=(fun () -> S.get variant)
        on_pick=(choose variants set_variant)
      />
      <Select
        label="size"
        choices=(fun () -> sizes)
        picked=(fun () -> S.get size)
        on_pick=(choose sizes set_size)
      />
      <Toggle
        label="full width"
        on=(fun () -> S.get full_width)
        on_toggle=(S.set set_full_width)
      />
      <Toggle
        label="icon only"
        on=(fun () -> S.get icon_only)
        on_toggle=(S.set set_icon_only)
      />
      <Toggle
        label="disabled"
        on=(fun () -> S.get disabled)
        on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      ours=(<Button
              variant=(fun () -> fst (S.get variant))
              size=(fun () -> fst (S.get size))
              full_width=(fun () -> S.get full_width)
              is_icon_only=(fun () -> S.get icon_only)
              disabled=(fun () -> S.get disabled)>
              (fun () -> Jsx.string (label ()))
            </Button>)
      theirs=(fun host ->
               Heroui_react.button host
                 (Heroui_react.button_props
                    ~variant:(snd (S.get variant))
                    ~size:(snd (S.get size))
                    ~full_width:(S.get full_width)
                    ~is_icon_only:(S.get icon_only)
                    ~is_disabled:(S.get disabled) ~label:(label ()) ()))
    />
  </section>
