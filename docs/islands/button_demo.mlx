module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Button = Solidtype_heroui.Button
module Select = Controls.Select
module Toggle = Controls.Toggle

(* Each choice with the name HeroUI's React component takes for it. *)
let variants =
  [|
    (`primary, "primary");
    (`secondary, "secondary");
    (`tertiary, "tertiary");
    (`outline, "outline");
    (`ghost, "ghost");
    (`danger, "danger");
    (`danger_soft, "danger-soft");
  |]

let sizes = [| (`sm, "sm"); (`md, "md"); (`lg, "lg") |]

let make () =
  let variant, set_variant = S.create_signal (`primary, "primary") in
  let size, set_size = S.create_signal (`md, "md") in
  let full_width, set_full_width = S.create_signal false in
  let icon_only, set_icon_only = S.create_signal false in
  let disabled, set_disabled = S.create_signal false in
  let label () = if S.get icon_only then {js|★|js} else "Save" in
  <section class_="flex flex-col gap-4">
    <h2 class_="text-lg font-semibold">"Button"</h2>
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="variant"
        choices=(fun () -> variants)
        picked=(fun () -> S.get variant)
        on_pick=(Controls.choose variants set_variant)
      />
      <Select
        label="size"
        choices=(fun () -> sizes)
        picked=(fun () -> S.get size)
        on_pick=(Controls.choose sizes set_size)
      />
      <Toggle
        label="full width"
        on=(fun () -> S.get full_width)
        on_toggle=(S.set set_full_width)
      />
      <Toggle
        label="icon only"
        on=(fun () -> S.get icon_only)
        on_toggle=(S.set set_icon_only)
      />
      <Toggle
        label="disabled"
        on=(fun () -> S.get disabled)
        on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      solidtype=(<Button
                   variant=(fun () -> fst (S.get variant))
                   size=(fun () -> fst (S.get size))
                   full_width=(fun () -> S.get full_width)
                   is_icon_only=(fun () -> S.get icon_only)
                   is_disabled=(fun () -> S.get disabled)>
                   (fun () -> Jsx.string (label ()))
                 </Button>)
      react=(fun host ->
              Heroui_react.button host
                (Heroui_react.button_props
                   ~variant:(snd (S.get variant))
                   ~size:(snd (S.get size))
                   ~full_width:(S.get full_width)
                   ~is_icon_only:(S.get icon_only) ~is_disabled:(S.get disabled)
                   ~label:(label ()) ()))
    />
  </section>
