(* Four lines, the shorter ones placed as text is aligned. *)
module Align = struct
  let%component make ~(lines : string) () =
    <svg view_box="0 0 16 16" fill="none" aria_hidden=true class_="size-4">
      <path
        d=(fun () -> lines ())
        stroke="currentColor"
        stroke_width="1.5"
        stroke_linecap="round"
      />
    </svg>
end

module Align_left = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M2.5 6.5H9.5M2.5 9.5H13.5M2.5 12.5H9.5" />
end

module Align_center = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M4.5 6.5H11.5M2.5 9.5H13.5M4.5 12.5H11.5" />
end

module Align_right = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M6.5 6.5H13.5M2.5 9.5H13.5M6.5 12.5H13.5" />
end

module Align_justify = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M2.5 6.5H13.5M2.5 9.5H13.5M2.5 12.5H13.5" />
end

module Circle_dollar = struct
  let%component make () =
    <svg
      view_box="0 0 16 16"
      fill="none"
      role=`img
      aria_label="Dollar sign icon"
      class_="size-6 text-accent">
      <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke_width="1.5" />
      <path
        d="M9.75 6C9.75 5.31 8.97 4.75 8 4.75C7.03 4.75 6.25 5.31 6.25 6C6.25 \
           6.69 7.03 7.25 8 7.25C8.97 7.25 9.75 7.81 9.75 8.5C9.75 9.19 8.97 \
           9.75 8 9.75C7.03 9.75 6.25 9.19 6.25 8.5M8 3.75V4.75M8 9.75V11.25"
        stroke="currentColor"
        stroke_width="1.25"
        stroke_linecap="round"
      />
    </svg>
end

