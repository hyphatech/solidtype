module Circle_dollar = struct
  let%component make () =
    <svg
      view_box="0 0 16 16"
      fill="none"
      role=`img
      aria_label="Dollar sign icon"
                 (* HeroUI's example names [text-primary], which HeroUI 3 has not, so
         heroui.com draws it in the text's colour, as here. *)
      class_="size-6">
      <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke_width="1.5" />
      <path
        d="M9.75 6C9.75 5.31 8.97 4.75 8 4.75C7.03 4.75 6.25 5.31 6.25 6C6.25 \
           6.69 7.03 7.25 8 7.25C8.97 7.25 9.75 7.81 9.75 8.5C9.75 9.19 8.97 \
           9.75 8 9.75C7.03 9.75 6.25 9.19 6.25 8.5M8 3.75V4.75M8 9.75V11.25"
        stroke="currentColor"
        stroke_width="1.25"
        stroke_linecap="round"
      />
    </svg>
end

