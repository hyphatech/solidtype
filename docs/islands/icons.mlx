(* Four lines, the shorter ones placed as text is aligned. *)
module Align = struct
  let%component make ~(lines : string) () =
    <svg view_box="0 0 16 16" fill="none" aria_hidden=true class_="size-4">
      <path
        d=(fun () -> lines ())
        stroke="currentColor"
        stroke_width="1.5"
        stroke_linecap="round"
      />
    </svg>
end

module Align_left = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M2.5 6.5H9.5M2.5 9.5H13.5M2.5 12.5H9.5" />
end

module Align_center = struct
  let%component make () =
    <Align lines="M2.5 3.5H13.5M4.5 6.5H11.5M2.5 9.5H13.5M4.5 12.5H11.5" />
end

module Align_right = struct
  let%component make () =
