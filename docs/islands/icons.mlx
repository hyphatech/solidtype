(* A few icons for the examples, drawn as HeroUI's examples draw theirs:
   currentColor, sized by the component around them. *)

module Check = struct
  let%component make () =
    <svg view_box="0 0 16 16" fill="none" aria_hidden=true class_="size-4">
      <path
        d="M13.5 4.5L6.5 11.5L3 8"
        stroke="currentColor"
        stroke_width="1.5"
        stroke_linecap="round"
        stroke_linejoin="round"
      />
    </svg>
end

