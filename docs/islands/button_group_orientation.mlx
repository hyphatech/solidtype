module Button = Solidtype_heroui.Button
module Button_group = Solidtype_heroui.Button_group

let make () =
  <div class_="flex items-start gap-8">
    <div class_="flex flex-col items-start gap-2">
      <p class_="text-sm text-muted">"Horizontal"</p>
      <Button_group orientation=`horizontal variant=`tertiary>
        <Button is_icon_only=true aria_label="Align left">
          <Icons.Align_left />
        </Button>
        <Button is_icon_only=true aria_label="Align center">
          <Button_group.Separator /> <Icons.Align_center />
        </Button>
        <Button is_icon_only=true aria_label="Align right">
          <Button_group.Separator /> <Icons.Align_right />
        </Button>
        <Button is_icon_only=true aria_label="Justify">
          <Button_group.Separator /> <Icons.Align_justify />
        </Button>
      </Button_group>
    </div>
    <div class_="flex flex-col items-start gap-2">
      <p class_="text-sm text-muted">"Vertical"</p>
      <Button_group orientation=`vertical variant=`tertiary>
        <Button is_icon_only=true aria_label="Align left">
          <Icons.Align_left />
        </Button>
        <Button is_icon_only=true aria_label="Align center">
          <Button_group.Separator /> <Icons.Align_center />
        </Button>
        <Button is_icon_only=true aria_label="Align right">
          <Button_group.Separator /> <Icons.Align_right />
        </Button>
        <Button is_icon_only=true aria_label="Justify">
          <Button_group.Separator /> <Icons.Align_justify />
        </Button>
      </Button_group>
    </div>
  </div>
