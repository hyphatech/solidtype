module S = Solidtype.Solid
module Checkbox = Solidtype_heroui.Checkbox
module Label = Solidtype_heroui.Label

let make () =
  let terms, set_terms = S.create_signal false in
  <div class_="flex flex-col gap-3">
    <Checkbox is_selected=(fun () -> S.get terms) on_change=(S.set set_terms)>
      <Checkbox.Content>
        <Checkbox.Control><Checkbox.Indicator /></Checkbox.Control>
        <Label>"Accept terms and conditions"</Label>
      </Checkbox.Content>
    </Checkbox>
    <Checkbox is_indeterminate=true>
      <Checkbox.Content>
        <Checkbox.Control><Checkbox.Indicator /></Checkbox.Control>
        <Label>"Select all"</Label>
      </Checkbox.Content>
    </Checkbox>
  </div>
