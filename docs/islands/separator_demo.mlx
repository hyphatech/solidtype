module S = Solidtype.Solid
module Separator = Solidtype_heroui.Separator
module Select = Controls.Select

(* Each choice with the name HeroUI's React component takes for it. *)
let orientations = [| (`horizontal, "horizontal"); (`vertical, "vertical") |]

let variants =
  [|
    (`default, "default"); (`secondary, "secondary"); (`tertiary, "tertiary");
  |]

(* A line alone in its frame has no length of its own: both sides are
   given the same one. *)
let length = function `horizontal -> "w-40" | `vertical -> "h-16"

let make () =
  let orientation, set_orientation =
    S.create_signal (`horizontal, "horizontal")
  in
  let variant, set_variant = S.create_signal (`default, "default") in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="orientation"
        choices=(fun () -> orientations)
        picked=(fun () -> S.get orientation)
        on_pick=(Controls.choose orientations set_orientation)
      />
      <Select
        label="variant"
        choices=(fun () -> variants)
        picked=(fun () -> S.get variant)
        on_pick=(Controls.choose variants set_variant)
      />
    </div>
    <Side_by_side
      solidtype=(<Separator
                   orientation=(fun () -> fst (S.get orientation))
                   variant=(fun () -> fst (S.get variant))
                   class_=(fun () -> length (fst (S.get orientation)))
                 />)
      react=(fun host ->
              Heroui_react.separator host
                (Heroui_react.separator_props
                   ~orientation:(snd (S.get orientation))
                   ~variant:(snd (S.get variant))
                   ~class_name:(length (fst (S.get orientation)))
                   ()))
    />
  </section>
