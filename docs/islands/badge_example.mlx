module Badge = Solidtype_heroui.Badge

let make () =
  <div class_="flex items-center gap-8">
    <Badge.Anchor>
      <span class_="block size-10 rounded-full bg-default" />
      <Badge color=`danger size=`sm>"5"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-10 rounded-full bg-default" />
      <Badge color=`success placement=`bottom_right size=`sm>"New"</Badge>
    </Badge.Anchor>
  </div>
