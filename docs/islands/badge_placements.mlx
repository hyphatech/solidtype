module Badge = Solidtype_heroui.Badge

let make () =
  <div class_="flex items-center gap-6">
    <Badge.Anchor>
      <span class_="block size-10 rounded-lg bg-default" />
      <Badge color=`accent placement=`top_right size=`sm>"1"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-10 rounded-lg bg-default" />
      <Badge color=`accent placement=`top_left size=`sm>"2"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-10 rounded-lg bg-default" />
      <Badge color=`accent placement=`bottom_right size=`sm>"3"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-10 rounded-lg bg-default" />
      <Badge color=`accent placement=`bottom_left size=`sm>"4"</Badge>
    </Badge.Anchor>
  </div>
