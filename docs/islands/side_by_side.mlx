module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For

external query : Dom.htmlDivElement -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

external attribute_names : Dom.element -> string array = "getAttributeNames"
[@@mel.send]

external attribute : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

type observer
type watched

external observer : ((unit -> unit)[@mel.uncurry]) -> observer
  = "MutationObserver"
[@@mel.new]

external watched :
  attributes:bool ->
  subtree:bool ->
  child_list:(bool[@mel.as "childList"]) ->
  unit ->
  watched = ""
[@@mel.obj]

external observe : observer -> Dom.htmlDivElement -> watched -> unit = "observe"
[@@mel.send]

external disconnect : observer -> unit = "disconnect" [@@mel.send]
external tag_name : Dom.element -> string = "tagName" [@@mel.get]

external by_id : Dom.htmlDivElement -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

external escape : string -> string = "escape" [@@mel.scope "CSS"]

(* An attribute whose value is ids of other elements, which each framework
   makes its own way: it is shown as the parts they are, by their data-slot,
   or their tag where they have none. *)
let names_others = function
  | "aria-labelledby" | "aria-describedby" | "aria-controls" | "aria-owns"
  | "aria-activedescendant" | "for" ->
      true
  | _ -> false

let part host id =
  match Js.Null.toOption (by_id host ("#" ^ escape id)) with
  | Some e -> (
      match Js.Null.toOption (attribute e "data-slot") with
      | Some slot -> slot
      | None -> String.lowercase_ascii (tag_name e))
  | None -> "(elsewhere)"

(* An element a key reaches whatever its tabindex, as a browser's own. *)
let focusable e =
  match tag_name e with
  | "BUTTON" | "INPUT" | "SELECT" | "TEXTAREA" -> true
  | "A" -> Option.is_some (Js.Null.toOption (attribute e "href"))
  | _ -> false

(* What one side shows of the element [compared] finds in it: whether a key
   reaches it natively, and each attribute and its value. *)
let shown compared host =
  match Js.Null.toOption (query host compared) with
  | None -> (false, [||])
  | Some e ->
      ( focusable e,
        attribute_names e
        |> Array.map (fun name ->
            let v =
              Option.value (Js.Null.toOption (attribute e name)) ~default:""
            in
            if names_others name then
              ( name,
                String.split_on_char ' ' v
                |> List.filter (fun id -> not (String.equal id ""))
                |> List.map (part host)
                |> String.concat " " )
            else (name, v)) )

let value_of name pairs =
  Option.map snd (Array.find_opt (fun (n, _) -> String.equal n name) pairs)

(* Every attribute either side has, once, with each side's value. *)
let rows solidtype react =
  let names =
    Array.append (Array.map fst solidtype) (Array.map fst react)
    |> Array.to_list
    |> List.sort_uniq String.compare
    |> Array.of_list
  in
  Array.map
    (fun name -> (name, value_of name solidtype, value_of name react))
    names

(* What each framework writes for itself and no style reads: Solid's
   hydration key, React Aria's markers and the id it generates, React's
   attribute of a controlled input's value; and Kobalte's own state, present
   and empty, where React Aria writes none. *)
let internal name solidtype react =
  match (name, solidtype, react) with
  | ( ( "data-hk" | "data-rac" | "data-react-aria-pressable" | "data-collection"
      | "id" ),
      _,
      _ ) ->
      true
  | _, Some "", None -> String.starts_with ~prefix:"data-" name
  (* React writes a controlled input's value as an attribute too. *)
  | "value", None, Some _ -> true
  | _ -> false

(* A class is a set of words, whatever their order and spacing, but React
   Aria's default class for each of its components, which no style reads. *)
let words s =
  String.split_on_char ' ' s
  |> List.filter (fun w ->
      not (String.equal w "" || String.starts_with ~prefix:"react-aria-" w))
  |> List.sort_uniq String.compare

(* An opaque colour written with its alpha, rgba(4, 133, 247, 1), as a
   browser writes it back without, rgb(4, 133, 247). *)
let opaque d =
  let n = String.length d in
  if String.ends_with ~suffix:", 1)" d then
    match String.index_opt d '(' with
    | Some i when i >= 4 && String.equal (String.sub d (i - 4) 4) "rgba" ->
        String.sub d 0 (i - 1) ^ String.sub d i (n - i - 4) ^ ")"
    | Some _ | None -> d
  else d

(* A style is a set of declarations, however a framework spaces and ends
   them, and writes an opaque colour. *)
let declarations s =
  String.split_on_char ';' s
  |> List.map (fun d ->
      String.split_on_char ':' d |> List.map String.trim |> String.concat ":"
      |> opaque)
  |> List.filter (fun d -> not (String.equal d ""))
  |> List.sort_uniq String.compare

let same ~focusable name a b =
  match (name, a, b) with
  | "class", Some a, Some b -> List.equal String.equal (words a) (words b)
  | "class", Some c, None | "class", None, Some c -> (
      match words c with [] -> true | _ :: _ -> false)
  | "style", Some a, Some b ->
      List.equal String.equal (declarations a) (declarations b)
  | "aria-roledescription", Some a, Some b ->
      String.equal (String.lowercase_ascii a) (String.lowercase_ascii b)
  | "aria-disabled", (Some "false" | None), (Some "false" | None) -> true
  | "tabindex", (Some "0" | None), (Some "0" | None) ->
      focusable || Option.equal String.equal a b
  | _ -> Option.equal String.equal a b

let cell = function
  | Some v -> Jsx.string (if String.equal v "" then {js|(present)|js} else v)
  | None -> Jsx.string {js|—|js}

(* One HeroUI component twice, under the same props: [solidtype] renders the
   port, [react] renders HeroUI's React component into its host, and is run
   again whenever what it reads changes; [compared] finds the element each
   frame is compared by, its first by default. Below them, each attribute of
   the two elements, compared as the twin tests compare them: a row marked
   where they differ, and dimmed where it is a framework's own. *)
let%component make ?(compared : string = ":scope > *")
    ~(solidtype : Jsx.element) ~(react : Dom.htmlDivElement -> unit) () =
  let table, set_table = S.create_signal [||] in
  let solidtype_host = ref None in
  let react_host = ref None in
  let read () =
    match (!solidtype_host, !react_host) with
    | Some s, Some r ->
        let s_focusable, s_shown = shown (compared ()) s in
        let r_focusable, r_shown = shown (compared ()) r in
        S.set set_table
          (Array.map
             (fun (name, a, b) -> (name, a, b, s_focusable && r_focusable))
             (rows s_shown r_shown))
    | _ -> ()
  in
  (* The observer is made once mounted: the page is also prerendered, where
     there is no DOM to watch. *)
  S.on_mount (fun () ->
      match (!solidtype_host, !react_host) with
      | Some s, Some r ->
          let watcher = observer read in
          let all =
            watched ~attributes:true ~subtree:true ~child_list:true ()
          in
          observe watcher s all;
          observe watcher r all;
          S.on_cleanup (fun () ->
              disconnect watcher;
              Heroui_react.unmount r)
      | _ -> ());
  S.create_effect (fun () ->
      match !react_host with
      | Some r ->
          react r;
          read ()
      | None -> ());
  <div class_="flex flex-col gap-4">
    <div class_="grid grid-cols-2 gap-4">
      <figure class_="flex flex-col gap-2">
        <figcaption class_="font-mono text-xs text-muted">
          "solidtype-heroui"
        </figcaption>
        <div
          class_="heroui-ground flex min-h-24 items-center justify-center \
                  rounded-xl border border-separator p-6"
          ref=(fun el -> solidtype_host := Some el)>
          (fun () -> Jsx.element (solidtype ()))
        </div>
      </figure>
      <figure class_="flex flex-col gap-2">
        <figcaption class_="font-mono text-xs text-muted">
          "@heroui/react"
        </figcaption>
        <div
          class_="heroui-ground flex min-h-24 items-center justify-center \
                  rounded-xl border border-separator p-6"
          ref=(fun el -> react_host := Some el)
        />
      </figure>
    </div>
    <table class_="w-full text-left font-mono text-xs">
      <thead class_="text-muted">
        <tr>
          <th class_="py-1 pe-4 font-medium">"attribute"</th>
          <th class_="py-1 pe-4 font-medium">"solidtype"</th>
          <th class_="py-1 font-medium">"React"</th>
        </tr>
      </thead>
      <tbody>
        <For each=(fun () -> S.get table)>
          (fun (name, a, b, focusable) _ ->
            let marked =
              if internal name a b then "text-muted"
              else if same ~focusable name a b then ""
              else "bg-warning-soft"
            in
            <tr class_=marked>
              <td class_="py-1 pe-4">(fun () -> Jsx.string name)</td>
              <td class_="py-1 pe-4 break-all">(fun () -> cell a)</td>
              <td class_="py-1 break-all">(fun () -> cell b)</td>
            </tr>)
        </For>
      </tbody>
    </table>
  </div>
