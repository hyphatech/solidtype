module Badge = Solidtype_heroui.Badge

let make () =
  <div class_="flex items-center gap-6">
    <Badge.Anchor>
      <span class_="block size-8 rounded-full bg-default" />
      <Badge color=`danger size=`sm>"5"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-10 rounded-full bg-default" />
      <Badge color=`danger size=`md>"5"</Badge>
    </Badge.Anchor>
    <Badge.Anchor>
      <span class_="block size-12 rounded-full bg-default" />
      <Badge color=`danger size=`lg>"5"</Badge>
    </Badge.Anchor>
  </div>
