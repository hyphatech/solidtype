module Avatar = Solidtype_heroui.Avatar
module Badge = Solidtype_heroui.Badge
module Separator = Solidtype_heroui.Separator

let avatar =
  "https://heroui-assets.nyc3.cdn.digitaloceanspaces.com/avatars/green.jpg"

let colors = [| `accent; `default; `success; `warning; `danger |]

let row ~name ~variant =
  <div class_="flex flex-col gap-4">
    <h3 class_="text-sm font-semibold text-muted capitalize">
      (fun () -> Solidtype.Jsx.string name)
    </h3>
    <div class_="flex items-center gap-6">
      <Solidtype.For each=(fun () -> colors)>
        (fun color _ ->
          <Badge.Anchor>
            <Avatar>
              <Avatar.Image src=(fun () -> avatar) />
              <Avatar.Fallback>"JD"</Avatar.Fallback>
            </Avatar>
            <Badge color=(fun () -> color) size=`sm variant=(fun () -> variant)>
              "5"
            </Badge>
          </Badge.Anchor>)
      </Solidtype.For>
    </div>
  </div>

let make () =
  <div class_="flex flex-col gap-8">
    (fun () -> Solidtype.Jsx.element (row ~name:"primary" ~variant:`primary))
    <Separator />
    (fun () ->
      Solidtype.Jsx.element (row ~name:"secondary" ~variant:`secondary))
    <Separator />
    (fun () -> Solidtype.Jsx.element (row ~name:"soft" ~variant:`soft))
  </div>
