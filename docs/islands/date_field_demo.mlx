module S = Solidtype.Solid
module Label = Solidtype_heroui.Label
module Date_field = Solidtype_heroui.Date_field
module Select = Controls.Select
module Toggle = Controls.Toggle

(* Each choice with the name HeroUI's React component takes for it. *)
let variants = [| (`primary, "primary"); (`secondary, "secondary") |]

let make () =
  let variant, set_variant = S.create_signal (`primary, "primary") in
  let disabled, set_disabled = S.create_signal false in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="variant"
        choices=variants
        picked=(S.get variant)
        on_pick=(Controls.choose variants set_variant)
      />
      <Toggle
        label="disabled" on=(S.get disabled) on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      compared="[data-slot=date-field]"
      solidtype=(<Date_field
                   is_disabled=(S.get disabled) class_="w-56" name="date">
                   <Label>"Date"</Label>
                   <Date_field.Group variant=(fst (S.get variant))>
                     <Date_field.Input>
                       (fun segment ->
                         <Date_field.Segment segment=(S.get segment) />)
                     </Date_field.Input>
                   </Date_field.Group>
                 </Date_field>)
      react=(fun host ->
              Heroui_react.date_field host
                (Heroui_react.date_field_props
                   ~variant:(snd (S.get variant))
                   ~is_disabled:(S.get disabled) ()))
    />
  </section>
