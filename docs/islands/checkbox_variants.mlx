module Checkbox = Solidtype_heroui.Checkbox
module Label = Solidtype_heroui.Label

let make () =
  <div class_="flex flex-col gap-4">
    <Checkbox variant=`primary default_selected=true>
      <Checkbox.Content>
        <Checkbox.Control><Checkbox.Indicator /></Checkbox.Control>
        <Label>"Primary checkbox"</Label>
      </Checkbox.Content>
    </Checkbox>
    <Checkbox variant=`secondary default_selected=true>
      <Checkbox.Content>
        <Checkbox.Control><Checkbox.Indicator /></Checkbox.Control>
        <Label>"Secondary checkbox"</Label>
      </Checkbox.Content>
    </Checkbox>
  </div>
