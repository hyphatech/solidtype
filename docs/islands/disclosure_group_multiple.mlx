module Disclosure = Solidtype_heroui.Disclosure
module Disclosure_group = Solidtype_heroui.Disclosure_group

let make () =
  <Disclosure_group
    allows_multiple_expanded=true
    default_expanded_keys=(fun () -> [| "size"; "care" |])
    class_="max-w-md">
    <Disclosure id="size">
      <Disclosure.Heading>
        <Disclosure.Trigger>"Size" <Disclosure.Indicator /></Disclosure.Trigger>
      </Disclosure.Heading>
      <Disclosure.Content>
        <Disclosure.Body>"Runs true to size."</Disclosure.Body>
      </Disclosure.Content>
    </Disclosure>
    <Disclosure id="care">
      <Disclosure.Heading>
        <Disclosure.Trigger>"Care" <Disclosure.Indicator /></Disclosure.Trigger>
      </Disclosure.Heading>
      <Disclosure.Content>
        <Disclosure.Body>"Wash cold, dry flat."</Disclosure.Body>
      </Disclosure.Content>
    </Disclosure>
  </Disclosure_group>
