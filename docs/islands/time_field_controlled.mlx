module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Button = Solidtype_heroui.Button
module Description = Solidtype_heroui.Description
module Label = Solidtype_heroui.Label
module Time_field = Solidtype_heroui.Time_field
module Time = Solidtype_kobalte.Types.Time

(* The time now, in the reader's time zone. *)
let now () =
  let d = Js.Date.make () in
  Time.make ~hour:(Js.Date.getHours d) ~minute:(Js.Date.getMinutes d)
    ~second:(Js.Date.getSeconds d) ()

(* A time as @internationalized/date's [Time] writes it, 09:45:00. *)
let to_string t =
  let two part =
    let n = Option.value (part t) ~default:0. in
    (if n < 10. then "0" else "") ^ Js.Float.toString n
  in
  String.concat ":" [ two Time.hour; two Time.minute; two Time.second ]

let make () =
  let value, set_value = S.create_signal None in
  <div class_="flex flex-col gap-4">
    <Time_field
      class_="w-[256px]"
      name="time"
      value=(fun () -> Js.Nullable.fromOption (S.get value))
      on_change=(S.set set_value)>
      <Label>"Time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> S.get segment) />)
        </Time_field.Input>
      </Time_field.Group>
      <Description>
        (fun () ->
          Jsx.string
            ("Current value: "
            ^ match S.get value with Some t -> to_string t | None -> "(empty)"))
      </Description>
    </Time_field>
    <div class_="flex gap-2">
      <Button
        variant=`tertiary on_click=(fun _ -> S.set set_value (Some (now ())))>
        "Set now"
      </Button>
      <Button variant=`tertiary on_click=(fun _ -> S.set set_value None)>
        "Clear"
      </Button>
    </div>
  </div>
