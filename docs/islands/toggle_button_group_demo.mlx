module S = Solidtype.Solid
module Toggle_button = Solidtype_heroui.Toggle_button
module Toggle_button_group = Solidtype_heroui.Toggle_button_group
module Select = Controls.Select
module Toggle = Controls.Toggle

(* Each choice with the name HeroUI's React component takes for it. *)
let modes = [| (`single, "single"); (`multiple, "multiple") |]
let sizes = [| (`sm, "sm"); (`md, "md"); (`lg, "lg") |]
let orientations = [| (`horizontal, "horizontal"); (`vertical, "vertical") |]

let make () =
  let mode, set_mode = S.create_signal (`single, "single") in
  let size, set_size = S.create_signal (`md, "md") in
  let orientation, set_orientation =
    S.create_signal (`horizontal, "horizontal")
  in
  let detached, set_detached = S.create_signal false in
  let full_width, set_full_width = S.create_signal false in
  let disabled, set_disabled = S.create_signal false in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="selection mode"
        choices=(fun () -> modes)
        picked=(fun () -> S.get mode)
        on_pick=(Controls.choose modes set_mode)
      />
      <Select
        label="size"
        choices=(fun () -> sizes)
        picked=(fun () -> S.get size)
        on_pick=(Controls.choose sizes set_size)
      />
      <Select
        label="orientation"
        choices=(fun () -> orientations)
        picked=(fun () -> S.get orientation)
        on_pick=(Controls.choose orientations set_orientation)
      />
      <Toggle
        label="detached"
        on=(fun () -> S.get detached)
        on_toggle=(S.set set_detached)
      />
      <Toggle
        label="full width"
        on=(fun () -> S.get full_width)
        on_toggle=(S.set set_full_width)
      />
      <Toggle
        label="disabled"
        on=(fun () -> S.get disabled)
        on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      compared="[data-slot=toggle-button-group]"
      solidtype=(<Toggle_button_group
                   selection_mode=(fun () -> fst (S.get mode))
                   default_selected_keys=(fun () -> [| "center" |])
                   size=(fun () -> fst (S.get size))
                   orientation=(fun () -> fst (S.get orientation))
                   is_detached=(fun () -> S.get detached)
                   full_width=(fun () -> S.get full_width)
                   is_disabled=(fun () -> S.get disabled)
                   aria_label="Alignment">
                   <Toggle_button id="left">"Left"</Toggle_button>
                   <Toggle_button id="center">
                     <Toggle_button_group.Separator /> "Center"
                   </Toggle_button>
                   <Toggle_button id="right">
                     <Toggle_button_group.Separator /> "Right"
                   </Toggle_button>
                 </Toggle_button_group>)
      react=(fun host ->
              Heroui_react.toggle_button_group host
                (Heroui_react.toggle_button_group_props
                   ~selection_mode:(snd (S.get mode))
                   ~size:(snd (S.get size))
                   ~orientation:(snd (S.get orientation))
                   ~is_detached:(S.get detached) ~full_width:(S.get full_width)
                   ~is_disabled:(S.get disabled) ()))
    />
  </section>
