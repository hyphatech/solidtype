module S = Solidtype.Solid
module Label = Solidtype_heroui.Label
module Meter = Solidtype_heroui.Meter
module Select = Controls.Select

(* Each choice with the name HeroUI's React component takes for it. *)
let colors =
  [|
    (`accent, "accent");
    (`default, "default");
    (`success, "success");
    (`warning, "warning");
    (`danger, "danger");
  |]

let sizes = [| (`sm, "sm"); (`md, "md"); (`lg, "lg") |]

let make () =
  let color, set_color = S.create_signal (`accent, "accent") in
  let size, set_size = S.create_signal (`md, "md") in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Select
        label="color"
        choices=(fun () -> colors)
        picked=(fun () -> S.get color)
        on_pick=(Controls.choose colors set_color)
      />
      <Select
        label="size"
        choices=(fun () -> sizes)
        picked=(fun () -> S.get size)
        on_pick=(Controls.choose sizes set_size)
      />
    </div>
    <Side_by_side
      compared="[data-slot=meter]"
      solidtype=(<Meter
                   value=60.
                   color=(fun () -> fst (S.get color))
                   size=(fun () -> fst (S.get size))
                   class_="w-56">
                   <Label>"Storage"</Label>
                   <Meter.Output />
                   <Meter.Track><Meter.Fill /></Meter.Track>
                 </Meter>)
      react=(fun host ->
              Heroui_react.meter host
                (Heroui_react.meter_props
                   ~color:(snd (S.get color))
                   ~size:(snd (S.get size))
                   ()))
    />
  </section>
