module S = Solidtype.Solid
module Accordion = Solidtype_heroui.Accordion

let make () =
  let expanded, set_expanded = S.create_signal [| "" |] in
  <Accordion
    class_="w-full max-w-md"
    expanded_keys=(fun () -> S.get expanded)
    variant=`surface
    on_expanded_change=(S.set set_expanded)>
    <Accordion.Item id="1">
      <Accordion.Heading>
        <Accordion.Trigger>
          "Using Plus/Minus Icon"
          <Accordion.Indicator>
            (fun () ->
              if Array.exists (String.equal "1") (S.get expanded) then
                Solidtype.Jsx.element <Gravity.Minus />
              else Solidtype.Jsx.element <Gravity.Plus />)
          </Accordion.Indicator>
        </Accordion.Trigger>
      </Accordion.Heading>
      <Accordion.Panel>
        <Accordion.Body>
          "This accordion uses a plus icon that transforms when expanded. The \
           icon automatically rotates 45 degrees to form an X."
        </Accordion.Body>
      </Accordion.Panel>
    </Accordion.Item>
    <Accordion.Item id="2">
      <Accordion.Heading>
        <Accordion.Trigger>
          "Using Caret Icon"
          <Accordion.Indicator>
            <Gravity.Circle_chevron_down />
          </Accordion.Indicator>
        </Accordion.Trigger>
      </Accordion.Heading>
      <Accordion.Panel>
        <Accordion.Body>
          "This item uses a caret icon for the indicator. The rotation \
           animation is applied automatically."
        </Accordion.Body>
      </Accordion.Panel>
    </Accordion.Item>
    <Accordion.Item id="3">
      <Accordion.Heading>
        <Accordion.Trigger>
          "Using Arrow Icon"
          <Accordion.Indicator><Gravity.Chevrons_down /></Accordion.Indicator>
        </Accordion.Trigger>
      </Accordion.Heading>
      <Accordion.Panel>
        <Accordion.Body>
          "This item uses an arrow icon. Any icon you pass will receive the \
           rotation animation when the item expands."
        </Accordion.Body>
      </Accordion.Panel>
    </Accordion.Item>
  </Accordion>
