module Label = Solidtype_heroui.Label
module Slider = Solidtype_heroui.Slider

let make () =
  <Slider
    class_="w-full max-w-xs"
    default_value=(fun () -> [| 100.; 500. |])
    max_value=1000.
    min_value=0.
    step=50.>
    <Label>"Price Range"</Label>
    <Slider.Output />
    <Slider.Track>
      <Slider.Fill /> <Slider.Thumb index=0 /> <Slider.Thumb index=1 />
    </Slider.Track>
  </Slider>
