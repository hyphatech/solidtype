module Button = Solidtype_heroui.Button
module Button_group = Solidtype_heroui.Button_group

let group ~label ~size =
  <div class_="flex flex-col items-start gap-2">
    <p class_="text-sm text-muted">(fun () -> Solidtype.Jsx.string label)</p>
    <Button_group size=(fun () -> size) variant=`secondary>
      <Button>"First"</Button>
      <Button><Button_group.Separator /> "Second"</Button>
      <Button><Button_group.Separator /> "Third"</Button>
    </Button_group>
  </div>

let make () =
  <div class_="flex flex-col gap-4">
    (fun () -> Solidtype.Jsx.element (group ~label:"Small" ~size:`sm))
    (fun () ->
      Solidtype.Jsx.element (group ~label:"Medium (default)" ~size:`md))
    (fun () -> Solidtype.Jsx.element (group ~label:"Large" ~size:`lg))
  </div>
