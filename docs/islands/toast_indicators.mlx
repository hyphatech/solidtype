module Button = Solidtype_heroui.Button
module Toast = Solidtype_heroui.Toast

let make () =
  <div class_="flex h-full max-w-xl flex-col items-center justify-center">
    <Button
      size=`sm
      variant=`secondary
      on_click=(fun _ ->
                   ignore
                     (Toast.show
                        ~indicator:(Toast.Icon <Gravity.Star />)
                        "Custom icon indicator"
                       : Toast.key))>
      "Custom indicator"
    </Button>
  </div>
