module S = Solidtype.Solid
module Combo_box = Solidtype_heroui.Combo_box
module Input = Solidtype_heroui.Input
module Label = Solidtype_heroui.Label
module List_box = Solidtype_heroui.List_box
module Choice = Controls.Select
module Toggle = Controls.Toggle

(* Each choice with the name HeroUI's React component takes for it. *)
let modes = [| (`single, "single"); (`multiple, "multiple") |]
let variants = [| (`primary, "primary"); (`secondary, "secondary") |]

let make () =
  let mode, set_mode = S.create_signal (`single, "single") in
  let variant, set_variant = S.create_signal (`primary, "primary") in
  let disabled, set_disabled = S.create_signal false in
  <section class_="flex flex-col gap-4">
    <div class_="flex flex-wrap items-end gap-4">
      <Choice
        label="selectionMode"
        choices=(fun () -> modes)
        picked=(fun () -> S.get mode)
        on_pick=(Controls.choose modes set_mode)
      />
      <Choice
        label="variant"
        choices=(fun () -> variants)
        picked=(fun () -> S.get variant)
        on_pick=(Controls.choose variants set_variant)
      />
      <Toggle
        label="isDisabled"
        on=(fun () -> S.get disabled)
        on_toggle=(S.set set_disabled)
      />
    </div>
    <Side_by_side
      compared="[data-slot=input]"
      solidtype=(<div>
                   (fun () ->
                     (* A combo box's mode is read as it is made, so another
                        makes another combo box, as React's key does. *)
                     let mode = fst (S.get mode) in
                     Solidtype.Jsx.element
                       <Combo_box
                         class_="w-[256px]"
                         selection_mode=(fun () -> mode)
                         variant=(fun () -> fst (S.get variant))
                         is_disabled=(fun () -> S.get disabled)>
                         <Label>"Favorite Animal"</Label>
                         <Combo_box.Input_group>
                           <Input placeholder="Search animals..." />
                           <Combo_box.Trigger />
                         </Combo_box.Input_group>
                         (fun () ->
                           match mode with
                           | `multiple ->
                               Solidtype.Jsx.element
                                 <Combo_box.Value
                                   placeholder="No animals selected"
                                 />
                           | `single ->
                               Solidtype.Jsx.element Solidtype.Jsx.nothing)
                         <Combo_box.Popover>
                           <List_box
                             selection_mode=(fun () ->
                                              (mode :> List_box.selection_mode))>
                             <List_box.Item id="cat" text_value="Cat">
                               "Cat" <List_box.Item_indicator />
                             </List_box.Item>
                             <List_box.Item id="dog" text_value="Dog">
                               "Dog" <List_box.Item_indicator />
                             </List_box.Item>
                             <List_box.Item id="panda" text_value="Panda">
                               "Panda" <List_box.Item_indicator />
                             </List_box.Item>
                           </List_box>
                         </Combo_box.Popover>
                       </Combo_box>)
                 </div>)
      react=(fun host ->
              Heroui_react.combo_box host
                (Heroui_react.combo_box_props
                   ~selection_mode:(fst (S.get mode))
                   ~variant:(fst (S.get variant))
                   ~is_disabled:(S.get disabled) ()))
    />
  </section>
