module Label = Solidtype_heroui.Label
module Time_field = Solidtype_heroui.Time_field

let make () =
  <div class_="w-96">
    <Time_field full_width=true name="time">
      <Label>"Time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment)
            />)
        </Time_field.Input>
      </Time_field.Group>
    </Time_field>
  </div>
