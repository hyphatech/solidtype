module Separator = Solidtype_heroui.Separator

let make () =
  <div class_="flex w-64 flex-col gap-3 text-sm">
    <p>"Kobalte gives it its role and orientation; HeroUI its look."</p>
    <Separator />
    <div class_="flex h-5 items-center gap-3">
      "Docs"
      <Separator orientation=`vertical />
      "Components"
      <Separator orientation=`vertical />
      "Coverage"
    </div>
  </div>
