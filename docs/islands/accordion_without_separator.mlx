module Accordion = Solidtype_heroui.Accordion

let items =
  [|
    ( "How do I place an order?",
      "Browse our products, add items to your cart, and proceed to checkout." );
    ( "Can I modify or cancel my order?",
      "Yes, you can modify or cancel your order before it's shipped." );
    ( "What payment methods do you accept?",
      "We accept all major credit cards, including Visa, Mastercard, and \
       American Express." );
  |]

let make () =
  <Accordion hide_separator=true class_="w-full max-w-md">
    <Solidtype.For each=(fun () -> items)>
      (fun (title, content) _ ->
        <Accordion.Item>
          <Accordion.Heading>
            <Accordion.Trigger>
              (fun () -> Solidtype.Jsx.string title) <Accordion.Indicator />
            </Accordion.Trigger>
          </Accordion.Heading>
          <Accordion.Panel>
            <Accordion.Body>
              (fun () -> Solidtype.Jsx.string content)
            </Accordion.Body>
          </Accordion.Panel>
        </Accordion.Item>)
    </Solidtype.For>
  </Accordion>
