module Accordion = Solidtype_heroui.Accordion

let items =
  [|
    ( (fun () -> <Gravity.Shopping_bag />),
      "How do I place an order?",
      "Browse our products, add items to your cart, and proceed to checkout. \
       You'll need to provide shipping and payment information to complete \
       your purchase." );
    ( (fun () -> <Gravity.Receipt />),
      "Can I modify or cancel my order?",
      "Yes, you can modify or cancel your order before it's shipped. Once your \
       order is processed, you can't make changes." );
    ( (fun () -> <Gravity.Credit_card />),
      "What payment methods do you accept?",
      "We accept all major credit cards, including Visa, Mastercard, and \
       American Express." );
  |]

let make () =
  <Accordion hide_separator=true class_="w-full max-w-md">
    <Solidtype.For each=(fun () -> items)>
      (fun (icon, title, content) _ ->
        <Accordion.Item>
          <Accordion.Heading>
            <Accordion.Trigger>
              <span class_="me-3 size-4 shrink-0 text-muted">
                (fun () -> Solidtype.Jsx.element (icon ()))
              </span>
              (fun () -> Solidtype.Jsx.string title)
              <Accordion.Indicator>
                <Gravity.Chevron_down />
              </Accordion.Indicator>
            </Accordion.Trigger>
          </Accordion.Heading>
          <Accordion.Panel>
            <Accordion.Body>
              (fun () -> Solidtype.Jsx.string content)
            </Accordion.Body>
          </Accordion.Panel>
        </Accordion.Item>)
    </Solidtype.For>
  </Accordion>
