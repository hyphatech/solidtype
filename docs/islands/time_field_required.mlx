module Description = Solidtype_heroui.Description
module Label = Solidtype_heroui.Label
module Time_field = Solidtype_heroui.Time_field

let make () =
  <div class_="flex flex-col gap-4">
    <Time_field class_="w-64" is_required=true name="time">
      <Label>"Time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment)
            />)
        </Time_field.Input>
      </Time_field.Group>
    </Time_field>
    <Time_field class_="w-64" is_required=true name="appointment-time">
      <Label>"Appointment time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment)
            />)
        </Time_field.Input>
      </Time_field.Group>
      <Description>"Required field"</Description>
    </Time_field>
  </div>
