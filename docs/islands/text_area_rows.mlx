module Text_area = Solidtype_heroui.Text_area

let make () =
  <div class_="flex w-64 flex-col gap-4">
    <Text_area rows="2" placeholder="Two rows" aria_label="Two rows" />
    <Text_area
      rows="6"
      class_="resize-none"
      placeholder="Six rows, fixed"
      aria_label="Six rows"
    />
  </div>
