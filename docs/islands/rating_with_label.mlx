module Rating = Solidtype_heroui.Rating
module Label = Solidtype_heroui.Label

let make () =
  <div class_="flex flex-col gap-1.5">
    <Label>"How would you rate this product?"</Label>
    <Rating aria_label="Product rating">
      <Rating.Item value=1. />
      <Rating.Item value=2. />
      <Rating.Item value=3. />
      <Rating.Item value=4. />
      <Rating.Item value=5. />
    </Rating>
  </div>
