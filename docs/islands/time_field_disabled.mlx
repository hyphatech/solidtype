module Description = Solidtype_heroui.Description
module Label = Solidtype_heroui.Label
module Time_field = Solidtype_heroui.Time_field
module Time = Solidtype_kobalte.Types.Time

let make () =
  <div class_="flex flex-col gap-4">
    <Time_field
      class_="w-64"
      is_disabled=true
      name="time"
      default_value=(fun () -> Time.make ~hour:14. ~minute:30. ())>
      <Label>"Time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment)
            />)
        </Time_field.Input>
      </Time_field.Group>
      <Description>"This time field is disabled"</Description>
    </Time_field>
    <Time_field class_="w-64" is_disabled=true name="time-empty">
      <Label>"Time"</Label>
      <Time_field.Group>
        <Time_field.Input>
          (fun segment ->
            <Time_field.Segment segment=(fun () -> Solidtype.Solid.get segment)
            />)
        </Time_field.Input>
      </Time_field.Group>
      <Description>"This time field is disabled"</Description>
    </Time_field>
  </div>
