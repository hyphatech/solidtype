opam-version: "2.0"
synopsis:
  "Components Kobalte lacks for solidtype, made as Kobalte makes its own"
description:
  "Headless, accessible components that Kobalte 0.13 has none of, made of Kobalte's own hooks for OCaml front ends on Solid written with solidtype: their roles, keys and state, and no style, for a design system to dress."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/solidtype"
bug-reports: "https://github.com/hyphatech/solidtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "melange" {>= "7.0.1-55"}
  "solidtype" {= version}
  "solidtype-kobalte" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/solidtype.git"
x-maintenance-intent: ["(latest)"]
x-open-opam: true
