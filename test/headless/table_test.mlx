(* The headless Table as a caller meets it: a grid of rows and cells, walked by
   the keys, its rows selected by Kobalte's list and their state written as
   Kobalte writes it, a control's press left to the control, the caller's ref
   and handlers called beside its own, an empty state across every column,
   and no violation axe finds. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Table = Solidtype_headless.Table
module E = Jest.Expect
module H = Harness
open Harness.Syntax

type member = { id : string; name : string; role : string }

let members =
  [|
    { id = "1"; name = "Kate Moore"; role = "CEO" };
    { id = "2"; name = "John Smith"; role = "CTO" };
    { id = "3"; name = "Sara Johnson"; role = "CMO" };
  |]

(* The team, its rows selected as [mode] says, row 2 disabled where asked. *)
let team ?(mode = `none) ?(disabled = [||]) ?(told = ref [||])
    ?(members = members) ?(on_key_down = fun (_ : Dom.keyboardEvent) -> ())
    ?(got_table = ref false) ?(clicked = ref 0) () =
  H.render (fun () ->
      <Table.Root
        aria_label="Team members"
        selection_mode=(fun () -> mode)
        disabled_keys=(fun () -> disabled)
        on_selection_change=(fun keys -> told := keys)
        ref=(fun _ -> got_table := true)
        on_key_down>
        <Table.Header>
          <Table.Column is_row_header=true>"Name"</Table.Column>
          <Table.Column>"Role"</Table.Column>
          <Table.Column>"Actions"</Table.Column>
        </Table.Header>
        <Table.Body empty_state=(<span>"No members"</span>)>
          <For each=(fun () -> members)>
            (fun m _ ->
              <Table.Row id=(fun () -> m.id) on_click=(fun _ -> incr clicked)>
                <Table.Cell>(fun () -> Jsx.string m.name)</Table.Cell>
                <Table.Cell>(fun () -> Jsx.string m.role)</Table.Cell>
                <Table.Cell>
                  <button type_=`button>
                    (fun () -> Jsx.string ("Edit " ^ m.name))
                  </button>
                </Table.Cell>
              </Table.Row>)
          </For>
        </Table.Body>
      </Table.Root>)

let where () =
  Option.value (H.attribute H.focused "role") ~default:"?"
  ^ ":" ^ H.text H.focused

let row name =
  match
    Array.to_list (H.all_by_role "row")
    |> List.filter (fun r -> Js.String.includes ~search:name (H.text r))
  with
  | r :: _ -> r
  | [] -> Js.Exn.raiseError ("no row of " ^ name)

let () =
  Jest.describe "Table" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.test "is a grid of rows and cells, each row named by its header"
        (fun () ->
          team ();
          let kate = row "Kate Moore" in
          let header =
            match H.attribute kate "aria-labelledby" with
            | Some id -> (
                match Js.Null.toOption (H.by_id id) with
                | Some e -> H.text e
                | None -> "missing")
            | None -> "unnamed"
          in
          E.(
            expect
              ( Array.map
                  (fun e -> Option.value (H.attribute e "role") ~default:"")
                  (H.all_by_role "columnheader"),
                Array.length (H.all_by_role "rowheader"),
                Array.length (H.all_by_role "gridcell"),
                header )
            |> toEqual
                 ( [| "columnheader"; "columnheader"; "columnheader" |],
                   3,
                   6,
                   "Kate Moore" )));
      Jest.testPromise "is walked by the keys, rows and their cells" (fun () ->
          team ();
          let user = H.setup () in
          let* () = H.tab user in
          let seen = ref [ where () ] in
          let rec go = function
            | [] -> Js.Promise.resolve ()
            | k :: rest ->
                let* () = H.keyboard user k in
                seen := where () :: !seen;
                go rest
          in
          let* () =
            go
              [
                "{ArrowDown}";
                "{ArrowRight}";
                "{ArrowRight}";
                "{ArrowDown}";
                "{ArrowLeft}";
                "{ArrowLeft}";
                "{ArrowUp}";
                "{End}";
              ]
          in
          Js.Promise.resolve
            E.(
              expect (Array.of_list (List.rev !seen))
              |> toEqual
                   [|
                     "row:Kate MooreCEOEdit Kate Moore";
                     "row:John SmithCTOEdit John Smith";
                     "rowheader:John Smith";
                     "gridcell:CTO";
                     "gridcell:CMO";
                     "rowheader:Sara Johnson";
                     "row:Sara JohnsonCMOEdit Sara Johnson";
                     "row:John SmithCTOEdit John Smith";
                     "row:Sara JohnsonCMOEdit Sara Johnson";
                   |]));
      Jest.testPromise
        "keeps focus on a cell given it, and where an arrow reaches no cell"
        (fun () ->
          team ();
          let user = H.setup () in
          let after start k =
            H.focus (H.by_text start);
            let* () = H.keyboard user k in
            Js.Promise.resolve (where ())
          in
          let* below_last = after "CMO" "{ArrowDown}" in
          let* above_header = after "Role" "{ArrowUp}" in
          let* before_header = after "Name" "{ArrowLeft}" in
          let* after_header = after "Actions" "{ArrowRight}" in
          Js.Promise.resolve
            E.(
              expect (below_last, above_header, before_header, after_header)
              |> toEqual
                   ( "gridcell:CMO",
                     "columnheader:Role",
                     "columnheader:Name",
                     "columnheader:Actions" )));
      Jest.testPromise "walks its rows in their order after they are sorted"
        (fun () ->
          let shown, set_shown = S.create_signal members in
          H.render (fun () ->
              <Table.Root aria_label="Team members">
                <Table.Header>
                  <Table.Column is_row_header=true>"Name"</Table.Column>
                </Table.Header>
                <Table.Body>
                  <For each=(fun () -> S.get shown)>
                    (fun m _ ->
                      <Table.Row id=(fun () -> m.id)>
                        <Table.Cell>(fun () -> Jsx.string m.name)</Table.Cell>
                      </Table.Row>)
                  </For>
                </Table.Body>
              </Table.Root>);
          let user = H.setup () in
          H.focus (row "John Smith");
          S.set set_shown (Array.of_list (List.rev (Array.to_list members)));
          let* () = H.keyboard user "{ArrowDown}" in
          let below = where () in
          let* () = H.keyboard user "{ArrowUp}{ArrowUp}" in
          Js.Promise.resolve
            E.(
              expect (below, where ())
              |> toEqual ("row:Kate Moore", "row:Sara Johnson")));
      Jest.test "indexes its columns and cells in their order after a reorder"
        (fun () ->
          let columns, set_columns = S.create_signal [| "Name"; "Role" |] in
          H.render (fun () ->
              <Table.Root aria_label="Team members">
                <Table.Header>
                  <For each=(fun () -> S.get columns)>
                    (fun c _ ->
                      <Table.Column
                        is_row_header=(fun () -> String.equal c "Name")>
                        (fun () -> Jsx.string c)
                      </Table.Column>)
                  </For>
                </Table.Header>
                <Table.Body>
                  <Table.Row id="1">
                    <For each=(fun () -> S.get columns)>
                      (fun c _ ->
                        <Table.Cell>
                          (fun () -> Jsx.string ("Kate's " ^ c))
                        </Table.Cell>)
                    </For>
                  </Table.Row>
                </Table.Body>
              </Table.Root>);
          S.set set_columns [| "Role"; "Name" |];
          let cell text =
            let e = H.by_text text in
            (H.attribute e "data-column-index", H.attribute e "role")
          in
          E.(
            expect
              ( cell "Kate's Role",
                cell "Kate's Name",
                H.attribute (H.by_text "Role") "aria-colindex" )
            |> toEqual
                 ( (Some "0", Some "gridcell"),
                   (Some "1", Some "rowheader"),
                   Some "1" )));
      Jest.testPromise
        "selects rows, writing their state as Kobalte writes it, a disabled \
         row left out" (fun () ->
          let told = ref [||] in
          team ~mode:`multiple ~disabled:[| "2" |] ~told ();
          let user = H.setup () in
          let* () = H.click user (H.by_text "Kate Moore") in
          let* () = H.click user (H.by_text "John Smith") in
          let state name =
            let r = row name in
            ( H.attribute r "aria-selected",
              H.attribute r "data-selected",
              H.attribute r "aria-disabled",
              H.attribute r "data-disabled" )
          in
          Js.Promise.resolve
            E.(
              expect (!told, state "Kate Moore", state "John Smith")
              |> toEqual
                   ( [| "1" |],
                     (Some "true", Some "", None, None),
                     (Some "false", None, Some "true", Some "") )));
      Jest.testPromise "leaves a press in a control to the control" (fun () ->
          let told = ref [||] in
          team ~mode:`multiple ~told ();
          let user = H.setup () in
          let* () = H.click user (H.by_text "Edit Kate Moore") in
          Js.Promise.resolve
            E.(
              expect (!told, H.attribute (row "Kate Moore") "aria-selected")
              |> toEqual ([||], Some "false")));
      Jest.testPromise "calls the caller's ref and handlers beside its own"
        (fun () ->
          let keys = ref 0 in
          let got_table = ref false in
          let clicked = ref 0 in
          let told = ref [||] in
          team ~mode:`single ~told ~got_table ~clicked
            ~on_key_down:(fun _ -> incr keys)
            ();
          let user = H.setup () in
          let* () = H.click user (H.by_text "John Smith") in
          let* () = H.keyboard user "{ArrowDown}" in
          Js.Promise.resolve
            E.(
              expect (!got_table, !clicked, !keys, !told, where ())
              |> toEqual (true, 1, 1, [| "2" |], "rowheader:Sara Johnson")));
      Jest.test "shows its empty state across every column" (fun () ->
          team ~members:[||] ();
          let cell = H.by_text "No members" in
          let td =
            match Js.Null.toOption (H.parent cell) with
            | Some td -> td
            | None -> cell
          in
          E.(expect (H.attribute td "colspan") |> toEqual (Some "3")));
      Jest.test "places a column added between two, and its cells, by the page"
        (fun () ->
          let roles, set_roles = S.create_signal false in
          H.render (fun () ->
              <Table.Root aria_label="Team members">
                <Table.Header>
                  <Solidtype.Show when_=(fun () -> S.get roles)>
                    <Table.Column>"Role"</Table.Column>
                  </Solidtype.Show>
                  <Table.Column is_row_header=true>"Name"</Table.Column>
                  <Table.Column>"Actions"</Table.Column>
                </Table.Header>
                <Table.Body>
                  <Table.Row id="1">
                    <Solidtype.Show when_=(fun () -> S.get roles)>
                      <Table.Cell>"CEO"</Table.Cell>
                    </Solidtype.Show>
                    <Table.Cell>"Kate Moore"</Table.Cell>
                    <Table.Cell>"Edit"</Table.Cell>
                  </Table.Row>
                </Table.Body>
              </Table.Root>);
          let placed () =
            ( Array.map
                (fun c ->
                  ( H.text c,
                    Option.value (H.attribute c "aria-colindex") ~default:"" ))
                (H.all_by_role "columnheader"),
              Array.map
                (fun c ->
                  ( H.text c,
                    Option.value (H.attribute c "role") ~default:"",
                    Option.value (H.attribute c "data-column-index") ~default:""
                  ))
                (Array.append
                   (H.all_by_role "rowheader")
                   (H.all_by_role "gridcell")) )
          in
          let before = placed () in
          S.set set_roles true;
          let added = placed () in
          S.set set_roles false;
          E.(
            expect (before, added, placed ())
            |> toEqual
                 ( ( [| ("Name", "1"); ("Actions", "2") |],
                     [|
                       ("Kate Moore", "rowheader", "0");
                       ("Edit", "gridcell", "1");
                     |] ),
                   ( [| ("Role", "1"); ("Name", "2"); ("Actions", "3") |],
                     [|
                       ("Kate Moore", "rowheader", "1");
                       ("CEO", "gridcell", "0");
                       ("Edit", "gridcell", "2");
                     |] ),
                   before )));
      Jest.testPromise "has no violation axe finds" (fun () ->
          team ~mode:`multiple ();
          let* found = H.accessibility_violations () in
          Js.Promise.resolve E.(expect found |> toEqual [||])))

module Direction = struct
  (* A column's direction, as a part inside it reads it. *)
  let make () =
    let c = Table.use_column_context () in
    <span>
      (fun () ->
        Jsx.string
          (match c.direction () with
          | Some `ascending -> "up"
          | Some `descending -> "down"
          | None -> "-"))
    </span>
end

let () =
  Jest.describe "Table, sorted" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "is sorted by a column pressed or keyed, its direction told inside it"
        (fun () ->
          let told = ref [] in
          let sort, set_sort =
            S.create_signal { Table.column = "name"; direction = `ascending }
          in
          H.render (fun () ->
              <Table.Root
                aria_label="Sortable"
                sort_descriptor=(fun () -> S.get sort)
                on_sort_change=(fun (s : Table.sort_descriptor) ->
                                 told := s :: !told;
                                 S.set set_sort s)>
                <Table.Header>
                  <Table.Column
                    id="name" allows_sorting=true is_row_header=true>
                    "Name " (fun () -> Jsx.element (Direction.make ()))
                  </Table.Column>
                  <Table.Column id="role" allows_sorting=true>
                    "Role " (fun () -> Jsx.element (Direction.make ()))
                  </Table.Column>
                  <Table.Column>"Actions"</Table.Column>
                </Table.Header>
                <Table.Body>
                  <Table.Row id="1"><Table.Cell>"Kate"</Table.Cell></Table.Row>
                </Table.Body>
              </Table.Root>);
          let columns () =
            Array.map
              (fun c ->
                (Option.value (H.attribute c "aria-sort") ~default:"", H.text c))
              (H.all_by_role "columnheader")
          in
          let at_first = columns () in
          let user = H.setup () in
          let column i = (H.all_by_role "columnheader").(i) in
          let* () = H.click user (column 0) in
          let* () = H.click user (column 1) in
          let* () = H.click user (column 2) in
          H.focus (column 1);
          let* () = H.keyboard user "{Enter}" in
          Js.Promise.resolve
            E.(
              expect
                ( at_first,
                  columns (),
                  Array.of_list
                    (List.rev_map
                       (fun (s : Table.sort_descriptor) ->
                         s.column
                         ^
                         match s.direction with
                         | `ascending -> "+"
                         | `descending -> "-")
                       !told) )
              |> toEqual
                   ( [|
                       ("ascending", "Name up");
                       ("none", "Role -");
                       ("", "Actions");
                     |],
                     [|
                       ("none", "Name -");
                       ("descending", "Role down");
                       ("", "Actions");
                     |],
                     [| "name-"; "role+"; "role-" |] ))))

(* The stand-in observer's own: brings an element into view, as a scroll to
   it would. *)
external intersect : Dom.element -> unit = "intersect"
[@@mel.scope "IntersectionObserver"]

external query : string -> Dom.element Js.null = "querySelector"
[@@mel.scope "document"]

let found selector =
  match Js.Null.toOption (query selector) with
  | Some e -> e
  | None -> Js.Exn.raiseError ("nothing is " ^ selector)

let () =
  Jest.describe "Table, loading more" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "asks for more as its end comes into view, never while loading"
        (fun () ->
          let asked = ref 0 in
          let loading, set_loading = S.create_signal false in
          H.render (fun () ->
              <Table.Root aria_label="Team members">
                <Table.Header>
                  <Table.Column is_row_header=true>"Name"</Table.Column>
                  <Table.Column>"Role"</Table.Column>
                </Table.Header>
                <Table.Body>
                  <For each=(fun () -> members)>
                    (fun m _ ->
                      <Table.Row id=(fun () -> m.id)>
                        <Table.Cell>(fun () -> Jsx.string m.name)</Table.Cell>
                        <Table.Cell>(fun () -> Jsx.string m.role)</Table.Cell>
                      </Table.Row>)
                  </For>
                  <Table.Load_more
                    is_loading=(fun () -> S.get loading)
                    on_load_more=(fun _ -> incr asked)
                    class_="loader">
                    <span>"Loading more"</span>
                  </Table.Load_more>
                </Table.Body>
              </Table.Root>);
          let sentinel () = found "tbody > tr:not([role]) > td > div" in
          intersect (sentinel ());
          let at_end = !asked in
          S.set set_loading true;
          let loader = found "tr.loader" in
          let cell = found "tr.loader > td" in
          let shown =
            ( H.attribute loader "role",
              H.attribute cell "role",
              H.attribute cell "colspan",
              H.text cell )
          in
          intersect (sentinel ());
          let while_loading = !asked in
          let* found_while_loading = H.accessibility_violations () in
          S.set set_loading false;
          intersect (sentinel ());
          let user = H.setup () in
          H.focus (H.by_text "CMO");
          let* () = H.keyboard user "{ArrowDown}" in
          E.(
            expect
              ( at_end,
                shown,
                while_loading,
                found_while_loading,
                !asked,
                Option.is_none (Js.Null.toOption (query "tr.loader")),
                where () )
            |> toEqual
                 ( 1,
                   (Some "row", Some "rowheader", Some "2", "Loading more"),
                   1,
                   [||],
                   2,
                   true,
                   "gridcell:CMO" ))
          |> Js.Promise.resolve))

external query_in : Dom.element -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

external blur : Dom.element -> unit = "blur" [@@mel.send]

(* A column's resizer's input. *)
let input_of column =
  match Js.Null.toOption (query_in column "input") with
  | Some i -> i
  | None -> Js.Exn.raiseError "no resizer"

type pointer

external pointer :
  client_x:(float[@mel.as "clientX"]) ->
  ?button:int ->
  pointer_id:(int[@mel.as "pointerId"]) ->
  pointer_type:(string[@mel.as "pointerType"]) ->
  unit ->
  pointer = ""
[@@mel.obj]

external pointer_down : Dom.element -> pointer -> bool = "pointerDown"
[@@mel.module "@solidjs/testing-library"] [@@mel.scope "fireEvent"]

external pointer_move : Dom.element -> pointer -> bool = "pointerMove"
[@@mel.module "@solidjs/testing-library"] [@@mel.scope "fireEvent"]

external pointer_up : Dom.element -> pointer -> bool = "pointerUp"
[@@mel.module "@solidjs/testing-library"] [@@mel.scope "fireEvent"]

let size_name : Table.column_size -> string = function
  | Pixels p -> Js.Float.toString p ^ "px"
  | Percent p -> Js.Float.toString p ^ "%"
  | Fraction f -> Js.Float.toString f ^ "fr"

let () =
  Jest.describe "Table, its columns resized" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "lays its columns out in its width, resized by the keys and a pointer"
        (fun () ->
          let ended = ref [] in
          let column ~id ~min name =
            <Table.Column
              id=(fun () -> id)
              is_row_header=(fun () -> String.equal id "name")
              min_width=(fun () -> min)>
              (fun () -> Jsx.string name) <Table.Column_resizer />
            </Table.Column>
          in
          H.render (fun () ->
              <Table.Resizable_container
                data_client_width="700"
                on_resize_end=(fun sizes ->
                                ended :=
                                  Array.to_list
                                    (Array.map
                                       (fun (k, s) -> k ^ ":" ^ size_name s)
                                       sizes))>
                <Table.Root aria_label="Resizable">
                  <Table.Header>
                    (fun () -> Jsx.element (column ~id:"name" ~min:160. "Name"))
                    (fun () -> Jsx.element (column ~id:"role" ~min:220. "Role"))
                    (fun () ->
                      Jsx.element (column ~id:"status" ~min:100. "Status"))
                    <Table.Column id="email" min_width=200.>
                      "Email"
                    </Table.Column>
                  </Table.Header>
                  <Table.Body>
                    <Table.Row id="1">
                      <Table.Cell>"Kate Moore"</Table.Cell>
                      <Table.Cell>"CEO"</Table.Cell>
                      <Table.Cell>"Active"</Table.Cell>
                      <Table.Cell>"kate@acme.com"</Table.Cell>
                    </Table.Row>
                  </Table.Body>
                </Table.Root>
              </Table.Resizable_container>);
          let widths () =
            H.all_by_role "columnheader"
            |> Array.map (fun c ->
                Option.value (H.attribute c "style") ~default:"")
          in
          let resizer n =
            match
              Array.to_list (H.all_by_role "columnheader")
              |> List.filter (fun c -> String.equal (H.text c) n)
            with
            | c :: _ -> c
            | [] -> Js.Exn.raiseError ("no column " ^ n)
          in
          let handle n =
            match Js.Null.toOption (H.parent (input_of (resizer n))) with
            | Some h -> h
            | None -> Js.Exn.raiseError "no handle"
          in
          let at_rest = widths () in
          let user = H.setup () in
          H.focus (resizer "Name");
          let* () = H.tab user in
          let on_name () = H.focused == input_of (resizer "Name") in
          let reached = on_name () in
          let* () = H.keyboard user "{ArrowRight}" in
          let stepped = widths () in
          let* () = H.keyboard user "{Enter}" in
          let resizing =
            ( H.attribute (handle "Name") "data-resizing",
              H.attribute (resizer "Name") "data-resizing" )
          in
          let* () = H.keyboard user "{ArrowLeft}{ArrowLeft}{ArrowLeft}" in
          let* () = H.keyboard user "{Enter}" in
          let narrowest =
            ( widths (),
              H.attribute (handle "Name") "data-resizable-direction",
              H.attribute (handle "Name") "data-resizing",
              !ended,
              on_name () )
          in
          (* Focus leaves the table, and a drag brings it back. *)
          blur H.focused;
          let role = handle "Role" in
          let at x =
            pointer ~client_x:x ~button:0 ~pointer_id:1 ~pointer_type:"mouse" ()
          in
          ignore (pointer_down role (at 100.) : bool);
          ignore (pointer_move role (at 130.) : bool);
          let dragged = (widths (), H.focused == input_of (resizer "Role")) in
          ignore (pointer_up role (at 130.) : bool);
          Js.Promise.resolve
            E.(
              expect
                (at_rest, reached, stepped, resizing, narrowest, dragged, !ended)
              |> toEqual
                   ( [|
                       "width: 160px;";
                       "width: 220px;";
                       "width: 120px;";
                       "width: 200px;";
                     |],
                     true,
                     [|
                       "width: 170px;";
                       "width: 220px;";
                       "width: 110px;";
                       "width: 200px;";
                     |],
                     (Some "", Some ""),
                     ( [|
                         "width: 160px;";
                         "width: 220px;";
                         "width: 120px;";
                         "width: 200px;";
                       |],
                       Some "left",
                       None,
                       [ "name:160px"; "role:1fr"; "status:1fr"; "email:1fr" ],
                       true ),
                     ( [|
                         "width: 160px;";
                         "width: 250px;";
                         "width: 100px;";
                         "width: 200px;";
                       |],
                       true ),
                     [ "name:160px"; "role:250px"; "status:1fr"; "email:1fr" ]
                   ))))

type file = { file_id : string; title : string; files : file array }

let files =
  [|
    {
      file_id = "1";
      title = "Documents";
      files =
        [|
          {
            file_id = "2";
            title = "Project";
            files =
              [|
                { file_id = "3"; title = "Weekly Report"; files = [||] };
                { file_id = "4"; title = "Budget"; files = [||] };
              |];
          };
        |];
    };
    {
      file_id = "5";
      title = "Photos";
      files =
        [|
          { file_id = "6"; title = "Image 1"; files = [||] };
          { file_id = "7"; title = "Image 2"; files = [||] };
        |];
    };
  |]

let rec file_row f =
  <Table.Row id=(fun () -> f.file_id)>
    <Table.Cell>(fun () -> Jsx.string f.title)</Table.Cell>
    <Table.Cell>"-"</Table.Cell>
    <For each=(fun () -> f.files)>(fun f _ -> file_row f)</For>
  </Table.Row>

let tree_grid () =
  match H.all_by_role "treegrid" with
  | [| t |] -> t
  | _ -> Js.Exn.raiseError "no tree grid"

let () =
  Jest.describe "Table, a tree" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "draws the rows its rows hold while expanded, walked as a tree"
        (fun () ->
          let told = ref [||] in
          H.render (fun () ->
              <Table.Root
                aria_label="Files"
                tree_column="name"
                default_expanded_keys=(fun () -> [| "1" |])
                on_expanded_change=(fun keys ->
                                     told :=
                                       Array.of_list
                                         (List.sort String.compare
                                            (Array.to_list keys)))>
                <Table.Header>
                  <Table.Column id="name" is_row_header=true>
                    "Name"
                  </Table.Column>
                  <Table.Column id="type">"Type"</Table.Column>
                </Table.Header>
                <Table.Body>
                  <For each=(fun () -> files)>(fun f _ -> file_row f)</For>
                </Table.Body>
              </Table.Root>);
          let rows () =
            H.all_by_role "row" |> Array.to_list
            |> List.filter (fun r -> Option.is_some (H.attribute r "data-key"))
            |> List.map (fun r ->
                String.concat " "
                  (List.filter_map
                     (fun name ->
                       Option.map (fun v -> name ^ "=" ^ v) (H.attribute r name))
                     [
                       "data-key";
                       "aria-level";
                       "aria-posinset";
                       "aria-setsize";
                       "aria-expanded";
                       "data-expanded";
                     ]))
            |> Array.of_list
          in
          let at_rest = rows () in
          let tree_cells =
            H.all_by_role "rowheader"
            |> Array.map (fun c -> H.attribute c "data-tree-column")
          in
          let user = H.setup () in
          let* () = H.tab user in
          let seen = ref [] in
          let rec go = function
            | [] -> Js.Promise.resolve ()
            | k :: rest ->
                let* () = H.keyboard user k in
                seen := (k ^ " " ^ where ()) :: !seen;
                go rest
          in
          let* () =
            go
              [
                "{ArrowDown}";
                "{ArrowRight}";
                "{ArrowRight}";
                "{ArrowLeft}";
                "{ArrowLeft}";
                "{ArrowLeft}";
                "{ArrowLeft}";
              ]
          in
          Js.Promise.resolve
            E.(
              expect
                ( H.attribute (tree_grid ()) "role",
                  at_rest,
                  tree_cells,
                  Array.of_list (List.rev !seen),
                  !told,
                  rows () )
              |> toEqual
                   ( Some "treegrid",
                     [|
                       "data-key=1 aria-level=1 aria-posinset=1 aria-setsize=2 \
                        aria-expanded=true data-expanded=";
                       "data-key=2 aria-level=2 aria-posinset=1 aria-setsize=1 \
                        aria-expanded=false";
                       "data-key=5 aria-level=1 aria-posinset=2 aria-setsize=2 \
                        aria-expanded=false";
                     |],
                     [| Some ""; Some ""; Some "" |],
                     [|
                       "{ArrowDown} row:Project-";
                       "{ArrowRight} row:Project-";
                       "{ArrowRight} rowheader:Project";
                       "{ArrowLeft} row:Project-";
                       "{ArrowLeft} row:Project-";
                       "{ArrowLeft} row:Documents-";
                       "{ArrowLeft} row:Documents-";
                     |],
                     [||],
                     [|
                       "data-key=1 aria-level=1 aria-posinset=1 aria-setsize=2 \
                        aria-expanded=false";
                       "data-key=5 aria-level=1 aria-posinset=2 aria-setsize=2 \
                        aria-expanded=false";
                     |] ))))

module Virtualizer = Solidtype_headless.Virtualizer

let () =
  Jest.describe "Table, virtualized" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "draws the rows in view, reaches those it does not by the keys, and \
         loads more after the last" (fun () ->
          H.render (fun () ->
              <Virtualizer
                layout=(fun () ->
                         Virtualizer.table_layout ~heading_size:40.
                           ~row_size:40. ())>
                <Table.Root
                  aria_label="Many"
                  data_client_height="200"
                  data_client_width="400">
                  <Table.Header>
                    <Table.Column id="name" is_row_header=true>
                      "Name"
                    </Table.Column>
                  </Table.Header>
                  <Table.Body>
                    <For each=(fun () -> Array.init 100 (fun i -> i + 1))>
                      (fun n _ ->
                        <Table.Row id=(fun () -> string_of_int n)>
                          <Table.Cell>
                            (fun () -> Jsx.string ("Row " ^ string_of_int n))
                          </Table.Cell>
                        </Table.Row>)
                    </For>
                    <Table.Load_more is_loading=(fun () -> true)>
                      "Loading"
                    </Table.Load_more>
                  </Table.Body>
                </Table.Root>
              </Virtualizer>);
          let drawn () =
            H.all_by_role "row" |> Array.to_list
            |> List.filter_map (fun r -> H.attribute r "data-key")
            |> Array.of_list
          in
          let at_rest = drawn () in
          let loader =
            match Js.Null.toOption (H.parent (H.by_text "Loading")) with
            | Some row -> (
                match Js.Null.toOption (H.parent row) with
                | Some wrapper -> H.attribute wrapper "style"
                | None -> None)
            | None -> None
          in
          let user = H.setup () in
          H.focus (row "Row 1");
          let* () = H.keyboard user "{End}" in
          let last = where () in
          let* () = H.keyboard user "{Home}" in
          Js.Promise.resolve
            E.(
              expect (at_rest, loader, last, where ())
              |> toEqual
                   ( [| "1"; "2"; "3"; "4"; "5"; "6"; "7" |],
                     Some
                       "position: absolute; overflow: visible; opacity: 1; \
                        z-index: 0; contain: size layout style; top: 4000px; \
                        left: 0px; width: 400px; height: 40px;",
                     "row:Row 100",
                     "row:Row 1" ))))
