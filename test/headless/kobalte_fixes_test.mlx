(* Kobalte's own components where they need a fix, as a caller meets them: a
   swatch and an area's thumb whose colour a browser reads, less than opaque
   too; a disabled area out of the page's order, its inputs disabled and its
   parts marked so; and no violation axe finds. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Color_swatch = Solidtype_headless.Color_swatch
module Color_area = Solidtype_headless.Color_area
module Colors = Solidtype_kobalte.Colors
module E = Jest.Expect
module H = Harness
open Harness.Syntax

type style

external style : Dom.element -> style = "style" [@@mel.get]
external background_color : style -> string = "backgroundColor" [@@mel.get]
external property : style -> string -> string = "getPropertyValue" [@@mel.send]

external query : string -> Dom.element = "querySelector"
[@@mel.scope "document"]

external query_all : string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.scope "document"]

external disabled : Dom.element -> bool = "disabled" [@@mel.get]

let half = "rgba(4, 133, 247, 0.5)"

let area ~is_disabled =
  H.render (fun () ->
      <Color_area.Root
        aria_label="Colour"
        default_value=(fun () -> Colors.parse_color half)
        disabled=(fun () -> is_disabled)>
        <Color_area.Background>
          <Color_area.Thumb>
            <Color_area.HiddenInputX /> <Color_area.HiddenInputY />
          </Color_area.Thumb>
        </Color_area.Background>
      </Color_area.Root>)

(* What a disabled area shows of it, part by part. *)
let held () =
  let thumb = query "[role=presentation]" in
  let marked selector = H.attribute (query selector) "data-disabled" in
  ( H.attribute thumb "tabindex",
    Array.map disabled (Js.Array.from (query_all "input")),
    ( marked "[role=group]",
      marked "[role=group] > div",
      marked "[role=presentation]" ) )

let () =
  Jest.describe "Kobalte's components, fixed" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.test "a swatch paints a colour less than opaque" (fun () ->
          H.render (fun () ->
              <Color_swatch
                value=(fun () -> Colors.parse_color half)
                aria_label="Half blue"
                data_testid="swatch"
              />);
          E.(
            expect (background_color (style (query "[data-testid=swatch]")))
            |> toBe half));
      Jest.test "an area's thumb writes its colour, less than opaque" (fun () ->
          area ~is_disabled:false;
          E.(
            expect
              (property
                 (style (query "[role=presentation]"))
                 "--kb-color-current")
            |> toBe half));
      Jest.test "an area enabled is in the page's order" (fun () ->
          area ~is_disabled:false;
          E.(
            expect (held ())
            |> toEqual (Some "0", [| false; false |], (None, None, None))));
      Jest.test "an area disabled is out of it, its inputs disabled" (fun () ->
          area ~is_disabled:true;
          E.(
            expect (held ())
            |> toEqual (Some "-1", [| true; true |], (Some "", Some "", Some ""))));
      Jest.testPromise "a swatch and an area have no violation axe finds"
        (fun () ->
          area ~is_disabled:true;
          H.render (fun () ->
              <Color_swatch
                value=(fun () -> Colors.parse_color half) aria_label="Half blue"
              />);
          let* found = H.accessibility_violations () in
          Js.Promise.resolve E.(expect found |> toEqual [||])))

module Color_slider = Solidtype_headless.Color_slider
module Kobalte_slider = Solidtype_kobalte.ColorSlider
module Color = Solidtype_kobalte.Types.Color

(* A hue slider, the fixed one or Kobalte's own, at a red, told each change;
   its thumb placed by a plain left, since Kobalte places it by a calc() jsdom
   cannot read. *)
let hue ~fixed told =
  let value () = Colors.parse_color "hsl(0, 100%, 50%)" in
  let on_change c = told := Color.to_string c ~format:`css () :: !told in
  H.render (fun () ->
      if fixed then
        <Color_slider.Root
          aria_label="Hue"
          channel=(fun () -> `hue)
          default_value=(fun () -> value ())
          on_change>
          <Color_slider.Track>
            <Color_slider.Thumb style="left: 0%">
              <Color_slider.Input />
            </Color_slider.Thumb>
          </Color_slider.Track>
        </Color_slider.Root>
      else
        <Kobalte_slider.Root
          aria_label="Hue"
          channel=(fun () -> `hue)
          default_value=(fun () -> value ())
          on_change>
          <Kobalte_slider.Track>
            <Kobalte_slider.Thumb style="left: 0%">
              <Kobalte_slider.Input />
            </Kobalte_slider.Thumb>
          </Kobalte_slider.Track>
        </Kobalte_slider.Root>)

(* What the thumb tells, after a key at the start, a page up and a page
   down: its value, and how many changes were told. *)
let paged ~fixed =
  let told = ref [] in
  hue ~fixed told;
  let thumb = query "[role=slider]" in
  let user = H.setup () in
  H.focus thumb;
  let* () = H.keyboard user "{ArrowLeft}" in
  let at_start = List.length !told in
  let* () = H.keyboard user "{PageUp}" in
  let up = H.attribute thumb "aria-valuetext" in
  let* () = H.keyboard user "{PageDown}" in
  Js.Promise.resolve
    ( at_start,
      up,
      H.attribute thumb "aria-valuetext",
      H.attribute (query "[role=group]") "pagesize" )

let () =
  Jest.describe "Kobalte's colour slider, fixed" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "pages by the colour's page, names it in lower case, tells only a \
         change, and writes no page on its element" (fun () ->
          let* fixed = paged ~fixed:true in
          H.cleanup ();
          let* own = paged ~fixed:false in
          Js.Promise.resolve
            E.(
              expect (fixed, own)
              |> toEqual
                   ( ( 0,
                       Some {js|15°, red orange|js},
                       Some {js|0°, red|js},
                       None ),
                     ( 1,
                       Some {js|36°, orange|js},
                       Some {js|0°, Red|js},
                       Some "15" ) ))))

type wheel_init

external wheel_init :
  delta_y:(float[@mel.as "deltaY"]) ->
  bubbles:bool ->
  cancelable:bool ->
  unit ->
  wheel_init = ""
[@@mel.obj]

external wheel_event : (_[@mel.as "wheel"]) -> wheel_init -> Dom.event
  = "WheelEvent"
[@@mel.new]

external dispatch : Dom.element -> Dom.event -> bool = "dispatchEvent"
[@@mel.send]

module Color_channel_field = Solidtype_headless.Color_channel_field
module Kobalte_channel_field = Solidtype_kobalte.ColorChannelField

(* How many colours a hue field, the fixed one or Kobalte's own, tells as it
   mounts, and what its input tells a reader of its value after a step up and
   a turn of the wheel down. *)
let stepped ~fixed =
  let value () = Colors.parse_color "hsl(300, 100%, 25%)" in
  let told = ref 0 in
  let on_change _ = incr told in
  H.render (fun () ->
      if fixed then
        <Color_channel_field.Root
          aria_label="Hue"
          channel=(fun () -> `hue)
          default_value=(fun () -> value ())
          on_change>
          <Color_channel_field.Input />
        </Color_channel_field.Root>
      else
        <Kobalte_channel_field.Root
          aria_label="Hue"
          channel=(fun () -> `hue)
          default_value=(fun () -> value ())
          on_change>
          <Kobalte_channel_field.Input />
        </Kobalte_channel_field.Root>);
  let at_mount = !told in
  let input = query "[role=spinbutton]" in
  let user = H.setup () in
  H.focus input;
  let* () = H.keyboard user "{ArrowUp}" in
  ignore
    (dispatch input
       (wheel_event (wheel_init ~delta_y:1. ~bubbles:true ~cancelable:true ()))
      : bool);
  Js.Promise.resolve
    ( at_mount,
      H.attribute input "aria-valuenow",
      H.attribute input "aria-valuetext" )

module Slider = Solidtype_headless.Slider
module Kobalte_own_slider = Solidtype_kobalte.Slider
module Slider_context = Solidtype_kobalte.Types.SliderContextValue

(* Whether a slider's track, given a ref, the fixed one or Kobalte's own, is
   the track its slider presses and drags against, and its ref called. *)
let track_known ~fixed =
  let known = ref (fun () -> false) and given = ref false in
  let watch () =
    let context = Kobalte_own_slider.use_slider_context () in
    (known :=
       fun () -> Option.is_some (S.get (Slider_context.track_ref context)));
    Jsx.string ""
  in
  H.render (fun () ->
      <Kobalte_own_slider.Root default_value=(fun () -> [| 10. |])>
        (fun () ->
          if fixed then
            Jsx.element
              <Slider.Track ref=(fun _ -> given := true)>
                (fun () -> watch ())
              </Slider.Track>
          else
            Jsx.element
              <Kobalte_own_slider.Track ref=(fun _ -> given := true)>
                (fun () -> watch ())
              </Kobalte_own_slider.Track>)
      </Kobalte_own_slider.Root>);
  (!known (), !given)

let () =
  Jest.describe "Kobalte's slider, fixed" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.test "knows its track, given a ref" (fun () ->
          let fixed = track_known ~fixed:true in
          H.cleanup ();
          let own = track_known ~fixed:false in
          E.(expect (fixed, own) |> toEqual ((true, true), (false, true)))));
  Jest.describe "Kobalte's colour channel field, fixed" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise
        "tells no change as it mounts, its value now as a number, and turns \
         the wheel as React Aria's" (fun () ->
          let* fixed = stepped ~fixed:true in
          H.cleanup ();
          let* own = stepped ~fixed:false in
          Js.Promise.resolve
            E.(
              expect (fixed, own)
              |> toEqual
                   ( (0, Some "302", Some {js|302°|js}),
                     (1, Some {js|300°|js}, Some {js|300°|js}) ))))

module Color_field = Solidtype_headless.Color_field
module Kobalte_field = Solidtype_kobalte.ColorField

external value_of : Dom.element -> string = "value" [@@mel.get]

(* What a hex field's input shows, and the colours it tells, after a step up,
   End, Home, a hex typed and Enter, and a turn of the wheel down. *)
let hex_steps ~fixed =
  let told = ref [] in
  H.render (fun () ->
      if fixed then
        <Color_field.Root
          aria_label="Colour"
          default_value=(fun () -> Colors.parse_color "#0485F7")
          on_change=(fun c ->
                      told :=
                        (match c with
                        | Some c -> Color.to_string c ~format:`hex ()
                        | None -> "(none)")
                        :: !told)>
          <Color_field.Input />
        </Color_field.Root>
      else
        <Kobalte_field.Root aria_label="Colour" default_value="#0485F7">
          <Kobalte_field.Input />
        </Kobalte_field.Root>);
  let input = query "input" in
  let user = H.setup () in
  H.focus input;
  let shown = ref [] in
  let press k =
    let* () = H.keyboard user k in
    shown := value_of input :: !shown;
    Js.Promise.resolve ()
  in
  let* () = press "{ArrowUp}" in
  let* () = press "{End}" in
  let* () = press "{Home}" in
  let* () = press "{Control>}a{/Control}ff0000{Enter}" in
  ignore
    (dispatch input
       (wheel_event (wheel_init ~delta_y:1. ~bubbles:true ~cancelable:true ()))
      : bool);
  shown := value_of input :: !shown;
  Js.Promise.resolve (List.rev !shown, List.rev !told)

let () =
  Jest.describe "Kobalte's colour field, fixed" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.testPromise "commits on Enter, and steps by the keys and the wheel"
        (fun () ->
          let* fixed = hex_steps ~fixed:true in
          H.cleanup ();
          let* own = hex_steps ~fixed:false in
          let steps =
            [ "#0485F8"; "#FFFFFF"; "#000000"; "#FF0000"; "#FF0001" ]
          in
          Js.Promise.resolve
            E.(
              expect (fixed, own)
              |> toEqual
                   ( (steps, steps),
                     ( [ "#0485F7"; "#0485F7"; "#0485F7"; "ff0000"; "ff0000" ],
                       [] ) ))))
