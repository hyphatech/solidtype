(* The headless date field of a range as a caller meets it: its two inputs,
   named Start Date and End Date and by its label; the range told once both
   ends are typed, and [None] as one is erased; invalid with its end before
   its start; each end sent with a form by its name; and no violation axe
   finds. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Date_field = Solidtype_headless.Date_field
module I18n = Solidtype_kobalte.I18n
module D = Solidtype_internationalized_date
module Date = D.Types.CalendarDate
module E = Jest.Expect
module H = Harness
open Harness.Syntax

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external input_value : Dom.element -> string = "value" [@@mel.get]

let one selector =
  match Js.Null.toOption (query H.body selector) with
  | Some e -> e
  | None -> Js.Exn.raiseError ("no " ^ selector)

let inputs () = Js.Array.from (query_all H.body "[role=presentation]")

let segment n kind =
  match
    Js.Null.toOption (query (inputs ()).(n) ("[data-type=" ^ kind ^ "]"))
  with
  | Some e -> e
  | None -> Js.Exn.raiseError ("no " ^ kind ^ " segment")

let told_of = function
  | Some ({ start; end_ } : Date.t Date_field.range) ->
      Date.to_string start () ^ ".." ^ Date.to_string end_ ()
  | None -> "none"

let range ?default_value ?(told = ref []) () =
  H.render (fun () ->
      <I18n.I18nProvider locale="en-US">
        <Date_field.Root_range
          ?default_value
          start_name="from"
          end_name="to"
          on_change=(fun r -> told := told_of r :: !told)>
          <Date_field.Label>"Trip"</Date_field.Label>
          <Date_field.Input slot="start">
            (fun segment -> <Date_field.Segment segment=(S.get segment) />)
          </Date_field.Input>
          <Date_field.Input slot="end">
            (fun segment -> <Date_field.Segment segment=(S.get segment) />)
          </Date_field.Input>
        </Date_field.Root_range>
      </I18n.I18nProvider>)

let sent () =
  Js.Array.from (query_all H.body "input[type=hidden]")
  |> Array.map (fun e ->
      Option.value (H.attribute e "name") ~default:"" ^ "=" ^ input_value e)
  |> Array.to_list

let () =
  Jest.describe "Date_field.Root_range" (fun () ->
      Jest.afterEach H.cleanup;
      Jest.test "is two fields, each named for its end and by the label"
        (fun () ->
          range
            ~default_value:
              { start = Date.make 2026 11 3; end_ = Date.make 2026 11 6 }
            ();
          let label_id = H.attribute (one "span[id]") "id" in
          let labelled n =
            Option.map
              (fun l ->
                List.exists
                  (fun id -> Option.equal String.equal (Some id) label_id)
                  (String.split_on_char ' ' l))
              (H.attribute (inputs ()).(n) "aria-labelledby")
          in
          E.(
            expect
              ( Option.map
                  (fun l -> Js.String.includes ~search:"Start Date" l)
                  (H.attribute (segment 0 "day") "aria-label"),
                Option.map
                  (fun l -> Js.String.includes ~search:"End Date" l)
                  (H.attribute (segment 1 "day") "aria-label"),
                labelled 0,
                labelled 1,
                H.text (segment 0 "day"),
                H.text (segment 1 "day"),
                sent () )
            |> toEqual
                 ( Some true,
                   Some true,
                   Some true,
                   Some true,
                   "3",
                   "6",
                   [ "from=2026-11-03"; "to=2026-11-06" ] )));
      Jest.testPromise "tells the range once both ends are typed" (fun () ->
          let told = ref [] in
          range ~told ();
          let user = H.setup () in
          let* () = H.click user (segment 0 "month") in
          let* () = H.keyboard user "11032026" in
          let after_start = !told in
          let* () = H.click user (segment 1 "month") in
          let* () = H.keyboard user "11062026" in
          (* Each year typed is a date, 0002 and on, as React Aria's field
             tells them, so the range is told as each is. *)
          Js.Promise.resolve
            E.(
              expect (after_start, List.hd !told, sent ())
              |> toEqual
                   ( [],
                     "2026-11-03..2026-11-06",
                     [ "from=2026-11-03"; "to=2026-11-06" ] )));
      Jest.testPromise "tells None as an end is erased whole" (fun () ->
          let told = ref [] in
          range ~told
            ~default_value:
              { start = Date.make 2026 11 3; end_ = Date.make 2026 11 6 }
            ();
          let user = H.setup () in
          let* () = H.click user (segment 1 "year") in
          let* () =
            H.keyboard user
              "{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}{Backspace}"
          in
          Js.Promise.resolve
            E.(
              expect (List.hd !told, sent ())
              |> toEqual ("none", [ "from=2026-11-03"; "to=" ])));
      Jest.test "is invalid with its end before its start" (fun () ->
          range
            ~default_value:
              { start = Date.make 2026 11 6; end_ = Date.make 2026 11 3 }
            ();
          E.(
            expect
              ( H.attribute (one "div[data-invalid]") "data-invalid",
                H.attribute (segment 0 "day") "aria-invalid",
                H.attribute (segment 1 "day") "aria-invalid" )
            |> toEqual (Some "", Some "true", Some "true")));
      Jest.testPromise "has no violation axe finds" (fun () ->
          range
            ~default_value:
              { start = Date.make 2026 11 3; end_ = Date.make 2026 11 6 }
            ();
          let* found = H.accessibility_violations () in
          Js.Promise.resolve E.(expect found |> toEqual [||])))
