(* HeroUI's Disclosure on Kobalte's Collapsible, beside the same disclosure in
   React: every part, which controls and names which, and whether it is
   expanded as its trigger is clicked and pressed by the keys. *)

module Button = Solidtype_heroui.Button
module Disclosure = Solidtype_heroui.Disclosure
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?is_expanded:(bool[@mel.as "isExpanded"]) ->
  ?default_expanded:(bool[@mel.as "defaultExpanded"]) ->
  ?is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?button:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> ((bool -> unit)[@mel.uncurry]) -> Dom.element
    = "render"
  [@@mel.module "./twins/Disclosure.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Disclosure.tsx"]

  external render_of_state : bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/Disclosure.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Disclosure.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

type style

external style : Dom.element -> style = "style" [@@mel.get]
external property : style -> string -> string = "getPropertyValue" [@@mel.send]

type event

external event : string -> event = "Event" [@@mel.new]
external dispatch : Dom.element -> event -> bool = "dispatchEvent" [@@mel.send]

(* An attribute that names elements by id, written as the slots of the
   elements it names, since each side makes its own ids. *)
let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

let references = [ "aria-labelledby"; "aria-controls" ]

(* What Kobalte writes that React Aria does not, and no style of HeroUI's
   reads: its own state, present and empty. React Aria's tabindex on a button
   the pointer presses, and its press's own user-select, and the focus it
   marks visible within the root, which no style reads either. The sizes HeroUI's
   styles animate are compared as values, each side writing its style
   attribute its own way. React Aria's content is a group its trigger names,
   Kobalte's a region of the page its trigger controls: each accessible. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-expanded" | "data-closed" | "data-disabled"), Some "" -> true
  | ("tabindex" | "style" | "data-focus-visible-within"), _ -> true
  | ("role" | "aria-labelledby"), _ ->
      Option.equal String.equal
        (T.attribute e "data-slot")
        (Some "disclosure-content")
  | _ -> false

(* Each part, its tag, its attributes, each reference by what it names, the
   sizes HeroUI's styles animate, and its text. *)
let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        references
        |> List.filter (fun name -> not (framework_only e name))
        |> List.filter_map (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
      in
      let sizes =
        [ "--disclosure-panel-width"; "--disclosure-panel-height" ]
        |> List.filter_map (fun name ->
            match property (style e) name with
            | "" -> None
            | v -> Some (name ^ ":" ^ v))
      in
      String.concat " "
        (tag_name e
         :: T.attributes_but
              (("id" :: references)
              @ (T.attribute_names e |> Array.to_list
                |> List.filter (framework_only e)))
              e
         :: named
        @ sizes)
      ^ if element_count e > 0 then "" else " " ^ text e)

(* The disclosure as it is rendered, as its trigger is clicked twice, and as
   Enter and Space press it: every part, and what it told, after each. *)
let walk ~step host told =
  let user = T.setup () in
  let trigger () =
    match Js.Null.toOption (query host "[aria-expanded]") with
    | Some e -> e
    | None -> host
  in
  let seen = ref [] in
  let after name action =
    let* () = step action in
    seen := (name, shown host, Array.of_list (List.rev !told)) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "clicked" (fun () -> T.click user (trigger ())) in
  let* () = after "clicked again" (fun () -> T.click user (trigger ())) in
  let* () = after "Enter" (fun () -> T.keyboard user "{Enter}") in
  let* () = after "Space" (fun () -> T.keyboard user " ") in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

(* The disclosure the twin renders, under the same props. *)
let render ?is_expanded ?default_expanded ?is_disabled ~button tell =
  T.render (fun () ->
      <Disclosure
        ?is_expanded=(fun () -> is_expanded)
        ?default_expanded=(fun () -> default_expanded)
        ?is_disabled=(fun () -> is_disabled)
        on_expanded_change=tell>
        <Disclosure.Heading>
          (fun () ->
            Solidtype.Jsx.element
              (if button then
                 <Button slot=`trigger variant=`secondary>
                   "Shipping" <Disclosure.Indicator />
                 </Button>
               else
                 <Disclosure.Trigger>
                   "Shipping" <Disclosure.Indicator />
                 </Disclosure.Trigger>))
        </Disclosure.Heading>
        <Disclosure.Content>
          <Disclosure.Body>
            "Orders ship within 2 business days."
          </Disclosure.Body>
        </Disclosure.Content>
      </Disclosure>)

let both ?is_expanded ?default_expanded ?is_disabled ?(button = false) () =
  let told = ref [] in
  render ?is_expanded ?default_expanded ?is_disabled ~button (fun v ->
      told := v :: !told);
  let* solidtype = walk ~step:(fun action -> action ()) T.body told in
  T.cleanup ();
  let told' = ref [] in
  let host =
    Twin.render (props ?is_expanded ?default_expanded ?is_disabled ~button ())
      (fun v -> told' := v :: !told')
  in
  let* react = walk ~step:Twin.step host told' in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

(* The walk on the trigger of a disclosure whose root and trigger draw their
   children of their state, as words: what each part's function was given of
   its focus and the trigger's interaction, beside React's. *)
let of_state ~disabled =
  let words name flags =
    <span data_words=(fun () -> Solidtype.Jsx.data name)>
      (fun () -> Solidtype.Jsx.string (T.words flags))
    </span>
  in
  T.render (fun () ->
      <Disclosure is_disabled=(fun () -> disabled)>
        (fun d ->
          Solidtype.Jsx.fragment
            [|
              words "disclosure"
                [
                  ("focus-visible-within", d.is_focus_visible_within);
                  ("disabled", d.is_disabled);
                ];
              <Disclosure.Heading>
                <Disclosure.Trigger>
                  (fun t ->
                    words "trigger"
                      [
                        ("hovered", t.is_hovered);
                        ("pressed", t.is_pressed);
                        ("focused", t.is_focused);
                        ("focus-visible", t.is_focus_visible);
                        ("disabled", t.is_disabled);
                      ])
                </Disclosure.Trigger>
              </Disclosure.Heading>;
              <Disclosure.Content>
                "Orders ship within 2 business days."
              </Disclosure.Content>;
            |])
      </Disclosure>);
  let* solidtype =
    T.walk ~read:T.words_shown ~step:Twin.step (T.by_role "button")
  in
  T.cleanup ();
  let* react =
    T.walk ~read:T.words_shown ~step:Twin.step (Twin.render_of_state disabled)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Disclosure" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "draws its parts' children of their state, as React's"
        (fun () ->
          let* solidtype, react = of_state ~disabled:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its parts' children of their state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its expansion, as it changes"
        (fun () ->
          T.render (fun () ->
              <Disclosure>
                (fun d ->
                  Solidtype.Jsx.fragment
                    [|
                      <span data_words="disclosure">
                        (fun () ->
                          Solidtype.Jsx.string
                            (T.words [ ("expanded", d.is_expanded) ]))
                      </span>;
                      <Disclosure.Heading>
                        <Disclosure.Trigger>"Shipping"</Disclosure.Trigger>
                      </Disclosure.Heading>;
                    |])
              </Disclosure>);
          let root = T.query "[data-slot=disclosure]" in
          (* Whether its words and its data-expanded say the same. *)
          let agree _ =
            let said =
              String.equal (T.words_shown T.body) "disclosure: expanded"
            in
            let shown =
              match
                Option.bind root (fun r -> T.attribute r "data-expanded")
              with
              | Some _ -> true
              | None -> false
            in
            if Bool.equal said shown then "agree" else "differ"
          in
          let* walked =
            T.walk ~read:agree ~step:(fun f -> f ()) (T.by_role "button")
          in
          Js.Promise.resolve
            E.(
              expect (Array.map snd walked)
              |> toEqual (Array.make (Array.length walked) "agree")));
      Jest.testPromise "draws its content's children of the focus within it"
        (fun () ->
          T.render (fun () ->
              <Disclosure default_expanded=true>
                <Disclosure.Heading>
                  <Disclosure.Trigger>"Shipping"</Disclosure.Trigger>
                </Disclosure.Heading>
                <Disclosure.Content>
                  (fun c ->
                    Solidtype.Jsx.fragment
                      [|
                        <span data_words="content">
                          (fun () ->
                            Solidtype.Jsx.string
                              (T.words
                                 [
                                   ( "focus-visible-within",
                                     c.is_focus_visible_within );
                                 ]))
                        </span>;
                        <button>"Track"</button>;
                      |])
                </Disclosure.Content>
              </Disclosure>);
          let user = T.setup () in
          let before = T.words_shown T.body in
          let* () = T.tab user in
          let on_trigger = T.words_shown T.body in
          let* () = T.tab user in
          Js.Promise.resolve
            E.(
              expect (before, on_trigger, T.words_shown T.body)
              |> toEqual
                   ("content: ", "content: ", "content: focus-visible-within")));
      Jest.testPromise "expands and collapses, as React's does" (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "is expanded at first, as React's is" (fun () ->
          let* r = both ~default_expanded:true () in
          same r);
      Jest.testPromise "stays as it is while disabled, as React's" (fun () ->
          let* r = both ~is_disabled:true () in
          same r);
      Jest.testPromise "is expanded while it is told, as React's" (fun () ->
          let* r = both ~is_expanded:true () in
          same r);
      Jest.testPromise "takes a button as its trigger, as React's does"
        (fun () ->
          let* r = both ~button:true () in
          same r);
      Jest.testPromise "is expanded as find in page reaches it, as React's"
        (fun () ->
          let reveal host =
            let* () =
              Twin.step (fun () ->
                  (match Js.Null.toOption (query host "[hidden]") with
                  | Some content ->
                      ignore (dispatch content (event "beforematch") : bool)
                  | None -> ());
                  Js.Promise.resolve ())
            in
            Js.Promise.resolve (shown host)
          in
          render ~button:false (fun (_ : bool) -> ());
          let* solidtype = reveal T.body in
          T.cleanup ();
          let host = Twin.render (props ()) (fun (_ : bool) -> ()) in
          let* react = reveal host in
          Twin.cleanup ();
          same (solidtype, react));
      Jest.testPromise
        "takes its parts' attributes, calling a caller's refs beside its own"
        (fun () ->
          let triggers = ref 0 and contents = ref 0 in
          T.render (fun () ->
              <Disclosure>
                <Disclosure.Heading>
                  <Disclosure.Trigger
                    title="Opens" style="--x: 1" ref=(fun _ -> incr triggers)>
                    "Shipping"
                  </Disclosure.Trigger>
                </Disclosure.Heading>
                <Disclosure.Content
                  title="Shown" style="--y: 2" ref=(fun _ -> incr contents)>
                  "Soon."
                </Disclosure.Content>
              </Disclosure>);
          let user = T.setup () in
          let trigger = T.by_role "button" in
          let content () =
            match T.query "[data-slot=disclosure-content]" with
            | Some c -> c
            | None -> T.body
          in
          let height () =
            property (style (content ())) "--disclosure-panel-height"
          in
          let collapsed = height () in
          (* Counted before it is expanded: Kobalte's parts give their ref
             again as their state changes. *)
          let given = (!triggers, !contents) in
          let* () = T.hover user trigger in
          let hovered = T.attribute trigger "data-hovered" in
          let* () = T.click user trigger in
          Js.Promise.resolve
            E.(
              expect
                ( (T.attribute trigger "title", T.attribute trigger "style"),
                  ( T.attribute (content ()) "title",
                    property (style (content ())) "--y" ),
                  ( hovered,
                    collapsed,
                    height (),
                    T.attribute (content ()) "hidden" ),
                  given )
              |> toEqual
                   ( (Some "Opens", Some "--x: 1;"),
                     (Some "Shown", "2"),
                     (Some "true", "0px", "auto", None),
                     (1, 1) )));
      Jest.testPromise "keeps its size as a caller's style changes" (fun () ->
          let shade, set_shade = Solidtype.Solid.create_signal "1" in
          T.render (fun () ->
              <Disclosure>
                <Disclosure.Heading>
                  <Disclosure.Trigger>"Shipping"</Disclosure.Trigger>
                </Disclosure.Heading>
                <Disclosure.Content
                  style=(fun () -> "--y: " ^ Solidtype.Solid.get shade)>
                  "Soon."
                </Disclosure.Content>
              </Disclosure>);
          let* () = T.click (T.setup ()) (T.by_role "button") in
          Solidtype.Solid.set set_shade "2";
          let content =
            match T.query "[data-slot=disclosure-content]" with
            | Some c -> c
            | None -> T.body
          in
          Js.Promise.resolve
            E.(
              expect
                ( property (style content) "--disclosure-panel-height",
                  property (style content) "--y" )
              |> toEqual ("auto", "2")));
      Jest.test "keeps its trigger controlling its content given an id"
        (fun () ->
          T.render (fun () ->
              <Disclosure default_expanded=true>
                <Disclosure.Heading>
                  <Disclosure.Trigger>"Shipping"</Disclosure.Trigger>
                </Disclosure.Heading>
                <Disclosure.Content id="mine">
                  <Disclosure.Body>"Soon."</Disclosure.Body>
                </Disclosure.Content>
              </Disclosure>);
          let controlled =
            Option.bind
              (T.attribute (T.by_role "button") "aria-controls")
              (fun id -> T.query ("#" ^ id))
            |> Option.map (fun e -> T.attribute e "data-slot")
          in
          E.(expect controlled |> toEqual (Some (Some "disclosure-content"))));
      Jest.test "is a button given the trigger's slot outside one" (fun () ->
          T.render (fun () -> <Button slot=`trigger>"Save"</Button>);
          let expanded =
            Option.bind (T.query "[data-slot=button]") (fun b ->
                T.attribute b "aria-expanded")
          in
          E.(expect expanded |> toEqual None)))
