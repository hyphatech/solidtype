(* HeroUI's Table with its rows reordered: beside the same table in React, each
   handle and row at rest; and as a caller meets it, a row moved by the keys and dropped, the row it lands
   beside marked, and no violation axe finds while a row is grabbed. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Button = Solidtype_heroui.Button
module Table = Solidtype_heroui.Table
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type user = { id : string; name : string }

let users =
  [|
    { id = "1"; name = "Kate Moore" };
    { id = "2"; name = "John Smith" };
    { id = "3"; name = "Sara Johnson" };
  |]

module Twin = struct
  external render : unit -> Dom.element = "render"
  [@@mel.module "./twins/TableReorder.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/TableReorder.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

let reorderable ?(told = ref []) () =
  T.render (fun () ->
      <Table>
        <Table.Scroll_container>
          <Table.Content
            aria_label="Reorderable"
            on_reorder=(fun (r : Table.reorder) ->
                         told :=
                           (String.concat "," (Array.to_list r.keys)
                           ^ (match r.position with
                             | `before -> " before "
                             | `after -> " after ")
                           ^ r.target)
                           :: !told)>
            <Table.Header>
              <Table.Column>"Move"</Table.Column>
              <Table.Column is_row_header=true>"Name"</Table.Column>
            </Table.Header>
            <Table.Body>
              <For each=users>
                (fun u _ ->
                  <Table.Row id=u.id>
                    <Table.Cell>
                      <Button
                        slot=`drag is_icon_only=true size=`sm variant=`ghost>
                        <span aria_hidden=true>"::"</span>
                      </Button>
                    </Table.Cell>
                    <Table.Cell>(Jsx.string u.name)</Table.Cell>
                  </Table.Row>)
              </For>
            </Table.Body>
          </Table.Content>
        </Table.Scroll_container>
      </Table>)

(* Each handle's and row's state a drag reads. *)
let shown host =
  Js.Array.from (query_all host "[slot=drag], [data-slot=table-row]")
  |> Array.map (fun e ->
      String.concat " "
        (List.filter_map
           (fun name ->
             match T.attribute e name with
             | Some v -> Some (name ^ "=" ^ v)
             | None -> None)
           [
             "data-slot";
             "aria-label";
             "tabindex";
             "slot";
             "data-dragging";
             "disabled";
           ]))

let handles host = Js.Array.from (query_all host "[slot=drag]")

let () =
  Jest.describe "Table, its rows reordered" (fun () ->
      Jest.afterEach T.cleanup;
      (* React Aria's drag, in jsdom, which lays nothing out, finds no drop
         target and is canceled as it starts: what is compared is each handle
         and row at rest. *)
      Jest.test
        "names its handles and leaves them in the page's order, as React's does"
        (fun () ->
          reorderable ();
          let solidtype = shown T.body in
          T.cleanup ();
          let host = Twin.render () in
          let react = shown host in
          Twin.cleanup ();
          E.(expect solidtype |> toEqual react));
      Jest.testPromise "moves a row by the keys and marks where it lands"
        (fun () ->
          let told = ref [] in
          reorderable ~told ();
          let user = T.setup () in
          T.focus (handles T.body).(0);
          let* () = T.keyboard user "{Enter}{ArrowDown}" in
          let rows =
            Js.Array.from (query_all T.body "[data-slot=table-row]")
            |> Array.map (fun r ->
                ( T.attribute r "data-dragging",
                  T.attribute r "data-drop-position" ))
          in
          let* () = T.keyboard user "{Enter}" in
          Js.Promise.resolve
            E.(
              expect (rows, !told)
              |> toEqual
                   ( [|
                       (Some "true", None); (None, None); (None, Some "before");
                     |],
                     [ "1 before 3" ] )));
      Jest.testPromise "has no violation axe finds while a row is grabbed"
        (fun () ->
          reorderable ();
          let user = T.setup () in
          T.focus (handles T.body).(0);
          let* () = T.keyboard user "{Enter}{ArrowDown}" in
          let* found = T.accessibility_violations () in
          Js.Promise.resolve E.(expect found |> toEqual [||])))
