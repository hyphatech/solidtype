(* HeroUI's ColorPicker on Kobalte's popover, beside the same picker in React:
   its trigger and popover, what has the focus, and the colour each component
   inside it shows as one of them changes it, as the page holds it or it keeps
   it. *)

module S = Solidtype.Solid
module For = Solidtype.For
module Color_picker = Solidtype_heroui.Color_picker
module Color_area = Solidtype_heroui.Color_area
module Color_slider = Solidtype_heroui.Color_slider
module Color_field = Solidtype_heroui.Color_field
module Color_swatch = Solidtype_heroui.Color_swatch
module Color_swatch_picker = Solidtype_heroui.Color_swatch_picker
module Button = Solidtype_heroui.Button
module Label = Solidtype_heroui.Label
module Colors = Solidtype_kobalte.Colors
module Color = Solidtype_kobalte.Types.Color
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?default_value:(string[@mel.as "defaultValue"]) ->
  ?value:string ->
  ?fixed:bool ->
  ?placement:string ->
  ?own_value:(string[@mel.as "ownValue"]) ->
  ?button:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render :
    props ->
    ((string -> unit)[@mel.uncurry]) ->
    ((string -> unit)[@mel.uncurry]) ->
    Dom.element = "render"
  [@@mel.module "./twins/ColorPicker.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/ColorPicker.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/ColorPicker.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external value_of : Dom.element -> string = "value" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

external clear : T.user -> Dom.element -> unit Js.Promise.t = "clear"
[@@mel.send]

type options

external options :
  pointer_events_check:(int[@mel.as "pointerEventsCheck"]) -> unit -> options
  = ""
[@@mel.obj]

(* A user whose press outside is let through Kobalte's modal, which takes
   pointer events from the rest of the page. *)
external setup : options -> T.user = "setup"
[@@mel.module "@testing-library/user-event"] [@@mel.scope "default"]

(* A while for a framework's timers and focus moves to run. *)
let settle () = Testing.wait 20
let all selector = Js.Array.from (query_all T.body selector)

let first selector =
  match all selector with [||] -> T.body | found -> found.(0)

(* What one framework writes for itself: Kobalte's own state, present and empty,
   which no style of HeroUI's reads, and its trigger's popup, which React Aria's
   leaves out; React Aria's popover's trigger, and its place; and each id, which
   names one part from another. A reference is read below, by what it names. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-expanded" | "data-closed"), Some "" -> true
  | "aria-haspopup", _ -> true
  | "tabindex", Some "0" -> true
  | ("id" | "style" | "dir" | "data-trigger"), _ -> true
  | ("aria-controls" | "aria-labelledby"), _ -> true
  | "type", _ -> true
  | "data-rac", _ -> true
  | "data-react-aria-pressable", _ -> true
  | _ -> false

(* A part: its tag and attributes. *)
let one e =
  String.concat " "
    [
      tag_name e;
      T.attributes_but
        (T.attribute_names e |> Array.to_list |> List.filter (framework_only e))
        e;
    ]

(* The parts HeroUI's styles read of the picker itself. *)
let parts () =
  all
    "[data-slot=color-picker], [data-slot=color-picker-trigger], \
     [data-slot=color-picker-popover]"
  |> Array.map one

(* The colour a variable holds in a part's style, as a hex with its alpha,
   which each framework writes in a CSS form of its own. *)
let declared variable e =
  let prefix = variable ^ ": " in
  Option.value (T.attribute e "style") ~default:""
  |> String.split_on_char ';' |> List.map String.trim
  |> List.find_opt (String.starts_with ~prefix)
  |> Option.fold ~none:("no " ^ variable) ~some:(fun d ->
      let n = String.length prefix in
      String.sub d n (String.length d - n) |> Colors.parse_color |> fun c ->
      Color.to_string c ~format:`hexa ())

(* The colour each component shows, read as a user reads it. *)
let colours () =
  let of_ selector read =
    all selector |> Array.map read |> Array.to_list |> String.concat ", "
  in
  [|
    "swatches: "
    ^ of_ "[data-slot=color-swatch]" (declared "--color-swatch-current");
    "area: "
    ^ of_ "[data-slot=color-area-thumb]" (declared "--color-area-thumb-color");
    "slider: " ^ of_ "[data-slot=color-slider-output]" text;
    "fields: " ^ of_ "[data-slot=color-input-group-input]" value_of;
    "chosen: "
    ^ of_ "[data-slot=color-swatch-picker-item][data-selected=true]"
        (declared "--color-swatch-current");
  |]

let focus_is () =
  "focus: "
  ^
  match Js.Null.toOption active with
  | Some e -> Option.value (T.attribute e "data-slot") ~default:(tag_name e)
  | None -> "none"

(* What names the popover, read by what it names. *)
let named () =
  match all "[data-slot=color-picker-popover]" with
  | [||] -> "no popover"
  | found -> (
      match T.attribute found.(0) "aria-labelledby" with
      | None -> "unnamed"
      | Some id -> (
          match all ("[id=\"" ^ id ^ "\"]") with
          | [||] -> "names nothing"
          | named ->
              Option.value (T.attribute named.(0) "data-slot") ~default:"?"))

let outside () =
  match
    Js.Null.toOption
      (closest (first "[data-testid=outside]") "[aria-hidden=true], [inert]")
  with
  | Some _ -> "outside: hidden from a reader"
  | None -> "outside: read"

let shown () =
  Array.concat [ parts (); colours (); [| focus_is (); named (); outside () |] ]

let trigger () = first "[data-slot=color-picker-trigger], [data-slot=button]"

let walk ~step ~told =
  let user = setup (options ~pointer_events_check:0 ()) in
  let seen = ref [] in
  let after name action =
    let* () =
      step (fun () ->
          let* () = action () in
          settle ())
    in
    seen := (name, shown (), !told) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "pressed" (fun () -> T.click user (trigger ())) in
  let* () =
    after "a preset chosen" (fun () ->
        T.click user (T.nth "[data-slot=color-swatch-picker-item]" 1))
  in
  let* () =
    after "the hue stepped" (fun () ->
        T.focus (first "[data-slot=color-slider-thumb] input");
        T.keyboard user "{ArrowRight}")
  in
  let* () =
    after "the area stepped" (fun () ->
        T.focus (first "[data-slot=color-area-thumb] input");
        T.keyboard user "{ArrowUp}")
  in
  let* () =
    after "a hex typed" (fun () ->
        let input = T.nth "[data-slot=color-input-group-input]" 0 in
        T.focus input;
        let* () = clear user input in
        T.keyboard user "#3b82f6{Enter}")
  in
  let* () =
    after "the hex emptied" (fun () ->
        let input = T.nth "[data-slot=color-input-group-input]" 0 in
        let* () = clear user input in
        T.keyboard user "{Enter}")
  in
  let* () =
    after "a channel typed" (fun () ->
        let input = T.nth "[data-slot=color-input-group-input]" 1 in
        T.focus input;
        let* () = clear user input in
        T.keyboard user "100{Enter}")
  in
  let* () =
    after "a channel emptied" (fun () ->
        let input = T.nth "[data-slot=color-input-group-input]" 1 in
        let* () = clear user input in
        T.keyboard user "{Enter}")
  in
  let* () = after "Escape" (fun () -> T.keyboard user "{Escape}") in
  let* () = after "pressed again" (fun () -> T.click user (trigger ())) in
  let* () =
    after "pressed outside" (fun () ->
        T.click user (first "[data-testid=outside]"))
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let picker ?value ?default_value ?(fixed = false) ?placement ?own_value
    ?(button = false) ~told ~told_own () =
  let parse = Colors.parse_color in
  let hex c = Color.to_string c ~format:`hex () in
  let held, set_held = S.create_signal (Option.map parse value) in
  <div>
    <p data_testid="outside">"Outside"</p>
    <Color_picker
      ?default_value=(fun () -> Option.map parse default_value)
      ?value=(fun () -> S.get held)
      on_change=(fun c ->
                  told := Array.append !told [| hex c |];
                  if (not fixed) && Option.is_some value then
                    S.set set_held (Some c))>
      (fun () ->
        if button then Solidtype.Jsx.element <Button>"Pick"</Button>
        else
          Solidtype.Jsx.element
            <Color_picker.Trigger>
              <Color_swatch size=`lg /> <Label>"Pick a color"</Label>
            </Color_picker.Trigger>)
      <Color_picker.Popover ?placement=(fun () -> placement) should_flip=false>
        <Color_area
          aria_label="Color area"
          color_space=`hsb
          x_channel=`saturation
          y_channel=`brightness
          ?value=(fun () -> Option.map parse own_value)
          on_change=(fun c -> told_own := Array.append !told_own [| hex c |])>
          <Color_area.Thumb />
        </Color_area>
        <Color_slider channel=`hue color_space=`hsb>
          <Label>"Hue"</Label>
          <Color_slider.Output />
          <Color_slider.Track><Color_slider.Thumb /></Color_slider.Track>
        </Color_slider>
        <Color_swatch_picker aria_label="Presets" size=`xs>
          <For each=(fun () -> [| "#ef4444"; "#22c55e"; "#3b82f6" |])>
            (fun preset _ ->
              <Color_swatch_picker.Item color=(fun () -> parse preset)>
                <Color_swatch_picker.Swatch />
              </Color_swatch_picker.Item>)
          </For>
        </Color_swatch_picker>
        <Color_field aria_label="Hex">
          <Color_field.Group>
            <Color_field.Prefix><Color_swatch size=`xs /></Color_field.Prefix>
            <Color_field.Input />
          </Color_field.Group>
        </Color_field>
        <Color_field aria_label="Red" channel=`red color_space=`rgb>
          <Color_field.Group><Color_field.Input /></Color_field.Group>
        </Color_field>
        <Button>"Inside"</Button>
      </Color_picker.Popover>
    </Color_picker>
  </div>

let compared name ?value ?default_value ?fixed ?placement ?own_value ?button ()
    =
  Jest.testPromise name (fun () ->
      let told = ref [||] and told_own = ref [||] in
      T.render (fun () ->
          picker ?value ?default_value ?fixed
            ?placement:(Option.map fst placement) ?own_value ?button ~told
            ~told_own ());
      let* port = walk ~step:(fun action -> action ()) ~told in
      T.cleanup ();
      let told = ref [||] and told_own_react = ref [||] in
      let (_ : Dom.element) =
        Twin.render
          (props ?value ?default_value ?fixed
             ?placement:(Option.map snd placement) ?own_value ?button ())
          (fun hex -> told := Array.append !told [| hex |])
          (fun hex -> told_own_react := Array.append !told_own_react [| hex |])
      in
      let* react = walk ~step:Twin.step ~told in
      Twin.cleanup ();
      Js.Promise.resolve
        (E.toEqual (react, !told_own_react) (E.expect (port, !told_own))))

let () =
  Jest.describe "Color_picker" (fun () ->
      Jest.afterEach T.cleanup;
      compared "shares a colour it keeps" ~default_value:"#0485F7" ();
      compared "starts at black with no colour given" ();
      compared "shares a colour the page holds" ~value:"#325578" ();
      compared "shows the colour a page will not change" ~value:"#325578"
        ~fixed:true ();
      compared "shares a colour with an alpha"
        ~default_value:"hsla(220, 90%, 50%, 0.8)" ();
      compared "lets a part's own colour win" ~default_value:"#0485F7"
        ~own_value:"#F43F5E" ();
      compared "takes a button as its trigger" ~default_value:"#0485F7"
        ~button:true ();
      compared "sits where it is placed" ~default_value:"#0485F7"
        ~placement:(`top_right, "top right") ();
      Jest.testPromise "tells a reader nothing wrong while open" (fun () ->
          let told = ref [||] and told_own = ref [||] in
          T.render (fun () ->
              picker ~default_value:"#0485F7" ~told ~told_own ());
          let user = setup (options ~pointer_events_check:0 ()) in
          let* () = T.click user (trigger ()) in
          let* () = settle () in
          let* violations = T.accessibility_violations () in
          (* The thumb's input inside the thumb is Kobalte's own slider, which
             a port keeps, as test/kobalte/slider_test.mlx says. *)
          Js.Promise.resolve
            (E.toEqual [||]
               (E.expect
                  (Js.Array.filter
                     ~f:(fun id -> not (String.equal id "nested-interactive"))
                     violations))));
      Jest.testPromise "opens as its popover is told, its trigger pressed"
        (fun () ->
          let told = ref [||] in
          T.render (fun () ->
              let opened, set_opened = S.create_signal true in
              <Color_picker>
                <Color_picker.Trigger>"Pick"</Color_picker.Trigger>
                <Color_picker.Popover
                  is_open=(fun () -> S.get opened)
                  on_open_change=(fun o ->
                                   told := Array.append !told [| o |];
                                   S.set set_opened o)>
                  "Inside"
                </Color_picker.Popover>
              </Color_picker>);
          let* () = settle () in
          let was_open =
            Array.length (all "[data-slot=color-picker-popover]")
          in
          let pressed = T.attribute (trigger ()) "data-pressed" in
          let user = setup (options ~pointer_events_check:0 ()) in
          let* () = T.keyboard user "{Escape}" in
          let* () = settle () in
          Js.Promise.resolve
            (E.toEqual
               ((1, Some "true"), [| false |], Some "false")
               (E.expect
                  ( (was_open, pressed),
                    !told,
                    T.attribute (trigger ()) "aria-expanded" ))));
      Jest.test "raises when a part is outside a picker" (fun () ->
          E.toThrow
            (E.expect (fun () ->
                 T.render (fun () ->
                     <Color_picker.Popover><span /></Color_picker.Popover>)))))
