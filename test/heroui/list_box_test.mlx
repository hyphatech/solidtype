(* HeroUI's ListBox on Kobalte's, beside the same list box in React: its
   options and all in them, what it tells and what has the focus, as Tab
   reaches it, the keys move through it and select, and a press selects. *)

module List_box = Solidtype_heroui.List_box
module Label = Solidtype_heroui.Label
module Description = Solidtype_heroui.Description
module Header = Solidtype_heroui.Header
module Separator = Solidtype_heroui.Separator
module Virtualizer = Solidtype_heroui.Virtualizer
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type list = [ `single | `multiple | `sections ]
type props

external props : list:list -> told:(string -> unit) -> unit -> props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/ListBox.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/ListBox.tsx"]

  external render_of_state : bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/ListBox.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/ListBox.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

(* A while for a framework's timers and focus moves to run. *)
let settle () = Testing.wait 20

(* What one framework writes for itself, which no style of HeroUI's reads:
   Kobalte's own state, present and empty, an [aria-disabled] it writes false,
   and each option's place in the list, which a reader counts in React Aria's;
   React Aria's collection; and each framework's ids
   and keys, made its own way. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-selected" | "data-highlighted" | "data-disabled"), Some "" -> true
  | "aria-disabled", Some "false" -> true
  | ("aria-posinset" | "aria-setsize"), _ -> true
  | "data-collection", _ -> true
  | ("id" | "style" | "dir" | "data-key"), _ -> true
  | _ -> false

(* An id one part names another by, which each framework makes its own way. *)
let names_another = function
  | "aria-describedby" | "aria-labelledby" -> true
  | _ -> false

(* An element: its tag, its attributes and its text. *)
let one e =
  let names =
    T.attribute_names e |> Array.to_list
    |> List.filter (fun name ->
        not (framework_only e name || T.framework_only name))
    |> List.sort String.compare
  in
  String.concat " "
    (tag_name e
    :: List.map
         (fun name ->
           if names_another name then name ^ "=(id)"
           else name ^ "=" ^ Option.value (T.attribute e name) ~default:"")
         names)
  ^ if element_count e > 0 then "" else " " ^ text e

let all selector = Js.Array.from (query_all T.body selector)

(* What jsdom has no layout for, given as a browser would measure it: the
   height of what a list scrolls in, and where it is scrolled to. *)
type descriptor

external descriptor : value:'a -> writable:bool -> unit -> descriptor = ""
[@@mel.obj]

external define : Dom.element -> string -> descriptor -> unit = "defineProperty"
[@@mel.scope "Object"]

external scroll_top : Dom.element -> float = "scrollTop" [@@mel.get]
external set_scroll_top : Dom.element -> float -> unit = "scrollTop" [@@mel.set]

type event

external event : string -> event = "Event" [@@mel.new]
external dispatch : Dom.element -> event -> bool = "dispatchEvent" [@@mel.send]

let measured list ~height =
  define list "clientHeight" (descriptor ~value:height ~writable:false ());
  define list "scrollTop" (descriptor ~value:0. ~writable:true ());
  define list "scrollHeight" (descriptor ~value:50000. ~writable:false ())

let scrolled list top =
  set_scroll_top list top;
  ignore (dispatch list (event "scroll") : bool)

(* A thousand users, each an option of its name. *)
let users () = Array.init 1000 (fun i -> "User " ^ string_of_int (i + 1))

let virtualized () =
  T.render (fun () ->
      <div data_testid="scroller" style="overflow-y: auto">
        <Virtualizer
          layout=(fun () -> Virtualizer.list_layout ~row_size:50. ())>
          <List_box aria_label="Users">
            <Solidtype.For each=(fun () -> users ())>
              (fun name _ ->
                <List_box.Item id=(fun () -> name)>
                  (fun () -> Solidtype.Jsx.string name)
                </List_box.Item>)
            </Solidtype.For>
          </List_box>
        </Virtualizer>
      </div>);
  let list =
    match T.query "[data-testid=scroller]" with
    | Some e -> e
    | None -> T.by_role "listbox"
  in
  measured list ~height:400;
  scrolled list 0.;
  list

let drawn () = all "[role=option]" |> Array.map text

(* The list and all inside it, what it told, and what has the focus. *)
let shown told =
  all ".list-box, .list-box *:not([aria-hidden=true] *)"
  |> Array.map one
  |> Fun.flip Array.append (Array.of_list (List.rev !told))
  |> Fun.flip Array.append
       [|
         ("focus: "
         ^
         match Js.Null.toOption active with
         | Some e ->
             Option.value (T.attribute e "data-slot") ~default:(tag_name e)
             ^ " " ^ text e
         | None -> "none");
       |]

let by_text selector wanted =
  match
    List.find_opt
      (fun e -> String.equal (text e) wanted)
      (Array.to_list (all selector))
  with
  | Some e -> e
  | None -> T.body

(* The keys each list is walked with, from the button before it. *)
let keys = function
  | `single | `multiple ->
      [ "{Tab}"; "{ArrowDown}"; "[Space]"; "{ArrowDown}"; "{Enter}" ]
  | `sections -> [ "{Tab}"; "{ArrowDown}"; "{ArrowDown}"; "{Enter}" ]

let walk ~step ~told (list : list) =
  let user = T.setup () in
  let seen = ref [] in
  let after name action =
    let* () =
      step (fun () ->
          let* () = action () in
          settle ())
    in
    seen := (name, shown told) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () =
    after "before" (fun () -> T.click user (by_text "button" "Before"))
  in
  let* () =
    List.fold_left
      (fun before key ->
        let* () = before in
        after key (fun () -> T.keyboard user key))
      (Js.Promise.resolve ()) (keys list)
  in
  let first =
    match list with `single | `multiple -> "Bob" | `sections -> "New file"
  in
  let* () =
    after "pressed" (fun () -> T.click user (by_text "[data-slot=label]" first))
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let items (list : list) tell =
  match list with
  | (`single | `multiple) as mode ->
      <List_box
        aria_label="Users"
        selection_mode=(fun () -> (mode :> [ `none | `single | `multiple ]))
        default_selected_keys=(fun () -> [| "bob" |])
        disabled_keys=(fun () -> [| "martha" |])
        on_selection_change=(fun keys ->
                              let keys = Array.copy keys in
                              Array.sort String.compare keys;
                              tell
                                ("selected "
                                ^ String.concat " " (Array.to_list keys)))>
        <List_box.Item id="bob" text_value="Bob">
          <Label>"Bob"</Label>
          <Description>"bob@heroui.com"</Description>
          <List_box.Item_indicator />
        </List_box.Item>
        <List_box.Item id="fred" text_value="Fred">
          <Label>"Fred"</Label> <List_box.Item_indicator />
        </List_box.Item>
        <List_box.Item id="martha" text_value="Martha">
          <Label>"Martha"</Label>
        </List_box.Item>
        <List_box.Item id="tom" text_value="Tom" variant=`danger>
          <Label>"Tom"</Label>
        </List_box.Item>
      </List_box>
  | `sections ->
      <List_box
        aria_label="File actions"
        selection_mode=`none
        on_action=(fun key -> tell ("action " ^ key))>
        <List_box.Section>
          <Header>"Actions"</Header>
          <List_box.Item id="new" text_value="New file">
            <Label>"New file"</Label>
          </List_box.Item>
          <List_box.Item id="edit" text_value="Edit file">
            <Label>"Edit file"</Label>
          </List_box.Item>
        </List_box.Section>
        <Separator />
        <List_box.Section>
          <Header>"Danger zone"</Header>
          <List_box.Item id="delete" text_value="Delete file" variant=`danger>
            <Label>"Delete file"</Label>
          </List_box.Item>
        </List_box.Section>
      </List_box>

let both (list : list) =
  let told = ref [] in
  let tell said = told := said :: !told in
  T.render (fun () ->
      <div>
        <button type_=`button>"Before"</button>
        (fun () -> Solidtype.Jsx.element (items list tell))
      </div>);
  let* solidtype = walk ~step:(fun action -> action ()) ~told list in
  T.cleanup ();
  told := [];
  let (_ : Dom.element) = Twin.render (props ~list ~told:tell ()) in
  let* react = walk ~step:Twin.step ~told list in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

(* The walk on the first option of a list of single selection, whose
   children are drawn of its state, as words, beside React's. *)
let of_state ~disabled =
  let words name flags =
    <span data_words=(fun () -> Solidtype.Jsx.data name)>
      (fun () -> Solidtype.Jsx.string (T.words flags))
    </span>
  in
  T.render (fun () ->
      <List_box
        aria_label="Fruits"
        selection_mode=`single
        disabled_keys=(fun () -> if disabled then [| "apple" |] else [||])>
        <List_box.Item id="apple" text_value="Apple">
          (fun s ->
            words "apple"
              [
                ("hovered", s.is_hovered);
                ("pressed", s.is_pressed);
                ("focused", s.is_focused);
                ("focus-visible", s.is_focus_visible);
                ("selected", s.is_selected);
                ("disabled", s.is_disabled);
                ( "single",
                  Solidtype.Solid.accessor (fun () ->
                      match Solidtype.Solid.get s.selection_mode with
                      | `single -> true
                      | `none | `multiple -> false) );
              ])
        </List_box.Item>
        <List_box.Item id="banana">"Banana"</List_box.Item>
      </List_box>);
  let* solidtype =
    T.walk ~read:T.words_shown ~step:Twin.step (T.nth "[role=option]" 0)
  in
  T.cleanup ();
  let* react =
    T.walk ~read:T.words_shown ~step:Twin.step (Twin.render_of_state disabled)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "List_box" (fun () ->
      Jest.testPromise "draws its parts' children of their state, as React's"
        (fun () ->
          let* solidtype, react = of_state ~disabled:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its parts' children of their state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.afterEach T.cleanup;
      Jest.testPromise "selects one, as React's does" (fun () ->
          let* r = both `single in
          same r);
      Jest.testPromise "selects many, as React's does" (fun () ->
          let* r = both `multiple in
          same r);
      Jest.testPromise "acts on items in sections, as React's does" (fun () ->
          let* r = both `sections in
          same r);
      Jest.test "draws what loads more as an option while it loads" (fun () ->
          let loading, set_loading = Solidtype.Solid.create_signal true in
          T.render (fun () ->
              <List_box aria_label="Pokemon">
                <List_box.Item id="bulbasaur">"bulbasaur"</List_box.Item>
                <List_box.Load_more_item
                  is_loading=(fun () -> Solidtype.Solid.get loading)>
                  <span>"Loading more..."</span>
                </List_box.Load_more_item>
              </List_box>);
          let shown () =
            all "[role=listbox] > *"
            |> Array.map (fun e ->
                Option.value (T.attribute e "role") ~default:(tag_name e)
                ^ " " ^ text e)
          in
          let while_loading = shown () in
          Solidtype.Solid.set set_loading false;
          E.(
            expect (while_loading, shown ())
            |> toEqual
                 ( [| "option bulbasaur"; "DIV "; "option Loading more..." |],
                   [| "option bulbasaur"; "DIV " |] )));
      Jest.test "keeps its options in their order, one added between two"
        (fun () ->
          let names, set_names =
            Solidtype.Solid.create_signal [| "bulbasaur"; "squirtle" |]
          in
          T.render (fun () ->
              <List_box aria_label="Pokemon">
                <Solidtype.For each=(fun () -> Solidtype.Solid.get names)>
                  (fun name _ ->
                    <List_box.Item id=(fun () -> name)>
                      (fun () -> Solidtype.Jsx.string name)
                    </List_box.Item>)
                </Solidtype.For>
              </List_box>);
          let shown () = all "[role=option]" |> Array.map text in
          Solidtype.Solid.set set_names
            [| "bulbasaur"; "charmander"; "squirtle" |];
          E.(
            expect (shown ())
            |> toEqual [| "bulbasaur"; "charmander"; "squirtle" |]));
      Jest.test "virtualized, draws only the options in view, in a block of all"
        (fun () ->
          let list = virtualized () in
          let at_top = drawn () in
          scrolled list 1000.;
          let block =
            match all "[role=listbox] > [role=presentation]" with
            | [| b |] -> T.attribute b "style"
            | _ -> None
          in
          E.(
            expect
              ( at_top,
                drawn (),
                Option.map (Js.String.includes ~search:"height: 50000px") block
              )
            |> toEqual
                 ( Array.init 8 (fun i -> "User " ^ string_of_int (i + 1)),
                   Array.init 8 (fun i -> "User " ^ string_of_int (i + 21)),
                   Some true )));
      Jest.test "virtualized, tells each option's place in the whole list"
        (fun () ->
          let (_ : Dom.element) = virtualized () in
          let first = (all "[role=option]").(0) in
          E.(
            expect
              ( T.attribute first "aria-posinset",
                T.attribute first "aria-setsize" )
            |> toEqual (Some "1", Some "1000")));
      Jest.testPromise
        "virtualized, scrolls to the option the keys move to, the last to the \
         end" (fun () ->
          let list = virtualized () in
          let user = T.setup () in
          let* () = T.tab user in
          let* () = T.keyboard user "{End}" in
          let focused =
            match Js.Null.toOption active with Some e -> text e | None -> ""
          in
          Js.Promise.resolve
            E.(
              expect (focused, scroll_top list) |> toEqual ("User 1000", 50000.)));
      Jest.testPromise
        "takes its parts' attributes, calling a caller's ref and handlers \
         beside its own" (fun () ->
          (* Kobalte's option calls its ref again as it is pressed, on the
             same element: each part's is counted once. *)
          let refs = ref [] and handled = ref [] and acted = ref [] in
          let note seen what = seen := what :: !seen in
          T.render (fun () ->
              <List_box
                aria_label="Files"
                selection_mode=`none
                on_action=(fun key -> note acted key)
                title="Files"
                style="--x: 1"
                ref=(fun _ -> note refs "list")>
                <List_box.Section title="Actions">
                  <List_box.Item
                    id="new"
                    title="New"
                    style="--y: 2"
                    ref=(fun _ -> note refs "item")
                    on_click=(fun _ -> note handled "click")
                    on_key_down=(fun _ -> note handled "key")>
                    <Label>"New file"</Label>
                  </List_box.Item>
                </List_box.Section>
              </List_box>);
          let user = T.setup () in
          let item = by_text "[role=option]" "New file" in
          let* () = T.hover user item in
          let hovered = T.attribute item "data-hovered" in
          let* () = T.click user item in
          let* () = T.keyboard user "{Enter}" in
          let titled selector =
            Option.bind (T.query selector) (fun e -> T.attribute e "title")
          in
          Js.Promise.resolve
            E.(
              expect
                ( ( titled "[role=listbox]",
                    titled "section",
                    titled "[role=option]" ),
                  (T.attribute item "style", hovered),
                  Array.of_list (List.rev !acted),
                  Array.of_list (List.rev !handled),
                  Array.of_list (List.sort_uniq String.compare !refs) )
              |> toEqual
                   ( (Some "Files", Some "Actions", Some "New"),
                     (Some "--y: 2;", Some "true"),
                     [| "new"; "new" |],
                     [| "click"; "key" |],
                     [| "item"; "list" |] )));
      Jest.testPromise "takes a caller's change, and still selects" (fun () ->
          let told = ref [] in
          T.render (fun () ->
              <List_box
                aria_label="Users"
                on_selection_change=(fun keys -> told := keys :: !told)
                on_change=(fun _ -> ())>
                <List_box.Item id="bob">"Bob"</List_box.Item>
                <List_box.Item id="fred">"Fred"</List_box.Item>
              </List_box>);
          let* () = T.click (T.setup ()) (by_text "[role=option]" "Fred") in
          Js.Promise.resolve
            E.(
              expect
                ( Array.of_list !told,
                  T.attribute (by_text "[role=option]" "Fred") "aria-selected"
                )
              |> toEqual ([| [| "fred" |] |], Some "true")));
      Jest.testPromise "virtualized, keeps the option with the focus drawn"
        (fun () ->
          let list = virtualized () in
          let user = T.setup () in
          let* () = T.tab user in
          scrolled list 20000.;
          let focused =
            match Js.Null.toOption active with Some e -> text e | None -> ""
          in
          Js.Promise.resolve
            E.(
              expect (focused, Array.exists (String.equal "User 1") (drawn ()))
              |> toEqual ("User 1", true))))
