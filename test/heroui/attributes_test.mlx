external matches : Dom.element -> string -> bool = "matches" [@@mel.send]

(* What each part's ref was handed, and the element each part's handler was
   called on, by the part's name. *)
let refs : (string, Dom.element) Hashtbl.t = Hashtbl.create 256
let handled : (string, Dom.element) Hashtbl.t = Hashtbl.create 256

external as_element : _ Dom.element_like -> Dom.element = "%identity"

external current_target : Dom.keyboardEvent -> Dom.element = "currentTarget"
[@@mel.get]

(* A part drawn several times, a time field's segments, is handed each. *)
let seen name e = Hashtbl.add refs name (as_element e)
let heard name e = Hashtbl.add handled name (current_target e)

type keyboard_event_init

external keyboard_event_init :
  key:string -> bubbles:bool -> unit -> keyboard_event_init = ""
[@@mel.obj]

type keyboard_event

external keyboard_event : string -> keyboard_event_init -> keyboard_event
  = "KeyboardEvent"
[@@mel.new]

external dispatch : Dom.element -> keyboard_event -> bool = "dispatchEvent"
[@@mel.send]

(* The parts typed by an svg's attributes, which hold no title. *)
let untitled =
  [
    "Accordion.Indicator";
    "Accordion.Indicator.icon";
    "Autocomplete.Indicator";
    "Close_button.Icon";
    "Disclosure.Indicator";
    "Progress_circle.Fill_circle";
    "Progress_circle.Track";
    "Progress_circle.Track_circle";
    "Search_field.Search_icon";
    "Select.Indicator";
  ]

type css_style

external style_of : Dom.element -> css_style = "style" [@@mel.get]

external property : css_style -> string -> string = "getPropertyValue"
[@@mel.send]

external get_attribute : Dom.element -> string -> string Js.null
  = "getAttribute"
[@@mel.send]

(* What of a part's attributes is not on its element: its title, which an svg
   does not take, its style, its ref and its handler, told a key no part acts
   on. *)
let unattributed name e =
  ignore
    (dispatch e
       (keyboard_event "keydown"
          (keyboard_event_init ~key:"Unidentified" ~bubbles:true ()))
      : bool);
  let title =
    match Js.Null.toOption (get_attribute e "title") with
    | Some t -> String.equal t name
    | None -> List.exists (String.equal name) untitled
  in
  let same table =
    List.exists (fun x -> x == e) (Hashtbl.find_all table name)
  in
  [
    (title, "title");
    (String.equal (property (style_of e) "--part") "1", "style");
    (same refs, "ref");
    (same handled, "on_key_down");
  ]
  |> List.filter_map (fun (holds, what) -> if holds then None else Some what)

(* Each part's name whose data-testid is missing, on an element its selector
   does not find, or beside an attribute of its own that is not. *)
let misplaced parts =
  parts
  |> List.filter_map (fun (name, selector) ->
      match T.query ("[data-testid=\"" ^ name ^ "\"]") with
      | Some e when matches e selector -> (
          match unattributed name e with
          | [] -> None
          | missing -> Some (name ^ " without " ^ String.concat ", " missing))
      | Some e -> Some (name ^ " on " ^ T.attributes e)
      | None -> Some (name ^ " missing"))
  |> Array.of_list

