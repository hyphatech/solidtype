                            ref=(fun e -> seen "Toast.Content" e)
                            on_key_down=(fun e -> heard "Toast.Content" e)>
                            <Toast.Title
                              ?as_=(drawn "Toast.Title" "div")
                              data_testid="Toast.Title"
                              class_="given-class"
                              title="Toast.Title"
                              style="--part: 1"
                              ref=(fun e -> seen "Toast.Title" e)
                              on_key_down=(fun e -> heard "Toast.Title" e)>
                              "Title"
                            </Toast.Title>
                            <Toast.Description
                              ?as_=(drawn "Toast.Description" "div")
                              data_testid="Toast.Description"
                              class_="given-class"
                              title="Toast.Description"
                              style="--part: 1"
                              ref=(fun e -> seen "Toast.Description" e)
                              on_key_down=(fun e -> heard "Toast.Description" e)>
                              "Description"
                            </Toast.Description>
                          </Toast.Content>
                          <Toast.Action_button
                            ?as_=(drawn "Toast.Action_button" "button")
                            data_testid="Toast.Action_button"
                            class_="given-class"
                            title="Toast.Action_button"
                            style="--part: 1"
                            ref=(fun e -> seen "Toast.Action_button" e)
                            on_key_down=(fun e -> heard "Toast.Action_button" e)>
                            "Undo"
                          </Toast.Action_button>
                          <Toast.Close_button
                            ?as_=(drawn "Toast.Close_button" "button")
                            data_testid="Toast.Close_button"
                            class_="given-class"
                            title="Toast.Close_button"
                            style="--part: 1"
                            ref=(fun e -> seen "Toast.Close_button" e)
                            on_key_down=(fun e -> heard "Toast.Close_button" e)
                          />
                        </Toast>)
                    </Toast.Provider>
                  </div>);
              let (_ : Toast.key) = Toast.show ~timeout_ms:0. "Saved" in
              E.(
                expect
                  (misplaced
                     [
                       ("Meter", "[data-slot=meter]");
                       ("Meter.Output", "[data-slot=meter-output]");
                       ("Meter.Track", "[data-slot=meter-track]");
                       ("Meter.Fill", "[data-slot=meter-fill]");
                       ("Progress_bar", "[data-slot=progress-bar]");
                       ("Progress_bar.Output", "[data-slot=progress-bar-output]");
                       ("Progress_bar.Track", "[data-slot=progress-bar-track]");
                       ("Progress_bar.Fill", "[data-slot=progress-bar-fill]");
                       ("Progress_circle", "[data-slot=progress-circle]");
                       ( "Progress_circle.Track",
                         "[data-slot=progress-circle-track]" );
                       ( "Progress_circle.Track_circle",
                         "[data-slot=progress-circle-track-circle]" );
                       ( "Progress_circle.Fill_circle",
                         "[data-slot=progress-circle-fill-circle]" );
                       ("Toast.Provider", "[data-slot=toast-region]");
                       ("Toast", "[data-slot=toast]");
                       ("Toast.Indicator", "[data-slot=toast-indicator]");
                       ("Toast.Content", "[data-slot=toast-content]");
                       ("Toast.Title", "[data-slot=toast-title]");
                       ("Toast.Description", "[data-slot=toast-description]");
                       ("Toast.Action_button", "[data-slot=toast-action-button]");
                       ("Toast.Close_button", "[data-slot=toast-close]");
                     ])
                |> toEqual [||]))))
    [
      ("An attribute given to a port", false);
      ("An attribute given to a port drawn by an as_", true);
    ]
