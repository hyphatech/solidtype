                  value=60.>
                  <Progress_circle.Track
                    data_testid="Progress_circle.Track"
                    style="--part: 1"
                    ref=(fun e -> seen "Progress_circle.Track" e)
                    on_key_down=(fun e -> heard "Progress_circle.Track" e)>
                    <Progress_circle.Track_circle
                      data_testid="Progress_circle.Track_circle"
                      style="--part: 1"
                      ref=(fun e -> seen "Progress_circle.Track_circle" e)
                      on_key_down=(fun e ->
