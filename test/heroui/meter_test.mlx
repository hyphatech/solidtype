(* HeroUI's Meter on Kobalte's, beside the same meter in React: every part,
   which names which, its value as a reader and the output read it, and its
   fill's width. *)

module Label = Solidtype_heroui.Label
module Meter = Solidtype_heroui.Meter
module E = Jest.Expect
module T = Testing

type props

external props :
  value:float ->
  ?min_value:(float[@mel.as "minValue"]) ->
  ?max_value:(float[@mel.as "maxValue"]) ->
  ?color:string ->
  ?size:string ->
  ?format_options:
    (Solidtype_kobalte.Types.NumberFormatOptions.t[@mel.as "formatOptions"]) ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/Meter.tsx"]

  external render_of_state : bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/Meter.tsx"]

  external cleanup : unit -> unit = "cleanup" [@@mel.module "./twins/Meter.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

(* Kobalte's own state, present and empty, which no style of HeroUI's reads,
   and the label's [for], which names no input in a meter. *)
let kobalte_only e name =
  String.length name > 5
  && String.equal (String.sub name 0 5) "data-"
  && Option.equal String.equal (T.attribute e name) (Some "")
  || String.equal name "for"

let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        List.filter_map
          (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
          [ "aria-labelledby" ]
      in
      (* A style as its declarations, however a framework spaces them. *)
      let style =
        match T.attribute e "style" with
        | Some st -> " style=" ^ String.trim st
        | None -> ""
      in
      String.concat " "
        (tag_name e
        :: (T.attributes_but
              ("id" :: "aria-labelledby" :: "style"
              :: List.filter (kobalte_only e)
                   (Array.to_list (T.attribute_names e)))
              e
           ^ style)
        :: named)
      ^ if element_count e > 0 then "" else " " ^ text e)

let both ~value ?min_value ?max_value ?color ?size ?format_options () =
  T.render (fun () ->
      <Meter
        value=(fun () -> value)
        ?min_value=(fun () -> min_value)
        ?max_value=(fun () -> max_value)
        ?color=(fun () -> color)
        ?size=(fun () -> size)
        ?format_options=(fun () -> format_options)
        class_="w-64">
        <Label>"Storage"</Label>
        <Meter.Output />
        <Meter.Track><Meter.Fill /></Meter.Track>
      </Meter>);
  let host =
    match T.query "[data-slot=meter]" with
    | Some e -> Option.value (Js.Null.toOption (parent e)) ~default:T.body
    | None -> T.body
  in
  let solidtype = shown host in
  T.cleanup ();
  let react =
    shown
      (Twin.render
         (props ~value ?min_value ?max_value
            ?color:
              (Option.map
                 (function
                   | `default -> "default"
                   | `accent -> "accent"
                   | `success -> "success"
                   | `warning -> "warning"
                   | `danger -> "danger")
                 color)
            ?size:
              (Option.map
                 (function `sm -> "sm" | `md -> "md" | `lg -> "lg")
                 size)
            ?format_options ()))
  in
  Twin.cleanup ();
  (solidtype, react)

(* What a meter whose children are drawn of its state writes, beside React's. *)
let of_state ~indeterminate =
  T.render (fun () ->
      <Meter aria_label="Storage" value=40.>
        (fun s ->
          <span data_words="state">
            (fun () ->
              Solidtype.Jsx.string
                (Js.Float.toString (Solidtype.Solid.get s.percentage)
                ^ "|"
                ^ Solidtype.Solid.get s.value_text
                ^ "|false"))
          </span>)
      </Meter>);
  let solidtype = T.words_shown T.body in
  T.cleanup ();
  let (_ : Dom.element) = Twin.render_of_state indeterminate in
  let react = T.words_shown T.body in
  Twin.cleanup ();
  (solidtype, react)

let () =
  Jest.describe "Meter" (fun () ->
      Jest.test "draws its children of its value, as React's" (fun () ->
          let solidtype, react = of_state ~indeterminate:false in
          E.(expect solidtype |> toEqual react));
      Jest.afterEach T.cleanup;
      Jest.test "is a meter of its value, as React's is" (fun () ->
          let solidtype, react = both ~value:60. () in
          E.(expect solidtype |> toEqual react));
      Jest.test "is its value within its range, as React's is" (fun () ->
          let solidtype, react =
            both ~value:30. ~min_value:10. ~max_value:50. ()
          in
          E.(expect solidtype |> toEqual react));
      Jest.test "is each color and size, as React's is" (fun () ->
          let solidtype, react = both ~value:90. ~color:`danger ~size:`lg () in
          E.(expect solidtype |> toEqual react));
      Jest.test "formats its value as a currency, as React's does" (fun () ->
          let solidtype, react =
            both ~value:60.
              ~format_options:
                (Solidtype_kobalte.Types.NumberFormatOptions.make
                   ~style:`currency ~currency:"USD" ())
              ()
          in
          E.(expect solidtype |> toEqual react));
      Jest.test "formats its share of its range as a percent, as React's does"
        (fun () ->
          let solidtype, react =
            both ~value:31. ~min_value:10. ~max_value:50.
              ~format_options:
                (Solidtype_kobalte.Types.NumberFormatOptions.make
                   ~style:`percent ~maximum_fraction_digits:1. ())
              ()
          in
          E.(expect solidtype |> toEqual react)))

let () =
  Jest.describe "Meter, its elements" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "take their elements' attributes, a style after their own"
        (fun () ->
          T.render (fun () ->
              <Meter value=40. aria_label="Storage" title="Storage">
                <Meter.Output title="Used" />
                <Meter.Track title="Track">
                  <Meter.Fill title="Fill" style="--y: 2" />
                </Meter.Track>
              </Meter>);
          let read slot name =
            Option.bind
              (T.query ("[data-slot=" ^ slot ^ "]"))
              (fun e -> T.attribute e name)
          in
          E.(
            expect
              ( read "meter" "title",
                read "meter-output" "title",
                read "meter-fill" "title",
                read "meter-fill" "style" )
            |> toEqual
                 ( Some "Storage",
                   Some "Used",
                   Some "Fill",
                   Some "width: 40%; --y: 2;" ))))
