(* A text shimmer as a caller meets it: its text read once, its highlight a
   copy hidden from a reader and kept from focus, each part named by its
   classes alone, its look its stylesheet's, a class given after its own, and
   no violation axe finds. *)

module Text_shimmer = Solidtype_heroui.Text_shimmer
module E = Jest.Expect
module T = Testing
open Testing.Syntax

external text : Dom.element -> string = "textContent" [@@mel.get]

external query_all_js : string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.scope "document"]

let all selector = Js.Array.from (query_all_js selector)
let first selector = match all selector with [||] -> T.body | a -> a.(0)
let classes e = T.attribute e "class"

let () =
  Jest.describe "Text_shimmer" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "shows its text, and a copy hidden from a reader" (fun () ->
          T.render (fun () -> <Text_shimmer>"Thinking..."</Text_shimmer>);
          let root = first "[data-slot=text-shimmer]" in
          let label = first "[data-slot=text-shimmer-text]" in
          let highlight = first "[data-slot=text-shimmer-highlight]" in
          E.(
            expect
              ( classes root,
                (text label, classes label),
                ( text highlight,
                  T.attribute highlight "aria-hidden",
                  T.attribute highlight "inert",
                  classes highlight ) )
            |> toEqual
                 ( Some "text-shimmer",
                   ("Thinking...", Some "text-shimmer__text"),
                   ( "Thinking...",
                     Some "true",
                     Some "",
                     Some "text-shimmer__highlight" ) )));
      Jest.test "puts a class given after its own" (fun () ->
          T.render (fun () ->
              <Text_shimmer class_="text-muted">"Thinking..."</Text_shimmer>);
          E.(
            expect (classes (first "[data-slot=text-shimmer]"))
            |> toEqual (Some "text-shimmer text-muted")));
      Jest.testPromise "has no violation axe finds" (fun () ->
          T.render (fun () ->
              <Text_shimmer>"Generating response..."</Text_shimmer>);
          let* found = T.accessibility_violations () in
          Js.Promise.resolve E.(expect found |> toEqual [||])))
