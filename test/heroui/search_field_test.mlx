(* HeroUI's SearchField on Kobalte's text field, beside the same field in
   React: every part, which names and describes which, and its value as it is
   typed, cleared by Escape and by its button, and submitted by Enter. *)

module Description = Solidtype_heroui.Description
module Form = Solidtype_heroui.Form
module Label = Solidtype_heroui.Label
module Search_field = Solidtype_heroui.Search_field
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?variant:string ->
  ?full_width:(bool[@mel.as "fullWidth"]) ->
  ?is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?is_invalid:(bool[@mel.as "isInvalid"]) ->
  ?on_blur:((Dom.focusEvent -> unit)[@mel.as "onBlur"]) ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render :
    props ->
    ((string -> unit)[@mel.uncurry]) ->
    ((string -> unit)[@mel.uncurry]) ->
    Dom.element = "render"
  [@@mel.module "./twins/SearchField.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/SearchField.tsx"]

  external render_of_state : bool -> bool -> bool -> bool -> Dom.element
    = "renderOfState"
  [@@mel.module "./twins/SearchField.tsx"]

  external render_clear_of_state : bool -> Dom.element = "renderClearOfState"
  [@@mel.module "./twins/SearchField.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/SearchField.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external value_of : Dom.element -> string = "value" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]
external prevent_default : Dom.event -> unit = "preventDefault" [@@mel.send]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

let references = [ "for"; "aria-labelledby"; "aria-describedby" ]

(* What Kobalte writes that React Aria does not, and no style of HeroUI's
   reads: its own state, present and empty, its ARIA state beside the native
   attributes, and the field's role. React Aria's tabindex and title, and the
   value it writes as an attribute where Solid sets the property, which is
   shown as the property. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ( ( "data-valid" | "data-invalid" | "data-required" | "data-disabled"
      | "data-readonly" ),
      Some "" ) ->
      true
  | ("aria-required" | "aria-disabled" | "aria-readonly"), Some _ -> true
  | ("value" | "title"), _ -> true
  | "style", Some "user-select: none;" -> true
  | "tabindex", Some "0" -> true
  | "role", Some "group" ->
      Option.equal String.equal
        (T.attribute e "data-slot")
        (Some "search-field")
  | _ -> false

let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        references
        |> List.filter_map (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
      in
      String.concat " "
        (tag_name e
        :: T.attributes_but
             (("id" :: references)
             @ (T.attribute_names e |> Array.to_list
               |> List.filter (framework_only e)))
             e
        :: named)
      ^
      match tag_name e with
      | "INPUT" -> " value=" ^ value_of e
      | _ when element_count e > 0 -> ""
      | _ -> " " ^ text e)

let focused () =
  match Js.Null.toOption active with
  | Some e -> Option.value (T.attribute e "data-slot") ~default:(tag_name e)
  | None -> "nothing"

(* The field as it is rendered, typed in, cleared by Escape, typed in again,
   cleared by its button, and submitted by Enter: every part, what has the
   focus, and the values it told, after each. *)
let walk ~step host told =
  let user = T.setup () in
  let part slot =
    match Js.Null.toOption (query host ("[data-slot=" ^ slot ^ "]")) with
    | Some e -> e
    | None -> host
  in
  let seen = ref [] in
  let after name action =
    let* () = step action in
    seen := (name, shown host, focused (), !told) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () =
    after "typed in" (fun () ->
        let* () = T.click user (part "search-field-input") in
        T.keyboard user "abc")
  in
  let* () = after "escaped" (fun () -> T.keyboard user "{Escape}") in
  let* () = after "typed again" (fun () -> T.keyboard user "xy") in
  let* () =
    after "cleared" (fun () -> T.click user (part "search-field-clear-button"))
  in
  let* () = after "submitted" (fun () -> T.keyboard user "q{Enter}") in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?variant ?full_width ?is_disabled ?is_invalid () =
  let told = ref "" in
  let tell what v = told := !told ^ what ^ ":" ^ v ^ " " in
  T.render (fun () ->
      <Search_field
        ?variant=(fun () -> variant)
        ?full_width=(fun () -> full_width)
        ?is_disabled=(fun () -> is_disabled)
        ?is_invalid=(fun () -> is_invalid)
        name="search"
        on_change=(tell "changed")
        on_submit=(tell "submitted")>
        <Label>"Search"</Label>
        <Search_field.Group>
          <Search_field.Search_icon />
          <Search_field.Input placeholder="Search..." />
          <Search_field.Clear_button />
        </Search_field.Group>
        <Description>"Find a task."</Description>
      </Search_field>);
  let host =
    match T.query "[data-slot=search-field]" with
    | Some e -> Option.value (Js.Null.toOption (parent e)) ~default:T.body
    | None -> T.body
  in
  let* solidtype = walk ~step:(fun action -> action ()) host told in
  T.cleanup ();
  let told' = ref "" in
  let tell' what v = told' := !told' ^ what ^ ":" ^ v ^ " " in
  let host =
    Twin.render
      (props
         ?variant:
           (Option.map
              (function `primary -> "primary" | `secondary -> "secondary")
              variant)
         ?full_width ?is_disabled ?is_invalid ())
      (tell' "changed") (tell' "submitted")
  in
  let* react = walk ~step:Twin.step host told' in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

(* A field whose root and group draw their children of their state, as
   words. *)
let draw_of_state ~disabled ~read_only ~invalid ~required =
  let words name flags =
    <span data_words=(fun () -> Solidtype.Jsx.data name)>
      (fun () -> Solidtype.Jsx.string (T.words flags))
    </span>
  in
  T.render (fun () ->
      <Search_field
        aria_label="Field"
        is_disabled=(fun () -> disabled)
        is_read_only=(fun () -> read_only)
        is_invalid=(fun () -> invalid)
        is_required=(fun () -> required)>
        (fun r ->
          Solidtype.Jsx.fragment
            [|
              words "field"
                [
                  ("empty", r.is_empty);
                  ("disabled", r.is_disabled);
                  ("invalid", r.is_invalid);
                  ("read-only", r.is_read_only);
                  ("required", r.is_required);
                ];
              <Search_field.Group>
                (fun g ->
                  Solidtype.Jsx.fragment
                    [|
                      words "group"
                        [
                          ("hovered", g.is_hovered);
                          ("focus-within", g.is_focus_within);
                          ("focus-visible", g.is_focus_visible);
                          ("disabled", g.is_disabled);
                          ("invalid", g.is_invalid);
                        ];
                      <Search_field.Input />;
                    |])
              </Search_field.Group>;
            |])
      </Search_field>)

(* What it writes, beside React's, then a glance at its group. *)
let of_state ?(disabled = false) ?(read_only = false) ?(invalid = false)
    ?(required = false) () =
  draw_of_state ~disabled ~read_only ~invalid ~required;
  let* solidtype =
    T.glance ~read:T.words_shown ~step:Twin.step (T.slot "search-field-group")
  in
  T.cleanup ();
  let* react =
    T.glance ~read:T.words_shown ~step:Twin.step
      (Twin.render_of_state disabled read_only invalid required)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

(* A glance at the clear button of a search field of a text, whose children
   are drawn of its state, as words, beside React's. *)
let clear_of_state ~disabled =
  T.render (fun () ->
      <Search_field
        aria_label="Search"
        default_value=(fun () -> "cats")
        is_disabled=(fun () -> disabled)>
        <Search_field.Group>
          <Search_field.Input />
          <Search_field.Clear_button>
            (fun s ->
              <span data_words="clear">
                (fun () ->
                  Solidtype.Jsx.string
                    (T.words
                       [
                         ("hovered", s.is_hovered);
                         ("pressed", s.is_pressed);
                         ("focused", s.is_focused);
                         ("focus-visible", s.is_focus_visible);
                         ("disabled", s.is_disabled);
                       ]))
              </span>)
          </Search_field.Clear_button>
        </Search_field.Group>
      </Search_field>);
  let* solidtype =
    T.glance ~read:T.words_shown ~step:Twin.step
      (T.slot "search-field-clear-button")
  in
  T.cleanup ();
  let* react =
    T.glance ~read:T.words_shown ~step:Twin.step
      (Twin.render_clear_of_state disabled)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Search_field" (fun () ->
      Jest.testPromise
        "draws its clear button's children of its state, as React's" (fun () ->
          let* solidtype, react = clear_of_state ~disabled:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its parts' children of their state, as React's"
        (fun () ->
          let* solidtype, react = of_state () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its parts' children of their state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise
        "draws its parts' children of their state, read-only, invalid, required"
        (fun () ->
          let* solidtype, react =
            of_state ~read_only:true ~invalid:true ~required:true ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.afterEach T.cleanup;
      Jest.testPromise "is typed in, cleared and submitted, as React's is"
        (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "is secondary and full width, as React's is" (fun () ->
          let* r = both ~variant:`secondary ~full_width:true () in
          same r);
      Jest.testPromise "takes nothing while disabled, as React's" (fun () ->
          let* r = both ~is_disabled:true () in
          same r);
      Jest.testPromise "is invalid, as React's is" (fun () ->
          let* r = both ~is_invalid:true () in
          same r);
      Jest.test "passes a caller's attributes to an icon of its own" (fun () ->
          T.render (fun () ->
              <Search_field>
                <Label>"Search"</Label>
                <Search_field.Group>
                  <Search_field.Search_icon data_testid="icon" style="--x: 1">
                    "/"
                  </Search_field.Search_icon>
                  <Search_field.Input />
                </Search_field.Group>
              </Search_field>);
          E.(
            expect
              (Option.bind (T.query "[data-testid=icon]") (fun e ->
                   T.attribute e "data-slot"))
            |> toEqual (Some "search-field-search-icon"))))

let () =
  Jest.describe "Search_field, left" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "tells it is left once focus leaves it, as React's does"
        (fun () ->
          let solidtype =
            T.blurs ~root:"[data-slot=search-field]" (fun on_blur ->
                T.render (fun () ->
                    <Search_field on_blur>
                      <Label>"Search"</Label>
                      <Search_field.Group>
                        <Search_field.Search_icon />
                        <Search_field.Input />
                        <Search_field.Clear_button />
                      </Search_field.Group>
                    </Search_field>))
          in
          T.cleanup ();
          let react =
            T.blurs ~root:"[data-slot=search-field]" (fun on_blur ->
                ignore
                  (Twin.render (props ~on_blur ())
                     (fun (_ : string) -> ())
                     (fun (_ : string) -> ())
                    : Dom.element))
          in
          Twin.cleanup ();
          E.(expect (solidtype, react) |> toEqual (1, 1))))

let () =
  Jest.describe "Search_field's clear button" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "draws the icon it is given, as React's does" (fun () ->
          T.render (fun () ->
              <Search_field default_value="query">
                <Label>"Search"</Label>
                <Search_field.Group>
                  <Search_field.Input />
                  <Search_field.Clear_button>
                    <span class_="given" />
                  </Search_field.Clear_button>
                </Search_field.Group>
              </Search_field>);
          let drawn =
            Option.map
              (fun b ->
                ( Option.is_some (Js.Null.toOption (query b "span.given")),
                  Option.is_some (Js.Null.toOption (query b "svg")) ))
              (T.query "[data-slot=search-field-clear-button]")
          in
          E.(expect drawn |> toEqual (Some (true, false)))))

let () =
  Jest.describe "Search_field, its elements" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise
        "take their elements' attributes, calling a caller's ref and handlers \
         beside their own" (fun () ->
          let told = ref [] in
          let tell name = told := name :: !told in
          T.render (fun () ->
              <Form on_submit=prevent_default>
                <Search_field
                  name="query"
                  is_invalid=true
                  title="Search"
                  style="--x: 1"
                  ref=(fun _ -> tell "field ref")
                  on_focus_out=(fun _ -> tell "field focus out")
                  on_blur=(fun _ -> tell "field blur")>
                  <Label>"Search"</Label>
                  <Search_field.Group>
                    <Search_field.Input
                      title="Query"
                      ref=(fun _ -> tell "input ref")
                      on_key_down=(fun _ -> tell "input key down")
                    />
                    <Search_field.Clear_button
                      title="Clear"
                      ref=(fun _ -> tell "clear ref")
                      on_pointer_down=(fun _ -> tell "clear pointer down")
                      on_click=(fun _ -> tell "clear click")
                    />
                  </Search_field.Group>
                </Search_field>
                <button data_slot="submit" type_=`submit>"Save"</button>
              </Form>);
          let user = T.setup () in
          let part slot =
            Option.value (T.query ("[data-slot=" ^ slot ^ "]")) ~default:T.body
          in
          let input = part "search-field-input" in
          let clear = part "search-field-clear-button" in
          (* The input's ref watches the pointer, and its keys clear it. *)
          let* () = T.click user input in
          let* () = T.keyboard user "ab{Escape}" in
          let escaped = (value_of input, T.attribute input "data-hovered") in
          (* The clear button's ref watches the pointer, and a press clears the
             input and keeps the focus in it. *)
          let* () = T.keyboard user "cd" in
          let* () = T.click user clear in
          let cleared =
            (value_of input, focused (), T.attribute clear "data-hovered")
          in
          (* The form focuses the invalid field it finds by the field's ref. *)
          let* () = T.click user (part "submit") in
          let submitted = focused () in
          let* () = T.click user T.body in
          let root = part "search-field" in
          Js.Promise.resolve
            E.(
              expect
                ( (T.attribute root "title", T.attribute root "style"),
                  (T.attribute input "title", T.attribute clear "title"),
                  (escaped, cleared, submitted),
                  Array.of_list (List.sort_uniq String.compare !told) )
              |> toEqual
                   ( (Some "Search", Some "--x: 1;"),
                     (Some "Query", Some "Clear"),
                     ( ("", Some "true"),
                       ("", "search-field-input", Some "true"),
                       "search-field-input" ),
                     [|
                       "clear click";
                       "clear pointer down";
                       "clear ref";
                       "field blur";
                       "field focus out";
                       "field ref";
                       "input key down";
                       "input ref";
                     |] ))))

let () =
  Jest.describe "Search_field's clear button, given attributes" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "stays disabled in a disabled field" (fun () ->
          T.render (fun () ->
              <Search_field default_value="query" is_disabled=true>
                <Label>"Search"</Label>
                <Search_field.Group>
                  <Search_field.Input />
                  <Search_field.Clear_button disabled=false />
                </Search_field.Group>
              </Search_field>);
          E.(
            expect
              (Option.bind (T.query "[data-slot=search-field-clear-button]")
                 (fun b -> T.attribute b "disabled"))
            |> toEqual (Some ""))))
