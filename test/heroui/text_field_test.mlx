(* HeroUI's TextField on Kobalte's, beside the same field in React: every
   part of it, which part names and describes which, and their state as the
   input is hovered, focused and typed in; and its Input and TextArea alone. *)

module S = Solidtype.Solid
module Description = Solidtype_heroui.Description
module Field_error = Solidtype_heroui.Field_error
module Input = Solidtype_heroui.Input
module Label = Solidtype_heroui.Label
module Text_area = Solidtype_heroui.Text_area
module Text_field = Solidtype_heroui.Text_field
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type field

external field :
  ?variant:string ->
  ?full_width:(bool[@mel.as "fullWidth"]) ->
  ?is_required:(bool[@mel.as "isRequired"]) ->
  ?is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?is_invalid:(bool[@mel.as "isInvalid"]) ->
  ?is_read_only:(bool[@mel.as "isReadOnly"]) ->
  ?default_value:(string[@mel.as "defaultValue"]) ->
  ?multiline:bool ->
  ?on_blur:((Dom.focusEvent -> unit)[@mel.as "onBlur"]) ->
  unit ->
  field = ""
[@@mel.obj]

type alone

external alone :
  ?variant:string ->
  ?full_width:(bool[@mel.as "fullWidth"]) ->
  ?disabled:bool ->
  ?multiline:bool ->
  unit ->
  alone = ""
[@@mel.obj]

module Twin = struct
  external field : field -> Dom.element = "field"
  [@@mel.module "./twins/TextField.tsx"]

  external alone : alone -> Dom.element = "alone"
  [@@mel.module "./twins/TextField.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/TextField.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/TextField.tsx"]
end

external value_of : Dom.element -> string = "value" [@@mel.get]

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

(* An attribute that names elements by id, written as the slots of the
   elements it names, since each side makes its own ids. *)
let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

let references = [ "for"; "aria-labelledby"; "aria-describedby" ]

(* React writes a controlled input's value as an attribute, where Solid sets
   the property, which is what the input holds: its value is shown as the
   property. React Aria gives a field's input tabindex 0, which an input has
   already, and which no style reads. *)
let frameworks = [ "value"; "tabindex" ]

(* What Kobalte writes that React Aria does not, and no style of HeroUI's
   reads: its own state on each part, present and empty, the field's role,
   and its input's ARIA state beside the native attributes. *)
let kobalte_only e name =
  match (name, T.attribute e name) with
  | ( ( "data-valid" | "data-invalid" | "data-required" | "data-disabled"
      | "data-readonly" ),
      Some "" ) ->
      true
  | "role", Some "group" ->
      Option.equal String.equal (T.attribute e "data-slot") (Some "textfield")
  | ("aria-required" | "aria-disabled" | "aria-readonly"), Some "true" -> true
  | _ -> false

(* Each part, its tag, its attributes, each reference by what it names, and
   its text. *)
let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        references
        |> List.filter_map (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
      in
      String.concat " "
        (tag_name e
        :: T.attributes_but
             (("id" :: references) @ frameworks
             @ (T.attribute_names e |> Array.to_list
               |> List.filter (kobalte_only e)))
             e
        :: named)
      ^
      (* A control's value is its property, which React writes into a text
         area as its text too; a part that holds others shows theirs. *)
      match tag_name e with
      | "INPUT" | "TEXTAREA" -> " value=" ^ value_of e
      | _ when element_count e > 0 -> ""
      | _ -> " " ^ text e)

let input_of host =
  match Js.Null.toOption (query host "input, textarea") with
  | Some e -> e
  | None -> host

(* The field as it is rendered, hovered, clicked into, left, reached by Tab
   and typed in: every part after each step. *)
let walk ~step host =
  let user = T.setup () in
  let input = input_of host in
  let seen = ref [] in
  let after name action =
    let* () = step action in
    seen := (name, shown host) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "hovered" (fun () -> T.hover user input) in
  let* () = after "clicked" (fun () -> T.click user input) in
  let* () = after "left" (fun () -> T.click user T.body) in
  let* () = after "tabbed to" (fun () -> T.tab user) in
  let* () = after "typed in" (fun () -> T.keyboard user "a") in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let solidtype_host () =
  match
    T.query "[data-slot=textfield], [data-slot=input], [data-slot=textarea]"
  with
  | Some e -> (
      match T.attribute e "data-slot" with Some "textfield" -> e | _ -> T.body)
  | None -> T.body

let variant_name = function `primary -> "primary" | `secondary -> "secondary"

let both_field ?variant ?full_width ?is_required ?is_disabled ?is_invalid
    ?is_read_only ?default_value ?(multiline = false) () =
  T.render (fun () ->
      <Text_field
        ?variant=(fun () -> variant)
        ?full_width=(fun () -> full_width)
        ?is_required=(fun () -> is_required)
        ?is_disabled=(fun () -> is_disabled)
        ?is_invalid=(fun () -> is_invalid)
        ?is_read_only=(fun () -> is_read_only)
        ?default_value=(fun () -> default_value)
        name="email"
        class_="max-w-64">
        <Label>"Email"</Label>
        (fun () ->
          if multiline then
            Solidtype.Jsx.element <Text_area placeholder="Your message" />
          else Solidtype.Jsx.element <Input placeholder="Enter your email" />)
        <Description>"We'll never share it."</Description>
        <Field_error>"Enter a valid email."</Field_error>
      </Text_field>);
  let* solidtype =
    walk
      ~step:(fun action -> action ())
      (Option.value (T.query "body > div") ~default:T.body)
  in
  T.cleanup ();
  let host =
    Twin.field
      (field
         ?variant:(Option.map variant_name variant)
         ?full_width ?is_required ?is_disabled ?is_invalid ?is_read_only
         ?default_value ~multiline ())
  in
  let* react = walk ~step:Twin.step host in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let both_alone ?variant ?full_width ?disabled ?(multiline = false) () =
  T.render (fun () ->
      if multiline then
        <Text_area
          ?variant=(fun () -> variant)
          ?full_width=(fun () -> full_width)
          ?disabled=(fun () -> disabled)
          placeholder="Your message"
          aria_label="Message" />
      else
        <Input
          ?variant=(fun () -> variant)
          ?full_width=(fun () -> full_width)
          ?disabled=(fun () -> disabled)
          placeholder="Name"
          aria_label="Name" />);
  let* solidtype =
    walk
      ~step:(fun action -> action ())
      (Option.value (T.query "body > div") ~default:T.body)
  in
  T.cleanup ();
  let host =
    Twin.alone
      (alone
         ?variant:(Option.map variant_name variant)
         ?full_width ?disabled ~multiline ())
  in
  let* react = walk ~step:Twin.step host in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

let () =
  Jest.describe "Text_field" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "is an input alone, as React's is" (fun () ->
          let* r = both_alone () in
          same r);
      Jest.testPromise "is a secondary, full-width input alone" (fun () ->
          let* r = both_alone ~variant:`secondary ~full_width:true () in
          same r);
      Jest.testPromise "is a disabled input alone, as React's is" (fun () ->
          let* r = both_alone ~disabled:true () in
          same r);
      Jest.testPromise "is a text area alone, as React's is" (fun () ->
          let* r = both_alone ~multiline:true ~variant:`secondary () in
          same r);
      Jest.testPromise "is a field of every part, as React's is" (fun () ->
          let* r = both_field () in
          same r);
      Jest.testPromise "is a required field, as React's is" (fun () ->
          let* r = both_field ~is_required:true () in
          same r);
      Jest.testPromise "is a disabled field, as React's is" (fun () ->
          let* r = both_field ~is_disabled:true () in
          same r);
      Jest.testPromise "is an invalid field, its error shown, as React's"
        (fun () ->
          let* r = both_field ~is_invalid:true () in
          same r);
      Jest.testPromise "is a read-only field, as React's is" (fun () ->
          let* r =
            both_field ~is_read_only:true ~default_value:"ada@x.org" ()
          in
          same r);
      Jest.testPromise "gives its input its variant and width" (fun () ->
          let* r = both_field ~variant:`secondary ~full_width:true () in
          same r);
      Jest.testPromise "is a field of a text area, as React's is" (fun () ->
          let* r = both_field ~multiline:true () in
          same r);
      Jest.testPromise "keeps its value, and tells it as it changes" (fun () ->
          let told = ref [] in
          T.render (fun () ->
              <Text_field on_change=(fun v -> told := v :: !told)>
                <Label>"Name"</Label> <Input />
              </Text_field>);
          let user = T.setup () in
          let input = input_of T.body in
          let* () = T.click user input in
          let* () = T.keyboard user "Ada" in
          Js.Promise.resolve
            E.(expect (List.rev !told) |> toEqual [ "A"; "Ad"; "Ada" ]));
      Jest.testPromise "shows the value it is given" (fun () ->
          let value, set_value = S.create_signal "Ada" in
          T.render (fun () ->
              <Text_field
                value=(fun () -> S.get value) on_change=(S.set set_value)>
                <Label>"Name"</Label> <Input />
              </Text_field>);
          S.set set_value "Grace";
          Js.Promise.resolve
            E.(expect (value_of (input_of T.body)) |> toBe "Grace")))

let () =
  Jest.describe "Text_field, left" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "tells it is left once focus leaves it, as React's does"
        (fun () ->
          let solidtype =
            T.blurs ~root:"[data-slot=textfield]" (fun on_blur ->
                T.render (fun () ->
                    <Text_field on_blur>
                      <Label>"Name"</Label> <Input />
                    </Text_field>))
          in
          T.cleanup ();
          let react =
            T.blurs ~root:"[data-slot=textfield]" (fun on_blur ->
                ignore (Twin.field (field ~on_blur ()) : Dom.element))
          in
          Twin.cleanup ();
          E.(expect (solidtype, react) |> toEqual (1, 1))))
