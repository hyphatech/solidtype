(* HeroUI's Button on Kobalte: the classes HeroUI's own buttonVariants gives
   for the same props, and Kobalte's button underneath. *)

module S = Solidtype.Solid
module Button = Solidtype_heroui.Button
module E = Jest.Expect
module T = Testing
open Testing.Syntax

module Twin = struct
  external render : bool -> Dom.element = "render"
  [@@mel.module "./twins/Button.tsx"]

  external step : ((unit -> _ Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t
    = "step"
  [@@mel.module "./twins/Button.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Button.tsx"]
end

(* The state HeroUI's styles read, which React Aria writes on its element. *)
let state b =
  [
    "data-hovered";
    "data-pressed";
    "data-focused";
    "data-focus-visible";
    "data-disabled";
  ]
  |> List.filter_map (fun name ->
      Option.map (fun v -> name ^ "=" ^ v) (T.attribute b name))
  |> String.concat " "

(* A button hovered, pressed and let go by the mouse, left, then reached by
   Tab and pressed by Enter: its state after each step, by the step's name.
   Each step runs as React asks a test to, which Solid's side does not
   need and does not mind. *)
let walk b =
  let user = T.setup () in
  let seen = ref [] in
  let after name action =
    let* () = Twin.step action in
    seen := (name, state b) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "hovered" (fun () -> T.hover user b) in
  let* () = after "pressed" (fun () -> T.pointer user "[MouseLeft>]") in
  let* () = after "released" (fun () -> T.pointer user "[/MouseLeft]") in
  let* () = after "left" (fun () -> T.unhover user b) in
  let* () =
    after "tabbed to" (fun () ->
        let* () = T.click user T.body in
        T.tab user)
  in
  let* () = after "Enter held" (fun () -> T.keyboard user "{Enter>}") in
  let* () = after "Enter let go" (fun () -> T.keyboard user "{/Enter}") in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

(* The walk on HeroUI's Button in solidtype, then in React, each alone on
   the page, so Tab reaches it. *)
let both ~disabled =
  T.render (fun () -> <Button disabled=(fun () -> disabled)>"Save"</Button>);
  let* solidtype = walk (T.by_role "button") in
  T.cleanup ();
  let* react = walk (Twin.render disabled) in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Button" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "is a button with HeroUI's default classes" (fun () ->
          T.render (fun () -> <Button>"Save"</Button>);
          let b = T.by_role "button" in
          E.(
            expect (T.class_name b, T.attribute b "type")
            |> toEqual ("button button--md button--primary", Some "button")));
      Jest.test "has the classes of its variant, size and modifiers" (fun () ->
          T.render (fun () ->
              <Button
                variant=`danger_soft
                size=`lg
                full_width=true
                is_icon_only=true
                class_="mt-4">
                "Delete"
              </Button>);
          E.(
            expect (T.class_name (T.by_role "button"))
            |> toBe
                 "button button--full-width button--icon-only button--lg \
                  button--danger-soft mt-4"));
      Jest.test "changes its classes as its variant changes" (fun () ->
          let variant, set_variant = S.create_signal `primary in
          T.render (fun () ->
              <Button variant=(fun () -> S.get variant)>"Save"</Button>);
          S.set set_variant `ghost;
          E.(
            expect (T.class_name (T.by_role "button"))
            |> toBe "button button--md button--ghost"));
      Jest.testPromise "is clicked, and not while it is disabled" (fun () ->
          let clicks = ref 0 in
          let disabled, set_disabled = S.create_signal false in
          T.render (fun () ->
              <Button
                disabled=(fun () -> S.get disabled)
                on_click=(fun _ -> incr clicks)>
                "Save"
              </Button>);
          let user = T.setup () in
          let b = T.by_role "button" in
          let* () = T.click user b in
          S.set set_disabled true;
          let* () = T.click user b in
          Js.Promise.resolve
            E.(
              expect (!clicks, T.attribute b "disabled") |> toEqual (1, Some "")));
      Jest.testPromise "shows hover, press and focus as React Aria does"
        (fun () ->
          let* solidtype, react = both ~disabled:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "shows none of them while disabled, as React Aria does"
        (fun () ->
          let* solidtype, react = both ~disabled:true in
          Js.Promise.resolve E.(expect solidtype |> toEqual react)))
