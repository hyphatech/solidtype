(* HeroUI's Button on Kobalte: the classes HeroUI's own buttonVariants gives
   for the same props, and Kobalte's button underneath. *)

module S = Solidtype.Solid
module Button = Solidtype_heroui.Button
module Spinner = Solidtype_heroui.Spinner
module E = Jest.Expect
module T = Testing
open Testing.Syntax

module Twin = struct
  external render : bool -> bool -> Dom.element = "render"
  [@@mel.module "./twins/Button.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Button.tsx"]

  external render_of_state : bool -> bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/Button.tsx"]

  external render_function : unit -> Dom.element = "renderFunction"
  [@@mel.module "./twins/Button.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Button.tsx"]
end

(* The same walk on a button whose children are drawn of its state, which
   writes the state as words: what each side's function was given. *)
let of_state ?(pending = false) ~disabled () =
  T.render (fun () ->
      <Button is_disabled=(fun () -> disabled) is_pending=(fun () -> pending)>
        (fun s ->
          <span>
            (fun () ->
              Solidtype.Jsx.string
                (T.words
                   [
                     ("hovered", s.is_hovered);
                     ("pressed", s.is_pressed);
                     ("focused", s.is_focused);
                     ("focus-visible", s.is_focus_visible);
                     ("disabled", s.is_disabled);
                     ("pending", s.is_pending);
                   ]))
          </span>)
      </Button>);
  let read = T.text_content in
  let* solidtype = T.walk ~read ~step:Twin.step (T.by_role "button") in
  T.cleanup ();
  let* react =
    T.walk ~read ~step:Twin.step (Twin.render_of_state disabled pending)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

(* The walk on HeroUI's Button in solidtype, then in React, each alone on
   the page, so Tab reaches it. *)
let both ?(pending = false) ~disabled () =
  T.render (fun () ->
      <Button is_disabled=(fun () -> disabled) is_pending=(fun () -> pending)>
        "Save"
      </Button>);
  let* solidtype = T.walk ~step:Twin.step (T.by_role "button") in
  T.cleanup ();
  let* react = T.walk ~step:Twin.step (Twin.render disabled pending) in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Button" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "is a button with HeroUI's default classes" (fun () ->
          T.render (fun () -> <Button>"Save"</Button>);
          let b = T.by_role "button" in
          E.(
            expect (T.class_name b, T.attribute b "type")
            |> toEqual ("button button--md button--primary", Some "button")));
      Jest.test "has the classes of its variant, size and modifiers" (fun () ->
          T.render (fun () ->
              <Button
                variant=`danger_soft
                size=`lg
                full_width=true
                is_icon_only=true
                class_="mt-4">
                "Delete"
              </Button>);
          E.(
            expect (T.class_name (T.by_role "button"))
            |> toBe
                 "button button--full-width button--icon-only button--lg \
                  button--danger-soft mt-4"));
      Jest.test "is named by its aria-label where it shows an icon alone"
        (fun () ->
          T.render (fun () ->
              <Button is_icon_only=true aria_label="Delete">"×"</Button>);
          E.(
            expect (T.attribute (T.by_role "button") "aria-label")
            |> toEqual (Some "Delete")));
      Jest.test "changes its classes as its variant changes" (fun () ->
          let variant, set_variant = S.create_signal `primary in
          T.render (fun () ->
              <Button variant=(fun () -> S.get variant)>"Save"</Button>);
          S.set set_variant `ghost;
          E.(
            expect (T.class_name (T.by_role "button"))
            |> toBe "button button--md button--ghost"));
      Jest.testPromise "is clicked, and not while it is disabled" (fun () ->
          let clicks = ref 0 in
          let disabled, set_disabled = S.create_signal false in
          T.render (fun () ->
              <Button
                is_disabled=(fun () -> S.get disabled)
                on_click=(fun _ -> incr clicks)>
                "Save"
              </Button>);
          let user = T.setup () in
          let b = T.by_role "button" in
          let* () = T.click user b in
          S.set set_disabled true;
          let* () = T.click user b in
          Js.Promise.resolve
            E.(
              expect (!clicks, T.attribute b "disabled") |> toEqual (1, Some "")));
      Jest.testPromise
        "takes its element's attributes, calling a caller's ref and handlers \
         beside its own" (fun () ->
          let refs = ref 0 and focuses = ref 0 and clicks = ref 0 in
          T.render (fun () ->
              <Button
                title="Saves"
                style="--x: 1"
                ref=(fun _ -> incr refs)
                on_focus=(fun _ -> incr focuses)
                on_click=(fun _ -> incr clicks)>
                "Save"
              </Button>);
          let user = T.setup () in
          let b = T.by_role "button" in
          let* () = T.hover user b in
          let hovered = T.attribute b "data-hovered" in
          let* () = T.click user b in
          Js.Promise.resolve
            E.(
              expect
                ( T.attribute b "title",
                  T.attribute b "style",
                  hovered,
                  (!refs, !focuses, !clicks) )
              |> toEqual (Some "Saves", Some "--x: 1;", Some "true", (1, 1, 1))));
      Jest.testPromise "shows hover, press and focus as React Aria does"
        (fun () ->
          let* solidtype, react = both ~disabled:false () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "shows none of them while disabled, as React Aria does"
        (fun () ->
          let* solidtype, react = both ~disabled:true () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "shows focus alone while pending, as React Aria does"
        (fun () ->
          let* solidtype, react = both ~pending:true ~disabled:false () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws what as_ draws, of its state, as React's render"
        (fun () ->
          let read e =
            String.concat " "
              [
                Option.value (T.attribute e "data-custom") ~default:"";
                T.class_name e;
              ]
          in
          T.render (fun () ->
              <Button
                as_=(fun p s ->
                        <button
                          data_custom=(fun () ->
                                        Solidtype.Jsx.data
                                          (if S.get s.is_pressed then "pressed"
                                           else "bar"))
                          props=p
                        />)>
                "Press me"
              </Button>);
          let* solidtype = T.walk ~read ~step:Twin.step (T.by_role "button") in
          T.cleanup ();
          let* react = T.walk ~read ~step:Twin.step (Twin.render_function ()) in
          Twin.cleanup ();
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its state, as React's function"
        (fun () ->
          let* solidtype, react = of_state ~disabled:false () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its state while pending"
        (fun () ->
          let* solidtype, react = of_state ~pending:true ~disabled:false () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise
        "is not clicked while pending, nor submits, though it is focusable"
        (fun () ->
          let clicks = ref 0 in
          let pending, set_pending = S.create_signal true in
          T.render (fun () ->
              <Button
                type_=`submit
                is_pending=(fun () -> S.get pending)
                on_click=(fun _ -> incr clicks)>
                "Save"
              </Button>);
          let user = T.setup () in
          let b = T.by_role "button" in
          let* () = T.click user b in
          let while_pending =
            ( !clicks,
              T.attribute b "aria-disabled",
              T.attribute b "type",
              T.attribute b "disabled" )
          in
          S.set set_pending false;
          let* () = T.click user b in
          Js.Promise.resolve
            E.(
              expect
                ( while_pending,
                  (!clicks, T.attribute b "aria-disabled", T.attribute b "type")
                )
              |> toEqual
                   ( (0, Some "true", Some "button", None),
                     (1, None, Some "submit") )));
      Jest.test
        "is named with its spinner while pending, where its aria-label names it"
        (fun () ->
          T.render (fun () ->
              <Button
                is_icon_only=true
                aria_label="Delete"
                is_pending=(fun () -> true)>
                <Spinner size=`sm />
              </Button>);
          let b = T.by_role "button" in
          let named =
            match T.attribute b "aria-labelledby" with
            | Some ids ->
                Js.String.split ~sep:" " ids
                |> Array.map (fun id ->
                    match T.query ("[id=\"" ^ id ^ "\"]") with
                    | Some e ->
                        Option.value (T.attribute e "aria-label") ~default:""
                    | None -> "")
            | None -> [||]
          in
          E.(expect named |> toEqual [| "Delete"; "Loading" |]));
      Jest.testPromise "is announced as it comes to be pending with the focus"
        (fun () ->
          let pending, set_pending = S.create_signal false in
          T.render (fun () ->
              <Button is_pending=(fun () -> S.get pending)>"Save"</Button>);
          let b = T.by_role "button" in
          T.focus b;
          S.set set_pending true;
          (* The newest message: an earlier test's may stay its seven
             seconds. *)
          let announced =
            match
              List.rev
                (Array.to_list
                   (Js.Array.from
                      (T.query_all_in T.body "[role=log] [role=img]")))
            with
            | e :: _ -> T.attribute e "aria-labelledby"
            | [] -> None
          in
          let id = T.attribute b "id" in
          Js.Promise.resolve
            E.(
              expect
                (Option.is_some id && Option.equal String.equal announced id)
              |> toBe true)))
