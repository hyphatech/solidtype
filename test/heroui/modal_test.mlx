(* HeroUI's Modal on Kobalte's dialog, beside the same modal in React: its
   trigger, the modal, what has the focus and what is outside it, as the
   trigger is pressed, Tab moves within it, Escape closes it, a button with
   slot="close" closes it, and so does a press on the backdrop. *)

module S = Solidtype.Solid
module Modal = Solidtype_heroui.Modal
module Button = Solidtype_heroui.Button
module E = Jest.Expect
module T = Testing
open Testing.Syntax

external create_div : string -> Dom.htmlDivElement = "createElement"
[@@mel.scope "document"]

external append : Dom.element -> Dom.htmlDivElement -> unit = "appendChild"
[@@mel.send]

external contains : Dom.htmlDivElement -> Dom.element -> bool = "contains"
[@@mel.send]

type props

external props :
  ?variant:([ `opaque | `blur | `transparent ][@mel.as "variant"]) ->
  ?is_dismissable:(bool[@mel.as "isDismissable"]) ->
  ?placement:([ `auto | `center | `top | `bottom ][@mel.as "placement"]) ->
  ?size:([ `xs | `sm | `md | `lg | `cover | `full ][@mel.as "size"]) ->
  ?scroll:([ `inside | `outside ][@mel.as "scroll"]) ->
  ?custom:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/Modal.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Modal.tsx"]

  external render_of_state : bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/Modal.tsx"]

  external cleanup : unit -> unit = "cleanup" [@@mel.module "./twins/Modal.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

type options

external options :
  pointer_events_check:(int[@mel.as "pointerEventsCheck"]) -> unit -> options
  = ""
[@@mel.obj]

(* A user whose press outside is let through Kobalte's modal, which takes
   pointer events from the rest of the page: in a browser the press lands on
   the backdrop, which Kobalte's layer reads as outside the dialog. *)
external setup : options -> T.user = "setup"
[@@mel.module "@testing-library/user-event"] [@@mel.scope "default"]

(* A while for a framework's timers and focus moves to run. *)
let settle () = Testing.wait 20

(* What one framework writes for itself: Kobalte's own state, present and
   empty, which no style of HeroUI's reads, and its trigger's popup, which
   React Aria's leaves out; React Aria's tabindex on what is focusable
   already, and the slot each of its parts is named for; the id each makes to
   name one part from another, and how each writes a style. A dismiss button
   only a reader finds is a [type="button"] here, where React Aria's would
   submit a form around the modal. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-expanded" | "data-closed"), Some "" -> true
  | "aria-haspopup", Some "dialog" -> true
  | ("tabindex" | "slot" | "style" | "aria-controls" | "aria-labelledby"), _ ->
      true
  | "type", _ ->
      Option.equal String.equal (T.attribute e "aria-label") (Some "Dismiss")
  | _ -> false

(* React Aria's dismiss button stands before the dialog, the port's at its
   start, where Kobalte's modal leaves it to a reader: each is shown by
   itself, after the rest. *)
let dismiss = "[aria-label=Dismiss], div:has(> [aria-label=Dismiss])"

(* An element: its tag, its attributes and its text. *)
let one e =
  String.concat " "
    [
      tag_name e;
      T.attributes_but
        (T.attribute_names e |> Array.to_list |> List.filter (framework_only e))
        e;
    ]
  ^ if element_count e > 0 then "" else " " ^ text e

let all selector = Js.Array.from (query_all T.body selector)

(* The trigger, the modal and all inside it, wherever it is, whether what is
   outside it is read, and what has the focus. *)
let shown () =
  Array.concat
    [
      all
        "[data-slot=modal-trigger], [data-slot=button]:not(.modal__backdrop *)";
      all
        (".modal__backdrop, .modal__backdrop *:not([data-focus-trap]):not("
       ^ dismiss ^ ")");
      all ".modal__backdrop [aria-label=Dismiss]";
    ]
  |> Array.map one
  |> Fun.flip Array.append
       (all "[data-testid=outside]"
       |> Array.map (fun e ->
           match Js.Null.toOption (closest e "[aria-hidden=true], [inert]") with
           | Some _ -> "outside: hidden from a reader"
           | None -> "outside: read"))
  |> Fun.flip Array.append
       [|
         ("focus: "
         ^
         match Js.Null.toOption active with
         | Some e ->
             Option.value (T.attribute e "data-slot") ~default:(tag_name e)
         | None -> "none");
       |]

let first selector =
  match all selector with [||] -> T.body | found -> found.(0)

let trigger () =
  first "[data-slot=modal-trigger], [data-slot=button]:not(.modal__backdrop *)"

let walk ~step =
  let user = setup (options ~pointer_events_check:0 ()) in
  let seen = ref [] in
  let after name action =
    let* () =
      step (fun () ->
          let* () = action () in
          settle ())
    in
    seen := (name, shown ()) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "pressed" (fun () -> T.click user (trigger ())) in
  let* () = after "Tab" (fun () -> T.tab user) in
  let* () = after "Escape" (fun () -> T.keyboard user "{Escape}") in
  let* () = after "pressed again" (fun () -> T.click user (trigger ())) in
  let* () =
    after "Continue" (fun () ->
        T.click user (first ".modal__footer [data-slot=button]"))
  in
  let* () =
    after "pressed a third time" (fun () -> T.click user (trigger ()))
  in
  let* () =
    after "backdrop pressed" (fun () -> T.click user (first ".modal__backdrop"))
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?variant ?is_dismissable ?placement ?size ?scroll ?(custom = false) ()
    =
  T.render (fun () ->
      <div>
        <p data_testid="outside">"Outside"</p>
        <Modal>
          (fun () ->
            if custom then
              Solidtype.Jsx.element
                <Modal.Trigger aria_label="Open">
                  <span>"Card"</span>
                </Modal.Trigger>
            else
              Solidtype.Jsx.element
                <Button variant=`secondary>"Open Modal"</Button>)
          <Modal.Backdrop
            ?variant=(fun () -> variant)
            ?is_dismissable=(fun () -> is_dismissable)>
            <Modal.Container
              ?placement=(fun () -> placement)
              ?size=(fun () -> size)
              ?scroll=(fun () -> scroll)>
              <Modal.Dialog>
                <Modal.Close_trigger />
                <Modal.Header>
                  <Modal.Icon>"i"</Modal.Icon>
                  <Modal.Heading>"Welcome to HeroUI"</Modal.Heading>
                </Modal.Header>
                <Modal.Body>
                  <p>"A beautiful, fast, and modern React UI library."</p>
                </Modal.Body>
                <Modal.Footer>
                  <Button slot=`close>"Continue"</Button>
                </Modal.Footer>
              </Modal.Dialog>
            </Modal.Container>
          </Modal.Backdrop>
        </Modal>
      </div>);
  let* solidtype = walk ~step:(fun action -> action ()) in
  T.cleanup ();
  let (_ : Dom.element) =
    Twin.render
      (props ?variant ?is_dismissable ?placement ?size ?scroll ~custom ())
  in
  let* react = walk ~step:Twin.step in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

(* The title and the style a part is given, found on its element: the style
   as whether it holds the declaration given, beside any the port's own. *)
let given slot =
  let e = first ("[data-slot=" ^ slot ^ "]") in
  ( T.attribute e "title",
    Option.map (Js.String.includes ~search:"--x: 1") (T.attribute e "style") )

let focused () =
  match Js.Null.toOption active with
  | Some e -> T.attribute e "data-slot"
  | None -> None

(* What an open modal whose parts draw their children of their state writes,
   then whether its dialog's close, given its children, closed it. *)
let of_state () =
  let words name flags =
    <span data_words=(fun () -> Solidtype.Jsx.data name)>
      (fun () -> Solidtype.Jsx.string (T.words flags))
    </span>
  in
  let look () =
    (* Once what entering waits for has settled, on each side. *)
    let* () = Twin.step (fun () -> Js.Promise.resolve ()) in
    let opened = T.words_shown T.body in
    let* () =
      Twin.step (fun () ->
          match T.query "[data-testid=done]" with
          | Some done_ -> T.click (T.setup ()) done_
          | None -> Js.Promise.resolve ())
    in
    Js.Promise.resolve (opened, Option.is_some (T.query "[role=dialog]"))
  in
  T.render (fun () ->
      <Modal default_open=true>
        <Modal.Backdrop>
          (fun b ->
            Solidtype.Jsx.fragment
              [|
                words "backdrop"
                  [ ("entering", b.is_entering); ("exiting", b.is_exiting) ];
                <Modal.Container>
                  (fun c ->
                    Solidtype.Jsx.fragment
                      [|
                        words "container"
                          [
                            ("entering", c.is_entering);
                            ("exiting", c.is_exiting);
                          ];
                        <Modal.Dialog>
                          (fun d ->
                            Solidtype.Jsx.fragment
                              [|
                                <Modal.Close_trigger>
                                  (fun s ->
                                    words "close"
                                      [
                                        ("hovered", s.is_hovered);
                                        ("pressed", s.is_pressed);
                                        ("disabled", s.is_disabled);
                                      ])
                                </Modal.Close_trigger>;
                                <Modal.Heading>"Welcome"</Modal.Heading>;
                                <button
                                  type_=`button
                                  data_testid="done"
                                  on_click=(fun _ -> d.close ())>
                                  "Done"
                                </button>;
                              |])
                        </Modal.Dialog>;
                      |])
                </Modal.Container>;
              |])
        </Modal.Backdrop>
      </Modal>);
  let* solidtype = look () in
  T.cleanup ();
  let (_ : Dom.element) = Twin.render_of_state false in
  let* react = look () in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Modal" (fun () ->
      Jest.testPromise "draws its parts' children of their state, as React's"
        (fun () ->
          let* solidtype, react = of_state () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.afterEach T.cleanup;
      Jest.testPromise "opens, and closes each way, as React's does" (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "stays open on a press outside, not dismissable"
        (fun () ->
          let* r = both ~is_dismissable:false ~variant:`blur () in
          same r);
      Jest.testPromise "is placed, sized and scrolled, as React's" (fun () ->
          let* r = both ~placement:`top ~size:`lg ~scroll:`outside () in
          same r);
      Jest.testPromise "opens on a trigger of its own, as React's" (fun () ->
          let* r = both ~custom:true () in
          same r);
      Jest.testPromise "is a modal of its own, open as its backdrop says"
        (fun () ->
          let module S = Solidtype.Solid in
          let open_, set_open = S.create_signal false in
          let told = ref [] in
          T.render (fun () ->
              <Modal.Backdrop
                is_open=(fun () -> S.get open_)
                on_open_change=(fun o ->
                                 told := o :: !told;
                                 S.set set_open o)>
                <Modal.Container>
                  <Modal.Dialog>
                    <Modal.Heading>"Controlled"</Modal.Heading>
                  </Modal.Dialog>
                </Modal.Container>
              </Modal.Backdrop>);
          let user = T.setup () in
          let shown () = Array.length (all "[role=dialog]") in
          let before = shown () in
          S.set set_open true;
          let* () = settle () in
          let opened = shown () in
          let* () = T.keyboard user "{Escape}" in
          let* () = settle () in
          Js.Promise.resolve
            E.(
              expect (before, opened, shown (), List.rev !told)
              |> toEqual (0, 1, 0, [ false ])));
      Jest.testPromise
        "takes its parts' attributes, calling a caller's refs and handlers \
         beside its own" (fun () ->
          let refs = ref [] and focus_outs = ref 0 and clicks = ref 0 in
          let made part = refs := part :: !refs in
          T.render (fun () ->
              <Modal>
                <Button>"Open"</Button>
                <Modal.Backdrop
                  title="Backdrop" style="--x: 1" ref=(fun _ -> made "backdrop")>
                  <Modal.Container
                    title="Container"
                    style="--x: 1"
                    ref=(fun _ -> made "container")>
                    <Modal.Dialog
                      title="Dialog"
                      style="--x: 1"
                      ref=(fun _ -> made "dialog")
                      on_focus_out=(fun _ -> incr focus_outs)>
                      <Modal.Close_trigger
                        title="Close"
                        style="--x: 1"
                        on_click=(fun _ -> incr clicks)
                      />
                      <Modal.Heading title="Heading" style="--x: 1">
                        "Welcome"
                      </Modal.Heading>
                    </Modal.Dialog>
                  </Modal.Container>
                </Modal.Backdrop>
              </Modal>);
          let user = setup (options ~pointer_events_check:0 ()) in
          let* () = T.click user (trigger ()) in
          let* () = settle () in
          let parts =
            List.map given
              [
                "modal-backdrop";
                "modal-container";
                "modal-dialog";
                "modal-close-trigger";
                "modal-heading";
              ]
          in
          let viewport =
            Option.map
              (Js.String.includes ~search:"--visual-viewport-height")
              (T.attribute (first "[data-slot=modal-backdrop]") "style")
          in
          let opened_on = focused () in
          let* () = T.tab user in
          let* () = T.click user (first "[data-slot=modal-close-trigger]") in
          let* () = settle () in
          Js.Promise.resolve
            E.(
              expect
                ( parts,
                  viewport,
                  opened_on,
                  List.sort String.compare !refs,
                  (!focus_outs > 0, !clicks),
                  Array.length (all "[role=dialog]") )
              |> toEqual
                   ( [
                       (Some "Backdrop", Some true);
                       (Some "Container", Some true);
                       (Some "Dialog", Some true);
                       (Some "Close", Some true);
                       (Some "Heading", Some true);
                     ],
                     Some true,
                     Some "modal-dialog",
                     [ "backdrop"; "container"; "dialog" ],
                     (true, 1),
                     0 )));
      Jest.testPromise "is drawn in the portal container it is given" (fun () ->
          let host = create_div "div" in
          append T.body host;
          T.render (fun () ->
              <Modal.Backdrop is_open=true portal_container=(fun () -> host)>
                <Modal.Container>
                  <Modal.Dialog>
                    <Modal.Heading>"Inside"</Modal.Heading>
                  </Modal.Dialog>
                </Modal.Container>
              </Modal.Backdrop>);
          let* () = settle () in
          let backdrop = first "[data-slot=modal-backdrop]" in
          Js.Promise.resolve E.(expect (contains host backdrop) |> toBe true)))
