(* HeroUI's NumberField on Kobalte's, beside the same field in React: every
   part, which names and describes which, and its value as its buttons are
   clicked and its input is stepped by the keyboard. *)

module Description = Solidtype_heroui.Description
module Field_error = Solidtype_heroui.Field_error
module Label = Solidtype_heroui.Label
module Number_field = Solidtype_heroui.Number_field
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?variant:string ->
  ?full_width:(bool[@mel.as "fullWidth"]) ->
  ?is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?is_invalid:(bool[@mel.as "isInvalid"]) ->
  ?is_read_only:(bool[@mel.as "isReadOnly"]) ->
  ?is_required:(bool[@mel.as "isRequired"]) ->
  ?min_value:(float[@mel.as "minValue"]) ->
  ?max_value:(float[@mel.as "maxValue"]) ->
  ?step:float ->
  ?format_options:
    (Solidtype_kobalte.Types.NumberFormatOptions.t[@mel.as "formatOptions"]) ->
  ?on_blur:((Dom.focusEvent -> unit)[@mel.as "onBlur"]) ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> ((float -> unit)[@mel.uncurry]) -> Dom.element
    = "render"
  [@@mel.module "./twins/NumberField.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/NumberField.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/NumberField.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external value_of : Dom.element -> string = "value" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

(* An attribute that names elements by id, written as the slots of the
   elements it names, since each side makes its own ids. *)
let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

let references =
  [ "for"; "aria-labelledby"; "aria-describedby"; "aria-controls" ]

(* What Kobalte writes that React Aria does not, and no style of HeroUI's
   reads: its own state, present and empty, its ARIA state beside the native
   attributes, and the field's role. React Aria's tabindex on a button the
   pointer presses, and the value it writes as an attribute where Solid sets
   the property, which is shown as the property. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ( ( "data-valid" | "data-invalid" | "data-required" | "data-disabled"
      | "data-readonly" ),
      Some "" ) ->
      true
  | ("aria-required" | "aria-disabled" | "aria-readonly"), Some _ -> true
  (* Kobalte's input is a spinbutton, where React Aria's is a text input
     described as a number field: each an accessible pattern. *)
  | ( ( "aria-valuemax" | "aria-valuemin" | "aria-valuenow" | "aria-valuetext"
      | "aria-roledescription" | "inputmode" ),
      _ ) ->
      true
  | "role", Some "spinbutton" -> true
  | ("value" | "tabindex" | "title"), _ -> true
  | "style", Some "user-select: none;" -> true
  | "role", Some "group" ->
      Option.equal String.equal
        (T.attribute e "data-slot")
        (Some "number-field")
  | _ -> false

(* Each part, its tag, its attributes, each reference by what it names, and
   its text or value. *)
let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        references
        |> List.filter_map (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
      in
      String.concat " "
        (tag_name e
        :: T.attributes_but
             (("id" :: references)
             @ (T.attribute_names e |> Array.to_list
               |> List.filter (framework_only e)))
             e
        :: named)
      ^
      match tag_name e with
      | "INPUT" -> " value=" ^ value_of e
      | _ when element_count e > 0 -> ""
      | _ -> " " ^ text e)

(* The field as it is rendered, as its increment and decrement buttons are
   clicked, and as ArrowUp steps its input: every part, and the value it
   told, after each. *)
let walk ~step host told =
  let user = T.setup () in
  let part slot =
    match Js.Null.toOption (query host ("[data-slot=" ^ slot ^ "]")) with
    | Some e -> e
    | None -> host
  in
  let seen = ref [] in
  let after name action =
    let* () = step action in
    seen := (name, shown host, !told) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () =
    after "incremented" (fun () ->
        T.click user (part "number-field-increment-button"))
  in
  let* () =
    after "decremented twice" (fun () ->
        let* () = T.click user (part "number-field-decrement-button") in
        T.click user (part "number-field-decrement-button"))
  in
  let* () =
    after "stepped up" (fun () ->
        let* () = T.click user (part "number-field-input") in
        T.keyboard user "{ArrowUp}")
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?variant ?full_width ?is_disabled ?is_invalid ?is_read_only
    ?is_required ?min_value ?max_value ?step ?format_options () =
  let told = ref "" in
  T.render (fun () ->
      <Number_field
        ?variant=(fun () -> variant)
        ?full_width=(fun () -> full_width)
        ?is_disabled=(fun () -> is_disabled)
        ?is_invalid=(fun () -> is_invalid)
        ?is_read_only=(fun () -> is_read_only)
        ?is_required=(fun () -> is_required)
        ?min_value=(fun () -> min_value)
        ?max_value=(fun () -> max_value)
        ?step=(fun () -> step)
        ?format_options=(fun () -> format_options)
        default_value=4.
        name="width"
        on_change=(fun v -> told := Js.Float.toString v)>
        <Label>"Width"</Label>
        <Number_field.Group>
          <Number_field.Decrement_button />
          <Number_field.Input />
          <Number_field.Increment_button />
        </Number_field.Group>
        <Description>"In pixels."</Description>
        <Field_error>"Too wide."</Field_error>
      </Number_field>);
  let host =
    match T.query "[data-slot=number-field]" with
    | Some field ->
        Option.value (Js.Null.toOption (parent field)) ~default:T.body
    | None -> T.body
  in
  let* solidtype = walk ~step:(fun action -> action ()) host told in
  T.cleanup ();
  let told' = ref "" in
  let host =
    Twin.render
      (props
         ?variant:
           (Option.map
              (function `primary -> "primary" | `secondary -> "secondary")
              variant)
         ?full_width ?is_disabled ?is_invalid ?is_read_only ?is_required
         ?min_value ?max_value ?step ?format_options ())
      (fun v -> told' := Js.Float.toString v)
  in
  let* react = walk ~step:Twin.step host told' in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

let () =
  Jest.describe "Number_field" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "steps its value, as React's does" (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "steps by its step, within its range, as React's"
        (fun () ->
          let* r = both ~min_value:3. ~max_value:6. ~step:2. () in
          same r);
      Jest.testPromise "is secondary and full width, as React's is" (fun () ->
          let* r = both ~variant:`secondary ~full_width:true () in
          same r);
      Jest.testPromise "steps nothing while disabled, as React's" (fun () ->
          let* r = both ~is_disabled:true () in
          same r);
      Jest.testPromise "keeps its value while read-only, as React's" (fun () ->
          let* r = both ~is_read_only:true () in
          same r);
      Jest.testPromise "is invalid and required, its error shown, as React's"
        (fun () ->
          let* r = both ~is_invalid:true ~is_required:true () in
          same r);
      Jest.test "tells a reader its value as it shows it" (fun () ->
          T.render (fun () ->
              <Number_field
                default_value=4.
                format_options=(fun () ->
                                 Solidtype_kobalte.Types.NumberFormatOptions
                                 .make ~style:`currency ~currency:"USD" ())>
                <Label>"Price"</Label>
                <Number_field.Group><Number_field.Input /></Number_field.Group>
              </Number_field>);
          let told =
            Option.bind (T.query "[data-slot=number-field-input]") (fun input ->
                T.attribute input "aria-valuetext")
          in
          E.(expect told |> toEqual (Some "$4.00")));
      Jest.testPromise "steps a currency, as React's does" (fun () ->
          let* r =
            both
              ~format_options:
                (Solidtype_kobalte.Types.NumberFormatOptions.make
                   ~style:`currency ~currency:"USD" ())
              ()
          in
          same r))

(* The value a field shows and tells after it is rendered, and after its
   increment button is clicked, each as Kobalte tells a reader it. *)
let snapped ?min_value ?max_value ?step ?format_options default =
  let told = ref "" in
  T.render (fun () ->
      <Number_field
        ?min_value=(fun () -> min_value)
        ?max_value=(fun () -> max_value)
        ?step=(fun () -> step)
        ?format_options=(fun () -> format_options)
        default_value=(fun () -> default)
        on_change=(fun v -> told := Js.Float.toString v)>
        <Label>"Amount"</Label>
        <Number_field.Group>
          <Number_field.Input /> <Number_field.Increment_button />
        </Number_field.Group>
      </Number_field>);
  let now () =
    Option.bind (T.query "[data-slot=number-field-input]") (fun input ->
        T.attribute input "aria-valuenow")
  in
  let rendered = now () in
  let* () =
    match T.query "[data-slot=number-field-increment-button]" with
    | Some b -> T.click (T.setup ()) b
    | None -> Js.Promise.resolve ()
  in
  Js.Promise.resolve (rendered, !told, now ())

let () =
  Jest.describe "Number_field, on its step's grid" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "steps by a tenth to a tenth, never near one" (fun () ->
          let* r = snapped ~min_value:0. ~step:0.1 0.2 in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "0.2", "0.3", Some "0.3")));
      Jest.testPromise "snaps a value halfway between steps up" (fun () ->
          let* r = snapped ~min_value:0. ~step:0.1 0.25 in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "0.3", "0.4", Some "0.4")));
      Jest.testPromise "stops at the last step below its maximum" (fun () ->
          let* r = snapped ~min_value:0. ~max_value:1. ~step:0.3 1. in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "0.9", "", Some "0.9")));
      Jest.testPromise "keeps a value off any grid while its step is none"
        (fun () ->
          let* r = snapped ~min_value:0. ~max_value:10. ~step:0. 5.5 in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "5.5", "", Some "5.5")));
      Jest.testPromise "keeps a value off the grid of a step it is not given"
        (fun () ->
          let* r = snapped ~min_value:0. 99.99 in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "99.99", "100", Some "100")));
      Jest.testPromise "steps a percent by a hundredth while given no step"
        (fun () ->
          let* r =
            snapped ~min_value:0. ~max_value:1.
              ~format_options:
                (Solidtype_kobalte.Types.NumberFormatOptions.make
                   ~style:`percent ())
              0.5
          in
          Js.Promise.resolve
            E.(expect r |> toEqual (Some "0.5", "0.51", Some "0.51"))))

let () =
  Jest.describe "Number_field, left" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "tells it is left once focus leaves it, as React's does"
        (fun () ->
          let solidtype =
            T.blurs ~root:"[data-slot=number-field]" (fun on_blur ->
                T.render (fun () ->
                    <Number_field on_blur>
                      <Label>"Width"</Label>
                      <Number_field.Group>
                        <Number_field.Decrement_button />
                        <Number_field.Input />
                        <Number_field.Increment_button />
                      </Number_field.Group>
                    </Number_field>))
          in
          T.cleanup ();
          let react =
            T.blurs ~root:"[data-slot=number-field]" (fun on_blur ->
                ignore
                  (Twin.render (props ~on_blur ()) (fun (_ : float) -> ())
                    : Dom.element))
          in
          Twin.cleanup ();
          E.(expect (solidtype, react) |> toEqual (1, 1))))
