(* HeroUI's Drawer on Kobalte's dialog, beside the same drawer in React: its
   trigger, the drawer, what has the focus and what is outside it, as the
   trigger is pressed, Tab moves within it, Escape closes it, a drag of its
   handle toward its edge closes it, a button with slot="close" closes it,
   and so does a press on the backdrop. *)

module Drawer = Solidtype_heroui.Drawer
module Button = Solidtype_heroui.Button
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?variant:([ `opaque | `blur | `transparent ][@mel.as "variant"]) ->
  ?is_dismissable:(bool[@mel.as "isDismissable"]) ->
  ?placement:([ `top | `bottom | `left | `right ][@mel.as "placement"]) ->
  ?custom:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/Drawer.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Drawer.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Drawer.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

type options

external options :
  pointer_events_check:(int[@mel.as "pointerEventsCheck"]) -> unit -> options
  = ""
[@@mel.obj]

(* A user whose press outside is let through Kobalte's modal, which takes
   pointer events from the rest of the page: in a browser the press lands on
   the backdrop, which Kobalte's layer reads as outside the dialog. *)
external setup : options -> T.user = "setup"
[@@mel.module "@testing-library/user-event"] [@@mel.scope "default"]

type coords
type action

external coords :
  client_x:(float[@mel.as "clientX"]) ->
  client_y:(float[@mel.as "clientY"]) ->
  unit ->
  coords = ""
[@@mel.obj]

external action :
  ?keys:string -> target:Dom.element -> coords:coords -> unit -> action = ""
[@@mel.obj]

external pointer_actions : T.user -> action array -> T.pointers Js.Promise.t
  = "pointer"
[@@mel.send]

(* The handle pressed, moved a hundred pixels toward the drawer's bottom edge
   and let go: past HeroUI's threshold, and past a third of a drawer jsdom
   gives no size. *)
let drag user handle =
  let* (_ : T.pointers) =
    pointer_actions user
      [|
        action ~keys:"[MouseLeft>]" ~target:handle
          ~coords:(coords ~client_x:10. ~client_y:10. ())
          ();
        action ~target:handle ~coords:(coords ~client_x:10. ~client_y:60. ()) ();
        action ~target:handle
          ~coords:(coords ~client_x:10. ~client_y:110. ())
          ();
        action ~keys:"[/MouseLeft]" ~target:handle
          ~coords:(coords ~client_x:10. ~client_y:110. ())
          ();
      |]
  in
  Js.Promise.resolve ()

(* A while for a framework's timers and focus moves to run. *)
let settle () =
  Js.Promise.make (fun ~resolve ~reject:_ ->
      let (_ : Js.Global.timeoutId) =
        Js.Global.setTimeout ~f:(fun () -> (resolve true [@u])) 20
      in
      ())
  |> Js.Promise.then_ (fun (_ : bool) -> Js.Promise.resolve ())

(* What one framework writes for itself: Kobalte's own state, present and
   empty, which no style of HeroUI's reads, and its trigger's popup, which
   React Aria's leaves out; React Aria's tabindex on what is focusable
   already, and the slot each of its parts is named for; the id each makes to
   name one part from another, and how each writes a style. A dismiss button
   only a reader finds is a [type="button"] here, where React Aria's would
   submit a form around the modal. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-expanded" | "data-closed"), Some "" -> true
  | "aria-haspopup", Some "dialog" -> true
  | ("tabindex" | "slot" | "style" | "aria-controls" | "aria-labelledby"), _ ->
      true
  | "type", _ ->
      Option.equal String.equal (T.attribute e "aria-label") (Some "Dismiss")
  | _ -> false

(* React Aria's dismiss button stands before the dialog, the port's at its
   start, where Kobalte's modal leaves it to a reader: each is shown by
   itself, after the rest. *)
let dismiss = "[aria-label=Dismiss], div:has(> [aria-label=Dismiss])"

(* An element: its tag, its attributes and its text. *)
let one e =
  String.concat " "
    [
      tag_name e;
      T.attributes_but
        (T.attribute_names e |> Array.to_list |> List.filter (framework_only e))
        e;
    ]
  ^ if element_count e > 0 then "" else " " ^ text e

let all selector = Js.Array.from (query_all T.body selector)

(* The trigger, the drawer and all inside it, wherever it is, whether what is
   outside it is read, and what has the focus. *)
let shown () =
  Array.concat
    [
      all
        "[data-slot=drawer-trigger], [data-slot=button]:not(.drawer__backdrop \
         *)";
      all
        (".drawer__backdrop, .drawer__backdrop *:not([data-focus-trap]):not("
       ^ dismiss ^ ")");
      all ".drawer__backdrop [aria-label=Dismiss]";
    ]
  |> Array.map one
  |> Fun.flip Array.append
       (all "[data-testid=outside]"
       |> Array.map (fun e ->
           match Js.Null.toOption (closest e "[aria-hidden=true], [inert]") with
           | Some _ -> "outside: hidden from a reader"
           | None -> "outside: read"))
  |> Fun.flip Array.append
       [|
         ("focus: "
         ^
         match Js.Null.toOption active with
         | Some e ->
             Option.value (T.attribute e "data-slot") ~default:(tag_name e)
         | None -> "none");
       |]

let first selector =
  match all selector with [||] -> T.body | found -> found.(0)

let trigger () =
  first
    "[data-slot=drawer-trigger], [data-slot=button]:not(.drawer__backdrop *)"

let walk ~step =
  let user = setup (options ~pointer_events_check:0 ()) in
  let seen = ref [] in
  let after name action =
    let* () =
      step (fun () ->
          let* () = action () in
          settle ())
    in
    seen := (name, shown ()) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "pressed" (fun () -> T.click user (trigger ())) in
  let* () = after "Tab" (fun () -> T.tab user) in
  let* () = after "Escape" (fun () -> T.keyboard user "{Escape}") in
  let* () = after "pressed again" (fun () -> T.click user (trigger ())) in
  let* () =
    after "handle dragged" (fun () ->
        drag user (first "[data-slot=drawer-handle]"))
  in
  let* () =
    after "pressed a second time" (fun () -> T.click user (trigger ()))
  in
  let* () =
    after "Continue" (fun () ->
        T.click user (first ".drawer__footer [data-slot=button]"))
  in
  let* () =
    after "pressed a third time" (fun () -> T.click user (trigger ()))
  in
  let* () =
    after "backdrop pressed" (fun () ->
        T.click user (first ".drawer__backdrop"))
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?variant ?is_dismissable ?placement ?(custom = false) () =
  T.render (fun () ->
      <div>
        <p data_testid="outside">"Outside"</p>
        <Drawer>
          (fun () ->
            if custom then
              Solidtype.Jsx.element
                <Drawer.Trigger aria_label="Open">
                  <span>"Card"</span>
                </Drawer.Trigger>
            else
              Solidtype.Jsx.element
                <Button variant=`secondary>"Open Drawer"</Button>)
          <Drawer.Backdrop
            ?variant=(fun () -> variant)
            ?is_dismissable=(fun () -> is_dismissable)>
            <Drawer.Content ?placement=(fun () -> placement)>
              <Drawer.Dialog>
                <Drawer.Handle />
                <Drawer.Close_trigger />
                <Drawer.Header>
                  <Drawer.Heading>"Drawer Title"</Drawer.Heading>
                </Drawer.Header>
                <Drawer.Body>
                  <p>
                    "This is a bottom drawer built with React Aria's Modal \
                     component."
                  </p>
                </Drawer.Body>
                <Drawer.Footer>
                  <Button slot=`close>"Continue"</Button>
                </Drawer.Footer>
              </Drawer.Dialog>
            </Drawer.Content>
          </Drawer.Backdrop>
        </Drawer>
      </div>);
  let* solidtype = walk ~step:(fun action -> action ()) in
  T.cleanup ();
  let (_ : Dom.element) =
    Twin.render (props ?variant ?is_dismissable ?placement ~custom ())
  in
  let* react = walk ~step:Twin.step in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

let () =
  Jest.describe "Drawer" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "opens, and closes each way, as React's does" (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "stays open, not dismissable, nor dragged, as React's"
        (fun () ->
          let* r = both ~is_dismissable:false ~variant:`blur () in
          same r);
      Jest.testPromise "slides from its edge, as React's" (fun () ->
          let* r = both ~placement:`top () in
          same r);
      Jest.testPromise "opens on a trigger of its own, as React's" (fun () ->
          let* r = both ~custom:true () in
          same r);
      Jest.testPromise "closes as its handle is dragged toward its edge"
        (fun () ->
          T.render (fun () ->
              <Drawer default_open=true>
                <Drawer.Backdrop>
                  <Drawer.Content>
                    <Drawer.Dialog>
                      <Drawer.Handle />
                      <Drawer.Heading>"Drawer Title"</Drawer.Heading>
                    </Drawer.Dialog>
                  </Drawer.Content>
                </Drawer.Backdrop>
              </Drawer>);
          let* () = settle () in
          let before = Array.length (all "[role=dialog]") in
          let* () =
            drag
              (setup (options ~pointer_events_check:0 ()))
              (first "[data-slot=drawer-handle]")
          in
          let* () = settle () in
          Js.Promise.resolve
            E.(
              expect (before, Array.length (all "[role=dialog]"))
              |> toEqual (1, 0))))
