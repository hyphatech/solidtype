(* HeroUI's Switch on Kobalte, beside the same Switch in React: each part by
   its slot -- the field, its clickable content, the control, the thumb, the
   label -- what HeroUI's styles read of it, the input a reader reaches, and
   the state the field and its content show through a walk. *)

module Switch = Solidtype_heroui.Switch
module Label = Solidtype_heroui.Label
module Form = Solidtype_heroui.Form
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  size:[ `sm | `md | `lg ] ->
  default_selected:(bool[@mel.as "defaultSelected"]) ->
  is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?is_invalid:(bool[@mel.as "isInvalid"]) ->
  is_read_only:(bool[@mel.as "isReadOnly"]) ->
  is_required:(bool[@mel.as "isRequired"]) ->
  name:string ->
  ?aria_label:(string[@mel.as "aria-label"]) ->
  ?on_blur:((Dom.focusEvent -> unit)[@mel.as "onBlur"]) ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> unit = "render" [@@mel.module "./twins/Switch.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Switch.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Switch.tsx"]
end

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external checked : Dom.element -> bool = "checked" [@@mel.get]
external prevent_default : Dom.event -> unit = "preventDefault" [@@mel.send]
external active : Dom.element = "activeElement" [@@mel.scope "document"]

let part slot =
  match T.query ("[data-slot=" ^ slot ^ "]") with
  | Some e -> e
  | None -> Js.Exn.raiseError ("no " ^ slot)

(* What HeroUI's styles read of each part, and what a reader reaches. *)
let shown () =
  let parts =
    [| "switch"; "switch-content"; "switch-control"; "switch-thumb"; "label" |]
    |> Array.map (fun slot ->
        let e = part slot in
        ( slot,
          tag_name e,
          T.class_name e,
          T.attribute e "data-selected",
          T.attribute e "data-disabled",
          ( T.attribute e "data-readonly",
            T.attribute e "data-required",
            T.attribute e "data-invalid" ) ))
  in
  let input = T.by_role "switch" in
  ( parts,
    ( checked input,
      T.attribute input "disabled",
      ( T.attribute input "name",
        T.attribute input "required",
        T.attribute input "aria-label",
        T.attribute input "aria-invalid" ) ) )

(* The port, then the same Switch in React, each alone on the page, shown,
   then walked by its content, the field's state after each step too. *)
let both ?(read_only = false) ?(required = false) ?(invalid = false) ?aria_label
    ~size ~selected ~disabled () =
  let walk () =
    let shown_before = shown () in
    let content = part "switch-content" in
    let* walked = T.walk ~step:Twin.step content in
    let field = T.state (part "switch") in
    Js.Promise.resolve (shown_before, walked, field)
  in
  T.render (fun () ->
      <Switch
        size=(fun () -> size)
        default_selected=(fun () -> selected)
        is_disabled=(fun () -> disabled)
        is_invalid=(fun () -> invalid)
        is_read_only=(fun () -> read_only)
        is_required=(fun () -> required)
        name="wifi"
        ?aria_label=(fun () -> aria_label)>
        <Switch.Content>
          <Switch.Control><Switch.Thumb /></Switch.Control>
          <Label>"Wi-Fi"</Label>
        </Switch.Content>
      </Switch>);
  let* solidtype = walk () in
  T.cleanup ();
  Twin.render
    (props ~size ~default_selected:selected ~is_disabled:disabled
       ~is_invalid:invalid ~is_read_only:read_only ~is_required:required
       ~name:"wifi" ?aria_label ());
  let* react = walk () in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Switch" (fun () ->
      Jest.testPromise "is HeroUI's switch, off, and walked as React Aria's"
        (fun () ->
          let* solidtype, react =
            both ~size:`md ~selected:false ~disabled:false ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is on, large, as React Aria's is" (fun () ->
          let* solidtype, react =
            both ~size:`lg ~selected:true ~disabled:false ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is invalid as React's is" (fun () ->
          let* solidtype, react =
            both ~invalid:true ~size:`md ~selected:false ~disabled:false ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is disabled as React Aria's is" (fun () ->
          let* solidtype, react =
            both ~size:`sm ~selected:true ~disabled:true ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is read-only, required and named as React Aria's is"
        (fun () ->
          let* solidtype, react =
            both ~read_only:true ~required:true ~aria_label:"Wireless" ~size:`md
              ~selected:true ~disabled:false ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react)))

let () =
  Jest.describe "Switch, left" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "tells it is left once focus leaves it, as React's does"
        (fun () ->
          let solidtype =
            T.blurs ~root:"[data-slot=switch]" (fun on_blur ->
                T.render (fun () ->
                    <Switch on_blur>
                      <Switch.Content>
                        <Switch.Control><Switch.Thumb /></Switch.Control>
                        <Label>"Wi-Fi"</Label>
                      </Switch.Content>
                    </Switch>))
          in
          T.cleanup ();
          let react =
            T.blurs ~root:"[data-slot=switch]" (fun on_blur ->
                Twin.render
                  (props ~size:`md ~default_selected:false ~is_disabled:false
                     ~is_read_only:false ~is_required:false ~name:"wifi"
                     ~on_blur ()))
          in
          Twin.cleanup ();
          E.(expect (solidtype, react) |> toEqual (1, 1)));
      Jest.testPromise
        "takes its parts' attributes, calling a caller's refs and handlers \
         beside its own" (fun () ->
          let refs = ref 0 and outs = ref 0 in
          let content_refs = ref 0 and clicks = ref 0 in
          let blurs =
            T.blurs ~root:"[data-slot=switch]" (fun on_blur ->
                T.render (fun () ->
                    <Form on_submit=prevent_default>
                      <Switch
                        name="wifi"
                        is_invalid=true
                        on_blur
                        title="Wireless"
                        style="--x: 1"
                        ref=(fun _ -> incr refs)
                        on_focus_out=(fun _ -> incr outs)>
                        <Switch.Content
                          title="Toggles"
                          style="--y: 2"
                          ref=(fun _ -> incr content_refs)
                          on_click=(fun _ -> incr clicks)>
                          <Switch.Control><Switch.Thumb /></Switch.Control>
                          <Label>"Wi-Fi"</Label>
                        </Switch.Content>
                      </Switch>
                      <button data_slot="button" type_=`submit>"Save"</button>
                    </Form>))
          in
          (* Counted before the switch is toggled: Kobalte's parts give their
             ref again as their state changes. *)
          let left = !outs and given = (!refs, !content_refs) in
          let user = T.setup () in
          let root = part "switch" and content = part "switch-content" in
          let* () = T.hover user content in
          let hovered = T.attribute content "data-hovered" in
          let* () = T.click user content in
          let selected = T.attribute root "data-selected" in
          let* () = T.click user (part "button") in
          Js.Promise.resolve
            E.(
              expect
                ( (T.attribute root "title", T.attribute root "style"),
                  (T.attribute content "title", T.attribute content "style"),
                  (blurs, left, given, active == T.by_role "switch"),
                  (hovered, selected, !clicks) )
              |> toEqual
                   ( (Some "Wireless", Some "--x: 1;"),
                     (Some "Toggles", Some "--y: 2;"),
                     (1, 1, (1, 1), true),
                     (* The label's click, and its input's, which bubbles
                        through the label. *)
                     (Some "true", Some "true", 2) ))))
