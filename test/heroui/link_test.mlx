(* HeroUI's Link on Kobalte, beside the same Link in React: what its styles
   read of the link and its icon, and the state it shows through a walk of
   hover, press, Tab, Enter and Space, which presses a button but not a
   link. *)

module Link = Solidtype_heroui.Link
module E = Jest.Expect
module T = Testing
open Testing.Syntax

module Twin = struct
  external render : bool -> Dom.element = "render"
  [@@mel.module "./twins/Link.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Link.tsx"]

  external render_of_state : bool -> bool -> Dom.element = "renderOfState"
  [@@mel.module "./twins/Link.tsx"]

  external cleanup : unit -> unit = "cleanup" [@@mel.module "./twins/Link.tsx"]
end

(* The walk on a link whose children are drawn of its state, as words, and
   whether it is marked current: what each side's function was given. *)
let of_state ~disabled ~current =
  T.render (fun () ->
      <Link
        href="#top"
        is_disabled=(fun () -> disabled)
        ?aria_current=(fun () -> if current then Some "page" else None)>
        (fun s ->
          <span>
            (fun () ->
              Solidtype.Jsx.string
                (T.words
                   [
                     ("current", s.is_current);
                     ("hovered", s.is_hovered);
                     ("pressed", s.is_pressed);
                     ("focused", s.is_focused);
                     ("focus-visible", s.is_focus_visible);
                     ("disabled", s.is_disabled);
                   ]))
          </span>)
      </Link>);
  let marked link = T.attribute link "data-current" in
  let link = T.by_role "link" in
  let* solidtype = T.walk ~read:T.text_content ~step:Twin.step link in
  let solidtype = (solidtype, marked link) in
  T.cleanup ();
  let link = Twin.render_of_state disabled current in
  let* react = T.walk ~read:T.text_content ~step:Twin.step link in
  let react = (react, marked link) in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

(* What HeroUI's styles read of the link and of its icon. *)
let shown link =
  let icon = T.query "[data-slot=link-icon]" in
  ( T.class_name link,
    T.attribute link "aria-disabled",
    Option.map
      (fun i ->
        ( T.class_name i,
          T.attribute i "data-default-icon",
          Option.is_some (T.query "[data-slot=link-default-icon]") ))
      icon )

(* The port, then the same Link in React, each alone on the page, shown and
   walked. *)
let both ~disabled =
  T.render (fun () ->
      <Link href="#top" is_disabled=(fun () -> disabled)>
        "HeroUI" <Link.Icon />
      </Link>);
  let link = T.by_role "link" in
  let solidtype = shown link in
  let* solidtype_walk = T.walk ~step:Twin.step link in
  T.cleanup ();
  let link = Twin.render disabled in
  let react = shown link in
  let* react_walk = T.walk ~step:Twin.step link in
  Twin.cleanup ();
  Js.Promise.resolve ((solidtype, solidtype_walk), (react, react_walk))

let () =
  Jest.describe "Link" (fun () ->
      Jest.testPromise "is HeroUI's link, and shows its state as React Aria"
        (fun () ->
          let* solidtype, react = both ~disabled:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is disabled as React Aria's is" (fun () ->
          let* solidtype, react = both ~disabled:true in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its state, as React's" (fun () ->
          let* solidtype, react = of_state ~disabled:false ~current:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "is current as its aria-current says, as React's"
        (fun () ->
          let* solidtype, react = of_state ~disabled:false ~current:true in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its children of its state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true ~current:false in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise
        "takes its element's attributes, calling a caller's ref beside its own"
        (fun () ->
          let refs = ref 0 in
          T.render (fun () ->
              <Link
                href="#top" title="Top" style="--x: 1" ref=(fun _ -> incr refs)>
                "HeroUI"
              </Link>);
          let user = T.setup () in
          let link = T.by_role "link" in
          let* () = T.hover user link in
          Js.Promise.resolve
            E.(
              expect
                ( T.attribute link "title",
                  T.attribute link "style",
                  T.attribute link "data-hovered",
                  !refs )
              |> toEqual (Some "Top", Some "--x: 1;", Some "true", 1))))
