(* HeroUI's Popover on Kobalte's, beside the same popover in React: its
   trigger, the popover, what has the focus and what is outside it, as the
   trigger is pressed, Tab moves within it, Escape closes it, and a press
   outside closes it again. *)

module Popover = Solidtype_heroui.Popover
module Button = Solidtype_heroui.Button
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?placement:([ `top | `bottom | `left | `right ][@mel.as "placement"]) ->
  ?arrow:bool ->
  ?custom:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/Popover.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/Popover.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/Popover.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

type options

external options :
  pointer_events_check:(int[@mel.as "pointerEventsCheck"]) -> unit -> options
  = ""
[@@mel.obj]

(* A user whose press outside is let through Kobalte's modal, which takes
   pointer events from the rest of the page: in a browser the press lands on
   the page's root, which Kobalte's layer also reads as outside. *)
external setup : options -> T.user = "setup"
[@@mel.module "@testing-library/user-event"] [@@mel.scope "default"]

(* A while for a framework's timers and focus moves to run. *)
let settle () =
  Js.Promise.make (fun ~resolve ~reject:_ ->
      let (_ : Js.Global.timeoutId) =
        Js.Global.setTimeout ~f:(fun () -> (resolve true [@u])) 20
      in
      ())
  |> Js.Promise.then_ (fun (_ : bool) -> Js.Promise.resolve ())

(* What one framework writes for itself: Kobalte's own state, present and
   empty, which no style of HeroUI's reads, and its trigger's popup, which
   React Aria's leaves out; React Aria's tabindex on what is focusable
   already, its heading's slot and its arrow's default class; the id each
   makes to name one part from another, and how each writes a style. And
   the dialog's role, name and focus, which Kobalte's content keeps and
   React Aria's section takes. A dismiss button only a reader finds is a
   [type="button"] here, where React Aria's would submit a form around the
   popover. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ("data-expanded" | "data-closed"), Some "" -> true
  | "aria-haspopup", Some "dialog" -> true
  | "tabindex", _ -> true
  | "type", _ -> Option.is_some (T.attribute e "aria-label")
  | ("role" | "aria-labelledby" | "aria-controls"), _ -> true
  | ("slot" | "style" | "dir" | "data-trigger"), _ -> true
  | "class", Some "react-aria-OverlayArrow" -> true
  | _ -> false

(* An element: its tag, its attributes and its text. *)
let one e =
  String.concat " "
    [
      tag_name e;
      T.attributes_but
        (T.attribute_names e |> Array.to_list |> List.filter (framework_only e))
        e;
    ]
  ^ if element_count e > 0 then "" else " " ^ text e

let all selector = Js.Array.from (query_all T.body selector)

(* The trigger, the popover and all inside it, wherever it is, what is outside
   it, and what has the focus. *)
let shown () =
  Array.concat
    [
      all "[data-slot=popover-trigger], [data-slot=button]";
      all
        ".popover, .popover \
         *:not([data-focus-trap]):not([aria-hidden=true]):not([aria-hidden=true] \
         *)";
    ]
  |> Array.map one
  |> Fun.flip Array.append
       (all "[data-testid=outside]"
       |> Array.map (fun e ->
           match Js.Null.toOption (closest e "[aria-hidden=true], [inert]") with
           | Some _ -> "outside: hidden from a reader"
           | None -> "outside: read"))
  |> Fun.flip Array.append
       [|
         ("focus: "
         ^
         match Js.Null.toOption active with
         | Some e ->
             Option.value (T.attribute e "data-slot") ~default:(tag_name e)
         | None -> "none");
       |]

let trigger () =
  match all "[data-slot=popover-trigger], [data-slot=button]" with
  | [||] -> T.body
  | found -> found.(0)

let walk ~step =
  let user = setup (options ~pointer_events_check:0 ()) in
  let seen = ref [] in
  let after name action =
    let* () =
      step (fun () ->
          let* () = action () in
          settle ())
    in
    seen := (name, shown ()) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "pressed" (fun () -> T.click user (trigger ())) in
  let* () = after "Tab" (fun () -> T.tab user) in
  let* () = after "Escape" (fun () -> T.keyboard user "{Escape}") in
  let* () = after "pressed again" (fun () -> T.click user (trigger ())) in
  let* () =
    after "pressed outside" (fun () ->
        match all "[data-testid=outside]" with
        | [||] -> Js.Promise.resolve ()
        | found -> T.click user found.(0))
  in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?placement ?(arrow = false) ?(custom = false) () =
  T.render (fun () ->
      <div>
        <p data_testid="outside">"Outside"</p>
        <Popover>
          (fun () ->
            if custom then
              Solidtype.Jsx.element
                <Popover.Trigger aria_label="Profile">
                  <span>"Sarah"</span>
                </Popover.Trigger>
            else Solidtype.Jsx.element <Button>"Click me"</Button>)
          <Popover.Content ?placement=(fun () -> placement) should_flip=false>
            <Popover.Dialog>
              (fun () ->
                if arrow then Solidtype.Jsx.element <Popover.Arrow />
                else Solidtype.Jsx.element Solidtype.Jsx.nothing)
              <Popover.Heading>"Popover Title"</Popover.Heading>
              <p>"This is the popover content."</p>
              <Button size=`sm>"Follow"</Button>
            </Popover.Dialog>
          </Popover.Content>
        </Popover>
      </div>);
  let* solidtype = walk ~step:(fun action -> action ()) in
  T.cleanup ();
  let (_ : Dom.element) = Twin.render (props ?placement ~arrow ~custom ()) in
  let* react = walk ~step:Twin.step in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

let () =
  Jest.describe "Popover" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "opens on a button, as React's does" (fun () ->
          let* r = both () in
          same r);
      Jest.testPromise "draws its arrow above, as React's" (fun () ->
          let* r = both ~placement:`top ~arrow:true () in
          same r);
      Jest.testPromise "opens on a trigger of its own, as React's" (fun () ->
          let* r = both ~custom:true () in
          same r);
      Jest.testPromise "is a dialog its heading names, its buttons buttons"
        (fun () ->
          T.render (fun () ->
              <Popover default_open=true>
                <Button>"Click me"</Button>
                <Popover.Content>
                  <Popover.Dialog>
                    <Popover.Heading>"Popover Title"</Popover.Heading>
                    <Button>"Follow"</Button>
                  </Popover.Dialog>
                </Popover.Content>
              </Popover>);
          let* () = settle () in
          let dialog = T.by_role "dialog" in
          let named =
            match T.attribute dialog "aria-labelledby" with
            | Some id -> (
                match all ("#" ^ id) with [| h |] -> text h | _ -> "")
            | None -> ""
          in
          let follow =
            Js.Array.from (query_all dialog "[data-slot=button]")
            |> Array.map (fun b -> T.attribute b "aria-haspopup")
          in
          Js.Promise.resolve
            E.(expect (named, follow) |> toEqual ("Popover Title", [| None |]))))
