(* HeroUI's InputGroup, beside the same group in React: every part, alone and
   in a text field, which names and describes which, and its state as it is
   hovered, clicked beside its input and typed in. *)

module Description = Solidtype_heroui.Description
module Input_group = Solidtype_heroui.Input_group
module Label = Solidtype_heroui.Label
module Text_field = Solidtype_heroui.Text_field
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?variant:string ->
  ?full_width:(bool[@mel.as "fullWidth"]) ->
  in_field:(bool[@mel.as "inField"]) ->
  multiline:bool ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> Dom.element = "render"
  [@@mel.module "./twins/InputGroup.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/InputGroup.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/InputGroup.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external value_of : Dom.element -> string = "value" [@@mel.get]
external text : Dom.element -> string = "textContent" [@@mel.get]
external element_count : Dom.element -> int = "childElementCount" [@@mel.get]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external by_id : string -> Dom.element Js.null = "getElementById"
[@@mel.scope "document"]

let linked value =
  String.split_on_char ' ' value
  |> List.filter (fun id -> String.length id > 0)
  |> List.map (fun id ->
      match Js.Null.toOption (by_id id) with
      | Some e -> Option.value (T.attribute e "data-slot") ~default:"?"
      | None -> "missing")
  |> String.concat " "

let references = [ "for"; "aria-labelledby"; "aria-describedby" ]

(* What Kobalte writes that React Aria does not, and no style of HeroUI's
   reads, and what React Aria writes for itself: as a text field's test
   holds. *)
let framework_only e name =
  match (name, T.attribute e name) with
  | ( ( "data-valid" | "data-invalid" | "data-required" | "data-disabled"
      | "data-readonly" ),
      Some "" ) ->
      true
  | ("aria-required" | "aria-disabled" | "aria-readonly"), Some _ -> true
  | ("value" | "tabindex"), _ -> true
  | "role", Some "group" ->
      Option.equal String.equal (T.attribute e "data-slot") (Some "textfield")
  | _ -> false

let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let named =
        references
        |> List.filter_map (fun name ->
            Option.map (fun v -> name ^ "->" ^ linked v) (T.attribute e name))
      in
      String.concat " "
        (tag_name e
        :: T.attributes_but
             (("id" :: references)
             @ (T.attribute_names e |> Array.to_list
               |> List.filter (framework_only e)))
             e
        :: named)
      ^
      match tag_name e with
      | "INPUT" | "TEXTAREA" -> " value=" ^ value_of e
      | _ when element_count e > 0 -> ""
      | _ -> " " ^ text e)

let focused () =
  match Js.Null.toOption active with
  | Some e -> Option.value (T.attribute e "data-slot") ~default:(tag_name e)
  | None -> "nothing"

(* The group as it is rendered, hovered, clicked on its prefix, which gives
   its input the focus, and typed in. *)
let walk ~step host =
  let user = T.setup () in
  let part slot =
    match Js.Null.toOption (query host ("[data-slot=" ^ slot ^ "]")) with
    | Some e -> e
    | None -> host
  in
  let seen = ref [] in
  let after name action =
    let* () = step action in
    seen := (name, shown host, focused ()) :: !seen;
    Js.Promise.resolve ()
  in
  let* () = after "rendered" Js.Promise.resolve in
  let* () = after "hovered" (fun () -> T.hover user (part "input-group")) in
  let* () =
    after "prefix clicked" (fun () -> T.click user (part "input-group-prefix"))
  in
  let* () = after "typed in" (fun () -> T.keyboard user "ui") in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?variant ?full_width ~in_field ~multiline () =
  let group () =
    <Input_group
      ?variant=(fun () -> variant) ?full_width=(fun () -> full_width)>
      <Input_group.Prefix>"https://"</Input_group.Prefix>
      (fun () ->
        if multiline then
          Solidtype.Jsx.element
            <Input_group.Text_area
              ?aria_label=(fun () -> if in_field then None else Some "Note")
              placeholder="note"
            />
        else
          Solidtype.Jsx.element
            <Input_group.Input
              ?aria_label=(fun () -> if in_field then None else Some "Site")
              placeholder="heroui"
            />)
      <Input_group.Suffix>".com"</Input_group.Suffix>
    </Input_group>
  in
  T.render (fun () ->
      if in_field then
        <Text_field name="site">
          <Label>"Site"</Label>
          (fun () -> Solidtype.Jsx.element (group ()))
          <Description>"Your site."</Description>
        </Text_field>
      else group ());
  let host =
    match T.query "[data-slot]" with
    | Some e -> Option.value (Js.Null.toOption (parent e)) ~default:T.body
    | None -> T.body
  in
  let* solidtype = walk ~step:(fun action -> action ()) host in
  T.cleanup ();
  let host =
    Twin.render
      (props
         ?variant:
           (Option.map
              (function `primary -> "primary" | `secondary -> "secondary")
              variant)
         ?full_width ~in_field ~multiline ())
  in
  let* react = walk ~step:Twin.step host in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let same (solidtype, react) =
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

let () =
  Jest.describe "Input_group" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "is an input with its prefix and suffix, as React's"
        (fun () ->
          let* r = both ~in_field:false ~multiline:false () in
          same r);
      Jest.testPromise "is secondary and full width, as React's is" (fun () ->
          let* r =
            both ~variant:`secondary ~full_width:true ~in_field:false
              ~multiline:false ()
          in
          same r);
      Jest.testPromise "is a field's input, as React's is" (fun () ->
          let* r = both ~in_field:true ~multiline:false () in
          same r);
      Jest.testPromise "is a text area, as React's is" (fun () ->
          let* r = both ~in_field:true ~multiline:true () in
          same r))
