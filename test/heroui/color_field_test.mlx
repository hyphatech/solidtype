(* HeroUI's ColorField on Kobalte's, beside the same field in React: every
   part, its classes and state, what its input shows, and the colour told, as
   a hex is typed and committed, a hex is stepped by the keys and the wheel, and
   a channel by the keys. React Aria's channel never turns on the wheel, which
   waits for a focus on a group its field never draws; the headless fixes test
   holds the channel's wheel. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Color_field = Solidtype_heroui.Color_field
module Color_swatch = Solidtype_heroui.Color_swatch
module Description = Solidtype_heroui.Description
module Field_error = Solidtype_heroui.Field_error
module Form = Solidtype_heroui.Form
module Label = Solidtype_heroui.Label
module Colors = Solidtype_kobalte.Colors
module Color = Solidtype_kobalte.Types.Color
module E = Jest.Expect
module T = Testing
open Testing.Syntax

type props

external props :
  ?channel:string ->
  ?default_value:(string[@mel.as "defaultValue"]) ->
  ?placeholder:string ->
  ?variant:string ->
  ?is_disabled:(bool[@mel.as "isDisabled"]) ->
  ?is_invalid:(bool[@mel.as "isInvalid"]) ->
  ?is_required:(bool[@mel.as "isRequired"]) ->
  ?swatch:bool ->
  ?suffix:string ->
  ?description:string ->
  ?error:string ->
  unit ->
  props = ""
[@@mel.obj]

module Twin = struct
  external render : props -> ((string -> unit)[@mel.uncurry]) -> Dom.element
    = "render"
  [@@mel.module "./twins/ColorField.tsx"]

  external step :
    ((unit -> unit Js.Promise.t)[@mel.uncurry]) -> unit Js.Promise.t = "step"
  [@@mel.module "./twins/ColorField.tsx"]

  external render_of_state : bool -> bool -> bool -> bool -> Dom.element
    = "renderOfState"
  [@@mel.module "./twins/ColorField.tsx"]

  external cleanup : unit -> unit = "cleanup"
  [@@mel.module "./twins/ColorField.tsx"]
end

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]
external active : Dom.element = "activeElement" [@@mel.scope "document"]
external prevent_default : Dom.event -> unit = "preventDefault" [@@mel.send]
external text : Dom.element -> string = "textContent" [@@mel.get]
external value_of : Dom.element -> string = "value" [@@mel.get]

type wheel_init

external wheel_init :
  delta_y:(float[@mel.as "deltaY"]) ->
  bubbles:bool ->
  cancelable:bool ->
  unit ->
  wheel_init = ""
[@@mel.obj]

external wheel_event : (_[@mel.as "wheel"]) -> wheel_init -> Dom.event
  = "WheelEvent"
[@@mel.new]

external dispatch : Dom.element -> Dom.event -> bool = "dispatchEvent"
[@@mel.send]

(* What HeroUI's styles read and a reader reaches of each part. Ids, and what
   each framework writes for itself, are left out. *)
let state =
  [
    "data-slot";
    "class";
    "data-channel";
    "role";
    "aria-invalid";
    "aria-valuenow";
    "aria-valuetext";
    "disabled";
    "readonly";
    "placeholder";
    "data-required";
    "data-invalid";
    "data-disabled";
    "data-readonly";
    "data-focus-within";
    "data-focused";
    "data-focus-visible";
  ]

(* Kobalte's field is a group, which React Aria's is not; and Kobalte's
   channel input a spin button, React Aria's a text input, each an accessible
   pattern: the field's role, and the channel input's, are left out, its value
   compared by what it shows. *)
let shown host =
  Js.Array.from (query_all host "[data-slot]")
  |> Array.map (fun e ->
      let slot = Option.value (T.attribute e "data-slot") ~default:"" in
      let channel_input =
        String.equal slot "color-input-group-input"
        && not
             (Option.equal String.equal (T.attribute e "role") (Some "textbox"))
      in
      String.concat " "
        (tag_name e
        :: List.filter_map
             (fun name ->
               match T.attribute e name with
               | Some "" | None -> None
               | Some _
                 when String.equal slot "color-field"
                      && String.equal name "role" ->
                   None
               | Some _
                 when channel_input
                      && List.exists (String.equal name)
                           [ "role"; "aria-valuenow"; "aria-valuetext" ] ->
                   None
               | Some v -> Some (name ^ "=" ^ v))
             state)
      ^
      match tag_name e with
      | "INPUT" ->
          (* Required, as React Aria's input says it natively and Kobalte's
             by ARIA, one fact to a reader. *)
          (if
             Option.is_some (T.attribute e "required")
             || Option.equal String.equal
                  (T.attribute e "aria-required")
                  (Some "true")
           then " required"
           else "")
          ^ " value=" ^ value_of e
      | "LABEL" | "SPAN" -> " " ^ text e
      | _ -> "")

let input host =
  match Js.Array.from (query_all host "input:not([type=hidden])") with
  | [||] -> Js.Exn.raiseError "no input"
  | inputs -> inputs.(0)

let walk ~keys ~step host told =
  let user = T.setup () in
  let seen = ref [ (shown host, !told) ] in
  let rec go = function
    | [] -> Js.Promise.resolve ()
    | k :: rest ->
        let* () =
          step (fun () ->
              match k with
              | "click" -> T.click user (input host)
              | "wheel" ->
                  ignore
                    (dispatch (input host)
                       (wheel_event
                          (wheel_init ~delta_y:1. ~bubbles:true ~cancelable:true
                             ()))
                      : bool);
                  Js.Promise.resolve ()
              | k -> T.keyboard user k)
        in
        seen := (shown host, !told) :: !seen;
        go rest
  in
  let* () = go keys in
  Js.Promise.resolve (Array.of_list (List.rev !seen))

let both ?channel ?default_value ?placeholder ?variant ?(is_disabled = false)
    ?(is_invalid = false) ?(is_required = false) ?(swatch = false) ?suffix
    ?description ?error ~keys () =
  let told = ref "" in
  T.render (fun () ->
      <Color_field
        ?channel=(fun () ->
                   Option.map
                     (function
                       | "saturation" -> `saturation
                       | "lightness" -> `lightness
                       | _ -> `hue)
                     channel)
        ?color_space=(fun () -> Option.map (fun _ -> `hsl) channel)
        class_="w-[280px]"
        ?default_value=(fun () -> Option.map Colors.parse_color default_value)
        name="color"
        is_disabled=(fun () -> is_disabled)
        is_invalid=(fun () -> is_invalid)
        is_required=(fun () -> is_required)
        on_change=(fun c ->
                    told :=
                      match c with
                      | Some c -> Color.to_string c ~format:`hex ()
                      | None -> "(empty)")>
        <Label>"Color"</Label>
        <Color_field.Group
          ?variant=(fun () ->
                     Option.map
                       (function "secondary" -> `secondary | _ -> `primary)
                       variant)>
          (fun () ->
            if swatch then
              Jsx.element
                <Color_field.Prefix>
                  <Color_swatch
                    color=(fun () -> Colors.parse_color "#0485F7") size=`xs
                  />
                </Color_field.Prefix>
            else Jsx.string "")
          <Color_field.Input ?placeholder=(fun () -> placeholder) />
          (fun () ->
            match suffix with
            | Some s ->
                Jsx.element
                  <Color_field.Suffix>
                    <span class_="text-sm text-muted">
                      (fun () -> Jsx.string s)
                    </span>
                  </Color_field.Suffix>
            | None -> Jsx.string "")
        </Color_field.Group>
        (fun () ->
          match description with
          | Some d ->
              Jsx.element <Description>(fun () -> Jsx.string d)</Description>
          | None -> Jsx.string "")
        (fun () ->
          match error with
          | Some m ->
              Jsx.element <Field_error>(fun () -> Jsx.string m)</Field_error>
          | None -> Jsx.string "")
      </Color_field>);
  let* solidtype = walk ~keys ~step:(fun action -> action ()) T.body told in
  T.cleanup ();
  let told' = ref "" in
  let host =
    Twin.render
      (props ?channel ?default_value ?placeholder ?variant ~is_disabled
         ~is_invalid ~is_required ~swatch ?suffix ?description ?error ())
      (fun c -> told' := c)
  in
  let* react = walk ~keys ~step:Twin.step host told' in
  Twin.cleanup ();
  Js.Promise.resolve E.(expect solidtype |> toEqual react)

(* A field whose root and group draw their children of their state, as
   words. *)
let draw_of_state ~disabled ~read_only ~invalid ~required =
  let words name flags =
    <span data_words=(fun () -> Solidtype.Jsx.data name)>
      (fun () -> Solidtype.Jsx.string (T.words flags))
    </span>
  in
  T.render (fun () ->
      <Color_field
        aria_label="Field"
        is_disabled=(fun () -> disabled)
        is_read_only=(fun () -> read_only)
        is_invalid=(fun () -> invalid)
        is_required=(fun () -> required)>
        (fun r ->
          Solidtype.Jsx.fragment
            [|
              words "field"
                [
                  ("disabled", r.is_disabled);
                  ("invalid", r.is_invalid);
                  ("read-only", r.is_read_only);
                  ("required", r.is_required);
                ];
              <Color_field.Group>
                (fun g ->
                  Solidtype.Jsx.fragment
                    [|
                      words "group"
                        [
                          ("hovered", g.is_hovered);
                          ("focus-within", g.is_focus_within);
                          ("focus-visible", g.is_focus_visible);
                          ("disabled", g.is_disabled);
                          ("invalid", g.is_invalid);
                        ];
                      <Color_field.Input />;
                    |])
              </Color_field.Group>;
            |])
      </Color_field>)

(* What it writes, beside React's, then a glance at its group. *)
let of_state ?(disabled = false) ?(read_only = false) ?(invalid = false)
    ?(required = false) () =
  draw_of_state ~disabled ~read_only ~invalid ~required;
  let* solidtype =
    T.glance ~read:T.words_shown ~step:Twin.step (T.slot "color-input-group")
  in
  T.cleanup ();
  let* react =
    T.glance ~read:T.words_shown ~step:Twin.step
      (Twin.render_of_state disabled read_only invalid required)
  in
  Twin.cleanup ();
  Js.Promise.resolve (solidtype, react)

let () =
  Jest.describe "Color_field" (fun () ->
      Jest.testPromise "draws its parts' children of their state, as React's"
        (fun () ->
          let* solidtype, react = of_state () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise "draws its parts' children of their state while disabled"
        (fun () ->
          let* solidtype, react = of_state ~disabled:true () in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.testPromise
        "draws its parts' children of their state, read-only, invalid, required"
        (fun () ->
          let* solidtype, react =
            of_state ~read_only:true ~invalid:true ~required:true ()
          in
          Js.Promise.resolve E.(expect solidtype |> toEqual react));
      Jest.afterEach T.cleanup;
      Jest.testPromise "commits a hex typed, as React's does" (fun () ->
          both ~default_value:"#0485F7" ~swatch:true
            ~keys:
              [
                "click";
                "{Control>}a{/Control}ff0000";
                "{Enter}";
                "{Control>}a{/Control}nope";
                "{Tab}";
              ]
            ());
      Jest.testPromise "steps a hex by the keys, as React's does" (fun () ->
          both ~default_value:"#0485F7"
            ~keys:
              [
                "click";
                "{ArrowUp}";
                "{PageDown}";
                "{End}";
                "{ArrowUp}";
                "{Home}";
                "{Control>}a{/Control}{Backspace}";
                "{ArrowUp}";
                "wheel";
                "{Tab}";
              ]
            ());
      Jest.testPromise "steps a channel, as React's does" (fun () ->
          both ~channel:"hue" ~default_value:"#7F007F"
            ~keys:[ "click"; "{ArrowUp}"; "{ArrowUp}"; "{ArrowDown}"; "{Tab}" ]
            ());
      Jest.testPromise "is disabled, as React's is" (fun () ->
          both ~default_value:"#0485F7" ~is_disabled:true
            ~description:"This color field is disabled" ~keys:[] ());
      Jest.testPromise "is invalid and required, as React's is" (fun () ->
          both ~placeholder:"#000000" ~is_invalid:true ~is_required:true
            ~error:"Please enter a valid hex color" ~keys:[] ());
      Jest.testPromise "is secondary, its channel with a suffix, as React's is"
        (fun () ->
          both ~channel:"saturation" ~default_value:"#7F007F"
            ~variant:"secondary" ~suffix:"%" ~keys:[] ()))

(* A field of [channel], else of a hex, each part given a caller's attributes,
   ref and handlers, as it is hovered, has its prefix clicked, is refused by
   its form and is left: what each part shows, and what the caller is told. *)
let given ?channel () =
  let told = ref [] in
  let tell name = told := name :: !told in
  T.render (fun () ->
      <Form on_submit=prevent_default>
        <Color_field
          ?channel=(fun () -> channel)
          name="color"
          is_invalid=true
          title="Color"
          style="--x: 1"
          ref=(fun _ -> tell "field ref")
          on_focus_out=(fun _ -> tell "field focus out")
          on_blur=(fun _ -> tell "field blur")>
          <Label>"Color"</Label>
          <Color_field.Group
            title="Group" on_click=(fun _ -> tell "group click")>
            <Color_field.Prefix>"#"</Color_field.Prefix>
            <Color_field.Input title="Value" ref=(fun _ -> tell "input ref") />
          </Color_field.Group>
        </Color_field>
        <button data_slot="submit" type_=`submit>"Save"</button>
      </Form>);
  let user = T.setup () in
  let part slot =
    Option.value (T.query ("[data-slot=" ^ slot ^ "]")) ~default:T.body
  in
  let input = part "color-input-group-input" in
  (* The input's ref watches the pointer. *)
  let* () = T.hover user input in
  let hovered = T.attribute input "data-hovered" in
  (* A click on the group's prefix focuses its input. *)
  let* () = T.click user (part "color-input-group-prefix") in
  let prefixed = T.attribute active "data-slot" in
  (* The form focuses the invalid field it finds by the field's ref. *)
  let* () = T.click user (part "submit") in
  let submitted = T.attribute active "data-slot" in
  let* () = T.click user T.body in
  let root = part "color-field" in
  Js.Promise.resolve
    E.(
      expect
        ( (T.attribute root "title", T.attribute root "style"),
          ( T.attribute (part "color-input-group") "title",
            T.attribute input "title" ),
          (hovered, prefixed, submitted),
          Array.of_list (List.sort_uniq String.compare !told) )
      |> toEqual
           ( (Some "Color", Some "--x: 1;"),
             (Some "Group", Some "Value"),
             ( Some "true",
               Some "color-input-group-input",
               Some "color-input-group-input" ),
             [|
               "field blur";
               "field focus out";
               "field ref";
               "group click";
               "input ref";
             |] ))

let () =
  Jest.describe "Color_field, its elements" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise
        "take their elements' attributes, calling a caller's ref and handlers \
         beside their own" (fun () -> given ());
      Jest.testPromise "take them so in a field of a channel" (fun () ->
          given ~channel:`hue ()))
