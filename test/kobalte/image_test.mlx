module H = Harness
module Image = Solidtype_kobalte.Image
module Jsx = Solidtype.Jsx
module S = Solidtype.Solid

let status_name = function
  | `idle -> "idle"
  | `loading -> "loading"
  | `loaded -> "loaded"
  | `error -> "error"

let island () =
  let status, set_status = S.create_signal "idle" in
  <div>
    <Image.Root
      on_loading_status_change=(fun s -> S.set set_status (status_name s))>
      <Image.Img src="/avatar.png" alt="Ada Lovelace" />
      <Image.Fallback>"AL"</Image.Fallback>
    </Image.Root>
    <p>"Image " (fun () -> Jsx.string (S.get status))</p>
  </div>

external twin : unit -> Jsx.element = "make" [@@mel.module "./twins/Image.tsx"]

let ( let* ) = H.( let* )

(* jsdom never fetches an image, so it stays loading and the fallback stays
   shown: the image itself, once loaded, cannot be seen here. *)
let () =
  H.alike "Image" ~island ~twin (fun _ ->
      let* () =
        H.eventually (fun () ->
            H.expect_equal ~what:"the status reported" "Image loading"
              (H.text (H.by_text "Image loading")))
      in
      H.expect_equal ~what:"the fallback" "AL" (H.text (H.by_text "AL"));
      if not (Int.equal (Array.length (H.all_by_role "img")) 0) then
        Js.Exn.raiseError "no image before it loads";
      Js.Promise.resolve ())
