module H = Harness
open Harness.Syntax
module Tooltip = Solidtype_kobalte.Tooltip

let island () =
  <Tooltip.Root open_delay=0. close_delay=0. ignore_safe_area=true>
    <Tooltip.Trigger>"Save"</Tooltip.Trigger>
    <Tooltip.Portal>
      <Tooltip.Content><Tooltip.Arrow /> "Save the draft"</Tooltip.Content>
    </Tooltip.Portal>
  </Tooltip.Root>

external twin : unit -> Solidtype.Jsx.element = "make"
[@@mel.module "./twins/Tooltip.tsx"]

let attribute e name = Option.value (H.attribute e name) ~default:""

external hover : H.user -> Dom.element -> unit Js.Promise.t = "hover"
[@@mel.send]

external unhover : H.user -> Dom.element -> unit Js.Promise.t = "unhover"
[@@mel.send]

let () =
  H.alike "Tooltip" ~island ~twin (fun user ->
      let trigger = H.by_role_named "button" (H.query ~name:"Save" ()) in
      H.expect_equal ~what:"the trigger, closed" ""
        (attribute trigger "aria-describedby");
      let* () = H.tab user in
      let* () =
        H.eventually (fun () ->
            H.expect_equal ~what:"the tooltip, the trigger focused"
              "Save the draft"
              (H.text (H.by_role "tooltip")))
      in
      let tooltip = H.by_role "tooltip" in
      H.expect_equal ~what:"the trigger is described by the tooltip"
        (attribute tooltip "id")
        (attribute trigger "aria-describedby");
      let* () = H.keyboard user "{Escape}" in
      let* () =
        H.eventually (fun () ->
            H.expect_equal ~what:"the trigger, Escape pressed" ""
              (attribute trigger "aria-describedby"))
      in
      let* () = H.tab user in
      let* () = hover user trigger in
      let* () =
        H.eventually (fun () ->
            H.expect_equal ~what:"the trigger, hovered" (attribute tooltip "id")
              (attribute trigger "aria-describedby"))
      in
      let* () = unhover user trigger in
      H.eventually (fun () ->
          H.expect_equal ~what:"the trigger, left" ""
            (attribute trigger "aria-describedby")))
