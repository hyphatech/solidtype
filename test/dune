; does_not_compile.t builds islands against the installed library, which
; dune puts on OCAMLPATH for a cram test that depends on its packages.

(cram
 (applies_to does_not_compile)
 (deps
  (package solidtype)
  (package solidtype-kobalte)
  (package ppx_solidtype)))

; Every island of the documentation is on one of its pages, every page
; of rhp's links to the page of rhp's documentation it follows, and llms.txt
; lists every page, and a page installs the newest release's plugin.

(test
 (name test_docs)
 (package solidtype)
 (modules test_docs)
 (libraries alcotest)
 (deps
  (glob_files ../docs/islands/*.{ml,mlx})
  (glob_files_rec ../docs/src/content/*.{md,mdx})
  ../docs/public/llms.txt
  ../CHANGES.md))

; Its errors are compared as text, so colour stays off even where the
; environment forces it, as CI's does.

(env
 (_
  (env-vars
   (CLICOLOR_FORCE 0))))
