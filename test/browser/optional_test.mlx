(* An optional prop passed on as it is, [?name=o]: present while [o] is
   [Some], absent while it is [None], on an element and through a component
   that may leave it out, a value or a function alike. *)

module S = Solidtype.Solid
module E = Jest.Expect
module T = Testing

(* A note a component may be given, passed to its element's title by name. *)
module Noted = struct
  let%component make ?(note : string option) () =
    <span ?title=(fun () -> S.get note)>"noted"</span>
end

(* A button that picks while it is given what to call, and says whether its
   last press was taken. *)
module Picker = struct
  let%component make ?(on_pick : (string -> unit) option) () =
    let taken, set_taken = S.create_signal "none" in
    <button
      on_click=(fun _ ->
                 S.set set_taken
                   (match on_pick "x" with
                   | Some () -> "taken"
                   | None -> "not taken"))>
      (fun () -> Solidtype.Jsx.string (S.get taken))
    </button>
end

(* A button that says what its functions make of a press, each its default
   while it is not given one. *)
module Defaulted = struct
  let%component make ?(label : unit -> string = fun () -> "default")
      ?(on_pick : string -> string = fun v -> "picked " ^ v) () =
    let said, set_said = S.create_signal "none" in
    <button on_click=(fun _ -> S.set set_said (label () ^ ", " ^ on_pick "x"))>
      (fun () -> Solidtype.Jsx.string (S.get said))
    </button>
end

external attribute : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

let title selector = Js.Null.toOption (attribute (T.query selector) "title")

let () =
  Jest.describe "optional props" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "an element's attribute is there while its option is Some"
        (fun () ->
          let link, set_link = S.create_signal None in
          T.render (fun () -> <a ?title=(fun () -> S.get link)>"home"</a>);
          let before = title "a" in
          S.set set_link (Some "/");
          let some = title "a" in
          S.set set_link None;
          E.(
            expect [| before; some; title "a" |]
            |> toEqual [| None; Some "/"; None |]));
      Jest.test "a component passes on an optional prop it may leave out"
        (fun () ->
          let note, set_note = S.create_signal (Some "first") in
          T.render (fun () ->
              <div><Noted ?note=(fun () -> S.get note) /> <Noted /></div>);
          let first = title "span" in
          S.set set_note None;
          let none = title "span" in
          S.set set_note (Some "");
          let empty = title "span" in
          E.(
            expect [| first; none; empty; title "span + span" |]
            |> toEqual [| Some "first"; None; Some ""; None |]));
      Jest.test "a component is given a function prop or not by one option"
        (fun () ->
          let picked = ref [] in
          let given, set_given = S.create_signal true in
          T.render (fun () ->
              <Picker
                ?on_pick=(fun () ->
                             if S.get given then
                               Some (fun v -> picked := v :: !picked)
                             else None)
              />);
          let button = T.query "button" in
          T.click button;
          let with_it = T.text button in
          S.set set_given false;
          T.click button;
          E.(
            expect (with_it, T.text button, !picked)
            |> toEqual ("taken", "not taken", [ "x" ])));
      Jest.test "a function prop left out is its default, and given is itself"
        (fun () ->
          T.render (fun () ->
              <div>
                <Defaulted />
                <Defaulted
                  label=(fun _ -> "given") on_pick=(fun v -> "chose " ^ v)
                />
              </div>);
          T.click (T.query "button");
          T.click (T.query "button + button");
          E.(
            expect
              (T.text (T.query "button"), T.text (T.query "button + button"))
            |> toEqual ("default, picked x", "given, chose x"))))
