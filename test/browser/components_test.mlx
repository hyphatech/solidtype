(* Solid's components that no other test reaches, each used as a page would
   use it and read as a person reads the page. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Switch = Solidtype.Switch
module Match = Solidtype.Match
module Show = Solidtype.Show
module ErrorBoundary = Solidtype.ErrorBoundary
module Dynamic = Solidtype.Dynamic
module Suspense = Solidtype.Suspense
module SuspenseList = Solidtype.SuspenseList
module E = Jest.Expect
module T = Testing
open Testing.Syntax

exception Broken

module Greeting = struct
  let%component make ~(name : string) () =
    <p>(fun () -> Jsx.string ("Hello, " ^ S.get name))</p>
end

(* Raises while [broken] says so, and renders once it does not. *)
module Fragile = struct
  let%component make ~(broken : bool) () =
    <p>
      (fun () -> if S.get broken then raise Broken else Jsx.string "mended")
    </p>
end

(* A card whose callback takes nothing, as a close or a remove does. *)
module Removable = struct
  let%component make ~(title : string) ~(on_remove : unit -> unit) () =
    <button on_click=(fun _ -> on_remove ())>
      (fun () -> Solidtype.Jsx.string (S.get title))
    </button>
end

(* A button whose handler its caller makes. *)
module Remove = struct
  let%component make ~(on_click : Dom.mouseEvent -> unit) () =
    <button on_click>"remove"</button>
end

(* A task's id, which there is none of until a task is chosen. *)
let id_of = function Some id -> id | None -> raise Broken

(* A field that reports what is typed, its callback any name. *)
module Field = struct
  let%component make ~(changed : string -> unit) () =
    <input aria_label="field" on_input=(fun _ -> changed "typed") />
end

(* Shows [text] once a fetch of it has resolved. *)
module Loaded = struct
  let%component make ~(text : string) () =
    let data, _ =
      S.create_resource (fun _ -> Js.Promise.resolve (S.get text))
    in
    <p>(fun () -> Jsx.string (Option.value (S.read data) ~default:""))</p>
end

(* A button that takes every attribute of its <button>: its class after its
   own, a click beside its own, and the rest passed on as they are. *)
module Save = struct
  let%component make ?(class_ : string option)
      ?(on_click : (Dom.mouseEvent -> unit) option) ~(saved : unit -> unit)
      ~(children : Jsx.content) () =
    <button
      class_=(fun () ->
               match S.get class_ with Some c -> "save " ^ c | None -> "save")
      on_click=(fun e ->
                 saved ();
                 ignore (on_click e : unit option))
      props=(Props.others props)>
      (fun () -> S.get children)
    </button>
  [@@element button]
end

(* A badge that draws its children of its state, a record its caller reads by
   field, the fields out of the caller's scope. *)
module Badge = struct
  type state = { count : int; label : string }

  let%component make ~(children : state -> Jsx.element) () =
    <span>(fun () -> Jsx.element (children { count = 3; label = "new" }))</span>
end

(* A toggle whose children are elements, or a function of its state. *)
module Toggle_tag = struct
  type state = { is_on : bool S.accessor }

  let%component make ~(children : state Jsx.children) () =
    let on, set_on = S.create_signal false in
    <button on_click=(fun _ -> S.update set_on not)>
      (fun () -> Jsx.draw (S.get children) { is_on = on })
    </button>
end

external attribute : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

external button_by_text : string -> Dom.element = "getByText"
[@@mel.module "@solidjs/testing-library"] [@@mel.scope "screen"]

let () =
  Jest.describe "components" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.test "Match.Some shows its case with the value, Some 0 too"
        (fun () ->
          let value, set_value = S.create_signal None in
          T.render (fun () ->
              <Switch fallback=(<p>"none"</p>)>
                <Match.Some some=(fun () -> S.get value)>
                  (fun v -> <p>(fun () -> Jsx.int (S.get v))</p>)
                </Match.Some>
              </Switch>);
          let before = T.page () in
          S.set set_value (Some 0);
          let zero = T.page () in
          S.set set_value (Some 7);
          E.(
            expect [| before; zero; T.page () |]
            |> toEqual [| "none"; "0"; "7" |]));
      Jest.test
        "a component given its element takes the element's attributes, a class \
         and a click beside its own" (fun () ->
          let saved = ref 0 and clicked = ref 0 in
          T.render (fun () ->
              <Save
                saved=(fun _ -> incr saved)
                class_="wide"
                on_click=(fun _ -> incr clicked)
                style="color: red"
                title="Save the draft">
                "Save"
              </Save>);
          let b = button_by_text "Save" in
          T.click b;
          E.(
            expect
              ( T.class_name b,
                Js.Null.toOption (attribute b "style"),
                T.title b,
                !saved,
                !clicked )
            |> toEqual ("save wide", Some "color: red;", "Save the draft", 1, 1)));
      Jest.test "Match.Keyed gives its case the value itself" (fun () ->
          let value, set_value = S.create_signal (Some "a") in
          T.render (fun () ->
              <Switch fallback=(<p>"none"</p>)>
                <Match.Keyed some=(fun () -> S.get value)>
                  (fun v -> <p>(fun () -> Jsx.string v)</p>)
                </Match.Keyed>
              </Switch>);
          let before = T.page () in
          S.set set_value None;
          E.(expect (before, T.page ()) |> toEqual ("a", "none")));
      Jest.test "ErrorBoundary's reset renders its children again" (fun () ->
          let broken, set_broken = S.create_signal true in
          T.render (fun () ->
              <ErrorBoundary
                fallback=(fun _ reset ->
                           <button on_click=(fun _ -> reset ())>"retry"</button>)>
                <Fragile broken=(fun () -> S.get broken) />
              </ErrorBoundary>);
          let before = T.page () in
          S.set set_broken false;
          T.click (button_by_text "retry");
          E.(expect (before, T.page ()) |> toEqual ("retry", "mended")));
      Jest.test
        "ErrorBoundary's fallback may take reset after a step of its own"
        (fun () ->
          T.render (fun () ->
              <ErrorBoundary
                fallback=(fun e ->
                           let said =
                             match e with Broken -> "broken" | _ -> "other"
                           in
                           fun _reset -> <p>(fun () -> Jsx.string said)</p>)>
                <Fragile broken=(fun () -> true) />
              </ErrorBoundary>);
          E.(expect (T.page ()) |> toBe "broken"));
      Jest.test "a callback prop that takes nothing is called" (fun () ->
          let removed = ref 0 in
          T.render (fun () ->
              <Removable title="card" on_remove=(fun _ -> incr removed) />);
          T.click (button_by_text "card");
          E.(expect !removed |> toBe 1));
      Jest.test "a handler made in a branch is made as the branch is drawn"
        (fun () ->
          let removed = ref 0 in
          let remove id (_ : Dom.mouseEvent) = removed := id in
          let task, set_task = S.create_signal None in
          T.render (fun () ->
              <Show when_=(fun () -> Option.is_some (S.get task))>
                <button on_click=(remove (id_of (S.get task)))>"remove"</button>
              </Show>);
          S.set set_task (Some 7);
          T.click (button_by_text "remove");
          E.(expect !removed |> toBe 7));
      Jest.test "a component's handler made in a branch is made as it is drawn"
        (fun () ->
          let removed = ref 0 in
          let remove id (_ : Dom.mouseEvent) = removed := id in
          let task, set_task = S.create_signal None in
          T.render (fun () ->
              <Show when_=(fun () -> Option.is_some (S.get task))>
                <Remove on_click=(remove (id_of (S.get task))) />
              </Show>);
          S.set set_task (Some 7);
          T.click (button_by_text "remove");
          E.(expect !removed |> toBe 7));
      Jest.test "a component's spread made in a branch is made as it is drawn"
        (fun () ->
          let removed = ref 0 in
          let rest_of id =
            S.pick
              (Remove.Props.make ~on_click:(fun _ -> removed := id) ())
              [| "onClick" |]
          in
          let task, set_task = S.create_signal None in
          T.render (fun () ->
              <Show when_=(fun () -> Option.is_some (S.get task))>
                <Remove
                  on_click=(fun _ -> ()) props=(rest_of (id_of (S.get task)))
                />
              </Show>);
          S.set set_task (Some 7);
          T.click (button_by_text "remove");
          E.(expect !removed |> toBe 7));
      Jest.test "a callback in a variable is passed by its name, any name"
        (fun () ->
          let got = ref "" in
          let changed s = got := s in
          T.render (fun () -> <Field changed />);
          T.input (T.by_role "textbox");
          E.(expect !got |> toBe "typed"));
      Jest.test "a constant in a variable is an element's attribute as it is"
        (fun () ->
          let cls = "card" in
          T.render (fun () -> <p class_=cls>"x"</p>);
          E.(expect (T.class_name (T.query "p")) |> toBe "card"));
      Jest.test "create_dynamic renders the component chosen, with its props"
        (fun () ->
          T.render (fun () ->
              Dynamic.create_dynamic
                (fun () -> Greeting.component)
                (Greeting.Props.make ~name:"Di" ()));
          E.(expect (T.page ()) |> toBe "Hello, Di"));
      Jest.test "a function child reads its state's fields by their names alone"
        (fun () ->
          T.render (fun () ->
              <Badge>
                (fun s ->
                  <b>
                    (fun () -> Jsx.string (s.label ^ string_of_int s.count))
                  </b>)
              </Badge>);
          E.(expect (T.page ()) |> toBe "new3"));
      Jest.test "children of either kind are drawn as elements" (fun () ->
          T.render (fun () -> <Toggle_tag>"plain " <b>"tag"</b></Toggle_tag>);
          E.(expect (T.page ()) |> toBe "plain tag"));
      Jest.test "children of either kind are drawn of the state, as it changes"
        (fun () ->
          T.render (fun () ->
              <Toggle_tag>
                (fun s ->
                  <b>
                    (fun () ->
                      Jsx.string (if S.get s.is_on then "on" else "off"))
                  </b>)
              </Toggle_tag>);
          let before = T.page () in
          T.click (T.by_role "button");
          E.(expect (before, T.page ()) |> toEqual ("off", "on")));
      Jest.testPromise "SuspenseList reveals its Suspenses' children" (fun () ->
          T.render (fun () ->
              <SuspenseList reveal_order=`forwards>
                <Suspense fallback=(<p>"..."</p>)>
                  <Loaded text="one" />
                </Suspense>
                <Suspense fallback=(<p>"..."</p>)>
                  <Loaded text="two" />
                </Suspense>
              </SuspenseList>);
          let* () = T.page_reads "onetwo" in
          Js.Promise.resolve E.(expect (T.page ()) |> toBe "onetwo")))
