; Solid's rendering on the server, in OCaml, run by vitest in Node, where
; Solid resolves its server build.

(library
 (name server_test)
 (modes melange)
 (libraries solidtype solidtype-kobalte solidtype-heroui melange-jest.jest)
 (preprocess
  (pps melange.ppx ppx_solidtype)))

(melange.emit
 (target out)
 (modules)
 (libraries server_test)
 (runtime_deps
  (glob_files *.tsx))
 (module_systems
  (es6 jsx)))
