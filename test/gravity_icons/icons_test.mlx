(* Each icon drawn beside the same icon of @gravity-ui/icons in React, given
   the same class, width and data- attribute: the same elements, each with
   the same attributes, but an icon's clip, whose id is its own where React's
   is "a". *)

module E = Jest.Expect
module Gravity = Solidtype_gravity_icons

module Twin = struct
  external render : string -> Dom.element = "render"
  [@@mel.module "./twins/Icon.ts"]

  external cleanup : unit -> unit = "cleanup" [@@mel.module "./twins/Icon.ts"]
end

type rendered

external render : (unit -> Solidtype.Jsx.element) -> rendered = "render"
[@@mel.module "@solidjs/testing-library"]

external container : rendered -> Dom.element = "container" [@@mel.get]

external cleanup : unit -> unit = "cleanup"
[@@mel.module "@solidjs/testing-library"]

external first_child : Dom.element -> Dom.element Js.null = "firstElementChild"
[@@mel.get]

external children : Dom.element -> Dom.element Js.Array.array_like = "children"
[@@mel.get]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

external query_all : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external tag_name : Dom.element -> string = "tagName" [@@mel.get]

external attribute_names : Dom.element -> string array = "getAttributeNames"
[@@mel.send]

external attribute_js : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

let attribute e name =
  Option.value (Js.Null.toOption (attribute_js e name)) ~default:""

(* An element as tag, attributes in order of name, and children, each id
   named by where it is in the icon, since its value is the framework's. *)
let shape host =
  let clip =
    Js.Null.toOption (query host "[id]")
    |> Option.map (fun e -> attribute e "id")
  in
  let named value =
    match clip with
    | Some id when String.equal value id -> "<clip>"
    | Some id when String.equal value ("url(#" ^ id ^ ")") -> "url(<clip>)"
    | Some _ | None -> value
  in
  let rec of_element e =
    let attributes =
      attribute_names e |> Array.to_list |> List.sort String.compare
      |> List.map (fun name -> name ^ "=" ^ named (attribute e name))
    in
    tag_name e ^ "["
    ^ String.concat " " attributes
    ^ "]("
    ^ String.concat ", "
        (Array.to_list (Array.map of_element (Js.Array.from (children e))))
    ^ ")"
  in
  match Js.Null.toOption (first_child host) with
  | Some e -> of_element e
  | None -> "nothing"

let () =
  Jest.describe "Gravity" (fun () ->
      Jest.test "draws every icon as @gravity-ui/icons draws it" (fun () ->
          let differ =
            Icons.all |> Array.to_list
            |> List.filter_map (fun (name, draw) ->
                let solidtype = shape (container (render draw)) in
                cleanup ();
                let react = shape (Twin.render name) in
                Twin.cleanup ();
                if String.equal solidtype react then None
                else Some (name ^ ": " ^ solidtype ^ " is not " ^ react))
          in
          E.(expect (Array.of_list differ) |> toEqual [||]));
      Jest.test "gives each icon on a page a clip of its own" (fun () ->
          let host =
            container
              (render (fun () ->
                   <div><Gravity.Abbr_sql /> <Gravity.Abbr_sql /></div>))
          in
          let read svg selector name =
            Js.Null.toOption (query svg selector)
            |> Option.map (fun e -> attribute e name)
          in
          let clips =
            Js.Array.from (query_all host "svg")
            |> Array.map (fun svg ->
                (read svg "clipPath" "id", read svg "g" "clip-path"))
          in
          cleanup ();
          let drawn =
            Array.map
              (fun (id, used) ->
                match (id, used) with
                | Some id, Some used -> String.equal used ("url(#" ^ id ^ ")")
                | (Some _ | None), _ -> false)
              clips
          in
          let distinct =
            match clips with
            | [| (Some a, _); (Some b, _) |] -> not (String.equal a b)
            | _ -> false
          in
          E.(expect (drawn, distinct) |> toEqual ([| true; true |], true))))
