(* The island both sides render: a count and the button that raises it.
   [clicks] counts what its handler handled, for the test to read. *)

module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

let clicks = ref 0

(* A tag whose children are drawn of its state, by a function the page gives. *)
module Tag = struct
  type state = { label : string S.accessor }

  let%component make ~(children : state Jsx.children) () =
    let label, _ = S.create_signal "drawn" in
    <span>(Jsx.draw (S.get children) { label })</span>
end

(* A component given a function of two arguments, and the same under
   [Arity], as a binding makes a JavaScript component that takes one. *)
module Joined = struct
  let%component make ~(join : string -> string -> string) () =
    <i>(Jsx.string (join "a" "b"))</i>
end

module Adapted = struct
  module Props = Joined.Props

  let component =
    Solidtype.Arity.adapted "join"
      (fun (f : string -> string -> string) -> fun[@u] a b -> f a b)
      Joined.component
end

let make () =
  let count, set_count = S.create_signal 0 in
  <div>
    <button
      type_=`button
      on_click=(fun _ ->
                   incr clicks;
                   S.update set_count succ)>
      "add"
    </button>
    <p>(Jsx.int (S.get count))</p>
    <Tag>(fun s -> <b>(Jsx.string (S.get s.label))</b>)</Tag>
    <ul>
      <Solidtype.For each=[| "x"; "y" |]>
        (fun item _ -> <li>(Jsx.string item)</li>)
      </Solidtype.For>
    </ul>
    <Adapted join=(fun a b -> a ^ b) />
  </div>
