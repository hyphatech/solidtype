include
  struct
    module Props =
      struct
        [@@@ocaml.warning "-32-37"]
        type 'a t
        external get_text : 'a t -> string = "text"[@@mel.get ]
        external get_count : 'a t -> int option = "count"[@@mel.get ]
        external get_on_pick : 'a t -> ((int -> unit)[@u ]) option = "onPick"
        [@@mel.get ]
        external get_children :
          'a t -> (('a -> Solidtype.Jsx.element)[@u ]) = "children"[@@mel.get
                                                                    ]
        external make :
          text:string ->
            ?count:int ->
              ?on_pick:((int -> unit)[@mel.as "onPick"]) ->
                children:('a -> Solidtype.Jsx.element) -> unit -> 'a t = ""
        [@@mel.obj ]
        let check ~text:(_ : string Solidtype.Check.value)
          ?count:(_ : int Solidtype.Check.value option)
          ?on_pick:(_ : (int -> unit) option)
          ~children:(_ :
                      ('a -> Solidtype.Jsx.element, [ `render ])
                        Solidtype.Check.children)
          ?spread:(_ : 'a t option) () = ()
        type name =
          | Text 
          | Count 
          | On_pick 
          | Children 
        let omit (props : 'a t) (names : name array) :
          'a t Solidtype.Solid.rest=
          Solidtype.Solid.omit props
            (Array.map
               (function
                | Text -> "text"
                | Count -> "count"
                | On_pick -> "onPick"
                | Children -> "children") names)
      end
    let make (props : _ Props.t) =
      let text () = Props.get_text props[@@inline ][@@ocaml.warning "-26-27"]
      and count () =
        match Props.get_count props with | Some v -> v | None -> 0[@@inline ]
      [@@ocaml.warning "-26-27"]
      and on_pick solidtype__0 =
        match Props.get_on_pick props with
        | Some f -> Some ((f solidtype__0)[@u ])
        | None -> None[@@inline ][@@ocaml.warning "-26-27"]
      and children solidtype__0 =
        let f = Props.get_children props in ((f solidtype__0)[@u ])[@@inline
                                                                    ]
      [@@ocaml.warning "-26-27"] in
      Solidtype.Jsx.el "p" [||]
        [|(Solidtype.Jsx.dynamic
             (fun () -> Solidtype.Jsx.int (count ()) : unit ->
                                                         Solidtype.Jsx.content))|]
    let component = Solidtype.Jsx.component make
  end
