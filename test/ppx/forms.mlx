module S = Solidtype.Solid

let static = <div class_="x" />
let handler = <button on_click=(fun _ -> ()) />
let handler_made = <button on_click=(remove (id ())) />

let component_handler_made =
  <Remove on_click=(remove (id ())) props=(rest ()) />

let component_handler_of_unit = <Remove on_remove=(fun () -> close ()) />
let dynamic = <div class_=(fun () -> cls ()) />
let spread = <input props=attrs />
let text = <p>"hello"</p>
let nested = <ul><li>"one"</li></ul>
let thunk = <p>(fun () -> Solidtype.Jsx.string (name ()))</p>
let component = <Label text=(fun () -> "x") count=1 />
let part = <Switch.Root checked=(fun () -> on ())><Switch.Thumb /></Switch.Root>
let constructor = <Toggle pressed=true />
let element_prop = <Show when_=(fun () -> ready ()) fallback=(<p>"wait"</p>) />

let function_child =
  <For each=(fun () -> items ())>
    (fun item -> <li>(fun () -> Solidtype.Jsx.string item)</li>)
  </For>

let ref_callback = <div ref=(fun el -> keep el) />

let%component make ~(text : string) ?(count : int = 0)
    ?(on_pick : (int -> unit) option) ?(on_close : unit -> unit = fun () -> ())
    ~(children : 'a -> Solidtype.Jsx.element) () =
  <p>(fun () -> Solidtype.Jsx.int (S.get count))</p>

module Given_its_element = struct
  let%component make ?(variant : [ `a | `b ] option) ?(class_ : string option)
      () =
    <button
      class_=(fun () -> Option.value (S.get class_) ~default:"")
      props=(Props.others props)
    />
  [@@element button]
end

