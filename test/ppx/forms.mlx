    read_only=true
    tab_index="0"
    class_list=(fun () -> classes ())
    accept_charset="utf-8"
    aria_label="name"
    data_user_id="7"
  />

let svg_names = <svg view_box="0 0 1 1" stroke_width="2" />
let run_of_capitals = <div inner_html="<b>x</b>" />
let data_flag = <div data_selected=(fun () -> Solidtype.Jsx.flag (on ())) />

let data_on_component =
  <Switch.Root
    data_slot="switch"
    data_hovered=(fun () -> Solidtype.Jsx.flag (on ()))
    data_state=state
  />

let kobalte_names = <Icon is_svg=true />

let namespaced =
  <div
    on_scroll=(Solidtype.Jsx.native (fun _ -> ()))
    on_click=(Solidtype.Jsx.capture handle)
    title=(Solidtype.Jsx.attr "t")
    hidden=(Solidtype.Jsx.bool (fun () -> closed ()))
    value=(Solidtype.Jsx.prop (fun () -> v ()))
    on=(Solidtype.Jsx.listen "myEvent" (fun _ -> ()))
    attr=(Solidtype.Jsx.named "data-x" "y")
  />

let namespaced_optional =
  <div ?hidden=(Solidtype.Jsx.attr (fun () -> found ())) />

let namespaced_on_component =
  <Switch.Root
    title=(Solidtype.Jsx.attr "t")
    ?hidden=(Solidtype.Jsx.attr (fun () -> found ()))
    inert=(Solidtype.Jsx.bool (fun () -> closed ()))
    attr=(Solidtype.Jsx.named "aria-x" "y")
  />

let switch =
  <Switch>
    (fun () ->
      match answer () with
      | Waiting -> <p>"wait"</p>
      | Ready n -> <p>(fun () -> Solidtype.Jsx.int n)</p>)
  </Switch>

let strings =
  <p title={x|né|x}>
    "C:\\new\\table"
    "¯\\_(ツ)_/¯"
    {|a\b|}
    {js|caf\u00e9|js}
    <Label text="x\\y" />
  </p>

(* A prop is read where it is used, and one the body binds again is the body's
   own: [title] is read whole, the shadowed [text] through its accessor, and a
   prop handed on stays an accessor. *)
module Read = struct
  let%component make ~(title : string) ~(text : string) ?(note : string option)
      () =
    let text = S.create_memo (fun () -> S.get text ^ "!") in
    <p title=(fun () -> S.get title) ?lang=(fun () -> S.get note)>
      (fun () -> Solidtype.Jsx.string (S.get text))
    </p>
end

(* A thunk's value coerced, which MLX may read as the function's own result
   coercion: the coercion is the body's. *)
let coerced (open_ : [ `a ]) =
  <p
    title=(fun () -> match (open_ :> [ `a | `b ]) with `a -> "a" | `b -> "b")
    data_x=(fun () -> (Jsx.data "x" :> Jsx.data))
  />

module Removable = struct
  let%component make ~(on_remove : unit -> unit) () =
    <button on_click=(fun _ -> on_remove ())>"x"</button>
end

(* A parameter names its variable apart from its label, so a prop called [ref]
   leaves Stdlib's [ref] to the body. *)
module Measured = struct
  let%component make ?ref:(given : (Dom.htmlDivElement -> unit) option) () =
    let seen = ref 0 in
    <div
      ref=(fun e ->
              incr seen;
              ignore (given e : unit option))
    />
end

let optional_attribute = <a title=(fun () -> "x") ?href=(fun () -> link ()) />
let optional_prop = <Label text=(fun () -> "x") ?count=(fun () -> count ()) />
let named_render = <For each=(fun () -> items ()) render=row />

module Part = struct
  let%component make ?(class_ : string option) () =
    <button
      class_=(fun () -> Option.value (S.get class_) ~default:"")
      ref=(fun _ -> ())
      props=(Props.others props)
    />
  [@@element button]
end

let drawn_as = <button ?as_=(fun () -> None) class_="x" />
