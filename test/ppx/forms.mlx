let static = <div class_="x" />
let handler = <button on_click=(fun _ -> ()) />
let dynamic = <div class_=(fun () -> cls ()) />
let spread = <input props=attrs />
let text = <p>"hello"</p>
let nested = <ul><li>"one"</li></ul>
let thunk = <p>(fun () -> Solidtype.Jsx.string (name ()))</p>
let component = <Label text=(fun () -> "x") count=1 />
let part = <Switch.Root checked=(fun () -> on ())><Switch.Thumb /></Switch.Root>
let constructor = <Toggle pressed=true />
let element_prop = <Show when_=(fun () -> ready ()) fallback=(<p>"wait"</p>) />

let function_child =
  <For each=(fun () -> items ())>
    (fun item -> <li>(fun () -> Solidtype.Jsx.string item)</li>)
  </For>

let ref_callback = <div ref=(fun el -> keep el) />

let%component make ~(text : string) ?(count : int = 0)
    ?(on_pick : (int -> unit) option) ~(children : 'a -> Solidtype.Jsx.element)
    () =
  <p>(fun () -> Solidtype.Jsx.int (count ()))</p>

let names =
  <input
    read_only=true
    tab_index="0"
    class_list=(fun () -> classes ())
    accept_charset="utf-8"
    aria_label="name"
    data_user_id="7"
  />

let svg_names = <svg view_box="0 0 1 1" stroke_width="2" />
let run_of_capitals = <div inner_html="<b>x</b>" />
let kobalte_names = <Icon is_svg=true />

let namespaced =
  <div
    on_scroll=(Solidtype.Jsx.native (fun _ -> ()))
    on_click=(Solidtype.Jsx.capture handle)
    title=(Solidtype.Jsx.attr "t")
    hidden=(Solidtype.Jsx.bool (fun () -> closed ()))
    value=(Solidtype.Jsx.prop (fun () -> v ()))
    on=(Solidtype.Jsx.listen "myEvent" (fun _ -> ()))
    attr=(Solidtype.Jsx.named "data-x" "y")
  />

let switch =
  <Switch>
    (fun () ->
      match answer () with
      | Waiting -> <p>"wait"</p>
      | Ready n -> <p>(fun () -> Solidtype.Jsx.int n)</p>)
  </Switch>

let strings =
  <p title={x|né|x}>
    "C:\\new\\table"
    "¯\\_(ツ)_/¯"
    {|a\b|}
    {js|caf\u00e9|js}
    <Label text="x\\y" />
  </p>

module Removable = struct
  let%component make ~(on_remove : unit -> unit) () =
    <button on_click=(fun _ -> on_remove ())>"x"</button>
end
