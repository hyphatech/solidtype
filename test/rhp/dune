; Each rhp chart island of the documentation beside the same chart in rhp's
; own JSX, its twin: the two must draw the same elements. An island's CSS is
; copied beside its output here too, where both the island and its twin
; import it.

(library
 (name rhp_test)
 (modes melange)
 (libraries
  solidtype
  solidtype-rhp
  docs_islands
  melange-jest.jest
  melange.dom)
 (preprocess
  (pps melange.ppx ppx_solidtype)))

(melange.emit
 (target out)
 (modules)
 (libraries rhp_test)
 (runtime_deps
  (glob_files twins/*.tsx)
  (glob_files %{project_root}/docs/islands/*.css))
 (module_systems
  (es6 jsx)))
