; The example's server: Spindle, serving the notes the island calls and the
; built site beside them, on one origin. Its command line prints the
; island's client from the routes, so a route that changes is a build that
; fails where an island no longer matches it.

(library
 (name routes)
 (modules routes)
 (libraries spindle wiretype)
 (preprocess
  (pps ppx_wiretype)))

(executable
 (name notes)
 (modules notes)
 (libraries spindle spindle-cli routes))

(executable
 (name serve)
 (modules serve)
 (libraries spindle routes eio_main))
