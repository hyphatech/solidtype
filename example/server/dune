; The board's server: Spindle, serving the tasks the board shows, their
; document at /docs, and the built page beside them, on one origin. Its
; command line prints the board's client from the routes, so a route that
; changes is a build that fails where an island no longer matches it.

; The store and the routes over it, each a module of its own.

(library
 (name server)
 (wrapped false)
 (modules store routes)
 (libraries spindle spindle-sqlite rowtype wiretype)
 (preprocess
  (pps ppx_wiretype)))

(executable
 (name serve)
 (modules serve)
 (libraries spindle spindle-sqlite server eio_main))

(executable
 (name board)
 (modules board)
 (libraries spindle spindle-cli server))

; The routes, called in-process as the board calls them, on a database the
; board's migrations make.

(test
 (name test_tasks)
 (modules test_tasks)
 (deps
  (glob_files ../migrations/*.sql))
 (libraries
  spindle
  spindle-http
  spindle-sqlite
  rowtype-sqlite
  rowtype-migrate
  rowtype-migrate.sqlite
  server
  eio_main
  alcotest))
