---
// The shelf as an Astro page: wiring alone. The board is OCaml, compiled by
// Melange into _build, and mounts as any Solid island does, prerendered and
// hydrated, then fetching the books from the server `make serve` runs.
import * as App from "../../_build/default/example/out/example/src/app.jsx";
import "../src/shelf.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shelf</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100">
    <App.make client:load />
  </body>
</html>
