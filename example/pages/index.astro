---
// The board as an Astro page: wiring alone. It is OCaml, compiled by
// Melange into _build, and mounts as any Solid island does, prerendered and
// hydrated, then fetching the tasks from the server `make example-serve` runs.
import * as App from "../../_build/default/example/out/example/src/app.jsx";
import "../src/board.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kanban Board</title>
    <!-- HeroUI's theme is dark under .dark: the system's scheme, as the page opens. -->
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches) document.documentElement.classList.add("dark");
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <App.make client:load />
  </body>
</html>
