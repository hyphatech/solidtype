module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For

external typed : Dom.inputEvent -> string = "value"
[@@mel.get] [@@mel.scope "currentTarget"]

(* What a call came to, as a sentence for the page: the server's own, or
   what went wrong at this end. *)
let said = function
  | `Refused (r : Api.refusal) -> r.message
  | `Invalid _ -> "A note is one to eighty characters."
  | `Lost _ -> "The server cannot be reached."
  | `Unexpected _ -> "Something went wrong at our end."

(* A note's state, every one the server answers: a state it gains is a
   case this match misses, and the island stops compiling. *)
let mark (n : Api.note) = match n.state with Open -> "open" | Done -> "done"

let%component make ?(origin : string = "") () =
  let problem, set_problem = S.create_signal "" in
  let notes, actions =
    S.create_resource (fun _ ->
        Js.Promise.then_
          (fun answered ->
            Js.Promise.resolve
              (match answered with
              | Ok notes -> notes
              | Error e ->
                  S.set set_problem (said e);
                  [||]))
          (Api.get_notes ~origin:(origin ()) ()))
  in
  let draft, set_draft = S.create_signal "" in
  let add _ =
    ignore
      (Js.Promise.then_
         (fun added ->
           (match added with
           | Ok _ ->
               S.set set_draft "";
               S.set set_problem "";
               S.refetch actions
           | Error e -> S.set set_problem (said e));
           Js.Promise.resolve ())
         (Api.post_notes ~origin:(origin ()) ~body:{ text = S.get draft } ()))
  in
  <section class_="notes">
    <ul>
      <For each=(fun () -> Option.value (S.read notes) ~default:[||])>
        (fun (n : Api.note) _ ->
          <li class_=(fun () -> mark n)>(fun () -> Jsx.string n.text)</li>)
      </For>
    </ul>
    <input
      aria_label="New note"
      value=(fun () -> S.get draft)
      onInput=(fun e -> S.set set_draft (typed e))
    />
    <button type_=`button onClick=add>"Add"</button>
    <p role=`status>(fun () -> Jsx.string (S.get problem))</p>
  </section>
