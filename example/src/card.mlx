module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Button = Solidtype_heroui.Button
module Card = Solidtype_heroui.Card
module Close_button = Solidtype_heroui.Close_button

(* A task on the board, HeroUI's card: dragged to another column, or moved a
   column at a time by its arrows. *)
let%component make ~(task : Api.task) ~(on_move : Status.t -> unit)
    ~(on_remove : unit -> unit) () =
  let arrow ~label target =
    match target with
    | None -> <span class_="size-8" />
    | Some status ->
        <Button
          variant=`ghost
          size=`sm
          is_icon_only=true
          aria_label=(fun () ->
                       "Move " ^ (task ()).title ^ " to " ^ Status.label status)
          on_click=(fun _ -> on_move status)>
          (fun () -> Jsx.string label)
        </Button>
  in
  <li
    class_="cursor-grab active:cursor-grabbing"
    draggable=true
    on_drag_start=(fun e -> Drag.start e (task ()).id)>
    <Card class_="gap-1 p-3">
      <Card.Header class_="flex-row items-start gap-2">
        <div class_="min-w-0 flex-1">
          <Card.Title class_="truncate">
            (fun () -> Jsx.string (task ()).title)
          </Card.Title>
          <Show.Some some=(fun () -> (task ()).note)>
            (fun note ->
              <Card.Description class_="truncate">
                (fun () -> Jsx.string (S.get note))
              </Card.Description>)
          </Show.Some>
        </div>
        <Close_button
          aria_label=(fun () -> "Remove " ^ (task ()).title)
          on_click=(fun _ -> on_remove ())
        />
      </Card.Header>
      <Card.Footer class_="justify-between">
        (fun () ->
          Jsx.element
            (arrow ~label:{js|←|js} (Status.previous (task ()).status)))
        (fun () ->
          Jsx.element (arrow ~label:{js|→|js} (Status.next (task ()).status)))
      </Card.Footer>
    </Card>
  </li>
