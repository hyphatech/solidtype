module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Show = Solidtype.Show

let make () =
  let items, set_items = S.create_signal [| "milk"; "bread" |] in
  <section>
    <Show
      when_=(fun () -> Array.length (S.get items) > 0)
      fallback=(<p>"Nothing to do"</p>)>
      <ul>
        <For each=(fun () -> S.get items)>
          (fun item _ -> <li>(fun () -> Jsx.string item)</li>)
        </For>
      </ul>
    </Show>
    <button type_=`button onClick=(fun _ -> S.set set_items [||])>
      "Clear"
    </button>
  </section>
