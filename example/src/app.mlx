module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Chip = Solidtype_heroui.Chip
module Empty_state = Solidtype_heroui.Empty_state
module Toast = Solidtype_heroui.Toast

(* What a call came to: the board fetched again and [what] said, or why
   not. *)
let settle ~changed what call =
  ignore
    (Js.Promise.then_
       (fun answered ->
         (match answered with
         | Ok _ -> changed what
         | Error e ->
             ignore
               (Toast.danger ~description:(Said.error e) "Not done" : Toast.key));
         Js.Promise.resolve ())
       call
      : unit Js.Promise.t)

let make () =
  (* Fetched in the browser alone: a page prerendered has no server to ask,
     and shows the board empty until it hydrates. *)
  let browser () = if Solidtype.Web.is_server then None else Some () in
  let tasks, actions =
    S.create_resource_from browser (fun () _ ->
        Js.Promise.then_
          (fun answered ->
            Js.Promise.resolve
              (match answered with
              | Ok tasks -> tasks
              | Error e ->
                  ignore
                    (Toast.danger ~description:(Said.error e)
                       "Could not load the board"
                      : Toast.key);
                  [||]))
          (Api.get_api_tasks ()))
  in
  let changed what =
    S.refetch actions;
    ignore (Toast.success ~description:what "Done" : Toast.key)
  in
  let settle what call = settle ~changed what call in
  let move (t : Api.task) status =
    if not (Status.equal t.status status) then
      settle
        (t.title ^ " is now in " ^ Status.label status)
        (Api.put_api_tasks_id_status ~id:t.id
           ~body:{ status = Status.to_move status }
           ())
  in
  let remove (t : Api.task) =
    settle (t.title ^ " is off the board") (Api.delete_api_tasks_id ~id:t.id ())
  in
  let in_column status =
    Array.of_list
      (List.filter
         (fun (t : Api.task) -> Status.equal t.status status)
         (Array.to_list (Option.value (S.latest tasks) ~default:[||])))
  in
  let find id =
    Array.find_opt
      (fun (t : Api.task) -> Float.equal t.id id)
      (Option.value (S.latest tasks) ~default:[||])
  in
  (* A drop needs a task to drag: while the board holds none, a column says
     what it is waiting for. *)
  let empty status =
    if Array.length (Option.value (S.latest tasks) ~default:[||]) > 0 then
      "Drop a task here"
    else
      match (status : Status.t) with
      | To_do -> "No tasks yet. Add one to start."
      | Doing -> "Nothing in progress"
      | Done -> "Nothing done yet"
  in
  let over, set_over = S.create_signal None in
  <main class_="mx-auto max-w-6xl px-4 py-10">
    <header class_="mb-8 flex items-center justify-between gap-4">
      <h1 class_="text-3xl font-semibold tracking-tight">"Kanban Board"</h1>
      <Add_task on_added=(fun title -> changed (title ^ " is on the board")) />
    </header>
    <div class_="grid gap-4 md:grid-cols-3">
      <For each=(fun () -> Array.of_list Status.all)>
        (fun status _ ->
          <section
            aria_label=(fun () -> Status.label status)
            class_=(fun () ->
                     match S.get over with
                     | Some s when Status.equal s status ->
                         "rounded-3xl bg-accent-soft p-3 ring-2 ring-accent \
                          transition"
                     | Some _ | None ->
                         "rounded-3xl bg-surface-secondary p-3 transition")
            on_drag_over=(fun e ->
                           Drag.prevent_default e;
                           S.set set_over (Some status))
            on_drag_leave=(fun _ -> S.set set_over None)
            on_drop=(fun e ->
                      Drag.prevent_default e;
                      S.set set_over None;
                      Option.iter
                        (fun t -> move t status)
                        (Option.bind (Drag.dropped e) find))>
            <h2
              class_="mb-3 flex items-center justify-between px-2 text-sm \
                      font-medium text-muted">
              (fun () -> Jsx.string (Status.label status))
              <Chip color=`accent size=`sm variant=`soft>
                (fun () -> Jsx.int (Array.length (in_column status)))
              </Chip>
            </h2>
            <ul class_="flex min-h-24 flex-col gap-2">
              <For
                each=(fun () -> in_column status)
                fallback=(<li
                            class_="rounded-2xl border border-dashed \
                                    border-border">
                            <Empty_state class_="p-4 text-center">
                              (fun () -> Jsx.string (empty status))
                            </Empty_state>
                          </li>)>
                (fun (t : Api.task) _ ->
                  <Card
                    task=(fun () -> t)
                    on_move=(fun status -> move t status)
                    on_remove=(fun _ -> remove t)
                  />)
              </For>
            </ul>
          </section>)
      </For>
    </div>
    <Toast.Provider placement=`bottom_end />
  </main>
