module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module For = Solidtype.For
module Toast = Solidtype_kobalte.Toast

(* What a call came to: the board fetched again and [what] said, or why
   not. *)
let settle ~changed what call =
  ignore
    (Js.Promise.then_
       (fun answered ->
         (match answered with
         | Ok _ -> changed what
         | Error e -> Notice.show ~title:"Not done" (Said.error e));
         Js.Promise.resolve ())
       call)

let make () =
  (* Fetched in the browser alone: a page prerendered has no server to ask,
     and shows the board empty until it hydrates. *)
  let browser () = if Solidtype.Web.is_server then None else Some () in
  let books, actions =
    S.create_resource_from browser (fun () _ ->
        Js.Promise.then_
          (fun answered ->
            Js.Promise.resolve
              (match answered with
              | Ok books -> books
              | Error e ->
                  Notice.show ~title:"Could not load the shelf" (Said.error e);
                  [||]))
          (Api.get_api_books ()))
  in
  let changed what =
    S.refetch actions;
    Notice.show ~title:"Done" what
  in
  let settle what call = settle ~changed what call in
  let move (b : Api.book) status =
    if not (Status.equal b.status status) then
      settle
        (b.title ^ " is now in " ^ Status.label status)
        (Api.put_api_books_id_status ~id:b.id
           ~body:{ status = Status.to_move status }
           ())
  in
  let rate (b : Api.book) n =
    settle
      (b.title ^ " rated " ^ string_of_int n)
      (Api.put_api_books_id_rating ~id:b.id ~body:{ stars = n } ())
  in
  let remove (b : Api.book) =
    settle (b.title ^ " is off the shelf") (Api.delete_api_books_id ~id:b.id ())
  in
  let shelved status =
    Array.of_list
      (List.filter
         (fun (b : Api.book) -> Status.equal b.status status)
         (Array.to_list (Option.value (S.latest books) ~default:[||])))
  in
  let find id =
    Array.find_opt
      (fun (b : Api.book) -> Float.equal b.id id)
      (Option.value (S.latest books) ~default:[||])
  in
  let over, set_over = S.create_signal None in
  <main class_="mx-auto max-w-6xl px-4 py-10">
    <header class_="mb-8 flex items-center justify-between">
      <h1 class_="font-serif text-3xl font-semibold tracking-tight">"Shelf"</h1>
      <Add_book on_added=(fun title -> changed (title ^ " is on the shelf")) />
    </header>
    <div class_="grid gap-4 md:grid-cols-3">
      <For each=(fun () -> Array.of_list Status.all)>
        (fun status _ ->
          <section
            aria_label=(fun () -> Status.label status)
            class_=(fun () ->
                     match S.get over with
                     | Some s when Status.equal s status ->
                         "rounded-xl bg-amber-100/70 p-3 ring-2 ring-amber-400 \
                          transition dark:bg-amber-950/40"
                     | Some _ | None ->
                         "rounded-xl bg-stone-100 p-3 transition \
                          dark:bg-stone-900/60")
            on_drag_over=(fun e ->
                           Drag.prevent_default e;
                           S.set set_over (Some status))
            on_drag_leave=(fun _ -> S.set set_over None)
            on_drop=(fun e ->
                      Drag.prevent_default e;
                      S.set set_over None;
                      Option.iter
                        (fun b -> move b status)
                        (Option.bind (Drag.dropped e) find))>
            <h2
              class_="mb-3 flex items-center justify-between px-1 text-sm \
                      font-semibold uppercase tracking-wide text-stone-500 \
                      dark:text-stone-400">
              (fun () -> Jsx.string (Status.label status))
              <span
                class_="rounded-full bg-stone-200 px-2 py-0.5 text-xs \
                        text-stone-600 dark:bg-stone-800 dark:text-stone-300">
                (fun () -> Jsx.int (Array.length (shelved status)))
              </span>
            </h2>
            <ul class_="flex min-h-24 flex-col gap-2">
              <For
                each=(fun () -> shelved status)
                fallback=(<li
                            class_="rounded-lg border border-dashed \
                                    border-stone-300 p-4 text-center text-sm \
                                    text-stone-400 dark:border-stone-700">
                            "Drop a book here"
                          </li>)>
                (fun (b : Api.book) _ ->
                  <Card
                    book=(fun () -> b)
                    on_move=(fun status -> move b status)
                    on_rate=(fun n -> rate b n)
                    on_remove=(fun _ -> remove b)
                  />)
              </For>
            </ul>
          </section>)
      </For>
    </div>
    <Toast.Region>
      <Toast.List
        class_="fixed bottom-4 right-4 z-50 flex w-80 max-w-[calc(100vw-2rem)] \
                flex-col gap-2"
      />
    </Toast.Region>
  </main>
