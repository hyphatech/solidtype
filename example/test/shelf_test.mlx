module T = Testing
open Testing.Syntax

(* Typed into the dialog and added, as a person does: the book's card once
   the board shows it. *)
let add ~title ~author =
  T.click (T.by_role_named "button" "Add a book");
  let* title_field = T.find_by_label "Title" in
  T.set_value title_field title;
  T.input title_field;
  let author_field = T.by_label "Author" in
  T.set_value author_field author;
  T.input author_field;
  T.click (T.by_role_named "button" "Add");
  T.find_by_text title

let () =
  Jest.describe "the shelf, against the example's server" (fun () ->
      Jest.afterEach T.cleanup;
      Jest.testPromise "a book added is on the board, to read, and said so"
        (fun () ->
          T.render Example.App.make;
          let* card = add ~title:"Dune" ~author:"Frank Herbert" in
          let* said = T.find_by_text "Dune is on the shelf" in
          Js.Promise.resolve
            Jest.Expect.(
              expect (T.column card, T.text said)
              |> toEqual (Some "To read", "Dune is on the shelf")));
      Jest.testPromise "a book moved by its arrow is in the next column"
        (fun () ->
          T.render Example.App.make;
          let* (_ : Dom.element) = add ~title:"Emma" ~author:"Jane Austen" in
          T.click (T.by_role_named "button" "Move Emma to Reading");
          let* () =
            T.eventually (fun () ->
                T.expect_equal ~what:"Emma's column" "Reading"
                  (Option.value (T.column (T.by_text "Emma")) ~default:""))
          in
          Js.Promise.resolve Jest.pass))
