; The notes twin's schemas, what Spindle prints from the server's routes,
; compared with the copy committed here: `dune promote` takes the new one.

(rule
 (with-stdout-to
  notes.gen.ts.printed
  (run %{exe:../server/notes.exe} api zod)))

(rule
 (alias runtest)
 (action
  (diff notes.gen.ts notes.gen.ts.printed)))
