# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Gravity UI's icons for solidtype, the icons HeroUI's examples draw"
description:
  "Every icon of @gravity-ui/icons, the set HeroUI's examples draw, as a solidtype component of its own: generated from the package's SVG files."
maintainer: ["Hypha Technologies Ltd <dev@hyphatech.io>"]
authors: ["Hypha Technologies Ltd"]
license: "MIT"
homepage: "https://github.com/hyphatech/solidtype"
bug-reports: "https://github.com/hyphatech/solidtype/issues"
depends: [
  "dune" {>= "3.18"}
  "ocaml" {>= "5.5"}
  "melange" {>= "7.0.1-55"}
  "solidtype" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hyphatech/solidtype.git"
x-maintenance-intent: ["(latest)"]
x-open-opam: true
