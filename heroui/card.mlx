module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show

(* HeroUI's classes for a card's parts, the same whatever its variant, read
   as a part is made: a module does nothing as it loads. *)
let slots () = Styles.Card.slots (Styles.Card.options ())

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Header = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Card.header (slots ())) (S.get class_))
      data_slot="card-header"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Title = struct
  let%component make ?(id : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    <h3
      ?id=(fun () -> S.get id)
      class_=(fun () -> after (Styles.Card.title (slots ())) (S.get class_))
      data_slot="card-title"
      props=(Props.others props)>
      (fun () -> S.get children)
    </h3>
  [@@element h3]
end

module Description = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <p
      class_=(fun () ->
               after (Styles.Card.description (slots ())) (S.get class_))
      data_slot="card-description"
      props=(Props.others props)>
      (fun () -> S.get children)
    </p>
  [@@element p]
end

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Card.content (slots ())) (S.get class_))
      data_slot="card-content"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Footer = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Card.footer (slots ())) (S.get class_))
      data_slot="card-footer"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

let%component make ?(variant : Surface.variant = `default)
    ?(role : Solidtype.Html.Div.role option) ?(aria_labelledby : string option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  (* Made where it is shown, so it reads the surface given there: a context is
     read as an element is made. *)
  let card () =
    <div
      ?role=(fun () -> S.get role)
      ?aria_labelledby=(fun () -> S.get aria_labelledby)
      class_=(fun () ->
               after
                 (Styles.Card.base
                    (Styles.Card.slots
                       (Styles.Card.options ~variant:(S.get variant) ())))
                 (S.get class_))
      data_slot="card"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  in
  (* A transparent card is no surface, as HeroUI's is not. *)
  <Show
    when_=(fun () ->
            match S.get variant with
            | `transparent -> false
            | `default | `secondary | `tertiary -> true)
    fallback=(fun () -> card ())>
    <Surface.Context.Provider value=(fun () -> variant)>
      (fun () -> Jsx.element (card ()))
    </Surface.Context.Provider>
  </Show>
[@@element div]
