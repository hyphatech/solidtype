let%component make ?(orientation : [ `horizontal | `vertical ] option)
    ?(class_ : string option) ~(children : Solidtype.Jsx.content) () =
  let slots () =
    Styles.SwitchGroup.slots
      (Styles.SwitchGroup.options ?orientation:(orientation ()) ())
  in
  <div
    class_=(fun () ->
             let base = Styles.SwitchGroup.base (slots ()) in
             match class_ () with Some c -> base ^ " " ^ c | None -> base)
    data_slot="switch-group"
    props=(Props.others props)>
    <div
      class_=(fun () -> Styles.SwitchGroup.items (slots ()))
      data_slot="switch-group-items">
      (fun () -> children ())
    </div>
  </div>
