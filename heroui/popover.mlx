module Jsx = Solidtype.Jsx
module S = Solidtype.Solid
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Popover
module Types = Solidtype_kobalte.Types

type placement = [ `top | `bottom | `left | `right ]

(* What a popover's parts read of it: its classes, the placement, offset and
   flip its content asks for, whether it draws an arrow, the side Kobalte
   placed it on, and the dialog its content gives the focus to. *)
type popover = {
  slots : Styles.Popover.slots;
  set_placement : placement -> unit;
  set_offset : float -> unit;
  set_flip : bool -> unit;
  set_arrow : bool -> unit;
  placement : unit -> string;
  mutable side : unit -> string;
  mutable dialog : Dom.element option;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = popover
end)

let within part =
  match Context.use () with
  | Some p -> p
  | None -> invalid_arg (part ^ " is used inside a Popover")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

external prevent_default : Dom.event -> unit = "preventDefault" [@@mel.send]

type focus_options

external focus_options :
  prevent_scroll:(bool[@mel.as "preventScroll"]) -> unit -> focus_options = ""
[@@mel.obj]

external focus_with : Dom.element -> focus_options -> unit = "focus"
[@@mel.send]

(* The focus moved without scrolling the page: a popover is given it before
   it is placed, at the page's top, as React Aria's focuses too. *)
let focus e = focus_with e (focus_options ~prevent_scroll:true ())

external as_element : _ Dom.element_like -> Dom.element = "%identity"
external contains : Dom.element -> Dom.element -> bool = "contains" [@@mel.send]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]
external body : Dom.element = "body" [@@mel.scope "document"]

(* Kobalte's trigger as the [<div role="button">] HeroUI's is, so a button
   inside it is not a button inside a button. *)
module As_div = struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Trigger.component
end

module Trigger = struct
  let%component make ?(aria_label : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let p = within "Popover.Trigger" in
    <As_div
      as_="div"
      ?aria_label
      class_=(fun () -> after (Styles.Popover.trigger p.slots) (class_ ()))
      role=`button
      tabindex="0"
      data_slot="popover-trigger"
      props=(Props.others props)>
      (fun () -> children ())
    </As_div>
end

(* A button only a reader finds, which closes the popover, as React Aria
   puts one either side of it for a reader with no Escape key. *)
let dismiss close =
  <div
    style="border: 0px; clip: rect(0px); clip-path: inset(50%); height: 1px; \
           margin: -1px; overflow: hidden; padding: 0px; position: absolute; \
           width: 1px; white-space: nowrap;">
    <button
      aria_label="Dismiss"
      style="width: 1px; height: 1px;"
      tabindex="-1"
      type_=`button
      on_click=(fun _ -> close ())
    />
  </div>

module Content = struct
  let%component make ?(placement : placement option) ?(offset : float option)
      ?(should_flip : bool = true) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let p = within "Popover.Content" in
    S.create_computed (fun () ->
        p.set_placement (Option.value (placement ()) ~default:`bottom));
    S.create_computed (fun () ->
        p.set_offset (Option.value (offset ()) ~default:8.));
    S.create_computed (fun () -> p.set_flip (should_flip ()));
    let k = Kobalte.use_popover_context () in
    let open_ = Types.PopoverContextValue.is_open k in
    let close () = Types.PopoverContextValue.close k () in
    let o = Overlay.create ~is_open:(fun () -> S.get open_) () in
    let content = ref None in
    (* Closed with the focus inside it, or nowhere, it gives the focus back to
       its trigger, as React Aria's does: Kobalte's would as its content
       unmounts, which here waits for its exit animation, when the focus has
       already left. *)
    S.create_computed_from ~init:false (fun was ->
        let now = S.get open_ in
        (if was && not now then
           match
             ( Js.Null.toOption active,
               S.untrack (fun () ->
                   S.get (Types.PopoverContextValue.trigger_ref k)) )
           with
           | Some focused, Some trigger
             when focused == body
                  || Option.fold ~none:false
                       ~some:(fun c -> contains c focused)
                       !content ->
               focus (as_element trigger)
           | (Some _ | None), _ -> ());
        now);
    let side, watch_side = Overlay.placed_side ~placement:p.placement () in
    p.side <- side;
    (* React Aria's popover gives its dialog the focus as it opens, where
       Kobalte's gives it to the first button inside. *)
    let focus_dialog e =
      match p.dialog with
      | Some d ->
          prevent_default e;
          focus d
      | None -> ()
    in
    <Show when_=(fun () -> Overlay.present o)>
      <Kobalte.Portal>
        <Kobalte.Content
          class_=(fun () -> after (Styles.Popover.base p.slots) (class_ ()))
          style="--trigger-anchor-point: \
                 var(--kb-popover-content-transform-origin);"
          ref=(fun e ->
                content := Some (as_element e);
                Overlay.watch o e;
                watch_side e)
          on_open_auto_focus=focus_dialog
          data_placement=(fun () -> Jsx.data (side ()))
          data_entering=(fun () -> Jsx.flag (Overlay.entering o))
          data_exiting=(fun () -> Jsx.flag (Overlay.exiting o))
          props=(Props.others props)>
          (fun () -> Jsx.element (dismiss close))
          <Button.Trigger.Provider value=(fun () -> Button.no_trigger)>
            (fun () -> children ())
          </Button.Trigger.Provider>
          (fun () -> Jsx.element (dismiss close))
        </Kobalte.Content>
      </Kobalte.Portal>
    </Show>
end

module Dialog = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let p = within "Popover.Dialog" in
    <section
      class_=(fun () -> after (Styles.Popover.dialog p.slots) (class_ ()))
      tabindex="-1"
      ref=(fun e ->
            p.dialog <- Some (as_element e);
            S.on_cleanup (fun () -> p.dialog <- None))
      data_slot="popover-dialog"
      props=(Props.others props)>
      (fun () -> children ())
    </section>
end

module Heading = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let p = within "Popover.Heading" in
    <Kobalte.Title
      class_=(fun () -> after (Styles.Popover.heading p.slots) (class_ ()))
      props=(Props.others props)>
      (fun () -> children ())
    </Kobalte.Title>
end

module Arrow = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let p = within "Popover.Arrow" in
    p.set_arrow true;
    S.on_cleanup (fun () -> p.set_arrow false);
    let position, follow = Overlay.arrow_position () in
    Jsx.fragment
      [|
        <Kobalte.Arrow
          size=12. style="visibility: hidden;" ref=(fun k -> follow k)
        />;
        <div
          ?class_=(fun () -> class_ ())
          style=(fun () -> "position: absolute; " ^ position ())
          data_placement=(fun () -> Jsx.data (p.side ()))
          data_slot="popover-overlay-arrow-group"
          props=(Props.others props)>
          (fun () ->
            match children () with
            | Some c -> c
            | None ->
                Jsx.element
                  <svg
                    fill="none"
                    height="12"
                    view_box="0 0 12 12"
                    width="12"
                    xmlns="http://www.w3.org/2000/svg"
                    data_slot="popover-overlay-arrow">
                    <path d="M0 0C5.48483 8 6.5 8 12 0Z" />
                  </svg>)
        </div>;
      |]
end

let%component make ?(is_open : bool option) ?(default_open : bool option)
    ?(on_open_change : (bool -> unit) option) ~(children : Jsx.content) () =
  let kept, set_kept = S.create_signal false in
  S.create_computed (fun () ->
      S.set set_kept (Option.value (S.untrack default_open) ~default:false));
  let opened () = match is_open () with Some o -> o | None -> S.get kept in
  let placement, set_placement = S.create_signal `bottom in
  let offset, set_offset = S.create_signal 8. in
  let flip, set_flip = S.create_signal true in
  let arrow, set_arrow = S.create_signal false in
  let p =
    {
      slots = Styles.Popover.slots (Styles.Popover.options ());
      set_placement = S.set set_placement;
      set_offset = S.set set_offset;
      set_flip = S.set set_flip;
      set_arrow = S.set set_arrow;
      placement =
        (fun () ->
          match S.get placement with
          | `top -> "top"
          | `bottom -> "bottom"
          | `left -> "left"
          | `right -> "right");
      side = (fun () -> "bottom");
      dialog = None;
    }
  in
  let trigger_for_buttons =
    {
      Button.component = Kobalte.Trigger.component;
      is_disabled = None;
      controls = None;
      pressed = Some opened;
      needs_slot = false;
    }
  in
  <Kobalte.Root
    ?open_=(fun () -> is_open ())
    ?default_open=(fun () -> default_open ())
    on_open_change=(fun o ->
                     S.set set_kept o;
                     ignore (on_open_change o : unit option))
    modal=true
    placement=(fun () -> p.placement ())
    gutter=(fun () ->
             (* Kobalte puts half its arrow's height more between them, where
                HeroUI's offset is the whole gap. *)
             if S.get arrow then S.get offset -. 6. else S.get offset)
    flip=(fun () -> Types.Either.right (S.get flip))
    force_mount=true>
    <Button.Trigger.Provider value=(fun () -> trigger_for_buttons)>
      <Context.Provider value=(fun () -> p)>
        (fun () -> children ())
      </Context.Provider>
    </Button.Trigger.Provider>
  </Kobalte.Root>
