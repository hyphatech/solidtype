module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_headless.Slider
module I18n = Solidtype_kobalte.I18n
module Types = Solidtype_kobalte.Types

(* What a slider's parts read of it: its values, each as a reader reads it,
   where each is along the track, its orientation and state, its classes and
   its thumbs' ids. *)
type slider = {
  values : float array S.accessor;
  format : float -> string;
  percent : float -> float;
  orientation : [ `horizontal | `vertical ] S.accessor;
  disabled : bool S.accessor;
  slots : Styles.Slider.slots S.accessor;
  thumb_id : int -> string;
  min_value : float S.accessor;
  max_value : float S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = slider
end)

let within part =
  match Context.use () with
  | Some s -> s
  | None -> invalid_arg (part ^ " is used inside a Slider")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

let orientation_name = function
  | `horizontal -> "horizontal"
  | `vertical -> "vertical"

let percent p = Js.Float.toString (p *. 100.) ^ "%"

(* Where the fill starts and ends along the track, from 0 to 1: from the start,
   or a range's first thumb, to its last. *)
let fill_span s =
  let values = S.get s.values in
  match Array.length values with
  | 0 -> (0., 0.)
  | n ->
      let last = s.percent values.(n - 1) in
      let first = if n > 1 then s.percent values.(0) else 0. in
      (Float.min first last, Float.max first last)

(* A caller's style, after a part's own, which ends its last declaration. *)
let with_style own = function Some s -> own ^ " " ^ s | None -> own

(* A label in a slider is Kobalte's, which names it and its thumbs. *)
let label id : Label.slot =
 fun classes others children ->
  <Kobalte.Label
    id=(fun () -> id)
    class_=(fun () -> classes ())
    data_slot="label"
    props=others>
    (fun () -> children ())
  </Kobalte.Label>

module Output = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    orientation : [ `horizontal | `vertical ] Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option)
      ?(children : state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Output.props -> state -> Solidtype.Jsx.element) option)
      () =
    let s = within "Slider.Output" in
    let state () = { orientation = s.orientation; is_disabled = s.disabled } in
    <output
      for_=(fun () ->
             String.concat " "
               (Array.to_list
                  (Array.mapi (fun i _ -> s.thumb_id i) (S.get s.values))))
      aria_live=`off
      class_=(fun () ->
               after (Styles.Slider.output (S.get s.slots)) (S.get class_))
      data_disabled=(fun () -> Jsx.flag (S.get s.disabled))
      data_orientation=(fun () ->
                         Jsx.data (orientation_name (S.get s.orientation)))
      data_slot="slider-output"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some given -> Jsx.draw given (state ())
        | None ->
            Jsx.string
              (String.concat {js| – |js}
                 (Array.to_list (Array.map s.format (S.get s.values)))))
    </output>
  [@@element output]
end

module Track = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    orientation : [ `horizontal | `vertical ] Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option) ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let s = within "Slider.Track" in
    let filled () =
      let start, stop = fill_span s in
      match Array.length (S.get s.values) with
      | 1 -> (stop > 0., stop >= 1.)
      | _ -> (start <= 0., stop >= 1.)
    in
    let i = Interaction.create ~disabled:(fun () -> S.get s.disabled) () in
    let state () =
      {
        orientation = s.orientation;
        is_disabled = s.disabled;
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
      }
    in
    <Kobalte.Track
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(fun () ->
               after (Styles.Slider.track (S.get s.slots)) (S.get class_))
      style=(fun () -> with_style "position: relative;" (S.get style))
      data_disabled=(fun () -> Jsx.flag (S.get s.disabled))
      data_fill_start=(fun () -> Jsx.flag (fst (filled ())))
      data_fill_end=(fun () -> Jsx.flag (snd (filled ())))
      data_orientation=(fun () ->
                         Jsx.data (orientation_name (S.get s.orientation)))
      data_slot="slider-track"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </Kobalte.Track>
  [@@element div]
end

module Fill = struct
  let%component make ?(class_ : string option) ?(style : string option) () =
    let s = within "Slider.Fill" in
    <div
      class_=(fun () ->
               after (Styles.Slider.fill (S.get s.slots)) (S.get class_))
      style=(fun () ->
              let start, stop = fill_span s in
              let own =
                match S.get s.orientation with
                | `horizontal ->
                    "left: " ^ percent start ^ "; width: "
                    ^ percent (stop -. start)
                    ^ ";"
                | `vertical ->
                    "bottom: " ^ percent start ^ "; height: "
                    ^ percent (stop -. start)
                    ^ ";"
              in
              with_style own (S.get style))
      data_disabled=(fun () -> Jsx.flag (S.get s.disabled))
      data_slot="slider-fill"
      props=(Props.others props)
    />
  [@@element div]
end

module Thumb = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_dragging : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ?(index : int = 0) ?(class_ : string option)
      ?(style : string option)
      ?ref:(given_ref : (Dom.htmlSpanElement -> unit) option)
      ?(children : state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Span.props -> state -> Solidtype.Jsx.element) option)
      () =
    let s = within "Slider.Thumb" in
    let i = Interaction.create ~disabled:(fun () -> S.get s.disabled) () in
    (* Dragged while a pointer holds it, where a key held presses it but drags
       nothing, as React Aria's thumb is. *)
    let dragging () = Interaction.dragged i in
    let at () =
      let values = S.get s.values in
      if S.get index < Array.length values then s.percent values.(S.get index)
      else 0.
    in
    (* A thumb of a range moves between its neighbours, which bound it for a
       reader, as React Aria's do. *)
    let bound side default () =
      let values = S.get s.values in
      let near = S.get index + side in
      if near >= 0 && near < Array.length values then values.(near)
      else S.get default
    in
    let state () =
      {
        is_dragging = S.accessor (fun () -> dragging ());
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = s.disabled;
      }
    in
    <Kobalte.Thumb
      aria_valuemin=(fun () -> Js.Float.toString (bound (-1) s.min_value ()))
      aria_valuemax=(fun () -> Js.Float.toString (bound 1 s.max_value ()))
      aria_valuetext=(fun () ->
                       let values = S.get s.values in
                       if S.get index < Array.length values then
                         s.format values.(S.get index)
                       else "")
      class_=(fun () ->
               after (Styles.Slider.thumb (S.get s.slots)) (S.get class_))
      style=(fun () ->
              (* Placed as React Aria places it, centred on its value across
                 the track, which HeroUI's styles count on. *)
              let edge =
                match S.get s.orientation with
                | `horizontal -> "left: " ^ percent (at ())
                (* Kobalte holds a vertical thumb by its bottom, which would
                   stretch it with its top. *)
                | `vertical ->
                    "top: " ^ percent (1. -. at ()) ^ "; bottom: auto"
              in
              (* Shown as HeroUI's styles show it: Kobalte hides a thumb until
                 it is mounted, so a prerendered page would show none. *)
              with_style
                ("display: flex; position: absolute; " ^ edge
               ^ "; transform: translate(-50%, -50%);")
                (S.get style))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      data_disabled=(fun () -> Jsx.flag (S.get s.disabled))
      data_dragging=(fun () -> Jsx.flag (dragging ()))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_slot="slider-thumb"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)
      id=(fun () -> s.thumb_id (S.get index))>
      <Kobalte.Input />
      (fun () ->
        match S.get children with
        | Some c -> Jsx.draw c (state ())
        | None -> Jsx.string "")
    </Kobalte.Thumb>
  [@@element span]
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  orientation : [ `horizontal | `vertical ] Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
}

let%component make ?(value : float array option)
    ?(default_value : float array option)
    ?(on_change : (float array -> unit) option)
    ?(on_change_end : (float array -> unit) option) ?(min_value : float = 0.)
    ?(max_value : float = 100.) ?(step : float = 1.)
    ?(orientation : [ `horizontal | `vertical ] = `horizontal)
    ?(is_disabled : bool option) ?(name : string option)
    ?(aria_label : string option) ?(class_ : string option)
    ?(format_options : Types.NumberFormatOptions.t option)
    ?(on_blur : (Dom.focusEvent -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* Each value as HeroUI's formatOptions asks, a decimal by default, in
     Kobalte's locale: Kobalte formats a thumb's value as a decimal alone. *)
  let formatter =
    I18n.create_number_formatter
      (Types.Either.right
         (S.accessor (fun () ->
              match S.get format_options with
              | Some o -> o
              | None -> Types.NumberFormatOptions.make ~style:`decimal ())))
  in
  (* A slider is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with Some d -> d | None -> S.get in_fieldset)
  in
  let values, set =
    Field.controlled
      ~value:(fun () -> S.get value)
      ~default:
        (Option.value (S.get default_value) ~default:[| S.get min_value |])
      ~on_change
  in
  (* A slider is never invalid by itself, HeroUI's having no isInvalid, but
     a server's error for it refuses a submit. *)
  let in_form =
    Form.field ~name:(fun () -> S.get name) ~invalid:(fun () -> false)
  in
  (* Kobalte tells its values as it is made too; a change is values other
     than these. *)
  let change now =
    let was = S.get values in
    let same =
      Array.length now = Array.length was && Array.for_all2 Float.equal now was
    in
    if not same then (
      in_form.changed ();
      set now)
  in
  let id = S.create_unique_id () in
  let label_id = id ^ "-label" in
  let s =
    {
      values;
      format = (fun v -> Types.NumberFormat.format (S.get formatter) v);
      percent =
        (fun v ->
          let range = S.get max_value -. S.get min_value in
          if range <= 0. then 0. else (v -. S.get min_value) /. range);
      orientation;
      disabled;
      slots =
        S.accessor (fun () -> Styles.Slider.slots (Styles.Slider.options ()));
      thumb_id = (fun i -> id ^ "-thumb-" ^ string_of_int i);
      min_value;
      max_value;
    }
  in
  let state () = { orientation; is_disabled = disabled } in
  <Context.Provider value=(fun () -> s)>
    <Kobalte.Root
      value=(fun () -> S.get values)
      on_change=change
      on_change_end=(fun v -> ignore (on_change_end v : unit option))
      min_value=(fun () -> S.get min_value)
      max_value=(fun () -> S.get max_value)
      step=(fun () -> S.get step)
      orientation=(fun () -> S.get orientation)
      disabled=(fun () -> S.get disabled)
      ?name
      ?aria_label
      aria_labelledby=(fun () -> label_id)
      class_=(fun () ->
               after (Styles.Slider.base (S.get s.slots)) (S.get class_))
      data_disabled=(fun () -> Jsx.flag (S.get disabled))
      data_orientation=(fun () ->
                         Jsx.data (orientation_name (S.get orientation)))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            in_form.root e)
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     Field.on_leave
                       (fun e ->
                         in_form.left ();
                         on_blur e)
                       e)
      data_slot="slider"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Label.Slot.Provider value=(fun () -> label label_id)>
        (fun () -> Jsx.draw (S.get children) (state ()))
      </Label.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
