module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.TextField.Input
module Kobalte_combo_box = Solidtype_kobalte.Combobox.Input

module Props = struct
  type t

  external check :
    ?variant:[ `primary | `secondary ] Solidtype.Check.value ->
    ?full_width:bool Solidtype.Check.value ->
    ?as_:(Solidtype.Html.Input.props -> Solidtype.Jsx.element) ->
    ?props:'spread Solidtype.Solid.rest ->
    (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
    Solidtype.Html.Input.check = "check"
  [@@mel.module "vite-plugin-solidtype/markers"]

  external variant : t -> [ `primary | `secondary ] option = "variant"
  [@@mel.get]

  external full_width : t -> bool option = "fullWidth" [@@mel.get]
  external class_ : t -> string option = "class" [@@mel.get]
  external disabled : t -> bool option = "disabled" [@@mel.get]
  external aria_invalid : t -> string option = "aria-invalid" [@@mel.get]
  external title : t -> string option = "title" [@@mel.get]

  external ref : t -> ((Dom.htmlInputElement -> unit)[@u]) option = "ref"
  [@@mel.get]
end

(* The props this input takes for itself; the rest it passes on. *)
let own = [| "variant"; "fullWidth"; "class"; "title"; "ref" |]

(* Where an input is: alone, or a field's, whose state and variant are the
   field's. *)
type place =
  | Alone
  | In_text_field of Text_field.field
  | In_combo_box of Combo_box.field

let input ~classes ~slot (props : Props.t) =
  let place =
    match (Text_field.Context.use (), Combo_box.Field.use ()) with
    | Some f, _ -> In_text_field f
    | None, Some f -> In_combo_box f
    | None, None -> Alone
  in
  let rest = S.omit props own in
  (* A field's state is the field's; alone, it is what it is given, as React
     Aria's is. *)
  let disabled () =
    match place with
    | In_text_field f -> S.get f.disabled
    | In_combo_box f -> S.get f.disabled
    | Alone -> Option.value (Props.disabled props) ~default:false
  in
  let invalid () =
    match place with
    | In_text_field f -> S.get f.invalid
    | In_combo_box f -> S.get f.invalid
    | Alone -> (
        match Props.aria_invalid props with
        | Some "false" | None -> false
        | Some _ -> true)
  in
  let i = Interaction.create ~disabled:(fun () -> disabled ()) () in
  let classes () =
    classes
      ~variant:
        (match (Props.variant props, place) with
        | Some v, _ -> Some v
        | None, In_text_field f -> S.get f.variant
        | None, In_combo_box f -> Some (S.get f.variant)
        | None, Alone -> None)
  in
  match place with
  | In_text_field _ ->
      (* React Aria titles a field's input with nothing, so a browser shows no
         tooltip of its own for the field's validity. *)
      <Kobalte
        props=rest
        class_=(fun () -> classes ())
        ?title=(fun () ->
                 match Props.title props with
                 | Some t -> Some t
                 | None -> if disabled () then None else Some "")
        ref=(fun e ->
              Jsx.call (Props.ref props) e;
              Interaction.watch i e)
        data_slot=(fun () -> Jsx.data slot)
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (disabled ()))
        data_invalid=(fun () -> Jsx.flag (invalid ()))
      />
  | In_combo_box f ->
      <Kobalte_combo_box
        props=rest
        class_=(fun () -> classes ())
        ?title=(fun () ->
                 match Props.title props with
                 | Some t -> Some t
                 | None -> if disabled () then None else Some "")
        ?name=(fun () -> S.get f.name)
        ref=(fun e ->
              Jsx.call (Props.ref props) e;
              Interaction.watch i e)
        data_slot=(fun () -> Jsx.data slot)
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () ->
                             Jsx.flag
                               (Interaction.focus_visible i
                               || (Interaction.focused i && S.get f.returned)))
        data_disabled=(fun () -> Jsx.flag (disabled ()))
        data_invalid=(fun () -> Jsx.flag (invalid ()))
      />
  | Alone ->
      <input
        ?as_=(fun () -> S.drawn_as props)
        props=(S.undrawn rest)
        class_=(fun () -> classes ())
        ?title=(fun () -> Props.title props)
        ref=(fun e ->
              Jsx.call (Props.ref props) e;
              Interaction.watch i e)
        data_slot=(fun () -> Jsx.data slot)
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (disabled ()))
        data_invalid=(fun () -> Jsx.flag (invalid ()))
      />

let make (props : Props.t) =
  input props ~slot:"input" ~classes:(fun ~variant ->
      Styles.Input.classes
        (Styles.Input.options ?full_width:(Props.full_width props) ?variant
           ?class_:(Props.class_ props) ()))

let component = Jsx.component make
