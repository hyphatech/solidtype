module Jsx = Solidtype.Jsx
module S = Solidtype.Solid

type animation
type animate_method
type keyframe
type options

(* jsdom, and a browser too old, has no Web Animations. *)
external animate_method : _ Dom.element_like -> animate_method Js.undefined
  = "animate"
[@@mel.get]

external keyframe :
  background_position:(string[@mel.as "backgroundPosition"]) -> unit -> keyframe
  = ""
[@@mel.obj]

external options :
  duration:float -> easing:string -> iterations:float -> unit -> options = ""
[@@mel.obj]

external animate : _ Dom.element_like -> keyframe array -> options -> animation
  = "animate"
[@@mel.send]

external cancel : animation -> unit = "cancel" [@@mel.send]

(* A class added after the shimmer's own and merged with them. *)
let after base = function
  | Some c ->
      Option.value (Js.Undefined.toOption (Styles.cn base c)) ~default:""
  | None -> base

(* The band, three times the text's width so a position from 100% to 0%
   carries its peak from half a width before the text to half after it, as
   Pro's travels; 4ch of falloff on each side, measured from Pro's demo. Its
   colour is the text's own: the copy hides its glyphs by their fill, never
   by its colour, which the band is drawn in. *)
let highlight_class =
  "text-shimmer__highlight pointer-events-none absolute inset-0 block \
   select-none [-webkit-text-fill-color:transparent] bg-clip-text bg-no-repeat \
   bg-size-[300%_100%] \
   bg-[linear-gradient(90deg,transparent_calc(50%-4ch),currentColor_50%,transparent_calc(50%+4ch))] \
   motion-reduce:hidden"

(* 2.5 seconds a sweep, eased, without end, as Pro's demo runs. *)
let sweep e =
  animate e
    [|
      keyframe ~background_position:"100% 0" ();
      keyframe ~background_position:"0% 0" ();
    |]
    (options ~duration:2500. ~easing:"ease" ~iterations:infinity ())

let%component make ?(class_ : string option) ~(children : Jsx.content) () =
  let running = ref None in
  S.on_cleanup (fun () -> Option.iter cancel !running);
  <span
    class_=(fun () ->
             after "text-shimmer relative inline-block w-fit" (class_ ()))
    data_slot="text-shimmer"
    props=(Props.others props)>
    <span
      class_="text-shimmer__text block text-current/45 \
              motion-reduce:text-current"
      data_slot="text-shimmer-text">
      (fun () -> children ())
    </span>
    <span
      aria_hidden=true
      inert=(Jsx.bool true)
      class_=highlight_class
      data_slot="text-shimmer-highlight"
      ref=(fun e ->
            match Js.Undefined.toOption (animate_method e) with
            | Some _ -> running := Some (sweep e)
            | None -> ())>
      (fun () -> children ())
    </span>
  </span>
