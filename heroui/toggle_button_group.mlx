module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.ToggleGroup

type size = [ `sm | `md | `lg ]

type group = {
  size : size option S.accessor;
  is_disabled : bool option S.accessor;
  is_selected : string -> bool;
  join : (unit -> bool) -> unit;
}

(* The orientation a part above gives a group inside it that gives none, as
   React Aria's ToggleButtonGroupContext does: a toolbar's own. *)
module Orientation = Solidtype.Context.Make_optional (struct
  type t = [ `horizontal | `vertical ] S.accessor
end)

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

module Separator = struct
  let%component make ?(class_ : string option) () =
    <span
      aria_hidden=true
      class_=(let separator =
                Styles.ToggleButtonGroup.separator
                  (Styles.ToggleButtonGroup.slots
                     (Styles.ToggleButtonGroup.options ()))
              in
              match S.get class_ with
              | Some c -> separator ^ " " ^ c
              | None -> separator)
      data_slot="toggle-button-group-separator"
      props=(Props.others props)
    />
  [@@element span]
end

(* What its children are drawn of: React Aria's render props for a toggle
   button group. *)
type state = {
  orientation : [ `horizontal | `vertical ] S.accessor;
  is_disabled : bool S.accessor;
}

let%component make ?(selection_mode : [ `single | `multiple ] = `single)
    ?(selected_keys : string array option)
    ?(default_selected_keys : string array option)
    ?(on_selection_change : (string array -> unit) option)
    ?(disallow_empty_selection : bool = false)
    ?(orientation : [ `horizontal | `vertical ] option) ?(size : size option)
    ?(is_detached : bool = false) ?(full_width : bool = false)
    ?(is_disabled : bool option) ?(aria_label : string option)
    ?(aria_labelledby : string option) ?(class_ : string option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let around = Orientation.use () in
  let orientation =
    S.accessor (fun () ->
        match (S.get orientation, around) with
        | Some o, _ -> o
        | None, Some o -> S.get o
        | None, None -> `horizontal)
  in
  (* The selection is kept here and Kobalte's group controlled by it, so a
     change that would leave none selected is refused, which Kobalte's group
     cannot do. *)
  let keys, set_keys =
    Field.controlled
      ~value:(fun () -> S.get selected_keys)
      ~default:(Option.value (S.get default_selected_keys) ~default:[||])
      ~on_change:(fun k -> on_selection_change k)
  in
  let change next =
    if not (S.get disallow_empty_selection && Array.length next = 0) then
      set_keys next
  in
  (* Each button's read of whether it is disabled. Kobalte's keys look past a
     disabled button for one that is not, round and round, so Kobalte's group
     is disabled while every button in it is, and a click finds nothing to
     focus. *)
  let buttons, set_buttons = S.create_signal [] in
  let join disabled =
    S.update set_buttons (fun bs -> disabled :: bs);
    S.on_cleanup (fun () ->
        S.update set_buttons (List.filter (fun b -> b != disabled)))
  in
  let all_disabled () =
    match S.get buttons with
    | [] -> false
    | bs -> List.for_all (fun disabled -> disabled ()) bs
  in
  let g =
    {
      size;
      is_disabled;
      is_selected = (fun key -> Array.exists (String.equal key) (S.get keys));
      join;
    }
  in
  let class_ () =
    let base =
      Styles.ToggleButtonGroup.base
        (Styles.ToggleButtonGroup.slots
           (Styles.ToggleButtonGroup.options ~orientation:(S.get orientation)
              ~is_detached:(S.get is_detached) ~full_width:(S.get full_width) ()))
    in
    match S.get class_ with Some c -> base ^ " " ^ c | None -> base
  in
  let disabled () = Option.value (S.get is_disabled) ~default:false in
  let state =
    { orientation; is_disabled = S.accessor (fun () -> disabled ()) }
  in
  (* A button decides whether it is disabled, its own prop over the group's,
     so Kobalte's group, which would disable every button whatever it says,
     is disabled only while they all are. *)
  <Context.Provider value=g>
    <Show
      when_=(match S.get selection_mode with
            | `multiple -> true
            | `single -> false)
      fallback=(<Kobalte.Root
                  value=(match S.get keys with
                        | [||] -> Js.Null.empty
                        | ks -> Js.Null.return ks.(0))
                  orientation=(S.get orientation)
                  disabled=(all_disabled ())
                  ?aria_label=(S.get aria_label)
                  ?aria_labelledby=(S.get aria_labelledby)
                  class_=(class_ ())
                  data_slot="toggle-button-group"
                  data_disabled=(Jsx.flag (disabled ()))
                  ?as_=(Option.map (fun f p -> f p state) (S.get as_))
                  props=(Props.others props)
                  on_change=(fun v ->
                              change
                                (match Js.Nullable.toOption v with
                                | Some k -> [| k |]
                                | None -> [||]))>
                  (Jsx.draw (S.get children) state)
                </Kobalte.Root>)>
      <Kobalte.Root_multiple
        multiple=true
        value=(S.get keys)
        orientation=(S.get orientation)
        disabled=(all_disabled ())
        ?aria_label=(S.get aria_label)
        ?aria_labelledby=(S.get aria_labelledby)
        class_=(class_ ())
        data_slot="toggle-button-group"
        data_disabled=(Jsx.flag (disabled ()))
        ?as_=(Option.map (fun f p -> f p state) (S.get as_))
        props=(Props.others props)
        on_change=change>
        (Jsx.draw (S.get children) state)
      </Kobalte.Root_multiple>
    </Show>
  </Context.Provider>
[@@element div]
