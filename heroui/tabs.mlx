module Jsx = Solidtype.Jsx
module Solid = Solidtype.Solid
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Tabs
module Types = Solidtype_kobalte.Types
module Gravity = Solidtype_gravity_icons

type css_style

external computed_style : _ Dom.element_like -> css_style = "getComputedStyle"

external property_value : css_style -> string -> string = "getPropertyValue"
[@@mel.send]

external queue_microtask : (unit -> unit) -> unit = "queueMicrotask"

(* What a tabs' parts read of it: its classes and orientation, and its
   indicators. *)
type tabs = {
  slots : Styles.Tabs.slots Solid.accessor;
  orientation : [ `horizontal | `vertical ] Solid.accessor;
  indicators : Selection_indicator.t;
  tab_id : string -> string;
      (* The id of the tab of a key, which its panel is labelled by, and,
         with "-panel", of the panel it controls: Kobalte reads each from a
         map the other fills as it is made, which a panel made later than its
         tab, or before, never finds. *)
  links : (string, unit) Hashtbl.t;
      (* The keys of the tabs that are links, which a press or a key follows
         and never selects, as React Aria's do. *)
}

module Context = Solidtype.Context.Make_optional (struct
  type t = tabs
end)

(* What a tab's parts read of it. *)
type tab = { selected : bool Solid.accessor }

module Tab_context = Solidtype.Context.Make_optional (struct
  type t = tab
end)

let within part =
  match Context.use () with
  | Some t -> t
  | None -> invalid_arg (part ^ " is used inside a Tabs")

let within_tab part =
  match (Context.use (), Tab_context.use ()) with
  | Some t, Some tab -> (t, tab)
  | None, _ | _, None -> invalid_arg (part ^ " is used inside a Tabs.Tab")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

external first_element_child : _ Dom.element_like -> Dom.element Js.null
  = "firstElementChild"
[@@mel.get]

external client_width : Dom.element -> float = "clientWidth" [@@mel.get]
external client_height : Dom.element -> float = "clientHeight" [@@mel.get]
external scroll_width : Dom.element -> float = "scrollWidth" [@@mel.get]
external scroll_height : Dom.element -> float = "scrollHeight" [@@mel.get]
external scroll_left : Dom.element -> float = "scrollLeft" [@@mel.get]
external scroll_top : Dom.element -> float = "scrollTop" [@@mel.get]

type scroll_options

external scroll_options :
  behavior:string -> ?left:float -> ?top:float -> unit -> scroll_options = ""
[@@mel.obj]

external scroll_to : Dom.element -> scroll_options -> unit = "scrollTo"
[@@mel.send]

module List_container = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let t = within "Tabs.List_container" in
    let container = ref None in
    let vertical () =
      match Solid.get t.orientation with
      | `vertical -> true
      | `horizontal -> false
    in
    (* Most of a view on, toward the start or the end, and no further than
       the list goes, as HeroUI's chevrons scroll it; in a right-to-left page
       the start is on the right, where scrolling runs below zero. *)
    let scroll_by direction =
      match
        Option.bind !container (fun c ->
            Js.Null.toOption (first_element_child c))
      with
      | None -> ()
      | Some scroller ->
          let vertical = vertical () in
          let size =
            if vertical then client_height scroller else client_width scroller
          in
          let full =
            if vertical then scroll_height scroller else scroll_width scroller
          in
          let most = Float.max 0. (full -. size) in
          let rtl =
            (not vertical)
            && String.equal
                 (property_value (computed_style scroller) "direction")
                 "rtl"
          in
          let current =
            if vertical then scroll_top scroller else scroll_left scroller
          in
          let delta = direction *. size *. 0.8 *. if rtl then -1. else 1. in
          let low, high = if rtl then (-.most, 0.) else (0., most) in
          let next = Float.min high (Float.max low (current +. delta)) in
          if not (Float.equal next current) then
            scroll_to scroller
              (if vertical then scroll_options ~behavior:"smooth" ~top:next ()
               else scroll_options ~behavior:"smooth" ~left:next ())
    in
    let slots () = Solid.get t.slots in
    <div
      class_=(fun () ->
               after
                 (Styles.Tabs.tab_list_container (slots ()))
                 (Solid.get class_))
      ref=(fun e -> container := Some e)
      data_slot="tabs-list-container"
      props=(Props.others props)>
      <Scroll_shadow
        class_=(fun () -> Styles.Tabs.scroller (slots ()))
        hide_scroll_bar=true
        orientation=(fun () -> Solid.get t.orientation)
        size=64>
        (fun () -> Solid.get children)
      </Scroll_shadow>
      <button
        aria_label=(fun () ->
                     if vertical () then "Scroll tabs up"
                     else "Scroll tabs left")
        class_=(fun () -> Styles.Tabs.scroll_prev (slots ()))
        tab_index="-1"
        type_=`button
        on_click=(fun _ -> scroll_by (-1.))>
        (fun () ->
          if vertical () then
            Jsx.element
              <Gravity.Chevron_up aria_hidden=true role=`presentation />
          else
            Jsx.element
              <Gravity.Chevron_left aria_hidden=true role=`presentation />)
      </button>
      <button
        aria_label=(fun () ->
                     if vertical () then "Scroll tabs down"
                     else "Scroll tabs right")
        class_=(fun () -> Styles.Tabs.scroll_next (slots ()))
        tab_index="-1"
        type_=`button
        on_click=(fun _ -> scroll_by 1.)>
        (fun () ->
          if vertical () then
            Jsx.element
              <Gravity.Chevron_down aria_hidden=true role=`presentation />
          else
            Jsx.element
              <Gravity.Chevron_right aria_hidden=true role=`presentation />)
      </button>
    </div>
  [@@element div]
end

(* Kobalte's trigger as the element a tab is: an [<a>] while it is a link, a
   [<button>] else. *)
module As_tab = struct
  module Props = struct
    external check :
      value:string Solidtype.Check.value ->
      ?disabled:bool Solidtype.Check.value ->
      ?as_:Jsx.drawn Solidtype.Check.value ->
      ?props:'spread Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.A.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Trigger.component
end

(* A tab is an anchor or a button, as it has an href or not: its ref is handed
   either, which Kobalte's part, typed by the anchor's attributes, calls an
   anchor. *)
external as_html : Dom.htmlAnchorElement -> Dom.htmlElement = "%identity"

module Tab = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_selected : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ~(id : string) ?(href : string option)
      ?(is_disabled : bool = false) ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ : (Solidtype.Html.A.props -> state -> Solidtype.Jsx.element) option)
      () =
    let t = within "Tabs.Tab" in
    let k = Kobalte.use_tabs_context () in
    let selected =
      Solid.accessor (fun () ->
          Option.equal String.equal
            (Solid.get
               (Types.SingleSelectListState.selected_key
                  (Solid.get (Types.TabsContextValue.list_state k))))
            (Some (Solid.get id)))
    in
    let disabled () =
      Solid.get is_disabled || Solid.get (Types.TabsContextValue.is_disabled k)
    in
    let n = Interaction.create ~disabled () in
    (* A disabled link has no [href], since [disabled] keeps no [<a>] from
       being followed. *)
    let link () = if disabled () then None else Solid.get href in
    Solid.create_computed (fun () ->
        let key = Solid.get id in
        match Solid.get href with
        | Some _ ->
            Hashtbl.replace t.links key ();
            Solid.on_cleanup (fun () -> Hashtbl.remove t.links key)
        | None -> ());
    let state () =
      {
        is_hovered = Solid.accessor (fun () -> Interaction.hovered n);
        is_pressed = Solid.accessor (fun () -> Interaction.pressed n);
        is_focused = Solid.accessor (fun () -> Interaction.focused n);
        is_focus_visible =
          Solid.accessor (fun () -> Interaction.focus_visible n);
        is_selected = selected;
        is_disabled = Solid.accessor (fun () -> Interaction.disabled n);
      }
    in
    <As_tab
      as_=(fun () ->
            Jsx.drawn_as
              (Option.map (fun f p -> f p (state ())) (Solid.get as_))
              (match link () with Some _ -> "a" | None -> "button"))
      ?href=(fun () -> link ())
      id=(fun () -> t.tab_id (Solid.get id))
      value=(fun () -> Solid.get id)
      disabled=(fun () -> Solid.get is_disabled)
      class_=(fun () ->
               after (Styles.Tabs.tab (Solid.get t.slots)) (Solid.get class_))
      ref=(fun b ->
            ignore (given_ref (as_html b) : unit option);
            Interaction.watch n b)
      data_slot="tabs-tab"
      data_selected=(fun () -> Jsx.flag (Solid.get selected))
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered n))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed n))
      data_focused=(fun () -> Jsx.flag (Interaction.focused n))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible n))
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled n))
      props=(Props.others props)
            (* The panel a selected tab names is the tabs', which an attribute in
         the rest must not replace. *)
      ?aria_controls=(fun () ->
                       if Solid.get selected then
                         Some (t.tab_id (Solid.get id) ^ "-panel")
                       else None)>
      <Tab_context.Provider value=(fun () -> { selected })>
        (fun () -> Jsx.draw (Solid.get children) (state ()))
      </Tab_context.Provider>
    </As_tab>
  [@@element a]
end

module Indicator = struct
  let%component make ?(class_ : string option) () =
    let t, tab = within_tab "Tabs.Indicator" in
    (* Made each time its tab is selected. *)
    let indicator () =
      let i = Selection_indicator.indicator t.indicators in
      <div
        class_=(fun () ->
                 after
                   (Styles.Tabs.tab_indicator (Solid.get t.slots))
                   (Solid.get class_))
        ref=(fun e -> i.ref e)
        data_slot="tabs-indicator"
        data_entering=(fun () -> Jsx.flag (Solid.get i.entering))
        props=(Props.others props)
      />
    in
    <Show when_=(fun () -> Solid.get tab.selected)>
      (fun () -> Jsx.element (indicator ()))
    </Show>
  [@@element div]
end

module Separator = struct
  let%component make ?(class_ : string option) () =
    let t, (_ : tab) = within_tab "Tabs.Separator" in
    <span
      aria_hidden=true
      class_=(fun () ->
               after
                 (Styles.Tabs.separator (Solid.get t.slots))
                 (Solid.get class_))
      data_slot="tabs-separator"
      props=(Props.others props)
    />
  [@@element span]
end

module Panel = struct
  let%component make ~(id : string) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let t = within "Tabs.Panel" in
    let k = Kobalte.use_tabs_context () in
    (* On the page while its tab is selected, as React Aria's panel is:
       Kobalte's, kept mounted, would wait for an animation to end before it
       left, which HeroUI's styles do not give a panel. React Aria's panel
       names no orientation, so HeroUI's spacing by it never reaches the page;
       Kobalte's names one, which an empty one overrides. *)
    <Show
      when_=(fun () ->
              Option.equal String.equal
                (Solid.get
                   (Types.SingleSelectListState.selected_key
                      (Solid.get (Types.TabsContextValue.list_state k))))
                (Some (Solid.get id)))>
      <Kobalte.Content
        value=(fun () -> Solid.get id)
        force_mount=true
        id=(fun () -> t.tab_id (Solid.get id) ^ "-panel")
        aria_labelledby=(fun () -> t.tab_id (Solid.get id))
        class_=(fun () ->
                 after
                   (Styles.Tabs.tab_panel (Solid.get t.slots))
                   (Solid.get class_))
        data_slot="tabs-panel"
        data_orientation=(fun () -> Jsx.data "")
        props=(Props.others props)>
        (fun () -> Solid.get children)
      </Kobalte.Content>
    </Show>
  [@@element div]
end

(* Last, since it takes the name of the stdlib's lists. *)
module List = struct
  let%component make ?(aria_label : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let t = within "Tabs.List" in
    <Kobalte.List
      ?aria_label
      class_=(fun () ->
               after
                 (Styles.Tabs.tab_list (Solid.get t.slots))
                 (Solid.get class_))
      data_slot="tabs-list"
      props=(Props.others props)>
      (fun () -> Solid.get children)
    </Kobalte.List>
  [@@element div]
end

let%component make ?(selected_key : string option)
    ?(default_selected_key : string option)
    ?(on_selection_change : (string -> unit) option)
    ?(orientation : [ `horizontal | `vertical ] = `horizontal)
    ?(variant : [ `primary | `secondary ] = `primary)
    ?(align : [ `start | `center | `end_ ] = `center)
    ?(keyboard_activation : [ `automatic | `manual ] = `automatic)
    ?(is_disabled : bool = false) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let t =
    {
      slots =
        Solid.accessor (fun () ->
            Styles.Tabs.slots
              (Styles.Tabs.options ~align:(Solid.get align)
                 ~variant:(Solid.get variant) ()));
      orientation;
      indicators = Selection_indicator.create ();
      tab_id =
        (let ids = Hashtbl.create 8 in
         fun key ->
           match Hashtbl.find_opt ids key with
           | Some id -> id
           | None ->
               let id = Solid.create_unique_id () in
               Hashtbl.replace ids key id;
               id);
      links = Hashtbl.create 8;
    }
  in
  (* Kobalte is given the key selected while there is one, so a link's key it
     selects is refused unseen; its first, while none is, stands, as React
     Aria selects a first tab that is a link. *)
  let kept, keep = Solid.create_signal (Solid.get default_selected_key) in
  let selected =
    Solid.accessor (fun () ->
        match Solid.get selected_key with
        | Some key -> Some key
        | None -> Solid.get kept)
  in
  (* Kobalte tells a selection twice as the arrows go round from the last tab
     to the first, in one press; React Aria tells each press once. *)
  let just_told = ref None in
  let tell key =
    match !just_told with
    | Some k when String.equal k key -> ()
    | Some _ | None ->
        just_told := Some key;
        queue_microtask (fun () -> just_told := None);
        ignore (on_selection_change key : unit option)
  in
  let change key =
    match (Hashtbl.mem t.links key, Solid.get selected) with
    | true, Some _ -> ()
    | true, None | false, (Some _ | None) ->
        Solid.set keep (Some key);
        tell key
  in
  <Kobalte.Root
    ?value=selected
    orientation=(fun () -> Solid.get orientation)
    activation_mode=(fun () -> Solid.get keyboard_activation)
    disabled=(fun () -> Solid.get is_disabled)
    class_=(fun () ->
             after (Styles.Tabs.base (Solid.get t.slots)) (Solid.get class_))
    data_slot="tabs"
    data_disabled=(fun () -> Jsx.flag (Solid.get is_disabled))
    props=(Props.others props)
    on_change=change>
    <Context.Provider value=(fun () -> t)>
      (fun () -> Solid.get children)
    </Context.Provider>
  </Kobalte.Root>
[@@element div]
