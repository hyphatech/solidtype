module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Hex = Solidtype_headless.Color_field
module Channel = Solidtype_headless.Color_channel_field
module Color = Solidtype_kobalte.Types.Color

type channel =
  [ `hue
  | `saturation
  | `brightness
  | `lightness
  | `red
  | `green
  | `blue
  | `alpha ]

external query : Dom.htmlDivElement -> string -> Dom.htmlElement Js.null
  = "querySelector"
[@@mel.send]

external focus : Dom.htmlElement -> unit = "focus" [@@mel.send]
external target : Dom.mouseEvent -> Dom.element = "target" [@@mel.get]

external contains : Dom.htmlElement -> Dom.element -> bool = "contains"
[@@mel.send]

(* What a field's parts read of it: its kind and its state. *)
type field = {
  aria_label : string option S.accessor;
  by_channel : bool;
  disabled : bool S.accessor;
  invalid : bool S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = field
end)

let within part =
  match Context.use () with
  | Some f -> f
  | None -> invalid_arg (part ^ " is used inside a Color_field")

(* A group's classes, which its parts read. *)
module Group_context = Solidtype.Context.Make_optional (struct
  type t = Styles.ColorInputGroup.slots S.accessor
end)

let in_group part =
  match Group_context.use () with
  | Some slots -> slots
  | None -> invalid_arg (part ^ " is used inside a Color_field.Group")

(* A channel's name, as React Aria writes it in [data-channel]. *)
let channel_name : channel -> string = function
  | `hue -> "hue"
  | `saturation -> "saturation"
  | `brightness -> "brightness"
  | `lightness -> "lightness"
  | `red -> "red"
  | `green -> "green"
  | `blue -> "blue"
  | `alpha -> "alpha"

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Hex_parts = Field.Slots (struct
  let label = Hex.Label.component
  let description = Hex.Description.component
  let error = Hex.ErrorMessage.component
end)

module Channel_parts = Field.Slots (struct
  let label = Channel.Label.component
  let description = Channel.Description.component
  let error = Channel.ErrorMessage.component
end)

module Prefix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_group "Color_field.Prefix" in
    <div
      class_=(fun () ->
               after
                 (Styles.ColorInputGroup.prefix (S.get slots))
                 (S.get class_))
      data_slot="color-input-group-prefix"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Suffix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_group "Color_field.Suffix" in
    <div
      class_=(fun () ->
               after
                 (Styles.ColorInputGroup.suffix (S.get slots))
                 (S.get class_))
      data_slot="color-input-group-suffix"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Input = struct
  let%component make ?(placeholder : string option) ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlInputElement -> unit) option) () =
    let f = within "Color_field.Input" in
    let slots = in_group "Color_field.Input" in
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    let classes () =
      after (Styles.ColorInputGroup.input (S.get slots)) (S.get class_)
    in
    let watched e =
      ignore (given_ref e : unit option);
      Interaction.watch i e
    in
    if f.by_channel then
      <Channel.Input
        ?aria_label=(fun () -> S.get f.aria_label)
        ?placeholder
        class_=(fun () -> classes ())
        ref=watched
        data_slot="color-input-group-input"
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
        data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
        props=(Props.others props) />
    else
      (* React Aria names a hex field's input a text box, as it is. *)
      <Hex.Input
        role=`textbox
        ?aria_label=(fun () -> S.get f.aria_label)
        ?placeholder
        class_=(fun () -> classes ())
        ref=watched
        data_slot="color-input-group-input"
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
        data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
        props=(Props.others props) />
  [@@element input]
end

module Group = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_focus_within : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
  }

  let%component make ?(variant : [ `primary | `secondary ] option)
      ?(full_width : bool option) ?(class_ : string option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let f = within "Color_field.Group" in
    let slots =
      S.accessor (fun () ->
          Styles.ColorInputGroup.slots
            (Styles.ColorInputGroup.options ?full_width:(S.get full_width)
               ?variant:(S.get variant) ()))
    in
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    let element = ref None in
    (* A press on the group but on its input gives the input the focus. *)
    let clicked e =
      ignore (on_click e : unit option);
      match !element with
      | Some group -> (
          match Js.Null.toOption (query group "input") with
          | Some input when not (contains input (target e)) -> focus input
          | Some _ | None -> ())
      | None -> ()
    in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_focus_within = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = f.disabled;
        is_invalid = f.invalid;
      }
    in
    <Group_context.Provider value=(fun () -> slots)>
      (* In a field, the field is the group, as React Aria's is. *)
      <div
        role=`presentation
        ref=(fun e ->
              element := Some e;
              Interaction.watch i e)
        on_click=clicked
        class_=(fun () ->
                 after
                   (Styles.ColorInputGroup.base (S.get slots))
                   (S.get class_))
        data_slot="color-input-group"
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focus_within=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
        data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
        ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
        props=(Props.others props)>
        (fun () -> Jsx.draw (S.get children) (state ()))
      </div>
    </Group_context.Provider>
  [@@element div]
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  is_disabled : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let%component make ?(value : Color.t Js.Nullable.t option)
    ?(default_value : Color.t option)
    ?(on_change : (Color.t option -> unit) option) ?(channel : channel option)
    ?(color_space : [ `rgb | `hsl | `hsb ] option) ?(full_width : bool option)
    ?(is_required : bool = false) ?(is_invalid : bool = false)
    ?(is_disabled : bool option) ?(is_read_only : bool = false)
    ?(is_wheel_disabled : bool = false) ?(name : string option)
    ?(aria_label : string option) ?(on_blur : (Dom.focusEvent -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(class_ : string option) ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with Some d -> d | None -> S.get in_fieldset)
  in
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid =
    S.accessor (fun () ->
        S.get is_invalid || Option.is_some (S.get in_form.error))
  in
  (* A change is a form's too, which clears the error it showed. *)
  let changed c =
    in_form.changed ();
    ignore (on_change c : unit option)
  in
  let by_channel = Option.is_some (S.untrack (fun () -> S.get channel)) in
  let f = { aria_label; by_channel; disabled; invalid } in
  let classes () =
    Styles.ColorField.classes
      (Styles.ColorField.options ?full_width:(S.get full_width)
         ?class_:(S.get class_) ())
  in
  let leave e =
    ignore (on_focus_out e : unit option);
    Field.on_leave
      (fun e ->
        in_form.left ();
        on_blur e)
      e
  in
  let root e =
    ignore (given_ref e : unit option);
    in_form.root e
  in
  let state () =
    { is_disabled = disabled; is_invalid = invalid; is_read_only; is_required }
  in
  <Context.Provider value=(fun () -> f)>
    (fun () ->
      match S.untrack (fun () -> S.get channel) with
      | Some ch ->
          Jsx.element
            <Channel.Root
              channel=(fun () -> ch)
              ?color_space
              ?value
              ?default_value
              on_change=changed
              change_on_wheel=(fun () -> not (S.get is_wheel_disabled))
              validation_state=(fun () ->
                                 if S.get invalid then `invalid else `valid)
              required=(fun () -> S.get is_required)
              disabled=(fun () -> S.get disabled)
              read_only=(fun () -> S.get is_read_only)
              ?name
              class_=(fun () -> classes ())
              ref=root
              on_focus_out=leave
              data_slot="color-field"
              data_channel=(fun () -> Jsx.data (channel_name ch))
              data_required=(fun () -> Jsx.flag (S.get is_required))
              data_invalid=(fun () -> Jsx.flag (S.get invalid))
              data_disabled=(fun () -> Jsx.flag (S.get disabled))
              data_readonly=(fun () -> Jsx.flag (S.get is_read_only))
              ?as_=(fun () ->
                     Option.map (fun f p -> f p (state ())) (S.get as_))
              props=(Props.others props)>
              <Field_error.Message.Provider value=(fun () -> in_form.error)>
                <Channel_parts>
                  (fun () -> Jsx.draw (S.get children) (state ()))
                </Channel_parts>
              </Field_error.Message.Provider>
            </Channel.Root>
      | None ->
          Jsx.element
            <Hex.Root
              ?value
              ?default_value
              on_change=changed
              change_on_wheel=(fun () -> not (S.get is_wheel_disabled))
              validation_state=(fun () ->
                                 if S.get invalid then `invalid else `valid)
              required=(fun () -> S.get is_required)
              disabled=(fun () -> S.get disabled)
              read_only=(fun () -> S.get is_read_only)
              ?name
              class_=(fun () -> classes ())
              ref=root
              on_focus_out=leave
              data_slot="color-field"
              data_channel="hex"
              data_required=(fun () -> Jsx.flag (S.get is_required))
              data_invalid=(fun () -> Jsx.flag (S.get invalid))
              data_disabled=(fun () -> Jsx.flag (S.get disabled))
              data_readonly=(fun () -> Jsx.flag (S.get is_read_only))
              ?as_=(fun () ->
                     Option.map (fun f p -> f p (state ())) (S.get as_))
              props=(Props.others props)>
              <Field_error.Message.Provider value=(fun () -> in_form.error)>
                <Hex_parts>
                  (fun () ->
                    Jsx.draw (S.get children)
                      {
                        is_disabled = disabled;
                        is_invalid = invalid;
                        is_read_only;
                        is_required;
                      })
                </Hex_parts>
              </Field_error.Message.Provider>
            </Hex.Root>)
  </Context.Provider>
[@@element div]
