module Headless = Solidtype_headless.Color_swatch
module Color = Solidtype_kobalte.Types.Color

(* HeroUI's styles paint the colour over a checkerboard, read from a variable
   of their own. *)
let painted color style =
  "--color-swatch-current: "
  ^ Color.to_string color ~format:`rgba ()
  ^ match style with Some s -> "; " ^ s | None -> ""

let%component make ~(color : Color.t) ?(color_name : string option)
    ?(aria_label : string option) ?(shape : [ `circle | `square ] option)
    ?(size : [ `xs | `sm | `md | `lg | `xl ] option) ?(class_ : string option)
    ?(style : string option) () =
  <Headless
    value=(fun () -> color ())
    ?color_name
    ?aria_label
    class_=(fun () ->
             Styles.ColorSwatch.classes
               (Styles.ColorSwatch.options ?shape:(shape ()) ?size:(size ())
                  ?class_:(class_ ()) ()))
    style=(fun () -> painted (color ()) (style ()))
    data_slot="color-swatch"
    props=(Props.others props)
  />
