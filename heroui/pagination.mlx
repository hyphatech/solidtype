module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.Button
module Gravity = Solidtype_gravity_icons

module Context = Solidtype.Context.Make_optional (struct
  type t = unit -> Styles.Pagination.slots
end)

let within part =
  match Context.use () with
  | Some slots -> slots
  | None -> invalid_arg (part ^ " is used inside a Pagination")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* A page, Previous or Next: Kobalte's button with the state HeroUI's styles
   read, kept as React Aria keeps it. *)
let button ~slot ~classes ~is_active ~is_disabled ~on_press ~on_click ~given_ref
    ~others children =
  let i = Interaction.create ~disabled:(fun[@u] () -> is_disabled ()) () in
  <Kobalte.Root
    class_=(fun () -> classes ())
    ?aria_current=(fun () -> if is_active () then Some "page" else None)
    on_click=(fun e ->
               ignore (on_click e : unit option);
               ignore (on_press () : unit option))
    ref=(fun b ->
          ignore (given_ref b : unit option);
          Interaction.watch i b)
    data_slot=(fun () -> Jsx.data slot)
    data_active=(fun () -> Jsx.flag (is_active ()))
    data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
    data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
    data_focused=(fun () -> Jsx.flag (Interaction.focused i))
    data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
    data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
    props=others
    disabled=(fun () -> is_disabled ())>
    (fun () -> children ())
  </Kobalte.Root>

module Summary = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Summary" in
    (* Its direction from its own text, so "1 to 5 of 10" keeps its order
       under a right-to-left page, as HeroUI's does. *)
    <div
      class_=(fun () ->
               after (Styles.Pagination.summary (slots ())) (class_ ()))
      data_slot="pagination-summary"
      dir=`auto
      props=(Props.others props)>
      (fun () -> children ())
    </div>
  [@@element div]
end

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Content" in
    <ul
      class_=(fun () ->
               after (Styles.Pagination.content (slots ())) (class_ ()))
      data_slot="pagination-content"
      props=(Props.others props)>
      (fun () -> children ())
    </ul>
  [@@element ul]
end

module Item = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Item" in
    <li
      class_=(fun () -> after (Styles.Pagination.item (slots ())) (class_ ()))
      data_slot="pagination-item"
      props=(Props.others props)>
      (fun () -> children ())
    </li>
  [@@element li]
end

module Link = struct
  let%component make ?(is_active : bool = false) ?(is_disabled : bool = false)
      ?(on_press : (unit -> unit) option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Link" in
    button ~slot:"pagination-link"
      ~classes:(fun () -> after (Styles.Pagination.link (slots ())) (class_ ()))
      ~is_active ~is_disabled ~on_press ~on_click ~given_ref
      ~others:(Props.others props) children
  [@@element button]
end

module Previous = struct
  let%component make ?(is_disabled : bool = false)
      ?(on_press : (unit -> unit) option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Previous" in
    button ~slot:"pagination-previous"
      ~classes:(fun () ->
        after
          (Styles.Pagination.link (slots ()) ^ " pagination__link--nav")
          (class_ ()))
      ~is_active:(fun () -> false)
      ~is_disabled ~on_press ~on_click ~given_ref ~others:(Props.others props)
      children
  [@@element button]
end

module Next = struct
  let%component make ?(is_disabled : bool = false)
      ?(on_press : (unit -> unit) option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = within "Pagination.Next" in
    button ~slot:"pagination-next"
      ~classes:(fun () ->
        after
          (Styles.Pagination.link (slots ()) ^ " pagination__link--nav")
          (class_ ()))
      ~is_active:(fun () -> false)
      ~is_disabled ~on_press ~on_click ~given_ref ~others:(Props.others props)
      children
  [@@element button]
end

module Previous_icon = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    <span
      aria_hidden=true
      ?class_=(fun () -> class_ ())
      data_slot="pagination-previous-icon"
      props=(Props.others props)>
      (fun () ->
        match children () with
        | Some c -> c
        | None ->
            Jsx.element
              <Gravity.Chevron_left aria_hidden=true role=`presentation />)
    </span>
  [@@element span]
end

module Next_icon = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    <span
      aria_hidden=true
      ?class_=(fun () -> class_ ())
      data_slot="pagination-next-icon"
      props=(Props.others props)>
      (fun () ->
        match children () with
        | Some c -> c
        | None ->
            Jsx.element
              <Gravity.Chevron_right aria_hidden=true role=`presentation />)
    </span>
  [@@element span]
end

module Ellipsis = struct
  let%component make ?(class_ : string option) () =
    let slots = within "Pagination.Ellipsis" in
    <span
      aria_hidden=true
      class_=(fun () ->
               after (Styles.Pagination.ellipsis (slots ())) (class_ ()))
      data_slot="pagination-ellipsis"
      props=(Props.others props)>
      {js|…|js}
    </span>
  [@@element span]
end

let%component make ?(size : [ `sm | `md | `lg ] = `md) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let slots () =
    Styles.Pagination.slots (Styles.Pagination.options ~size:(size ()) ())
  in
  (* HeroUI names the landmark and gives its role, which a [<nav>] has
     already. *)
  <nav
    aria_label="pagination"
    class_=(fun () -> after (Styles.Pagination.base (slots ())) (class_ ()))
    role=`navigation
    data_slot="pagination"
    props=(Props.others props)>
    <Context.Provider value=(fun () -> slots)>
      (fun () -> children ())
    </Context.Provider>
  </nav>
[@@element nav]
