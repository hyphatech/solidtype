module Jsx = Solidtype.Jsx
module S = Solidtype.Solid
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Select
module Types = Solidtype_kobalte.Types
module Gravity = Solidtype_gravity_icons

type placement = [ `top | `bottom | `left | `right ]

(* What a select's parts read of it: its classes, its list box once one has
   joined it, the options selected, whether it is open, and how it clears. *)
type select = {
  slots : Styles.Select.slots S.accessor;
  hosted : List_box.hosted option S.accessor;
  selected : List_box.option_ list S.accessor;
  is_open : bool S.accessor;
  set_placement : placement -> unit;
  placement : string S.accessor;
  is_empty : bool S.accessor;
  clear : unit -> unit;
  disabled : bool S.accessor;
  mutable clearable : int;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = select
end)

let within part =
  match Context.use () with
  | Some s -> s
  | None -> invalid_arg (part ^ " is used inside a Select")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* A style given after the part's own, so its declarations win. *)
let styled own = function Some s -> own ^ " " ^ s | None -> own

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]

external prevent_default : Dom.keyboardEvent -> unit = "preventDefault"
[@@mel.send]

external stop_propagation : Dom.pointerEvent -> unit = "stopPropagation"
[@@mel.send]

external stop_click : Dom.mouseEvent -> unit = "stopPropagation" [@@mel.send]
external prevent_click : Dom.mouseEvent -> unit = "preventDefault" [@@mel.send]

module Trigger = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option)
      ?(on_key_down : (Dom.keyboardEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
      () =
    let s = within "Select.Trigger" in
    let i = Interaction.create ~disabled:(fun () -> S.get s.disabled) () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_pressed = S.accessor (fun () -> Interaction.pressed i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = s.disabled;
      }
    in
    <Kobalte.Trigger
      class_=(fun () ->
               after (Styles.Select.trigger (S.get s.slots)) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      on_key_down=(fun e ->
                    ignore (on_key_down e : unit option);
                    (* A clear button inside a button takes no focus, so
                       Backspace or Delete on the trigger clears, as HeroUI's
                       does, where one is drawn. *)
                    match key e with
                    | ("Backspace" | "Delete")
                      when s.clearable > 0
                           && (not (S.get s.is_empty))
                           && not (S.get s.is_open) ->
                        prevent_default e;
                        s.clear ()
                    | _ -> ())
      data_slot="select-trigger"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (S.get s.disabled))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </Kobalte.Trigger>
  [@@element button]
end

module Value = struct
  (* What its children are drawn of while an option is chosen: React Aria's
     render props for a value, its keys and its text. *)
  type state = {
    selected_keys : string array S.accessor;
    selected_text : string S.accessor;
  }

  let%component make ?(class_ : string option)
      ?(children : state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Span.props -> state -> Solidtype.Jsx.element) option)
      () =
    let s = within "Select.Value" in
    let keys =
      S.create_memo (fun () ->
          Array.of_list (List.map List_box.key (S.get s.selected)))
    in
    let state () =
      {
        selected_keys = keys;
        selected_text =
          S.accessor (fun () -> List_box.listed (S.get s.selected));
      }
    in
    <Kobalte.Value
      class_=(fun () ->
               after (Styles.Select.value (S.get s.slots)) (S.get class_))
      data_slot="select-value"
      data_placeholder=(fun () -> Jsx.flag (S.get s.is_empty))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some c -> Jsx.draw c (state ())
        | None -> Jsx.element (List_box.shown (S.get s.selected)))
    </Kobalte.Value>
  [@@element span]
end

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let s = within "Select.Indicator" in
    let classes () =
      after (Styles.Select.indicator (S.get s.slots)) (S.get class_)
    in
    match S.untrack (fun () -> S.get children) with
    | Some _ ->
        (* HeroUI gives an indicator of the user's its classes; a Solid
           component cannot add them to an element already made, so a span
           around it takes them. *)
        <span
          aria_hidden=true
          class_=(fun () -> classes ())
          data_slot="select-indicator"
          data_open=(fun () -> Jsx.flag (S.get s.is_open))
          props=(Props.others props)>
          (fun () ->
            Option.value (S.get children) ~default:(Jsx.element Jsx.nothing))
        </span>
    | None ->
        <Gravity.Chevron_down
          aria_hidden=true
          class_=(fun () -> classes ())
          role=`presentation
          data_open=(fun () -> Jsx.flag (S.get s.is_open))
          data_slot="select-default-indicator"
          props=(Props.others props)
        />
  [@@element svg]
end

module Clear_button = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?(on_pointer_down : (Dom.pointerEvent -> unit) option) () =
    let s = within "Select.Clear_button" in
    s.clearable <- s.clearable + 1;
    S.on_cleanup (fun () -> s.clearable <- s.clearable - 1);
    <span
      aria_hidden=true
      class_=(fun () ->
               after (Styles.Select.clear_button (S.get s.slots)) (S.get class_))
      on_pointer_down=(fun e ->
                        ignore (on_pointer_down e : unit option);
                        (* A span in the trigger, as a button in a button is
                           not HTML: a press on it stays off the trigger, so
                           the list stays closed. *)
                        stop_propagation e)
      on_click=(fun e ->
                 prevent_click e;
                 stop_click e;
                 if not (S.get s.disabled || S.get s.is_empty) then s.clear ();
                 ignore (on_click e : unit option))
      data_empty=(fun () -> Jsx.flag (S.get s.is_empty))
      data_slot="select-clear-button"
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some c -> c
        | None ->
            Jsx.element
              <Gravity.Xmark
                aria_hidden=true
                role=`presentation
                data_slot="select-clear-button-icon"
              />)
    </span>
  [@@element span]
end

(* Kobalte's list as the [<div>] React Aria's list box is. *)
module As_list = struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      ?scroll_to_item:(string -> unit) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:
         ( List_box.node Types.Collection.t S.accessor -> Jsx.element,
           [ `render ] )
         Solidtype.Check.children ->
      unit ->
      unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Listbox.component
end

module Popover = struct
  let%component make ?(placement : placement option) ?(class_ : string option)
      ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : Jsx.content) () =
    let s = within "Select.Popover" in
    S.create_computed (fun () ->
        s.set_placement (Option.value (S.get placement) ~default:`bottom));
    let o = Overlay.create ~is_open:(fun () -> S.get s.is_open) () in
    let side, watch_side =
      Overlay.placed_side ~placement:(fun () -> S.get s.placement) ()
    in
    Jsx.fragment
      [|
        (* Its list box joins the select whether it is open or not, as the
           select's value is drawn from it. *)
        <Context.Provider value=(fun () -> s)>
          (fun () -> S.get children)
        </Context.Provider>;
        <Show when_=(fun () -> Overlay.present o)>
          <Kobalte.Portal>
            <Kobalte.Content
              class_=(fun () ->
                       after
                         (Styles.Select.popover (S.get s.slots))
                         (S.get class_))
              style=(fun () ->
                      styled
                        "--trigger-width: var(--kb-popper-anchor-width); \
                         --trigger-anchor-point: \
                         var(--kb-select-content-transform-origin);"
                        (S.get style))
              ref=(fun e ->
                    ignore (given_ref e : unit option);
                    Overlay.watch o e;
                    watch_side e)
              data_slot="select-popover"
              data_placement=(fun () -> Jsx.data (S.get side))
              data_entering=(fun () -> Jsx.flag (Overlay.entering o))
              data_exiting=(fun () -> Jsx.flag (Overlay.exiting o))
              props=(Props.others props)>
              (fun () ->
                match S.get s.hosted with
                | Some (h : List_box.hosted) ->
                    Jsx.element
                      <As_list
                        as_="div"
                        ref=(fun e -> h.list_ref e)
                        scroll_to_item=(fun key -> h.scroll_to_item key)
                        ?aria_label=(fun () -> S.get h.aria_label)
                        aria_orientation=`vertical
                        class_=(fun () -> S.get h.classes)
                        data_slot="list-box"
                        data_layout="stack"
                        data_orientation="vertical"
                        data_empty=(fun () -> Jsx.flag (S.get h.empty))
                        props=h.others>
                        (fun collection -> h.draw collection)
                      </As_list>
                | None -> Jsx.element Jsx.nothing)
            </Kobalte.Content>
          </Kobalte.Portal>
        </Show>;
      |]
  [@@element div]
end

(* Its label, description and error: Kobalte's, which name and describe its
   trigger. *)
module Parts = Field.Slots (struct
  let label = Kobalte.Label.component
  let description = Kobalte.Description.component
  let error = Kobalte.ErrorMessage.component
end)

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  is_focused : bool Solidtype.Solid.accessor;
  is_focus_visible : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_open : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let%component make ?(placeholder : string = "Select an item")
    ?(selection_mode : [ `single | `multiple ] = `single)
    ?(value : string array option) ?(default_value : string array option)
    ?(on_change : (string array -> unit) option)
    ?(on_clear : (unit -> unit) option) ?(disabled_keys : string array option)
    ?(is_open : bool option) ?(default_open : bool option)
    ?(on_open_change : (bool -> unit) option) ?(is_disabled : bool = false)
    ?(is_required : bool = false) ?(is_invalid : bool = false)
    ?(name : string option) ?(full_width : bool = false)
    ?(variant : [ `primary | `secondary ] = `primary) ?(class_ : string option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid () = S.get is_invalid || Option.is_some (S.get in_form.error) in
  let hosted, set_hosted = S.create_signal None in
  let kept, set_kept = S.create_signal [||] in
  S.create_computed (fun () ->
      S.set set_kept
        (Option.value (S.untrack (fun () -> S.get default_value)) ~default:[||]));
  let keys () =
    match S.get value with Some keys -> keys | None -> S.get kept
  in
  let options () =
    match S.get hosted with
    | Some (h : List_box.hosted) -> S.get h.options
    | None -> []
  in
  let selected =
    S.accessor (fun () ->
        let keys = keys () in
        List.filter
          (fun o -> Array.exists (String.equal (List_box.key o)) keys)
          (options ()))
  in
  (* Kobalte tells its selection as its options join it, empty as it was: a
     change to the keys it has is none. *)
  let same now =
    let held = S.untrack keys in
    Array.length now = Array.length held
    && Array.for_all (fun k -> Array.exists (String.equal k) held) now
  in
  let change now =
    if not (same now) then (
      S.set set_kept now;
      in_form.changed ();
      ignore (on_change now : unit option))
  in
  let opened_kept, set_opened = S.create_signal false in
  S.create_computed (fun () ->
      S.set set_opened
        (Option.value (S.untrack (fun () -> S.get default_open)) ~default:false));
  let opened =
    S.accessor (fun () ->
        match S.get is_open with Some o -> o | None -> S.get opened_kept)
  in
  let open_change o =
    S.set set_opened o;
    ignore (on_open_change o : unit option)
  in
  let placement, set_placement = S.create_signal `bottom in
  let disabled_key key =
    Array.exists (String.equal key)
      (Option.value (S.get disabled_keys) ~default:[||])
  in
  let s =
    {
      slots =
        S.accessor (fun () ->
            Styles.Select.slots
              (Styles.Select.options ~full_width:(S.get full_width)
                 ~variant:(S.get variant) ()));
      hosted;
      selected;
      is_open = opened;
      set_placement = S.set set_placement;
      placement =
        S.accessor (fun () ->
            match S.get placement with
            | `top -> "top"
            | `bottom -> "bottom"
            | `left -> "left"
            | `right -> "right");
      is_empty = S.accessor (fun () -> Array.length (keys ()) = 0);
      clear =
        (fun () ->
          change [||];
          ignore (on_clear () : unit option));
      disabled = is_disabled;
      clearable = 0;
    }
  in
  let mode = S.untrack (fun () -> S.get selection_mode) in
  let listing =
    {
      List_box.mode = S.accessor (fun () -> (mode :> List_box.selection_mode));
      is_selected = (fun key -> Array.exists (String.equal key) (keys ()));
      is_disabled = disabled_key;
      act = (fun (_ : string) -> ());
      focus = Real;
    }
  in
  let i = Interaction.create () in
  (* Its list box is taken once on the page: Kobalte's root is made before it,
     so on the server its hidden select holds no option, and one given as the
     page hydrates would be looked for among the server's nodes. *)
  let state =
    {
      is_focused = S.accessor (fun () -> Interaction.focused i || S.get opened);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled;
      is_open = opened;
      is_invalid = S.accessor (fun () -> invalid ());
      is_required;
    }
  in
  let host h =
    S.on_mount (fun () -> S.set set_hosted (Some h));
    S.on_cleanup (fun () -> S.set set_hosted None);
    Jsx.nothing
  in
  let parts () =
    <Context.Provider value=(fun () -> s)>
      <List_box.Host.Provider value=(fun () -> host)>
        <List_box.Listing.Provider value=(fun () -> listing)>
          <Field_error.Message.Provider value=(fun () -> in_form.error)>
            <Parts>
              (fun () -> Jsx.draw (S.get children) state)
              <Kobalte.HiddenSelect />
            </Parts>
          </Field_error.Message.Provider>
        </List_box.Listing.Provider>
      </List_box.Host.Provider>
    </Context.Provider>
  in
  (* Its placeholder as the text React Aria's value shows, as Kobalte takes an
     element: a provider draws only its children. *)
  let placeholder_text () =
    <Context.Provider value=(fun () -> s)>
      (fun () -> Jsx.string (S.get placeholder))
    </Context.Provider>
  in
  let root_classes () =
    after (Styles.Select.base (S.get s.slots)) (S.get class_)
  in
  let others = Props.others props in
  let root e =
    ignore (given_ref e : unit option);
    Interaction.watch i e;
    in_form.root e
  in
  let leave = Field.on_leave (fun (_ : Dom.focusEvent) -> in_form.left ()) in
  let focus_out e =
    ignore (on_focus_out e : unit option);
    leave e
  in
  match mode with
  | `single ->
      <Kobalte.Root
        options=(fun () ->
                  Array.of_list (List.map Types.Either.left (options ())))
        option_value=(fun o -> Types.Either.left (List_box.key o))
        option_text_value=List_box.text
        option_disabled=(fun o -> disabled_key (List_box.key o))
        value=(fun () ->
                (* [null], an empty selection Kobalte keeps: [undefined]
                   would be no value given. *)
                match S.get selected with
                | o :: _ -> Js.Nullable.return o
                | [] -> Js.Nullable.null)
        on_change=(fun o ->
                    change
                      (match Js.Nullable.toOption o with
                      | Some o -> [| List_box.key o |]
                      | None -> [||]))
        open_=(fun () -> S.get opened)
        on_open_change=open_change
        placement=(fun () -> S.get s.placement)
        gutter=8.
        same_width=false
        virtualized=true
        force_mount=true
        modal=true
        disabled=(fun () -> S.get is_disabled)
        required=(fun () -> S.get is_required)
        validation_state=(fun () -> if invalid () then `invalid else `valid)
        ?name
        placeholder=(fun () -> placeholder_text ())
        class_=(fun () -> root_classes ())
        ref=root
        on_focus_out=focus_out
        data_slot="select"
        data_open=(fun () -> Jsx.flag (S.get opened))
        data_focused=(fun () ->
                       Jsx.flag (Interaction.focused i || S.get opened))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_invalid=(fun () -> Jsx.flag (invalid ()))
        data_disabled=(fun () -> Jsx.flag (S.get is_disabled))
        data_required=(fun () -> Jsx.flag (S.get is_required))
        ?as_=(fun () -> Option.map (fun f p -> f p state) (S.get as_))
        props=others>
        (fun () -> Jsx.element (parts ()))
      </Kobalte.Root>
  | `multiple ->
      <Kobalte.Root_multiple
        multiple=true
        options=(fun () ->
                  Array.of_list (List.map Types.Either.left (options ())))
        option_value=(fun o -> Types.Either.left (List_box.key o))
        option_text_value=List_box.text
        option_disabled=(fun o -> disabled_key (List_box.key o))
        value=(fun () -> Array.of_list (S.get selected))
        on_change=(fun os -> change (Array.map List_box.key os))
        open_=(fun () -> S.get opened)
        on_open_change=open_change
        placement=(fun () -> S.get s.placement)
        gutter=8.
        same_width=false
        virtualized=true
        force_mount=true
        modal=true
        disabled=(fun () -> S.get is_disabled)
        required=(fun () -> S.get is_required)
        validation_state=(fun () -> if invalid () then `invalid else `valid)
        ?name
        placeholder=(fun () -> placeholder_text ())
        class_=(fun () -> root_classes ())
        ref=root
        on_focus_out=focus_out
        data_slot="select"
        data_open=(fun () -> Jsx.flag (S.get opened))
        data_focused=(fun () ->
                       Jsx.flag (Interaction.focused i || S.get opened))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_invalid=(fun () -> Jsx.flag (invalid ()))
        data_disabled=(fun () -> Jsx.flag (S.get is_disabled))
        data_required=(fun () -> Jsx.flag (S.get is_required))
        ?as_=(fun () -> Option.map (fun f p -> f p state) (S.get as_))
        props=others>
        (fun () -> Jsx.element (parts ()))
      </Kobalte.Root_multiple>
[@@element div]
