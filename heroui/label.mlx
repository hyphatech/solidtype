module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

type slot =
  (unit -> string) ->
  unit Solidtype.Solid.rest ->
  (unit -> Jsx.content) ->
  Jsx.element

(* How a label renders where a part above gives it its element, as React
   Aria's LabelContext does: a span in a control's own clickable label, since
   a label in a label is not HTML, or a group's label, which names it. *)
module Slot = Solidtype.Context.Make_optional (struct
  type t = slot
end)

let%component make ?(is_required : bool option) ?(is_disabled : bool option)
    ?(is_invalid : bool option) ?(for_ : string option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let classes () =
    Styles.Label.classes
      (Styles.Label.options ?is_required:(S.get is_required)
         ?is_disabled:(S.get is_disabled) ?is_invalid:(S.get is_invalid)
         ?class_:(S.get class_) ())
  in
  match Slot.use () with
  | Some render ->
      render classes (Props.others props) (fun () -> S.get children)
  | None ->
      <label
        ?for_
        class_=(fun () -> classes ())
        data_slot="label"
        props=(Props.others props)>
        (fun () -> S.get children)
      </label>
[@@element label]
