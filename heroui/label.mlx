module Jsx = Solidtype.Jsx

type slot = ((unit -> string) -> (unit -> Jsx.content) -> Jsx.element[@u])

(* How a label renders where a part above gives it its element, as React
   Aria's LabelContext does: a span in a control's own clickable label, since
   a label in a label is not HTML, or a group's label, which names it. *)
module Slot = Solidtype.Context.Make_optional (struct
  type t = slot
end)

let%component make ?(class_ : string option) ~(children : Jsx.content) () =
  let classes () =
    Styles.Label.classes (Styles.Label.options ?class_:(class_ ()) ())
  in
  match Slot.use () with
  | Some render -> render classes (fun () -> children ()) [@u]
  | None ->
      <label class_=(fun () -> classes ()) data_slot="label">
        (fun () -> children ())
      </label>
