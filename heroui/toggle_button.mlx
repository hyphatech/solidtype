module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.ToggleButton
module Item = Solidtype_kobalte.ToggleGroup.Item

(* What a toggle button's children are drawn of: React Aria's render props
   for a toggle button. *)
type state = {
  is_hovered : bool Solidtype.Solid.accessor;
  is_pressed : bool Solidtype.Solid.accessor;
  is_focused : bool Solidtype.Solid.accessor;
  is_focus_visible : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_selected : bool Solidtype.Solid.accessor;
}

let%component make ?(variant : [ `default | `ghost ] option)
    ?(size : Toggle_button_group.size option) ?(is_icon_only : bool = false)
    ?(id : string option) ?(is_selected : bool option)
    ?(default_selected : bool = false) ?(on_change : (bool -> unit) option)
    ?(is_disabled : bool option) ?(on_click : (Dom.mouseEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
    ?(aria_label : string option) ?(class_ : string option)
    ~(children : state Jsx.children)
    ?(as_ :
       (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
    () =
  let group = Toggle_button_group.Context.use () in
  (* A prop the button sets is its own, else its group's, else HeroUI's
     default; and it is disabled, too, in a disabled fieldset. *)
  let size () =
    match S.get size with
    | Some s -> s
    | None -> (
        match
          Option.bind group (fun (g : Toggle_button_group.group) ->
              S.get g.size)
        with
        | Some s -> s
        | None -> `md)
  in
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with
        | Some d -> d
        | None -> (
            match
              Option.bind group (fun (g : Toggle_button_group.group) ->
                  S.get g.is_disabled)
            with
            | Some d -> d
            | None -> S.get in_fieldset))
  in
  let i = Interaction.create ~disabled:(fun () -> S.get disabled) () in
  let class_ () =
    Styles.ToggleButton.classes
      (Styles.ToggleButton.options ?variant:(S.get variant) ~size:(size ())
         ~is_icon_only:(S.get is_icon_only) ?class_:(S.get class_) ())
  in
  let on_click e = ignore (on_click e : unit option) in
  let watch b =
    ignore (given_ref b : unit option);
    Interaction.watch i b
  in
  let state selected =
    {
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = S.accessor (fun () -> Interaction.pressed i);
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = S.accessor (fun () -> Interaction.disabled i);
      is_selected = selected;
    }
  in
  let draw selected () = Jsx.draw (S.get children) (state selected) in
  let drawn selected () =
    Option.map (fun f p -> f p (state selected)) (S.get as_)
  in
  match group with
  | None ->
      let selected, set_selected =
        Field.controlled
          ~value:(fun () -> S.get is_selected)
          ~default:(S.get default_selected)
          ~on_change:(fun v -> on_change v)
      in
      <Kobalte.Root
        pressed=(fun () -> S.get selected)
        on_change=set_selected
        class_=(fun () -> class_ ())
        ?aria_label
        ref=watch
        data_slot="toggle-button"
        data_selected=(fun () -> Jsx.flag (S.get selected))
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
        data_focused=(fun () -> Jsx.flag (Interaction.focused i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
        on_click
        ?as_=(fun () -> drawn selected ())
        props=(Props.others props)
        disabled=(fun () -> S.get disabled)>
        (fun () -> draw selected ())
      </Kobalte.Root>
  | Some g -> (
      match S.get id with
      | None -> invalid_arg "Toggle_button is given an id inside a group"
      | Some key ->
          g.join (fun () -> S.get disabled);
          <Item
            class_=(fun () -> class_ ())
            ?aria_label
            ref=watch
            data_slot="toggle-button"
            data_selected=(fun () -> Jsx.flag (g.is_selected key))
            data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
            data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
            data_focused=(fun () -> Jsx.flag (Interaction.focused i))
            data_focus_visible=(fun () ->
                                 Jsx.flag (Interaction.focus_visible i))
            data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
            on_click
            props=(Props.others props)
            value=(fun () -> key)
            disabled=(fun () -> S.get disabled)>
            (fun () -> draw (S.accessor (fun () -> g.is_selected key)) ())
          </Item>)
[@@element button]
