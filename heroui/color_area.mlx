module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.ColorArea
module Color = Solidtype_kobalte.Types.Color
module Area = Solidtype_kobalte.Types.ColorAreaContextValue
module State = Solidtype_kobalte.Types.ColorAreaState

type channel =
  [ `hue
  | `saturation
  | `brightness
  | `lightness
  | `red
  | `green
  | `blue
  | `alpha ]

(* What the thumb reads of its area: its classes, and whether it is disabled,
   which Kobalte's state never learns: its root keeps [disabled] from the form
   control it makes. *)
type area = { slots : unit -> Styles.ColorArea.slots; disabled : unit -> bool }

module Area_context = Solidtype.Context.Make_optional (struct
  type t = area
end)

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* The thumb's colour as HeroUI's styles read it. Kobalte writes a colour less
   than opaque for CSS as rgb(4, 133, 247 / 0.5), which no browser reads, so it
   is written as rgba. *)
let painted color style =
  "--color-area-thumb-color: "
  ^ Color.to_string color ~format:`rgba ()
  ^ match style with Some s -> "; " ^ s | None -> ""

module Thumb = struct
  let%component make ?(class_ : string option) ?(style : string option) () =
    let { slots; disabled } =
      match Area_context.use () with
      | Some a -> a
      | None -> invalid_arg "Color_area.Thumb is used inside a Color_area"
    in
    let area = Kobalte.use_color_area_context () in
    let state = Area.state area in
    let i = Interaction.create ~disabled:(fun[@u] () -> disabled ()) () in
    (* A disabled area's thumb is out of the page's order, and its inputs
       disabled; HeroUI's disabled style stops the pointer. *)
    <Kobalte.Thumb
      ref=(fun e -> Interaction.watch i e)
      ?tab_index=(fun () -> if disabled () then Some "-1" else None)
      class_=(fun () -> after (Styles.ColorArea.thumb (slots ())) (class_ ()))
      style=(fun () -> painted (Area.get_display_color area ()) (style ()))
      data_slot="color-area-thumb"
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_dragging=(fun () -> Jsx.flag (S.get (State.is_dragging state)))
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      props=(Props.others props)>
      <Kobalte.HiddenInputX disabled=(fun () -> disabled ()) />
      <Kobalte.HiddenInputY disabled=(fun () -> disabled ()) />
    </Kobalte.Thumb>
end

let%component make ?(value : Color.t option) ?(default_value : Color.t option)
    ?(on_change : (Color.t -> unit) option)
    ?(on_change_end : (Color.t -> unit) option) ?(x_channel : channel option)
    ?(y_channel : channel option) ?(color_space : [ `rgb | `hsl | `hsb ] option)
    ?(x_name : string option) ?(y_name : string option)
    ?(is_disabled : bool = false) ?(show_dots : bool option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let slots () =
    Styles.ColorArea.slots
      (Styles.ColorArea.options ?show_dots:(show_dots ()) ())
  in
  let a = { slots; disabled = (fun () -> is_disabled ()) } in
  <Area_context.Provider value=(fun () -> a)>
    <Kobalte.Root
      ?value
      ?default_value
      on_change=(fun c -> ignore (on_change c : unit option))
      on_change_end=(fun c -> ignore (on_change_end c : unit option))
      ?x_channel
      ?y_channel
      ?color_space
      ?x_name
      ?y_name
      disabled=(fun () -> is_disabled ())
      class_=(fun () -> after (Styles.ColorArea.base (slots ())) (class_ ()))
      data_slot="color-area"
      data_disabled=(fun () -> Jsx.flag (is_disabled ()))
      props=(Props.others props)>
      (* React Aria's area is its own gradient, where Kobalte's draws it on a
         background of its own: it fills the area, rounded and shadowed as the
         area is, its inset edge over the gradient. *)
      <Kobalte.Background
        style="position: absolute; inset: 0; border-radius: inherit; \
               box-shadow: inherit">
        (fun () -> children ())
      </Kobalte.Background>
    </Kobalte.Root>
  </Area_context.Provider>
