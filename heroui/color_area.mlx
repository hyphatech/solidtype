module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Headless = Solidtype_headless.Color_area
module Color = Solidtype_kobalte.Types.Color
module Area = Solidtype_kobalte.Types.ColorAreaContextValue

type channel =
  [ `hue
  | `saturation
  | `brightness
  | `lightness
  | `red
  | `green
  | `blue
  | `alpha ]

(* What the thumb reads of its area: its classes, and whether it is disabled,
   for HeroUI's state. *)
type area = {
  slots : Styles.ColorArea.slots S.accessor;
  disabled : bool S.accessor;
}

module Area_context = Solidtype.Context.Make_optional (struct
  type t = area
end)

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* The thumb's colour as HeroUI's styles read it, a variable of their own. *)
let painted color style =
  "--color-area-thumb-color: "
  ^ Color.to_string color ~format:`rgba ()
  ^ match style with Some s -> "; " ^ s | None -> ""

module Thumb = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    color : Solidtype_kobalte.Types.Color.t Solidtype.Solid.accessor;
    is_dragging : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option) ?(style : string option)
      ?ref:(given_ref : (Dom.htmlSpanElement -> unit) option)
      ?(children : state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Span.props -> state -> Solidtype.Jsx.element) option)
      () =
    let { slots; disabled } =
      match Area_context.use () with
      | Some a -> a
      | None -> invalid_arg "Color_area.Thumb is used inside a Color_area"
    in
    let area = Headless.use_color_area_context () in
    let i = Interaction.create ~disabled:(fun () -> S.get disabled) () in
    (* HeroUI's disabled style stops the pointer. *)
    let state () =
      {
        color = S.accessor (fun () -> Area.get_display_color area ());
        is_dragging = S.accessor (fun () -> Interaction.dragged i);
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = disabled;
      }
    in
    <Headless.Thumb
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(fun () ->
               after (Styles.ColorArea.thumb (S.get slots)) (S.get class_))
      style=(fun () -> painted (Area.get_display_color area ()) (S.get style))
      data_slot="color-area-thumb"
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_dragging=(fun () -> Jsx.flag (Interaction.dragged i))
      data_disabled=(fun () -> Jsx.flag (S.get disabled))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Headless.HiddenInputX />
      <Headless.HiddenInputY />
      (fun () ->
        match S.get children with
        | Some c -> Jsx.draw c (state ())
        | None -> Jsx.string "")
    </Headless.Thumb>
  [@@element span]
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = { is_disabled : bool Solidtype.Solid.accessor }

let%component make ?(value : Color.t option) ?(default_value : Color.t option)
    ?(on_change : (Color.t -> unit) option)
    ?(on_change_end : (Color.t -> unit) option) ?(x_channel : channel option)
    ?(y_channel : channel option) ?(color_space : [ `rgb | `hsl | `hsb ] option)
    ?(x_name : string option) ?(y_name : string option)
    ?(is_disabled : bool = false) ?(show_dots : bool option)
    ?(class_ : string option) ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let slots =
    S.accessor (fun () ->
        Styles.ColorArea.slots
          (Styles.ColorArea.options ?show_dots:(S.get show_dots) ()))
  in
  let a = { slots; disabled = is_disabled } in
  let state () = { is_disabled } in
  <Area_context.Provider value=(fun () -> a)>
    <Headless.Root
      ?value=(fun () -> S.get value)
      ?default_value=(fun () -> S.get default_value)
      on_change=(fun c -> ignore (on_change c : unit option))
      on_change_end=(fun c -> ignore (on_change_end c : unit option))
      ?x_channel=(fun () -> S.get x_channel)
      ?y_channel=(fun () -> S.get y_channel)
      ?color_space=(fun () -> S.get color_space)
      ?x_name=(fun () -> S.get x_name)
      ?y_name=(fun () -> S.get y_name)
      disabled=(fun () -> S.get is_disabled)
      class_=(fun () ->
               after (Styles.ColorArea.base (S.get slots)) (S.get class_))
      data_slot="color-area"
      data_disabled=(fun () -> Jsx.flag (S.get is_disabled))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (* React Aria's area is its own gradient, where Kobalte's draws it on a
         background of its own: it fills the area, rounded and shadowed as the
         area is, its inset edge over the gradient. *)
      <Headless.Background
        style="position: absolute; inset: 0; border-radius: inherit; \
               box-shadow: inherit">
        (fun () -> Jsx.draw (S.get children) (state ()))
      </Headless.Background>
    </Headless.Root>
  </Area_context.Provider>
[@@element div]
