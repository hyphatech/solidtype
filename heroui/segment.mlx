module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.SegmentedControl

type size = [ `sm | `md | `lg ]
type variant = [ `default | `ghost ]

(* What a segment's options read of it. *)
type segment = {
  value : unit -> string option;
  disabled : unit -> bool;
  variant : unit -> variant;
  size : unit -> size;
  indicators : Selection_indicator.t;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = segment
end)

(* What an option's content reads of it. *)
type item = { selected : unit -> bool }

module Item_context = Solidtype.Context.Make_optional (struct
  type t = item
end)

(* A class added after the segment's own, as React's className is: its look is
   segment.css's, in the components layer, which a utility given wins over. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* Each part's classes; its look is segment.css's. *)
let root_classes variant size =
  (match size with
    | `sm -> "segment segment--sm"
    | `md -> "segment segment--md"
    | `lg -> "segment segment--lg")
  ^ match variant with `default -> "" | `ghost -> " segment--ghost"

let item_classes variant size =
  (match size with
    | `sm -> "segment__item segment__item--sm"
    | `md -> "segment__item segment__item--md"
    | `lg -> "segment__item segment__item--lg")
  ^ match variant with `default -> "" | `ghost -> " segment__item--ghost"

let indicator_classes = function
  | `default -> "segment__indicator"
  | `ghost -> "segment__indicator segment__indicator--ghost"

let within part =
  match Context.use () with
  | Some s -> s
  | None -> invalid_arg (part ^ " is used inside a Segment")

module Field_content = Field.Content (struct
  let label = Kobalte.ItemLabel.component
  let input = Kobalte.ItemInput.component
end)

(* The indicator, made each time its option is selected. *)
let indicator s =
  let i = Selection_indicator.indicator s.indicators in
  <div
    class_=(fun () -> indicator_classes (s.variant ()))
    ref=(fun e -> i.ref e)
    data_slot="segment-indicator"
  />

module Item = struct
  let%component make ~(id : string) ?(is_disabled : bool = false)
      ?(aria_label : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let s = within "Segment.Item" in
    let selected () =
      match s.value () with Some v -> String.equal v (id ()) | None -> false
    in
    let disabled () = s.disabled () || is_disabled () in
    let field : Field.state =
      {
        selected;
        indeterminate = (fun () -> false);
        disabled;
        invalid = (fun () -> false);
        read_only = (fun () -> false);
        required = (fun () -> false);
        aria_label;
        described_by = (fun () -> None);
        interaction =
          Interaction.create
            ~disabled:(fun[@u] () -> disabled ())
            ~keys:`element ();
      }
    in
    <Item_context.Provider value=(fun () -> { selected })>
      <Kobalte.Item
        value=(fun () -> id ())
        disabled=(fun () -> is_disabled ())
        class_="segment__item-control">
        <Field_content
          field=(fun () -> field)
          slot="segment-item"
          class_=(fun () ->
                   after (item_classes (s.variant ()) (s.size ())) (class_ ()))
          props=(Props.others props)>
          <Show when_=(fun () -> selected ())>
            (fun () -> Jsx.element (indicator s))
          </Show>
          (fun () -> children ())
        </Field_content>
      </Kobalte.Item>
    </Item_context.Provider>
  [@@element label]

  let is_selected () =
    match Item_context.use () with
    | Some i -> i.selected
    | None ->
        invalid_arg "Segment.Item.is_selected is used inside a Segment.Item"
end

module Separator = struct
  let%component make ?(class_ : string option) () =
    let (_ : segment) = within "Segment.Separator" in
    <span
      aria_hidden=true
      class_=(fun () -> after "segment__separator" (class_ ()))
      data_slot="segment-separator"
      props=(Props.others props)
    />
  [@@element span]
end

let%component make ?(variant : variant = `default) ?(size : size = `md)
    ?(selected_key : string option) ?(default_selected_key : string option)
    ?(on_selection_change : (string -> unit) option)
    ?(is_disabled : bool = false) ?(name : string option)
    ?(aria_label : string option) ?(aria_labelledby : string option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let chosen, choose =
    Field.controlled
      ~value:(fun () -> Option.map Option.some (selected_key ()))
      ~default:(default_selected_key ())
      ~on_change:
        (Option.iter (fun key -> ignore (on_selection_change key : unit option)))
  in
  let s =
    {
      value = chosen;
      disabled = (fun () -> is_disabled ());
      variant = (fun () -> variant ());
      size = (fun () -> size ());
      indicators = Selection_indicator.create ();
    }
  in
  <Context.Provider value=(fun () -> s)>
    <Kobalte.Root
      value=(fun () -> Option.value (chosen ()) ~default:"")
      disabled=(fun () -> is_disabled ())
      ?name
      ?aria_label=(fun () -> aria_label ())
      ?aria_labelledby=(fun () -> aria_labelledby ())
      class_=(fun () -> after (root_classes (variant ()) (size ())) (class_ ()))
      data_slot="segment"
      data_disabled=(fun () -> Jsx.flag (is_disabled ()))
      props=(Props.others props)
      on_change=(fun key -> choose (Some key))>
      (fun () -> children ())
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
