module Jsx = Solidtype.Jsx

type slot = ((unit -> string) -> (unit -> Jsx.content) -> Jsx.element[@u])

(* How a field's error renders, which the field gives it: Kobalte's error
   message, which the field shows while it is invalid. *)
module Slot = Solidtype.Context.Make_optional (struct
  type t = slot
end)

let%component make ?(class_ : string option) ~(children : Jsx.content) () =
  let classes () =
    Styles.FieldError.classes (Styles.FieldError.options ?class_:(class_ ()) ())
  in
  match Slot.use () with
  | Some render -> render classes (fun () -> children ()) [@u]
  | None -> invalid_arg "Field_error is used inside a field"
