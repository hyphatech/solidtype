module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Link

(* HeroUI's classes for a link's parts, the same whatever its options, read
   as a part is made: a module does nothing as it loads. *)
let slots () = Styles.Link.slots (Styles.Link.options ())

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Icon = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let icon () = after (Styles.Link.icon (slots ())) (S.get class_) in
    <Show
      when_=(fun () -> Option.is_some (S.get children))
      fallback=(<span
                  class_=(fun () -> icon ())
                  data_default_icon="true"
                  data_slot="link-icon"
                  props=(Props.others props)>
                  <svg
                    aria_hidden=true
                    fill="none"
                    height="9"
                    role=`presentation
                    view_box="0 0 7 7"
                    width="9"
                    data_slot="link-default-icon">
                    <path
                      d="M1.20592 6.84333L0.379822 6.01723L4.52594 \
                         1.8672H1.37819L1.38601 \
                         0.731812H6.48742V5.83714H5.34421L5.35203 \
                         2.6933L1.20592 6.84333Z"
                      fill="currentColor"
                    />
                  </svg>
                </span>)>
      <span class_=(fun () -> icon ()) data_slot="link-icon">
        (fun () ->
          match S.get children with Some c -> c | None -> Jsx.string "")
      </span>
    </Show>
  [@@element span]
end

(* What a link's children are drawn of: React Aria's render props for a
   link. *)
type state = {
  is_current : bool Solidtype.Solid.accessor;
  is_hovered : bool Solidtype.Solid.accessor;
  is_pressed : bool Solidtype.Solid.accessor;
  is_focused : bool Solidtype.Solid.accessor;
  is_focus_visible : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
}

let%component make ~(href : string) ?(is_disabled : bool option)
    ?(class_ : string option)
    ?ref:(given_ref : (Dom.htmlAnchorElement -> unit) option)
    ?(aria_current : string option) ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.A.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* A link is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let is_disabled () =
    match S.get is_disabled with Some d -> d | None -> S.get in_fieldset
  in
  let i = Interaction.create ~disabled:(fun () -> is_disabled ()) () in
  (* Current while it says it is, any aria-current at all, as React Aria
     reads it. *)
  let current () =
    match S.get aria_current with
    | Some c -> not (String.equal c "")
    | None -> false
  in
  let state () =
    {
      is_current = S.accessor (fun () -> current ());
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = S.accessor (fun () -> Interaction.pressed i);
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = S.accessor (fun () -> Interaction.disabled i);
    }
  in
  <Kobalte.Root
    href=(fun () -> S.get href)
    disabled=(fun () -> is_disabled ())
    class_=(fun () ->
             after
               (Styles.Link.base (Styles.Link.slots (Styles.Link.options ())))
               (S.get class_))
    ref=(fun a ->
          ignore (given_ref a : unit option);
          Interaction.watch i a)
    data_slot="link"
    data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
    data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
    data_focused=(fun () -> Jsx.flag (Interaction.focused i))
    data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
    data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
    data_current=(fun () -> Jsx.flag (current ()))
    ?aria_current
    ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
    props=(Props.others props)>
    (fun () -> Jsx.draw (S.get children) (state ()))
  </Kobalte.Root>
[@@element a]
