module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

external prevent_default : Dom.mouseEvent -> unit = "preventDefault"
[@@mel.send]

type state = {
  selected : unit -> bool;
  indeterminate : unit -> bool;
  disabled : unit -> bool;
  invalid : unit -> bool;
  read_only : unit -> bool;
  required : unit -> bool;
  aria_label : unit -> string option;
  described_by : unit -> string option;
  interaction : Interaction.t;
}

let controlled ~value ~default ~on_change =
  let own, set_own = S.create_signal default in
  let get () = match value () with Some v -> v | None -> S.get own in
  let set v =
    S.set set_own v;
    ignore (on_change v)
  in
  (get, set)

(* A label inside a control's own clickable label is a span: a label in a
   label is not HTML. *)
let inline : Label.slot =
 fun[@u] classes children ->
  <span class_=(fun () -> classes ()) data_slot="label">
    (fun () -> children ())
  </span>

module type Kobalte = sig
  val label : unit Jsx.component
  val input : unit Jsx.component
end

(* The checks of the parts a library gives, which every library's field
   label and input share. *)
module Label_props = struct
  external check :
    (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
    Solidtype.Html.Label.check = "check"
  [@@mel.module "vite-plugin-solidtype/markers"]
end

module Input_props = struct
  external check :
    (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
    Solidtype.Html.Input.check = "check"
  [@@mel.module "vite-plugin-solidtype/markers"]
end

module As_span (K : sig
  val component : unit Jsx.component
end) =
struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Span.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = K.component
end

module Slots (K : sig
  val label : unit Jsx.component
  val description : unit Jsx.component
  val error : unit Jsx.component
end) =
struct
  module Kobalte_label = struct
    module Props = Label_props

    let component = K.label
  end

  module Kobalte_description = As_span (struct
    let component = K.description
  end)

  module Kobalte_error = As_span (struct
    let component = K.error
  end)

  let%component make ?(label_id : string option) ~(children : Jsx.content) () =
    let label : Label.slot =
     fun[@u] classes children ->
      <Kobalte_label
        ?id=(fun () -> label_id ())
        class_=(fun () -> classes ())
        data_slot="label">
        (fun () -> children ())
      </Kobalte_label>
    in
    let description : Description.slot =
     fun[@u] classes children ->
      <Kobalte_description
        as_="span"
        class_=(fun () -> classes ())
        slot="description"
        data_slot="description">
        (fun () -> children ())
      </Kobalte_description>
    in
    let error : Field_error.slot =
     fun[@u] classes children ->
      <Kobalte_error
        as_="span"
        class_=(fun () -> classes ())
        slot="errorMessage"
        data_slot="field-error"
        data_visible="true">
        (fun () -> children ())
      </Kobalte_error>
    in
    <Label.Slot.Provider value=(fun () -> label)>
      <Description.Slot.Provider value=(fun () -> description)>
        <Field_error.Slot.Provider value=(fun () -> error)>
          (fun () -> children ())
        </Field_error.Slot.Provider>
      </Description.Slot.Provider>
    </Label.Slot.Provider>
end

module Content (K : Kobalte) = struct
  module Kobalte_label = struct
    module Props = Label_props

    let component = K.label
  end

  module Kobalte_input = struct
    module Props = Input_props

    let component = K.input
  end

  let%component make ~(field : state) ~(slot : string) ~(class_ : string)
      ~(children : Jsx.content) () =
    let f = field () in
    let i = f.interaction in
    <Kobalte_label
      class_=(fun () -> class_ ())
      ref=(fun l -> Interaction.watch i l)
      on_click=(fun e -> if Interaction.pointer_inert i then prevent_default e)
      data_slot=(fun () -> Jsx.data (slot ()))
      data_selected=(fun () -> Jsx.flag (f.selected ()))
      data_indeterminate=(fun () -> Jsx.flag (f.indeterminate ()))
      data_disabled=(fun () -> Jsx.flag (f.disabled ()))
      data_invalid=(fun () -> Jsx.flag (f.invalid ()))
      data_readonly=(fun () -> Jsx.flag (f.read_only ()))
      data_required=(fun () -> Jsx.flag (f.required ()))
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))>
      <Label.Slot.Provider value=(fun () -> inline)>
        <Kobalte_input
          ?aria_label=(fun () -> f.aria_label ())
          ?aria_describedby=(fun () -> f.described_by ())
        />
        (fun () -> children ())
      </Label.Slot.Provider>
    </Kobalte_label>
end
