module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.Switch

(* What a switch's parts read of the switch they are in: its classes, and
   its state as a field. *)
type switch = { slots : Styles.Switch.slots S.accessor; field : Field.state }

module Context = Solidtype.Context.Make_optional (struct
  type t = switch
end)

let within part =
  match Context.use () with
  | Some s -> s
  | None -> invalid_arg (part ^ " is used inside a Switch")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Field_content = Field.Content (struct
  let label = Kobalte.Label.component
  let input = Kobalte.Input.component
end)

module Content = struct
  (* What its children are drawn of: React Aria's render props for it, made
     of its field's state and its interaction. *)
  type state = {
    is_selected : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_read_only : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
    is_required : bool Solidtype.Solid.accessor;
  }

  let state_of (f : Field.state) =
    let i = f.interaction in
    {
      is_selected = f.selected;
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = S.accessor (fun () -> Interaction.pressed i);
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = f.disabled;
      is_read_only = f.read_only;
      is_invalid = f.invalid;
      is_required = f.required;
    }

  let%component make ?(class_ : string option) ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Label.props -> state -> Solidtype.Jsx.element) option)
      () =
    let s = within "Switch.Content" in
    let state () = state_of s.field in
    <Field_content
      field=(fun () -> s.field)
      slot="switch-content"
      class_=(fun () ->
               after (Styles.Switch.content (S.get s.slots)) (S.get class_))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state_of s.field))
    </Field_content>
  [@@element label]
end

module Control = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let s = within "Switch.Control" in
    <span
      class_=(fun () ->
               after (Styles.Switch.control (S.get s.slots)) (S.get class_))
      data_slot="switch-control"
      props=(Props.others props)>
      (fun () -> S.get children)
    </span>
  [@@element span]
end

module Thumb = struct
  let%component make ?(class_ : string option) () =
    let s = within "Switch.Thumb" in
    <span
      class_=(fun () ->
               after (Styles.Switch.thumb (S.get s.slots)) (S.get class_))
      data_slot="switch-thumb"
      props=(Props.others props)
    />
  [@@element span]
end

(* What its children are drawn of: React Aria's render props for it,
   made of its state as a field. *)
type state = {
  is_selected : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let state_of (f : Field.state) =
  {
    is_selected = f.selected;
    is_disabled = f.disabled;
    is_read_only = f.read_only;
    is_invalid = f.invalid;
    is_required = f.required;
  }

let%component make ?(size : [ `lg | `md | `sm ] = `md)
    ?(is_selected : bool option) ?(default_selected : bool = false)
    ?(on_change : (bool -> unit) option) ?(is_disabled : bool = false)
    ?(is_invalid : bool = false) ?(is_read_only : bool = false)
    ?(is_required : bool = false) ?(name : string option)
    ?(value : string option) ?(aria_label : string option)
    ?(class_ : string option) ?(on_blur : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* The state is the switch's, read by Kobalte and by every part alike. *)
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid =
    S.accessor (fun () ->
        S.get is_invalid || Option.is_some (S.get in_form.error))
  in
  let on, change =
    Field.controlled
      ~value:(fun () -> S.get is_selected)
      ~default:(S.get default_selected)
      ~on_change:(fun v ->
        in_form.changed ();
        on_change v)
  in
  let s =
    {
      slots =
        S.accessor (fun () ->
            Styles.Switch.slots (Styles.Switch.options ~size:(S.get size) ()));
      field =
        {
          selected = on;
          indeterminate = S.accessor (fun () -> false);
          disabled = is_disabled;
          invalid;
          read_only = is_read_only;
          required = is_required;
          aria_label;
          described_by = S.accessor (fun () -> None);
          interaction =
            Interaction.create
              ~disabled:(fun () -> S.get is_disabled)
              ~no_hover:(fun () -> S.get is_read_only)
              ~no_pointer_press:(fun () -> S.get is_read_only)
              ();
        };
    }
  in
  let state () = state_of s.field in
  <Context.Provider value=(fun () -> s)>
    <Kobalte.Root
      checked=(fun () -> S.get on)
      on_change=change
      disabled=(fun () -> S.get is_disabled)
      read_only=(fun () -> S.get is_read_only)
      required=(fun () -> S.get is_required)
      validation_state=(fun () -> if S.get invalid then `invalid else `valid)
      ?name=(fun () -> S.get name)
      ?value=(fun () -> S.get value)
      class_=(fun () ->
               after (Styles.Switch.base (S.get s.slots)) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            in_form.root e)
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     Field.on_leave
                       (fun e ->
                         in_form.left ();
                         on_blur e)
                       e)
      data_slot="switch"
      data_selected=(fun () -> Jsx.flag (S.get on))
      data_disabled=(fun () -> Jsx.flag (S.get is_disabled))
      data_invalid=(fun () -> Jsx.flag (S.get invalid))
      data_readonly=(fun () -> Jsx.flag (S.get is_read_only))
      data_required=(fun () -> Jsx.flag (S.get is_required))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state_of s.field))
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
