module Jsx = Solidtype.Jsx
module S = Solidtype.Solid
module For = Solidtype.For
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Listbox
module Types = Solidtype_kobalte.Types

type selection_mode = [ `none | `single | `multiple ]

(* An option as it joined its list: its key, its text, whether it is disabled,
   and how it is drawn, given Kobalte's node of it. *)
type option_ = {
  key : string;
  text : unit -> string;
  disabled : unit -> bool;
  draw : node S.accessor -> Jsx.element;
  content : unit -> Jsx.element;
}

(* Kobalte's node of an option, in its list of options alone. *)
and node = (option_, unit) Types.Either.t Types.CollectionNode.t

(* What a list or a section holds, in order: options, sections of options,
   drawn given how to draw an option, and separators. *)
type entry =
  | Option of option_
  | Section of {
      options : unit -> option_ list;
      draw : (option_ -> Jsx.element) -> Jsx.element;
    }
  | Separator of (unit -> Jsx.element)
  | Loader of (unit -> Jsx.element)

(* Each entry stands in its place among its list's children, so the list
   reads them in their order on the page, one added between two included. *)
module Entry = Jsx.Token (struct
  type t = entry
end)

(* Whether a part is inside a list, which reads it: [true], since Solid takes
   a context of [()], which is [undefined], for none. *)
module Within = Solidtype.Context.Make_optional (struct
  type t = bool
end)

(* What a list's options read of it: how it selects, which keys are selected
   and disabled, and what an option chosen does. *)
type focus = Real | Virtual of (unit -> string option)

type listing = {
  mode : unit -> selection_mode;
  is_selected : string -> bool;
  is_disabled : string -> bool;
  act : string -> unit;
  focus : focus;
}

module Listing = Solidtype.Context.Make_optional (struct
  type t = listing
end)

let key (o : option_) = o.key
let text (o : option_) = o.text ()
let content (o : option_) = o.content ()

type list_format

external list_format : unit -> list_format = "ListFormat"
[@@mel.new] [@@mel.scope "Intl"]

external format : list_format -> string array -> string = "format" [@@mel.send]

let listed options =
  format (list_format ()) (Array.of_list (List.map text options))

type list_part

external format_to_parts : list_format -> string array -> list_part array
  = "formatToParts"
[@@mel.send]

external part_type : list_part -> string = "type" [@@mel.get]
external part_value : list_part -> string = "value" [@@mel.get]

(* React Aria's SelectValue: each option's content in the place its text takes
   in the list the reader's language makes of the texts. *)
let shown options =
  let rec join parts contents =
    match (parts, contents) with
    | [], _ -> []
    | part :: parts, content :: contents
      when String.equal (part_type part) "element" ->
        content :: join parts contents
    | part :: parts, contents ->
        Jsx.of_content (Jsx.string (part_value part)) :: join parts contents
  in
  let parts =
    format_to_parts (list_format ()) (Array.of_list (List.map text options))
  in
  Jsx.fragment
    (Array.of_list (join (Array.to_list parts) (List.map content options)))

(* What a part that holds a list takes of it, to draw it as its own. *)
type hosted = {
  options : unit -> option_ list;
  draw : node Types.Collection.t S.accessor -> Jsx.element;
  list_ref : Dom.htmlDivElement -> unit;
  scroll_to_item : string -> unit;
  empty : unit -> bool;
  classes : unit -> string;
  aria_label : unit -> string option;
  others : unit S.rest;
}

module Host = Solidtype.Context.Make_optional (struct
  type t = (hosted -> Jsx.element[@u])
end)

(* What an option's indicator reads of it. *)
type item = {
  item_slots : unit -> Styles.ListboxItem.slots;
  selected : unit -> bool;
}

module Item_context = Solidtype.Context.Make_optional (struct
  type t = item
end)

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* A list's or a section's entries: its children, made by [made] under the
   contexts its parts read, resolved once, so the server and the browser see
   them alike as the page is made, before Kobalte's list is. *)
let resolving made =
  let resolved = S.children (fun () -> Jsx.element (made ())) in
  fun () -> Array.to_list (Entry.read (S.to_array (S.get resolved)))

let within part =
  match Within.use () with
  | Some (_ : bool) -> ()
  | None -> invalid_arg (part ^ " is used inside a List_box")

(* Kobalte's item description as the [<span>] HeroUI's Description is. *)
module As_span = struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.ItemDescription.component
end

let description : Description.slot =
 fun[@u] classes others children ->
  <As_span
    as_="span"
    class_=(fun () -> classes ())
    slot="description"
    data_slot="description"
    props=others>
    (fun () -> children ())
  </As_span>

(* Kobalte's item as the [<div>] React Aria's option is. *)
module As_option = struct
  module Props = struct
    external check :
      ?as_:Jsx.drawn Solidtype.Check.value ->
      item:node Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Item.component
end

external pressed : Dom.keyboardEvent -> string = "key" [@@mel.get]

module Item = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_selected : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    selection_mode : [ `none | `single | `multiple ] S.accessor;
  }

  let%component make ~(id : string) ?(text_value : string option)
      ?(is_disabled : bool = false)
      ?(variant : [ `default | `danger ] = `default) ?(class_ : string option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?(on_key_down : (Dom.keyboardEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    within "List_box.Item";
    let others = Props.others props in
    let key_ = S.untrack id in
    let draw node =
      let l =
        match Listing.use () with
        | Some l -> l
        | None -> invalid_arg "List_box.Item is used inside a List_box"
      in
      let disabled () = is_disabled () || l.is_disabled key_ in
      let selected () = l.is_selected key_ in
      let item_slots () =
        Styles.ListboxItem.slots
          (Styles.ListboxItem.options ~variant:(variant ()) ())
      in
      let i = Interaction.create ~disabled:(fun[@u] () -> disabled ()) () in
      let focused () =
        match l.focus with
        | Real -> Interaction.focused i
        | Virtual focused_key ->
            Option.equal String.equal (focused_key ()) (Some key_)
            && not (disabled ())
      in
      (* A focus held elsewhere shows its ring by the page's last input alone,
         as React Aria's virtual focus does. *)
      let focus_visible () =
        match l.focus with
        | Real -> Interaction.focus_visible i
        | Virtual _ -> focused () && Interaction.keyed ()
      in
      (* React Aria's list without a selection acts on an option pressed. *)
      let act () =
        match l.mode () with
        | `none -> if not (disabled ()) then l.act key_
        | `single | `multiple -> ()
      in
      let state =
        {
          is_hovered = (fun[@u] () -> Interaction.hovered i);
          is_pressed = (fun[@u] () -> Interaction.pressed i);
          is_selected = (fun[@u] () -> selected ());
          is_focused = (fun[@u] () -> focused ());
          is_focus_visible = (fun[@u] () -> focus_visible ());
          is_disabled = (fun[@u] () -> disabled ());
          selection_mode = (fun[@u] () -> l.mode ());
        }
      in
      <As_option
        as_=(fun () ->
              Jsx.drawn_as (Option.map (fun f p -> f p state) (as_ ())) "div")
        item=(fun () -> S.get node)
        class_=(fun () ->
                 after (Styles.ListboxItem.item (item_slots ())) (class_ ()))
        ref=(fun e ->
              ignore (given_ref e : unit option);
              Interaction.watch i e)
        on_click=(fun e ->
                   ignore (on_click e : unit option);
                   act ())
        on_key_down=(fun e ->
                      ignore (on_key_down e : unit option);
                      match pressed e with "Enter" -> act () | _ -> ())
        data_slot="list-box-item"
        data_selection_mode=(fun () ->
                              match l.mode () with
                              | `none -> Jsx.flag false
                              | `single -> Jsx.data "single"
                              | `multiple -> Jsx.data "multiple")
        data_selected=(fun () -> Jsx.flag (selected ()))
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
        data_focused=(fun () -> Jsx.flag (focused ()))
        data_focus_visible=(fun () -> Jsx.flag (focus_visible ()))
        data_disabled=(fun () -> Jsx.flag (disabled ()))
        props=others>
        <Item_context.Provider value=(fun () -> { item_slots; selected })>
          <Description.Slot.Provider value=(fun () -> description)>
            (fun () -> Jsx.draw (children ()) state)
          </Description.Slot.Provider>
        </Item_context.Provider>
      </As_option>
    in
    (* Its children again, outside the list, as a select's value shows
       them, not selected there, as React Aria draws them. *)
    let content () =
      let item_slots () =
        Styles.ListboxItem.slots
          (Styles.ListboxItem.options ~variant:(variant ()) ())
      in
      let no = fun[@u] () -> false in
      <Item_context.Provider
        value=(fun () -> { item_slots; selected = (fun () -> false) })>
        (fun () ->
          Jsx.draw (children ())
            {
              is_hovered = no;
              is_pressed = no;
              is_selected = no;
              is_focused = no;
              is_focus_visible = no;
              is_disabled = no;
              selection_mode = (fun[@u] () -> `none);
            })
      </Item_context.Provider>
    in
    let option_ =
      {
        key = key_;
        text = (fun () -> Option.value (text_value ()) ~default:key_);
        disabled = (fun () -> is_disabled ());
        draw;
        content;
      }
    in
    Entry.element (Option option_)
  [@@element div]
end

module Item_indicator = struct
  let%component make ?(class_ : string option)
      ?(children : (bool S.accessor -> Jsx.element) option) () =
    let i =
      match Item_context.use () with
      | Some i -> i
      | None ->
          invalid_arg "List_box.Item_indicator is used inside a List_box.Item"
    in
    let selected = S.create_memo (fun () -> i.selected ()) in
    <span
      aria_hidden=true
      class_=(fun () ->
               after
                 (Styles.ListboxItem.indicator (i.item_slots ()))
                 (class_ ()))
      data_slot="list-box-item-indicator"
      data_visible=(fun () -> Jsx.flag (i.selected ()))
      props=(Props.others props)>
      (fun () ->
        match children selected with
        | Some drawn -> Jsx.element drawn
        | None ->
            Jsx.element
              <svg
                aria_hidden=true
                fill="none"
                role=`presentation
                stroke="currentColor"
                stroke_dasharray="22"
                stroke_dashoffset=(fun () ->
                                    if i.selected () then "44" else "66")
                stroke_linecap="round"
                stroke_linejoin="round"
                stroke_width="2"
                view_box="0 0 17 18"
                data_slot="list-box-item-indicator--checkmark">
                <polyline points="1 9 7 14 15 4" />
              </svg>)
    </span>
  [@@element span]
end

(* A separator stands in its place, among the options. *)
let separator = fun[@u] drawn -> Entry.element (Separator drawn)

external as_element : _ Dom.element_like -> Dom.element = "%identity"

external query_in : Dom.element -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

external css_escape : string -> string = "escape" [@@mel.scope "CSS"]

module Load_more_item = struct
  let%component make ?(is_loading : bool = false)
      ?(on_load_more : (unit -> unit) option) ?(scroll_offset : float = 1.)
      ~(children : Jsx.content) () =
    within "List_box.Load_more_item";
    let others = Props.others props in
    let draw () =
      Jsx.fragment
        [|
          <div style="position: relative; width: 0px; height: 0px;" inert=true>
            <Solidtype_headless.Load_more_sentinel
              is_loading=(fun () -> is_loading ())
              on_load_more=(fun _ -> ignore (on_load_more () : unit option))
              scroll_offset=(fun () -> scroll_offset ())
              style="position: absolute; height: 1px; width: 1px;"
              data_testid="loadMoreSentinel"
            />
          </div>;
          <Show when_=(fun () -> is_loading ())>
            <div role=`option tabindex="-1" props=others>
              (fun () -> children ())
            </div>
          </Show>;
        |]
    in
    Entry.element (Loader draw)
  [@@element div]
end

module Section = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    within "List_box.Section";
    let header, set_header = S.create_signal None in
    (* A section's header names it, as React Aria's does. *)
    let header_slot : Header.slot =
     fun[@u] classes others children ->
      S.set set_header
        (Some
           (fun header_id ->
             <header
               id=(fun () -> header_id)
               class_=(fun () -> classes ())
               role=`presentation
               data_slot="header"
               props=others>
               (fun () -> children ())
             </header>));
      Jsx.nothing
    in
    let entries =
      resolving (fun () ->
          <Within.Provider value=(fun () -> true)>
            <Header.Slot.Provider value=(fun () -> header_slot)>
              (fun () -> children ())
            </Header.Slot.Provider>
          </Within.Provider>)
    in
    let options () =
      List.filter_map
        (function
          | Option o -> Some o | Section _ | Separator _ | Loader _ -> None)
        (entries ())
    in
    let others = Props.others props in
    let draw draw_option =
      let header_id = S.create_unique_id () in
      <section
        class_=(fun () ->
                 Styles.ListboxSection.classes
                   (Styles.ListboxSection.options ?class_:(class_ ()) ()))
        role=`group
        ?aria_labelledby=(fun () ->
                           Option.map (fun _ -> header_id) (S.get header))
        ?as_=(fun () -> S.drawn_as others)
        props=(S.undrawn others)>
        (fun () ->
          match S.get header with
          | Some drawn -> Jsx.element (drawn header_id)
          | None -> Jsx.element Jsx.nothing)
        <For each=(fun () -> Array.of_list (options ()))>
          (fun o _ -> draw_option o)
        </For>
      </section>
    in
    Entry.element (Section { options; draw })
  [@@element section]
end

(* Kobalte's list as the [<div>] React Aria's list box is, of options alone.
   Kobalte gives its children its collection only where it is virtualized,
   else draws each option flat; the port draws its sections around them. *)
module As_list = struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      ?value:string array Solidtype.Check.value ->
      ?on_change:(string Js.Set.t -> unit) ->
      ?options:(option_, unit) Types.Either.t array Solidtype.Check.value ->
      ?option_value:(option_ -> string) ->
      ?option_text_value:(option_ -> string) ->
      ?option_disabled:(option_ -> bool) ->
      ?selection_mode:[ `none | `single | `multiple ] Solidtype.Check.value ->
      ?virtualized:bool Solidtype.Check.value ->
      ?scroll_to_item:(string -> unit) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:
         ( node Types.Collection.t S.accessor -> Jsx.element,
           [ `render ] )
         Solidtype.Check.children ->
      unit ->
      unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Root.component
end

external set_to_array : string Js.Set.t -> string array = "from"
[@@mel.scope "Array"]

let%component make ?(aria_label : string option)
    ?(selection_mode : selection_mode = `single)
    ?(selected_keys : string array option)
    ?(default_selected_keys : string array option)
    ?(on_selection_change : (string array -> unit) option)
    ?(disabled_keys : string array option)
    ?(on_action : (string -> unit) option)
    ?(render_empty_state : (unit -> Jsx.element) option)
    ?(variant : [ `default | `danger ] = `default) ?(class_ : string option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(children : Jsx.content option) () =
  let entries =
    resolving (fun () ->
        <Within.Provider value=(fun () -> true)>
          <Separator.Slot.Provider value=(fun () -> separator)>
            <Separator.Element.Provider value=(fun () -> `div)>
              (fun () ->
                Option.value (children ()) ~default:(Jsx.element Jsx.nothing))
            </Separator.Element.Provider>
          </Separator.Slot.Provider>
        </Within.Provider>)
  in
  let empty, set_empty = S.create_signal false in
  let kept, set_kept = S.create_signal [||] in
  (* The option the keys move to is brought into view of what scrolls the
     list, as Kobalte asks of a list it does not draw: where it is drawn, by
     its element; where a virtualizer has not drawn it, by its place. *)
  (* A list is laid out by a list's layout, never a table's. *)
  let layout =
    match Virtualizer.use () with
    | Some (List l) -> Some l
    | Some (Table _) | None -> None
  in
  let orientation =
    match layout with Some l -> l.orientation | None -> `vertical
  in
  let list_element = ref None in
  let list_ref e =
    ignore (given_ref e : unit option);
    list_element := Some (as_element e)
  in
  let placed = ref (fun (_ : string) -> false) in
  let scroll_to_item key =
    if not (!placed key) then
      Option.iter
        (Virtualizer.reveal_in orientation)
        (Option.bind !list_element (fun e ->
             Js.Null.toOption
               (query_in e ("[data-key=\"" ^ css_escape key ^ "\"]"))))
  in
  S.create_computed (fun () ->
      S.set set_kept
        (Option.value (S.untrack default_selected_keys) ~default:[||]));
  let selected () =
    match selected_keys () with Some keys -> keys | None -> S.get kept
  in
  let disabled key =
    Array.exists (String.equal key)
      (Option.value (disabled_keys ()) ~default:[||])
  in
  let l =
    {
      mode = selection_mode;
      is_selected = (fun key -> Array.exists (String.equal key) (selected ()));
      is_disabled = disabled;
      act = (fun key -> ignore (on_action key : unit option));
      focus = Real;
    }
  in
  (* Kobalte's list is of its options alone, in order, whatever holds them. *)
  let options () =
    entries ()
    |> List.concat_map (function
      | Option o -> [ o ]
      | Section s -> s.options ()
      | Separator _ | Loader _ -> [])
  in
  (* An option is drawn while Kobalte's collection holds it, as a combo box's
     filter keeps it, and a section while one of its options is. *)
  let draw collection =
    let node (o : option_) () =
      Types.Collection.get_item (S.get collection) o.key
    in
    let option_ (o : option_) =
      <Show.Some some=(node o)>(fun node -> o.draw node)</Show.Some>
    in
    S.create_computed (fun () ->
        S.set set_empty
          (not (List.exists (fun o -> Option.is_some (node o ())) (options ()))));
    let shows (s : unit -> option_ list) () =
      List.exists (fun o -> Option.is_some (node o ())) (s ())
    in
    let entries_drawn =
      match layout with
      | None ->
          <For each=(fun () -> Array.of_list (entries ()))>
            (fun entry _ ->
              match entry with
              | Option o -> option_ o
              | Separator drawn | Loader drawn -> drawn ()
              | Section s ->
                  <Show when_=(shows s.options)>
                    (fun () -> Jsx.element (s.draw option_))
                  </Show>)
          </For>
      | Some l ->
          let shown = function
            | Option o -> Option.is_some (node o ())
            | Section s -> shows s.options ()
            | Separator _ | Loader _ -> true
          in
          let rows () = Array.of_list (List.filter shown (entries ())) in
          let holds key = function
            | Option o -> String.equal o.key key
            | Section s ->
                List.exists (fun o -> String.equal o.key key) (s.options ())
            | Separator _ | Loader _ -> false
          in
          let state = Kobalte.use_listbox_context () in
          let focused () =
            Types.SelectionManager.focused_key
              (S.get
                 (Types.ListState.selection_manager
                    (S.get (Types.ListboxContextValue.list_state state))))
              ()
          in
          let row_estimate =
            match (l.row_size, l.estimated_row_size) with
            | _, Some n | Some n, None -> n
            | None, None -> 48.
          in
          let w =
            Virtualizer.window l ~rows
              ~fixed:(function
                | Option _ -> (
                    match (l.row_size, l.estimated_row_size) with
                    | Some n, _ -> Some n
                    | None, Some _ -> None
                    | None, None -> Some 48.)
                | Loader _ -> Some l.loader_size
                | Section _ | Separator _ -> None)
              ~estimate:(function
                | Option _ -> row_estimate
                | Section s ->
                    let heading =
                      match (l.heading_size, l.estimated_heading_size) with
                      | _, Some n | Some n, None -> n
                      | None, None -> 48.
                    in
                    heading
                    +. (row_estimate +. l.gap)
                       *. float_of_int (List.length (s.options ()))
                | Separator _ -> 1.
                | Loader _ -> l.loader_size)
              ~keep:(fun entry ->
                match focused () with
                | Some key -> holds key entry
                | None -> false)
          in
          (* An option of the list is placed by the layout, exactly; one in a
             section, by its element. *)
          (placed :=
             fun key ->
               match Array.find_opt (holds key) (S.untrack rows) with
               | Some (Option _ as entry) ->
                   w.scroll_to entry;
                   true
               | Some ((Section _ | Separator _ | Loader _) as entry) ->
                   w.scroll_to entry;
                   false
               | None -> false);
          <div
            role=`presentation
            ref=(fun e -> w.watch (as_element e))
            style=(fun () -> w.block ())>
            <For each=(fun () -> w.drawn ())>
              (fun entry _ ->
                <div
                  role=`presentation
                  ref=(fun e -> w.frame entry (as_element e))
                  style=(fun () -> w.place entry)>
                  (fun () ->
                    match entry with
                    | Option o -> Jsx.element (option_ o)
                    | Separator drawn | Loader drawn -> Jsx.element (drawn ())
                    | Section s -> Jsx.element (s.draw option_))
                </div>)
            </For>
          </div>
    in
    Jsx.fragment
      [|
        entries_drawn;
        (* What it shows while it holds no option, as React Aria's draws it. *)
        <Show when_=(fun () -> S.get empty)>
          (fun () ->
            match render_empty_state () with
            | Some drawn ->
                Jsx.element
                  <div role=`option style="display: contents;">
                    (fun () -> Jsx.element drawn)
                  </div>
            | None -> Jsx.element Jsx.nothing)
        </Show>;
      |]
  in
  let classes () =
    Styles.Listbox.classes
      (Styles.Listbox.options ~variant:(variant ()) ?class_:(class_ ()) ())
  in
  match Host.use () with
  | Some take ->
      take
        {
          options;
          draw;
          empty = (fun () -> S.get empty);
          classes;
          aria_label = (fun () -> aria_label ());
          others = Props.others props;
          list_ref;
          scroll_to_item;
        } [@u]
  | None ->
      <As_list
        as_="div"
        ?aria_label
        value=(fun () -> selected ())
        options=(fun () ->
                  Array.of_list (List.map Types.Either.left (options ())))
        option_value=(fun o -> o.key)
        option_text_value=(fun o -> o.text ())
        option_disabled=(fun o -> o.disabled () || disabled o.key)
        selection_mode=(fun () -> selection_mode ())
        virtualized=true
        scroll_to_item
        ref=list_ref
        aria_orientation=`vertical
        class_=(fun () -> classes ())
        data_slot="list-box"
        data_layout="stack"
        data_orientation="vertical"
        data_empty=(fun () -> Jsx.flag (S.get empty))
        props=(Props.others props)
        on_change=(fun keys ->
                    let keys = set_to_array keys in
                    S.set set_kept keys;
                    ignore (on_selection_change keys : unit option))>
        (fun collection ->
          <Listing.Provider value=(fun () -> l)>
            (fun () -> Jsx.element (draw collection))
          </Listing.Provider>)
      </As_list>
[@@element div]
