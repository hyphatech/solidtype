module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.Button

(* HeroUI's cross, which a close button draws where it is given nothing. *)
module Icon = struct
  let%component make () =
    <svg
      aria_hidden=true
      fill="none"
      height="16"
      role=`presentation
      view_box="0 0 16 16"
      width="16"
      xmlns="http://www.w3.org/2000/svg"
      data_slot="close-button-icon"
      props=(Props.others props)>
      <path
        clip_rule="evenodd"
        d="M3.47 3.47a.75.75 0 0 1 1.06 0L8 6.94l3.47-3.47a.75.75 0 1 1 1.06 \
           1.06L9.06 8l3.47 3.47a.75.75 0 1 1-1.06 1.06L8 9.06l-3.47 \
           3.47a.75.75 0 0 1-1.06-1.06L6.94 8 3.47 4.53a.75.75 0 0 1 0-1.06Z"
        fill="currentColor"
        fill_rule="evenodd"
      />
    </svg>
  [@@element svg]
end

(* What a close button's children are drawn of: React Aria's render props
   for a button. *)
type state = {
  is_hovered : bool Solidtype.Solid.accessor;
  is_pressed : bool Solidtype.Solid.accessor;
  is_focused : bool Solidtype.Solid.accessor;
  is_focus_visible : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
}

let%component make ?(variant : [ `default ] = `default)
    ?(is_disabled : bool = false) ?(aria_label : string = "Close")
    ?(class_ : string option) ?(on_click : (Dom.mouseEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
    ?(children : state Jsx.children option)
    ?(as_ :
       (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
    () =
  let i = Interaction.create ~disabled:(fun[@u] () -> is_disabled ()) () in
  let state () =
    {
      is_hovered = (fun[@u] () -> Interaction.hovered i);
      is_pressed = (fun[@u] () -> Interaction.pressed i);
      is_focused = (fun[@u] () -> Interaction.focused i);
      is_focus_visible = (fun[@u] () -> Interaction.focus_visible i);
      is_disabled = (fun[@u] () -> Interaction.disabled i);
    }
  in
  <Kobalte.Root
    aria_label=(fun () -> aria_label ())
    class_=(fun () ->
             Styles.CloseButton.classes
               (Styles.CloseButton.options ~variant:(variant ())
                  ?class_:(class_ ()) ()))
    disabled=(fun () -> is_disabled ())
    ref=(fun b ->
          ignore (given_ref b : unit option);
          Interaction.watch i b)
    data_slot="close-button"
    data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
    data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
    data_focused=(fun () -> Jsx.flag (Interaction.focused i))
    data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
    data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
    type_=`button
    on_click=(fun e -> ignore (on_click e : unit option))
    ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (as_ ()))
    props=(Props.others props)>
    (fun () ->
      match children () with
      | Some c -> Jsx.draw c (state ())
      | None -> Jsx.element <Icon />)
  </Kobalte.Root>
[@@element button]
