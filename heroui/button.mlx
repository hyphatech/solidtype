module Kobalte = Solidtype_kobalte.Button

type trigger = {
  component : unit Solidtype.Jsx.component;
  is_disabled : (unit -> bool) option;
  controls : string option;
  pressed : (unit -> bool) option;
  needs_slot : bool;
}

(* A button another part makes its trigger, as React Aria's ButtonContext
   slots do: a disclosure's heading gives it Kobalte's trigger, which is
   Kobalte's button with the part's state; and as its FocusableContext does,
   a tooltip gives any button below it Kobalte's tooltip trigger. *)
module Trigger = Solidtype.Context.Make_optional (struct
  type t = trigger
end)

(* What closes the dialog a button with slot=`close is in, as React Aria's
   close slot gives it. *)
module Close = Solidtype.Context.Make_optional (struct
  type t = unit -> unit
end)

let no_trigger =
  {
    component = Kobalte.Root.component;
    is_disabled = None;
    controls = None;
    pressed = None;
    needs_slot = true;
  }

let%component make
    ?(variant :
       [ `primary
       | `secondary
       | `tertiary
       | `outline
       | `ghost
       | `danger
       | `danger_soft ]
       option) ?(size : [ `sm | `md | `lg ] option) ?(full_width : bool option)
    ?(is_icon_only : bool = false) ?(is_disabled : bool option)
    ?(slot : [ `trigger | `close ] option)
    ?(type_ : Solidtype.Html.Button.type_ = `button) ?(class_ : string option)
    ?(on_click : (Dom.mouseEvent -> unit) option) ?(aria_label : string option)
    ~(children : Solidtype.Jsx.content) () =
  (* A prop the button sets is its own, else its group's, else HeroUI's
     default; and it is disabled, too, in a disabled fieldset. *)
  let group = Button_group.Context.use () in
  let given own of_group default () =
    match own () with
    | Some v -> v
    | None -> (
        match Option.bind group of_group with Some v -> v | None -> default)
  in
  let variant =
    given variant (fun (g : Button_group.group) -> g.variant ()) `primary
  in
  let size = given size (fun (g : Button_group.group) -> g.size ()) `md in
  let full_width =
    given full_width (fun (g : Button_group.group) -> g.full_width ()) false
  in
  let trigger =
    match (slot (), Trigger.use ()) with
    | Some `trigger, t -> t
    | (None | Some `close), Some t when not t.needs_slot -> Some t
    | (None | Some `close), (Some _ | None) -> None
  in
  let closes =
    match slot () with
    | Some `close -> Close.use ()
    | Some `trigger | None -> None
  in
  let in_fieldset = Fieldset.disabled () in
  let is_disabled () =
    match
      (is_disabled (), Option.bind trigger (fun (t : trigger) -> t.is_disabled))
    with
    | Some d, _ -> d
    | None, Some part -> part ()
    | None, None -> (
        match
          Option.bind group (fun (g : Button_group.group) -> g.is_disabled ())
        with
        | Some d -> d
        | None -> in_fieldset ())
  in
  let module Root = struct
    module Props = Kobalte.Root.Props

    let component =
      match trigger with
      | Some t -> t.component
      | None -> Kobalte.Root.component
  end in
  let i = Interaction.create ~disabled:(fun[@u] () -> is_disabled ()) () in
  <Root
    class_=(fun () ->
             Styles.Button.classes
               (Styles.Button.options ~variant:(variant ()) ~size:(size ())
                  ~full_width:(full_width ()) ~is_icon_only:(is_icon_only ())
                  ?class_:(class_ ()) ()))
    disabled=(fun () -> is_disabled ())
    ?aria_label
    ?aria_controls=(fun () ->
                     Option.bind trigger (fun (t : trigger) -> t.controls))
    ref=(fun b -> Interaction.watch i b)
    ?slot=(fun () ->
            Option.map
              (function `trigger -> "trigger" | `close -> "close")
              (slot ()))
    data_slot="button"
    data_hovered=(fun () -> Solidtype.Jsx.flag (Interaction.hovered i))
    data_pressed=(fun () ->
                   Solidtype.Jsx.flag
                     (Interaction.pressed i
                     ||
                     match
                       Option.bind trigger (fun (t : trigger) -> t.pressed)
                     with
                     | Some shown -> shown ()
                     | None -> false))
    data_focused=(fun () -> Solidtype.Jsx.flag (Interaction.focused i))
    data_focus_visible=(fun () ->
                         Solidtype.Jsx.flag (Interaction.focus_visible i))
    data_disabled=(fun () -> Solidtype.Jsx.flag (Interaction.disabled i))
    type_=(fun () -> type_ ())
    on_click=(fun e ->
               ignore (on_click e : unit option);
               Option.iter (fun close -> close ()) closes)
    props=(Props.others props)>
    (fun () -> children ())
  </Root>
