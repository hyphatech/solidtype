module S = Solidtype.Solid
module Kobalte = Solidtype_kobalte.Button

type trigger = {
  component : unit Solidtype.Jsx.component;
  is_disabled : (unit -> bool) option;
  controls : string option;
  described_by : string option;
  pressed : (unit -> bool) option;
  needs_slot : bool;
  element : (Dom.element -> unit) option;
}

(* A button another part makes its trigger, as React Aria's ButtonContext
   slots do: a disclosure's heading gives it Kobalte's trigger, which is
   Kobalte's button with the part's state; and as its FocusableContext does,
   a tooltip gives any button below it Kobalte's tooltip trigger. *)
module Trigger = Solidtype.Context.Make_optional (struct
  type t = trigger
end)

(* What closes the dialog a button with slot=`close is in, as React Aria's
   close slot gives it. *)
module Close = Solidtype.Context.Make_optional (struct
  type t = unit -> unit
end)

type chevron = {
  toggle : unit -> unit;
  focus_row : unit -> unit;
  labelled_by : string;
}

(* What a button with slot=`chevron expands and collapses: the row it is in,
   as React Aria's chevron slot gives it. *)
module Chevron = Solidtype.Context.Make_optional (struct
  type t = chevron
end)

let no_trigger =
  {
    component = Kobalte.Root.component;
    is_disabled = None;
    controls = None;
    described_by = None;
    pressed = None;
    needs_slot = true;
    element = None;
  }

external as_element : _ Dom.element_like -> Dom.element = "%identity"
external body : Dom.element = "body" [@@mel.scope "document"]

external create_element : string -> Dom.element = "createElement"
[@@mel.scope "document"]

external set_attribute : Dom.element -> string -> string -> unit
  = "setAttribute"
[@@mel.send]

external append : Dom.element -> Dom.element -> unit = "appendChild"
[@@mel.send]

external remove : Dom.element -> unit = "remove" [@@mel.send]
external connected : Dom.element -> bool = "isConnected" [@@mel.get]
external element_id : Dom.element -> string = "id" [@@mel.get]
external set_element_id : Dom.element -> string -> unit = "id" [@@mel.set]

external on_capture :
  Dom.element ->
  string ->
  (Dom.event -> unit) ->
  (_[@mel.as {json|true|json}]) ->
  unit = "addEventListener"
[@@mel.send]

external stop_propagation : Dom.event -> unit = "stopPropagation" [@@mel.send]
external prevent_default : Dom.event -> unit = "preventDefault" [@@mel.send]

(* React Aria's live announcer: an assertive log, out of sight, made once a
   message is first announced, in which a message stays seven seconds, as
   React Aria's does. A message is an element named by the ids given, which a
   reader reads as the element they name. *)
let log = ref None

let announce labelled_by =
  let region =
    match !log with
    | Some region when connected region -> region
    | Some _ | None ->
        let hidden = create_element "div" in
        set_attribute hidden "data-live-announcer" "true";
        set_attribute hidden "style"
          "border: 0; clip: rect(0 0 0 0); clip-path: inset(50%); \
           height:            1px; margin: -1px; overflow: hidden; padding: 0; \
           position:            absolute; width: 1px; white-space: nowrap";
        let region = create_element "div" in
        set_attribute region "role" "log";
        set_attribute region "aria-live" "assertive";
        set_attribute region "aria-relevant" "additions";
        append hidden region;
        append body hidden;
        log := Some region;
        region
  in
  let message = create_element "div" in
  set_attribute message "role" "img";
  set_attribute message "aria-labelledby" labelled_by;
  append region message;
  ignore
    (Js.Global.setTimeout ~f:(fun () -> remove message) 7000
      : Js.Global.timeoutId)

(* What a button's children are drawn of: React Aria's render props for a
   button, each read where Solid tracks it. *)
type state = {
  is_hovered : bool S.accessor;
  is_pressed : bool S.accessor;
  is_focused : bool S.accessor;
  is_focus_visible : bool S.accessor;
  is_disabled : bool S.accessor;
  is_pending : bool S.accessor;
}

let%component make
    ?(variant :
       [ `primary
       | `secondary
       | `tertiary
       | `outline
       | `ghost
       | `danger
       | `danger_soft ]
       option) ?(size : [ `sm | `md | `lg ] option) ?(full_width : bool option)
    ?(is_icon_only : bool = false) ?(is_disabled : bool option)
    ?(is_pending : bool = false) ?(id : string option)
    ?(slot : [ `trigger | `close | `chevron ] option)
    ?(type_ : Solidtype.Html.Button.type_ = `button) ?(class_ : string option)
    ?(on_click : (Dom.mouseEvent -> unit) option)
    ?(on_focus : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
    ?(aria_label : string option) ~(children : state Solidtype.Jsx.children)
    ?(as_ :
       (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* A prop the button sets is its own, else its group's, else HeroUI's
     default; and it is disabled, too, in a disabled fieldset. *)
  let group = Button_group.Context.use () in
  let given own of_group default =
    S.accessor (fun () ->
        match S.get own with
        | Some v -> v
        | None -> (
            match Option.bind group of_group with
            | Some v -> v
            | None -> default))
  in
  let variant =
    given variant (fun (g : Button_group.group) -> S.get g.variant) `primary
  in
  let size = given size (fun (g : Button_group.group) -> S.get g.size) `md in
  let full_width =
    given full_width (fun (g : Button_group.group) -> S.get g.full_width) false
  in
  let trigger =
    match (S.get slot, Trigger.use ()) with
    | Some `trigger, t -> t
    | (None | Some `close | Some `chevron), Some t when not t.needs_slot ->
        Some t
    | (None | Some `close | Some `chevron), (Some _ | None) -> None
  in
  let closes =
    match S.get slot with
    | Some `close -> Close.use ()
    | Some (`trigger | `chevron) | None -> None
  in
  let chevron =
    match S.get slot with
    | Some `chevron -> Chevron.use ()
    | Some (`trigger | `close) | None -> None
  in
  let in_fieldset = Fieldset.disabled () in
  let is_disabled =
    S.accessor (fun () ->
        match
          ( S.get is_disabled,
            Option.bind trigger (fun (t : trigger) -> t.is_disabled) )
        with
        | Some d, _ -> d
        | None, Some part -> part ()
        | None, None -> (
            match
              Option.bind group (fun (g : Button_group.group) ->
                  S.get g.is_disabled)
            with
            | Some d -> d
            | None -> S.get in_fieldset))
  in
  let module Root = struct
    module Props = Kobalte.Root.Props

    let component =
      match trigger with
      | Some t -> t.component
      | None -> Kobalte.Root.component
  end in
  let pending () = S.get is_pending in
  (* Its id names it with its spinner, and is what an announcement reads: the
     id it is given, else the one its element has, a trigger's, else its
     own. *)
  let own_id =
    match S.untrack (fun () -> S.get id) with
    | Some given -> given
    | None -> S.create_unique_id ()
  in
  let element = ref None in
  let named_by () =
    match !element with
    | Some e when not (String.equal (element_id e) "") -> element_id e
    | Some _ | None -> own_id
  in
  let progress_id = S.create_unique_id () in
  let labelled_by =
    S.accessor (fun () ->
        match (S.get aria_label, chevron) with
        | Some _, _ when pending () -> Some (named_by () ^ " " ^ progress_id)
        | Some _, Some c -> Some (named_by () ^ " " ^ c.labelled_by)
        | Some _, None | None, _ -> None)
  in
  let i =
    Interaction.create
      ~disabled:(fun () -> S.get is_disabled)
      ~no_hover:(fun () -> pending ())
      ()
  in
  (* Pressed as it is, or as its trigger shows it, and never while pending. *)
  let pressed =
    S.accessor (fun () ->
        (not (pending ()))
        && (Interaction.pressed i
           ||
           match Option.bind trigger (fun (t : trigger) -> t.pressed) with
           | Some shown -> shown ()
           | None -> false))
  in
  let state =
    {
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = pressed;
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = S.accessor (fun () -> Interaction.disabled i);
      is_pending = S.accessor (fun () -> pending ());
    }
  in
  (* A reader is told as it comes to be pending, or stops, while it has the
     focus, as React Aria tells it. *)
  S.create_computed_from ~init:(S.untrack pending) (fun was ->
      let now = pending () in
      if Interaction.focused i && not (Bool.equal was now) then
        announce
          (match S.untrack (fun () -> S.get labelled_by) with
          | Some ids -> ids
          | None -> named_by ());
      now);
  <Root
    class_=(fun () ->
             Styles.Button.classes
               (Styles.Button.options ~variant:(S.get variant)
                  ~size:(S.get size) ~full_width:(S.get full_width)
                  ~is_icon_only:(S.get is_icon_only) ?class_:(S.get class_) ()))
    disabled=(fun () -> S.get is_disabled)
    ?aria_label=(fun () -> S.get aria_label)
    ?id=(fun () ->
          match (S.get id, trigger) with
          | Some given, _ -> Some given
          | None, None -> Some own_id
          | None, Some _ -> None)
    ?aria_labelledby=(fun () -> S.get labelled_by)
    ?aria_disabled=(fun () -> if pending () then Some true else None)
    ?aria_controls=(fun () ->
                     Option.bind trigger (fun (t : trigger) -> t.controls))
    ?aria_describedby=(fun () ->
                        Option.bind trigger (fun (t : trigger) ->
                            t.described_by))
    ref=(fun b ->
          Interaction.watch i b;
          (let e = as_element b in
           element := Some e;
           if String.equal (element_id e) "" then set_element_id e own_id;
           (* While pending, a press reaches nothing it would do: the
              button's handlers nor a trigger's, as React Aria takes them
              away; its focus and hover stay. *)
           on_capture e "click" (fun ev ->
               if S.untrack pending then begin
                 stop_propagation ev;
                 prevent_default ev
               end));
          (match Option.bind trigger (fun (t : trigger) -> t.element) with
          | Some made -> made (as_element b)
          | None -> ());
          ignore (given_ref b : unit option))
    ?slot=(fun () ->
            Option.map
              (function
                | `trigger -> "trigger"
                | `close -> "close"
                | `chevron -> "chevron")
              (S.get slot))
    ?tabindex=(fun () -> Option.map (fun _ -> "-1") chevron)
    on_focus=(fun e ->
               ignore (on_focus e : unit option);
               (* A chevron's press is its row's, which takes the focus, as
                  React Aria's does: from the button the pointer focused, so
                  the row shows no ring a key's focus would. *)
               Option.iter (fun c -> c.focus_row ()) chevron)
    data_slot="button"
    data_hovered=(fun () -> Solidtype.Jsx.flag (Interaction.hovered i))
    data_pressed=(fun () -> Solidtype.Jsx.flag (S.get pressed))
    data_focused=(fun () -> Solidtype.Jsx.flag (Interaction.focused i))
    data_focus_visible=(fun () ->
                         Solidtype.Jsx.flag (Interaction.focus_visible i))
    data_disabled=(fun () -> Solidtype.Jsx.flag (Interaction.disabled i))
    data_pending=(fun () -> Solidtype.Jsx.flag (pending ()))
                 (* A pending submit button submits nothing, Enter in a field included. *)
    type_=(fun () ->
            match S.get type_ with
            | `submit when pending () -> `button
            | (`submit | `reset | `button | `menu) as t -> t)
    on_click=(fun e ->
               ignore (on_click e : unit option);
               Option.iter (fun close -> close ()) closes;
               Option.iter (fun c -> c.toggle ()) chevron)
    ?as_=(fun () -> Option.map (fun f p -> f p state) (S.get as_))
    props=(Props.others props)>
    <Spinner.Progress.Provider value=(fun () -> progress_id)>
      (fun () -> Solidtype.Jsx.draw (S.get children) state)
    </Spinner.Progress.Provider>
  </Root>
[@@element button]
