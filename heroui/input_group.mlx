module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

external query : Dom.htmlDivElement -> string -> Dom.htmlElement Js.null
  = "querySelector"
[@@mel.send]

external focus : Dom.htmlElement -> unit = "focus" [@@mel.send]
external target : Dom.mouseEvent -> Dom.element = "target" [@@mel.get]

external contains : Dom.htmlElement -> Dom.element -> bool = "contains"
[@@mel.send]

(* What a group's parts read of it: its classes. *)
type group = { slots : Styles.InputGroup.slots S.accessor }

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

let within part =
  match Context.use () with
  | Some g -> g
  | None -> invalid_arg (part ^ " is used inside an Input_group")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Prefix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let g = within "Input_group.Prefix" in
    <div
      class_=(fun () ->
               after (Styles.InputGroup.prefix (S.get g.slots)) (S.get class_))
      data_slot="input-group-prefix"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Suffix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let g = within "Input_group.Suffix" in
    <div
      class_=(fun () ->
               after (Styles.InputGroup.suffix (S.get g.slots)) (S.get class_))
      data_slot="input-group-suffix"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Input = struct
  module Props = Input.Props

  let make (props : Props.t) =
    let g = within "Input_group.Input" in
    Input.input props ~slot:"input-group-input" ~classes:(fun ~variant:_ ->
        after (Styles.InputGroup.input (S.get g.slots)) (Props.class_ props))

  let component = Jsx.component make
end

module Text_area = struct
  module Props = Text_area.Props

  let make (props : Props.t) =
    let g = within "Input_group.Text_area" in
    Text_area.text_area props ~slot:"input-group-textarea"
      ~classes:(fun ~variant:_ ->
        after (Styles.InputGroup.input (S.get g.slots)) (Props.class_ props))

  let component = Jsx.component make
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  is_hovered : bool Solidtype.Solid.accessor;
  is_focus_within : bool Solidtype.Solid.accessor;
  is_focus_visible : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
}

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(full_width : bool option) ?(is_disabled : bool option)
    ?(is_invalid : bool option) ?(class_ : string option)
    ?(on_click : (Dom.mouseEvent -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let field = Text_field.Context.use () in
  let disabled () =
    match (S.get is_disabled, field) with
    | Some d, _ -> d
    | None, Some f -> S.get f.disabled
    | None, None -> false
  in
  let invalid () =
    match (S.get is_invalid, field) with
    | Some i, _ -> i
    | None, Some f -> S.get f.invalid
    | None, None -> false
  in
  let g =
    {
      slots =
        S.accessor (fun () ->
            Styles.InputGroup.slots
              (Styles.InputGroup.options ?full_width:(S.get full_width)
                 ?variant:
                   (match S.get variant with
                   | Some v -> Some v
                   | None ->
                       Option.bind field (fun (f : Text_field.field) ->
                           S.get f.variant))
                 ()));
    }
  in
  let i = Interaction.create ~disabled:(fun () -> disabled ()) () in
  let element = ref None in
  (* A click on the group but on its input gives the input the focus, as
     HeroUI's does: an input's, never a text area's. *)
  let clicked e =
    ignore (on_click e : unit option);
    match !element with
    | Some group -> (
        match Js.Null.toOption (query group "input") with
        | Some input when not (contains input (target e)) -> focus input
        | Some _ | None -> ())
    | None -> ()
  in
  let state () =
    {
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_focus_within = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = S.accessor (fun () -> disabled ());
      is_invalid = S.accessor (fun () -> invalid ());
    }
  in
  <Context.Provider value=(fun () -> g)>
    <div
      role=(fun () ->
             (* In a field, the field is the group, as React Aria's is. *)
             match field with
             | Some _ -> `presentation
             | None -> `group)
      ref=(fun e ->
            element := Some e;
            Interaction.watch i e)
      on_click=clicked
      class_=(fun () ->
               after (Styles.InputGroup.base (S.get g.slots)) (S.get class_))
      data_slot="input-group"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_focus_within=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      data_invalid=(fun () -> Jsx.flag (invalid ()))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </div>
  </Context.Provider>
[@@element div]
