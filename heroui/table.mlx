module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Selection = Solidtype_kobalte.Selection
module Types = Solidtype_kobalte.Types
module Either = Types.Either
module List_state = Types.ListState
module Selectable_list = Types.Selection_CreateSelectableList
module Selectable_item = Types.Selection_CreateSelectableItem

external focus : Dom.element -> unit = "focus" [@@mel.send]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external text_content : _ Dom.element_like -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external attribute : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

external query_all :
  _ Dom.element_like -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

(* Whether [other] follows [e] on the page, by DOM's bit for it. *)
external position : _ Dom.element_like -> _ Dom.element_like -> int
  = "compareDocumentPosition"
[@@mel.send]

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]
external event_target : _ Dom.event_like -> Dom.element = "target" [@@mel.get]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

(* Whether an event began in a checkbox, which handles its own press. *)
let in_checkbox e =
  Js.Null.toOption (closest (event_target e) "[data-slot=checkbox]") <> None

external prevent_default : Dom.keyboardEvent -> unit = "preventDefault"
[@@mel.send]

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* The table's classes, which every part reads. *)
module Slots = Solidtype.Context.Make_optional (struct
  type t = unit -> Styles.Table.slots
end)

let in_table part =
  match Slots.use () with
  | Some slots -> slots
  | None -> invalid_arg (part ^ " is used inside a Table")

(* A row as the table keeps it: its key, and its element, which says where it
   is on the page. *)
type row = { key : string; element : Dom.htmlTableRowElement }

(* What a table's parts read of its content: its rows in the page's order,
   Kobalte's selection of them, and its columns. *)
type content = {
  rows : unit -> row list;
  add : row -> unit;
  remove : string -> unit;
  manager : Types.MultipleSelectionManager.t S.accessor;
  selection_mode : unit -> [ `none | `single | `multiple ];
  disabled : string -> bool;
  row_header : unit -> int;
  set_row_header : int -> unit;
  next_column : unit -> int;
  columns : unit -> int;
}

module Content_context = Solidtype.Context.Make_optional (struct
  type t = content
end)

let in_content part =
  match Content_context.use () with
  | Some c -> c
  | None -> invalid_arg (part ^ " is used inside a Table.Content")

(* What a row's cells read of it: the column the next is in, and the id of the
   one that names the row. *)
type row_cells = { next_cell : unit -> int; header_id : string }

module Row_context = Solidtype.Context.Make_optional (struct
  type t = row_cells
end)

let role e = Js.Null.toOption (attribute e "role")

(* A row's cells, in order: a header's columns, or a body row's cells. *)
let cells row =
  Js.Array.from
    (query_all row
       ":scope > [role=gridcell], :scope > [role=rowheader], :scope > \
        [role=columnheader]")

let index_of e items =
  let rec find i =
    if i >= Array.length items then None
    else if items.(i) == e then Some i
    else find (i + 1)
  in
  find 0

(* Where a key moves focus from a cell, as React Aria's grid moves it: along
   its row, back to the row from its first cell, and to the cell of the same
   column in the row above or below, the header's included. *)
let from_cell table cell k =
  match Js.Null.toOption (parent cell) with
  | None -> None
  | Some row -> (
      let along = cells row in
      let last = Array.length along - 1 in
      let i = Option.value (index_of cell along) ~default:0 in
      let body_row = Js.Null.toOption (attribute row "data-key") <> None in
      let vertical step =
        let rows = Js.Array.from (query_all table "tr[role=row]") in
        match index_of row rows with
        | Some r when r + step >= 0 && r + step < Array.length rows ->
            let next = cells rows.(r + step) in
            if Array.length next = 0 then None
            else Some next.(min i (Array.length next - 1))
        | Some _ | None -> None
      in
      match k with
      | "ArrowRight" ->
          if i < last then Some along.(i + 1)
          else if body_row then Some row
          else None
      | "ArrowLeft" ->
          if i > 0 then Some along.(i - 1)
          else if body_row then Some row
          else None
      | "ArrowDown" -> vertical 1
      | "ArrowUp" -> vertical (-1)
      | "Home" -> if last >= 0 then Some along.(0) else None
      | "End" -> if last >= 0 then Some along.(last) else None
      | _ -> None)

(* From a row, the arrows across reach its first cell, or its last. *)
let from_row row k =
  let along = cells row in
  let last = Array.length along - 1 in
  match k with
  | "ArrowRight" when last >= 0 -> Some along.(0)
  | "ArrowLeft" when last >= 0 -> Some along.(last)
  | _ -> None

let tabindex = function Some i -> Js.Float.toString i | None -> "-1"

module Scroll_container = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Scroll_container" in
    <div
      class_=(fun () ->
               after (Styles.Table.scroll_container (slots ())) (class_ ()))
      data_slot="table-scroll-container"
      props=(Props.others props)>
      (fun () -> children ())
    </div>
end

module Content = struct
  let%component make ?(aria_label : string option)
      ?(aria_labelledby : string option)
      ?(selection_mode : [ `none | `single | `multiple ] = `none)
      ?(selection_behavior : [ `toggle | `replace ] = `toggle)
      ?(selected_keys : string array option)
      ?(default_selected_keys : string array option)
      ?(on_selection_change : (string array -> unit) option)
      ?(disabled_keys : string array option)
      ?(disallow_empty_selection : bool = false) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let slots = in_table "Table.Content" in
    let rows, set_rows = S.create_signal [] in
    let ordered () =
      List.sort
        (fun a b -> if position a.element b.element land 4 <> 0 then -1 else 1)
        (S.get rows)
    in
    let keys =
      S.create_memo (fun () ->
          Array.of_list (List.map (fun r -> r.key) (ordered ())))
    in
    let disabled k =
      match disabled_keys () with
      | Some keys -> Array.exists (String.equal k) keys
      | None -> false
    in
    let text k =
      match List.find_opt (fun r -> String.equal r.key k) (S.get rows) with
      | Some r -> text_content r.element
      | None -> ""
    in
    let state =
      Selection.create_list_state
        (Types.CreateListStateProps.make ~data_source:(Either.right keys)
           ~get_key:(Either.left Fun.id) ~get_text_value:(Either.left text)
           ~get_disabled:(Either.left disabled)
           ~selection_mode:
             (Either.right (S.create_memo (fun () -> Some (selection_mode ()))))
           ~selection_behavior:
             (Either.right
                (S.create_memo (fun () -> Some (selection_behavior ()))))
           ~disallow_empty_selection:
             (Either.right
                (S.create_memo (fun () -> Some (disallow_empty_selection ()))))
           ~selected_keys:(Either.right (S.create_memo selected_keys))
           ?default_selected_keys:
             (Option.map Either.left (S.untrack default_selected_keys))
           ~on_selection_change:(fun keys ->
             ignore (on_selection_change (Js.Set.toArray keys) : unit option))
           ())
    in
    let manager =
      S.create_memo (fun () ->
          Types.SelectionManager.to_multiple_selection_manager
            (S.get (List_state.selection_manager state)))
    in
    let element, set_element = S.create_signal None in
    let list =
      Selection.create_selectable_list
        (Types.CreateSelectableListProps.make
           ~collection:(List_state.collection state)
           ~selection_manager:(Either.right manager) ())
        element ()
    in
    let row_header, set_row_header = S.create_signal 0 in
    let columns, set_columns = S.create_signal 0 in
    let c =
      {
        rows = ordered;
        add = (fun r -> S.set set_rows (r :: S.get rows));
        remove =
          (fun k ->
            S.set set_rows
              (List.filter (fun r -> not (String.equal r.key k)) (S.get rows)));
        manager;
        selection_mode = (fun () -> selection_mode ());
        disabled;
        row_header = (fun () -> S.get row_header);
        set_row_header = S.set set_row_header;
        next_column =
          (fun () ->
            let n = S.untrack (fun () -> S.get columns) in
            S.set set_columns (n + 1);
            n);
        columns = (fun () -> S.get columns);
      }
    in
    (* The arrows across a row and through its cells are the port's, which
       Kobalte's list of rows does not know; the rest are the list's. *)
    let on_key_down e =
      let moved =
        match (Js.Null.toOption active, S.get element) with
        | Some focused, Some table -> (
            match role focused with
            | Some ("gridcell" | "rowheader" | "columnheader") ->
                from_cell table focused (key e)
            | Some "row" -> from_row focused (key e)
            | Some _ | None -> None)
        | _ -> None
      in
      match moved with
      | Some target ->
          prevent_default e;
          focus target
      | None -> Selectable_list.on_key_down list e
    in
    <Content_context.Provider value=(fun () -> c)>
      <table
        role=`grid
        ref=(fun e -> S.set set_element (Some e))
        ?aria_multiselectable=(fun () ->
                                match selection_mode () with
                                | `multiple -> Some true
                                | `single | `none -> None)
        ?aria_label
        ?aria_labelledby
        tabindex=(fun () -> tabindex (S.get (Selectable_list.tab_index list)))
        class_=(fun () -> after (Styles.Table.content (slots ())) (class_ ()))
        data_slot="table-content"
        on_key_down
        on_mouse_down=(fun e -> Selectable_list.on_mouse_down list e)
        on_focus_in=(fun e -> Selectable_list.on_focus_in list e)
        on_focus_out=(fun e -> Selectable_list.on_focus_out list e)
        props=(Props.others props)>
        (fun () -> children ())
      </table>
    </Content_context.Provider>
end

module Header = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Header" in
    let c = in_content "Table.Header" in
    (* A checkbox of slot=`selection in the header stands for every row. *)
    let all =
      {
        Checkbox.selected =
          (fun () ->
            S.get
              (Types.MultipleSelectionManager.is_select_all (S.get c.manager)));
        indeterminate =
          (fun () ->
            let m = S.get c.manager in
            (not (S.get (Types.MultipleSelectionManager.is_empty m)))
            && not (S.get (Types.MultipleSelectionManager.is_select_all m)));
        set =
          (fun now ->
            let m = S.get c.manager in
            if now then Types.MultipleSelectionManager.select_all m ()
            else Types.MultipleSelectionManager.clear_selection m ());
        disabled =
          (fun () ->
            match c.selection_mode () with
            | `multiple -> false
            | `single | `none -> true);
      }
    in
    <Checkbox.Selection.Provider value=(fun () -> all)>
      <thead
        role=`rowgroup
        class_=(fun () -> after (Styles.Table.header (slots ())) (class_ ()))
        data_slot="table-header"
        props=(Props.others props)>
        <tr role=`row>(fun () -> children ())</tr>
      </thead>
    </Checkbox.Selection.Provider>
end

module Column = struct
  let%component make ?(is_row_header : bool = false) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let slots = in_table "Table.Column" in
    let c = in_content "Table.Column" in
    let index = c.next_column () in
    if S.untrack is_row_header then c.set_row_header index;
    let i = Interaction.create () in
    <th
      role=`columnheader
      ref=(fun e -> Interaction.watch i e)
      tabindex="-1"
      aria_colindex=(fun () -> string_of_int (index + 1))
      class_=(fun () -> after (Styles.Table.column (slots ())) (class_ ()))
      data_slot="table-column"
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      props=(Props.others props)>
      (fun () -> children ())
    </th>
end

module Body = struct
  let%component make ?(render_empty_state : (unit -> Jsx.element) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Body" in
    let c = in_content "Table.Body" in
    let empty () =
      match c.rows () with [] -> render_empty_state () | _ :: _ -> None
    in
    <tbody
      role=`rowgroup
      class_=(fun () -> after (Styles.Table.body (slots ())) (class_ ()))
      data_slot="table-body"
      props=(Props.others props)>
      (fun () -> children ())
      <Show.Some some=(fun () -> empty ())>
        (fun shown ->
          <tr role=`row>
            <td
              role=`rowheader colspan=(fun () -> string_of_int (c.columns ()))>
              (fun () -> Jsx.element (S.get shown))
            </td>
          </tr>)
      </Show.Some>
    </tbody>
end

module Row = struct
  let%component make ?(id : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let slots = in_table "Table.Row" in
    let c = in_content "Table.Row" in
    let key =
      match S.untrack id with Some k -> k | None -> S.create_unique_id ()
    in
    let element, set_element = S.create_signal None in
    let item =
      Selection.create_selectable_item
        (Types.CreateSelectableItemProps.make
           ~selection_manager:(Either.right c.manager) ~key:(Either.left key) ())
        element
    in
    let i = Interaction.create () in
    let cells = ref 0 in
    let r =
      {
        next_cell =
          (fun () ->
            let n = !cells in
            incr cells;
            n);
        header_id = S.create_unique_id ();
      }
    in
    (* A row joins the list once it is on the page, where its place among
       the others is read. *)
    S.on_mount (fun () ->
        Option.iter (fun e -> c.add { key; element = e }) (S.get element));
    S.on_cleanup (fun () -> c.remove key);
    let manager () = S.get c.manager in
    let selected () =
      Types.MultipleSelectionManager.is_selected (manager ()) key
    in
    let disabled () = c.disabled key in
    let one =
      {
        Checkbox.selected;
        indeterminate = (fun () -> false);
        set =
          (fun _ ->
            Types.MultipleSelectionManager.toggle_selection (manager ()) key);
        disabled;
      }
    in
    <Row_context.Provider value=(fun () -> r)>
      <Checkbox.Selection.Provider value=(fun () -> one)>
        <tr
          role=`row
          ref=(fun e ->
                S.set set_element (Some e);
                Interaction.watch i e)
          tabindex=(fun () -> tabindex (S.get (Selectable_item.tab_index item)))
          aria_labelledby=(fun () -> r.header_id)
          style="--table-row-level: 1"
          class_=(fun () -> after (Styles.Table.row (slots ())) (class_ ()))
          data_slot="table-row"
          data_key=(fun () -> Jsx.data key)
          data_level="1"
          ?aria_selected=(fun () ->
                           match c.selection_mode () with
                           | `none -> None
                           | `single | `multiple -> Some (selected ()))
          ?aria_disabled=(fun () -> if disabled () then Some true else None)
          data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
          data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
          data_selected=(fun () -> Jsx.flag (selected ()))
          data_disabled=(fun () -> Jsx.flag (disabled ()))
                        (* A checkbox in the row is pressed alone: the row would select its
           row again. *)
          on_pointer_down=(fun e ->
                            if not (in_checkbox e) then
                              Selectable_item.on_pointer_down item e)
          on_pointer_up=(fun e ->
                          if not (in_checkbox e) then
                            Selectable_item.on_pointer_up item e)
          on_click=(fun e ->
                     if not (in_checkbox e) then Selectable_item.on_click item e)
          on_key_down=(fun e ->
                        if not (in_checkbox e) then
                          Selectable_item.on_key_down item e)
          on_mouse_down=(fun e -> Selectable_item.on_mouse_down item e)
          on_focus=(fun e -> Selectable_item.on_focus item e)
          props=(Props.others props)>
          (fun () -> children ())
        </tr>
      </Checkbox.Selection.Provider>
    </Row_context.Provider>
end

module Cell = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Cell" in
    let c = in_content "Table.Cell" in
    let r =
      match Row_context.use () with
      | Some r -> r
      | None -> invalid_arg "Table.Cell is used inside a Table.Row"
    in
    let index = r.next_cell () in
    let names_row () = index = c.row_header () in
    let i = Interaction.create () in
    <td
      role=(fun () -> if names_row () then `rowheader else `gridcell)
      ?id=(fun () -> if names_row () then Some r.header_id else None)
      ref=(fun e -> Interaction.watch i e)
      tabindex="-1"
      class_=(fun () -> after (Styles.Table.cell (slots ())) (class_ ()))
      data_slot="table-cell"
      data_column_index=(fun () -> Jsx.data (string_of_int index))
      data_level="1"
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      props=(Props.others props)>
      (fun () -> children ())
    </td>
end

module Footer = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Footer" in
    <div
      class_=(fun () -> after (Styles.Table.footer (slots ())) (class_ ()))
      data_slot="table-footer"
      props=(Props.others props)>
      (fun () -> children ())
    </div>
end

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let slots () =
    Styles.Table.slots (Styles.Table.options ?variant:(variant ()) ())
  in
  <Slots.Provider value=(fun () -> slots)>
    <div
      class_=(fun () -> after (Styles.Table.base (slots ())) (class_ ()))
      data_slot="table"
      props=(Props.others props)>
      (fun () -> children ())
    </div>
  </Slots.Provider>
