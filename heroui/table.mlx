module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Headless = Solidtype_headless.Table
module Gravity = Solidtype_gravity_icons

type sort_descriptor = Headless.sort_descriptor = {
  column : string;
  direction : [ `ascending | `descending ];
}

type column_size = Headless.column_size =
  | Pixels of float
  | Percent of float
  | Fraction of float

external query_in : _ Dom.element_like -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

let direction_name = function
  | `ascending -> "ascending"
  | `descending -> "descending"

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* A style given after the part's own, so its declarations win. *)
let styled own = function Some s -> own ^ "; " ^ s | None -> own

(* The table's classes, which every part reads. *)
module Slots = Solidtype.Context.Make_optional (struct
  type t = Styles.Table.slots S.accessor
end)

let in_table part =
  match Slots.use () with
  | Some slots -> slots
  | None -> invalid_arg (part ^ " is used inside a Table")

let use_row_context = Headless.use_row_context
let use_cell_context = Headless.use_cell_context

module Scroll_container = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Scroll_container" in
    <div
      class_=(fun () ->
               after
                 (Styles.Table.scroll_container (S.get slots))
                 (S.get class_))
      data_slot="table-scroll-container"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

(* HeroUI's ResizableContainer takes no class of the table's: its class is
   its own. *)
module Resizable_container = struct
  let%component make
      ?(on_resize_start : ((string * column_size) array -> unit) option)
      ?(on_resize : ((string * column_size) array -> unit) option)
      ?(on_resize_end : ((string * column_size) array -> unit) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Resizable_container" in
    <Headless.Resizable_container
      on_resize_start=(fun sizes ->
                        ignore (on_resize_start sizes : unit option))
      on_resize=(fun sizes -> ignore (on_resize sizes : unit option))
      on_resize_end=(fun sizes -> ignore (on_resize_end sizes : unit option))
      class_=(fun () ->
               after
                 (Styles.Table.resizable_container (S.get slots))
                 (S.get class_))
      data_slot="table-resizable-container"
      props=(Props.others props)>
      (fun () -> S.get children)
    </Headless.Resizable_container>
  [@@element div]
end

module Content = struct
  let%component make ?(aria_label : string option)
      ?(aria_labelledby : string option)
      ?(selection_mode : [ `none | `single | `multiple ] option)
      ?(selection_behavior : [ `toggle | `replace ] option)
      ?(selected_keys : string array option)
      ?(default_selected_keys : string array option)
      ?(on_selection_change : (string array -> unit) option)
      ?(disabled_keys : string array option)
      ?(disallow_empty_selection : bool option)
      ?(sort_descriptor : sort_descriptor option)
      ?(on_sort_change : (sort_descriptor -> unit) option)
      ?(tree_column : string option) ?(expanded_keys : string array option)
      ?(default_expanded_keys : string array option)
      ?(on_expanded_change : (string array -> unit) option)
      ?(on_row_action : (string -> unit) option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    let slots = in_table "Table.Content" in
    <Headless.Root
      ?aria_label
      ?aria_labelledby
      ?selection_mode
      ?selection_behavior
      ?selected_keys
      ?default_selected_keys
      on_selection_change=(fun keys ->
                            ignore (on_selection_change keys : unit option))
      ?disabled_keys
      ?disallow_empty_selection
      ?sort_descriptor
      on_sort_change=(fun sort -> ignore (on_sort_change sort : unit option))
      ?tree_column
      ?expanded_keys
      ?default_expanded_keys
      on_expanded_change=(fun keys ->
                           ignore (on_expanded_change keys : unit option))
      class_=(fun () ->
               after (Styles.Table.content (S.get slots)) (S.get class_))
      data_slot="table-content"
      props=(S.merge_props
               [|
                 Props.others props;
                 (* Absent unless given, since a row with an action is pressed
                    for it rather than selected. *)
                 S.pick props [| "onRowAction" |];
               |])>
      (fun () -> S.get children)
    </Headless.Root>
  [@@element table]
end

module Header = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Header" in
    let t = Headless.use_context () in
    (* A checkbox of slot=`selection in the header stands for every row. *)
    let all =
      {
        Checkbox.selected = t.is_select_all;
        indeterminate =
          S.accessor (fun () ->
              (not (S.get t.is_empty)) && not (S.get t.is_select_all));
        set = (fun now -> if now then t.select_all () else t.clear_selection ());
        disabled =
          S.accessor (fun () ->
              match S.get t.selection_mode with
              | `multiple -> false
              | `single | `none -> true);
      }
    in
    <Checkbox.Selection.Provider value=(fun () -> all)>
      <Headless.Header
        class_=(fun () ->
                 after (Styles.Table.header (S.get slots)) (S.get class_))
        data_slot="table-header"
        props=(Props.others props)>
        (fun () -> S.get children)
      </Headless.Header>
    </Checkbox.Selection.Provider>
  [@@element thead]
end

module Column = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    allows_sorting : bool Solidtype.Solid.accessor;
    sort_direction :
      [ `ascending | `descending ] option Solidtype.Solid.accessor;
    is_resizing : bool Solidtype.Solid.accessor;
  }

  let%component make ?(id : string option) ?(allows_sorting : bool = false)
      ?(is_row_header : bool option) ?(width : column_size option)
      ?(default_width : column_size option) ?(min_width : float option)
      ?(max_width : float option) ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlTableCellElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Th.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let slots = in_table "Table.Column" in
    let t = Headless.use_context () in
    let i = Interaction.create () in
    let resizing () =
      match (S.get t.resizing_column, S.get id) with
      | Some k, Some id -> String.equal k id
      | _ -> false
    in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_pressed = S.accessor (fun () -> Interaction.pressed i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        allows_sorting;
        sort_direction =
          S.accessor (fun () ->
              match S.get t.sort with
              | Some (d : Headless.sort_descriptor)
                when Option.equal String.equal (Some d.column) (S.get id) ->
                  Some d.direction
              | Some _ | None -> None);
        is_resizing = S.accessor (fun () -> resizing ());
      }
    in
    <Headless.Column
      ?id
      allows_sorting=(fun () -> S.get allows_sorting)
      ?is_row_header
      ?width
      ?default_width
      ?min_width
      ?max_width
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(fun () ->
               after (Styles.Table.column (S.get slots)) (S.get class_))
      data_slot="table-column"
      data_allows_sorting=(fun () -> Jsx.flag (S.get allows_sorting))
      data_resizing=(fun () -> Jsx.flag (resizing ()))
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </Headless.Column>
  [@@element th]
end

(* HeroUI's styles read React Aria's state: the handle hovered, and its
   input focused. *)
module Column_resizer = struct
  (* What its children are drawn of: React Aria's render props for a column's
     resizer. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_resizing : bool Solidtype.Solid.accessor;
  }

  let%component make ?(aria_label : string option) ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ?(children : state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let slots = in_table "Table.Column_resizer" in
    let column = Headless.use_column_context () in
    let handle = Interaction.create () in
    let input = Interaction.create () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered handle);
        is_focused = S.accessor (fun () -> Interaction.focused input);
        is_focus_visible =
          S.accessor (fun () -> Interaction.focus_visible input);
        is_resizing = column.resizing;
      }
    in
    <Headless.Column_resizer
      ?aria_label
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch handle e;
            S.on_mount (fun () ->
                Option.iter (Interaction.watch input)
                  (Js.Null.toOption (query_in e "input"))))
      class_=(fun () ->
               after (Styles.Table.column_resizer (S.get slots)) (S.get class_))
      data_slot="table-column-resizer"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered handle))
      data_focused=(fun () -> Jsx.flag (Interaction.focused input))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible input))
      data_resizing=(fun () -> Jsx.flag (S.get column.resizing))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some c -> Jsx.draw c (state ())
        | None -> Jsx.string "")
    </Headless.Column_resizer>
  [@@element div]
end

(* A column's label, and HeroUI's chevron for how it is sorted, up for
   ascending, turned by HeroUI's styles for descending. *)
module Sortable_column_header = struct
  let%component make ?(sort_direction : [ `ascending | `descending ] option)
      ?(show_indicator : bool = true) ?(indicator : Jsx.element option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Sortable_column_header" in
    let column = Headless.use_column_context () in
    let direction () =
      match S.get sort_direction with
      | Some d -> Some d
      | None -> S.get column.direction
    in
    let shown () = if S.get show_indicator then direction () else None in
    let named () =
      match direction () with
      | Some d -> Jsx.data (direction_name d)
      | None -> Jsx.flag false
    in
    <span
      class_=(fun () ->
               after
                 (Styles.Table.sortable_column_header (S.get slots))
                 (S.get class_))
      data_direction=(fun () -> named ())
      data_slot="table-sortable-column-header"
      props=(Props.others props)>
      (fun () -> S.get children)
      <Solidtype.Show.Some some=(fun () -> shown ())>
        (fun _ ->
          match S.untrack (fun () -> S.get indicator) with
          | Some own ->
              <span
                class_=(fun () ->
                         Styles.Table.sortable_column_indicator (S.get slots))
                data_direction=(fun () -> named ())
                data_slot="table-sortable-column-indicator">
                (fun () -> Jsx.element own)
              </span>
          | None ->
              <Gravity.Chevron_up
                aria_hidden=true
                class_=(fun () ->
                         Styles.Table.sortable_column_indicator (S.get slots))
                role=`presentation
                data_direction=(fun () -> named ())
                data_slot="table-sortable-column-indicator"
              />)
      </Solidtype.Show.Some>
    </span>
  [@@element span]
end

module Body = struct
  let%component make ?(render_empty_state : (unit -> Jsx.element) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Body" in
    <Headless.Body
      ?empty_state=(fun () -> render_empty_state ())
      class_=(fun () -> after (Styles.Table.body (S.get slots)) (S.get class_))
      data_slot="table-body"
      props=(Props.others props)>
      (fun () -> S.get children)
    </Headless.Body>
  [@@element tbody]
end

module Row = struct
  let%component make ?(id : string option) ?(on_action : (unit -> unit) option)
      ?(href : string option) ?(target : string option) ?(rel : string option)
      ?(download : string option) ?(href_lang : string option)
      ?(ping : string option) ?(referrer_policy : string option)
      ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlTableRowElement -> unit) option)
      ?(style : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Row" in
    let t = Headless.use_context () in
    let key =
      match S.untrack (fun () -> S.get id) with
      | Some k -> k
      | None -> S.create_unique_id ()
    in
    let selected = S.accessor (fun () -> t.is_selected key) in
    let disabled = S.accessor (fun () -> t.is_disabled key) in
    let i = Interaction.create () in
    (* A checkbox of slot=`selection in a row stands for its row. *)
    let one =
      {
        Checkbox.selected;
        indeterminate = S.accessor (fun () -> false);
        set = (fun _ -> t.toggle key);
        disabled;
      }
    in
    (* HeroUI's styles read React Aria's state, "true" where Kobalte's is
       present and empty, and its row's level for nested rows, which the
       headless row gives the attributes it writes. *)
    let level () = string_of_int (Headless.use_row_context ()).level in
    let tree_state read = Jsx.flag (read (Headless.use_row_context ())) in
    <Checkbox.Selection.Provider value=(fun () -> one)>
      <Headless.Row
        id=(fun () -> key)
        ?href
        ?target
        ?rel
        ?download
        ?href_lang
        ?ping
        ?referrer_policy
        ref=(fun e ->
              ignore (given_ref e : unit option);
              Interaction.watch i e)
        style=(fun () ->
                styled ("--table-row-level: " ^ level ()) (S.get style))
        class_=(fun () -> after (Styles.Table.row (S.get slots)) (S.get class_))
        data_slot="table-row"
        data_level=(fun () -> Jsx.data (level ()))
        data_expanded=(fun () ->
                        tree_state (fun r ->
                            S.get r.has_child_items && S.get r.is_expanded))
        data_has_child_items=(fun () ->
                               tree_state (fun r -> S.get r.has_child_items))
        data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
        data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
        data_selected=(fun () -> Jsx.flag (S.get selected))
        data_disabled=(fun () -> Jsx.flag (S.get disabled))
        props=(S.merge_props
                 [|
                   Props.others props;
                   (* Absent unless given, since a row with an action is
                      pressed for it rather than selected. *)
                   S.pick props [| "onAction" |];
                 |])>
        (fun () -> S.get children)
      </Headless.Row>
    </Checkbox.Selection.Provider>
  [@@element tr]
end

module Cell = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_selected : bool Solidtype.Solid.accessor;
    column_index : int Solidtype.Solid.accessor;
    is_tree_column : bool Solidtype.Solid.accessor;
    is_expanded : bool Solidtype.Solid.accessor;
    has_child_items : bool Solidtype.Solid.accessor;
    level : int Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlTableCellElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Td.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let slots = in_table "Table.Cell" in
    let i = Interaction.create () in
    (* Its row's state and its column's, which the headless cell gives the
       attributes it writes; and its row's chevron, to a button inside it. *)
    let row () = Headless.use_row_context () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_pressed = S.accessor (fun () -> Interaction.pressed i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_selected = S.accessor (fun () -> S.get (row ()).is_selected);
        column_index =
          S.accessor (fun () ->
              S.get (Headless.use_cell_context ()).column_index);
        is_tree_column =
          S.accessor (fun () ->
              S.get (Headless.use_cell_context ()).is_tree_column);
        is_expanded =
          S.accessor (fun () ->
              let r = row () in
              S.get r.has_child_items && S.get r.is_expanded);
        has_child_items = S.accessor (fun () -> S.get (row ()).has_child_items);
        level = S.accessor (fun () -> (row ()).level);
      }
    in
    <Headless.Cell
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(fun () -> after (Styles.Table.cell (S.get slots)) (S.get class_))
      data_slot="table-cell"
      data_level=(fun () -> Jsx.data (string_of_int (row ()).level))
      data_expanded=(fun () ->
                      let r = row () in
                      Jsx.flag (S.get r.has_child_items && S.get r.is_expanded))
      data_has_child_items=(fun () -> Jsx.flag (S.get (row ()).has_child_items))
      data_tree_column=(fun () ->
                         Jsx.flag
                           (S.get (Headless.use_cell_context ()).is_tree_column))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () ->
        let r = row () in
        Jsx.element
          <Button.Chevron.Provider
            value=(fun () ->
                    {
                      Button.toggle = r.toggle_expanded;
                      focus_row = r.focus;
                      labelled_by = r.header_id;
                    })>
            (fun () -> Jsx.draw (S.get children) (state ()))
          </Button.Chevron.Provider>)
    </Headless.Cell>
  [@@element td]
end

(* What loads more rows: HeroUI's classes on the loading row, and React
   Aria's level, which HeroUI's styles read of a row. *)
module Load_more = struct
  let%component make ?(is_loading : bool option)
      ?(on_load_more : (unit -> unit) option) ?(scroll_offset : float option)
      ?(class_ : string option) ?(style : string option)
      ~(children : Jsx.content) () =
    let slots = in_table "Table.Load_more" in
    <Headless.Load_more
      ?is_loading
      on_load_more=(fun _ -> ignore (on_load_more () : unit option))
      ?scroll_offset
      style=(fun () -> styled "--table-row-level: 1" (S.get style))
      class_=(fun () ->
               after (Styles.Table.load_more (S.get slots)) (S.get class_))
      data_slot="table-load-more"
      data_level="1"
      props=(Props.others props)>
      (fun () -> S.get children)
    </Headless.Load_more>
  [@@element tr]
end

module Load_more_content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Load_more_content" in
    <div
      class_=(fun () ->
               after
                 (Styles.Table.load_more_content (S.get slots))
                 (S.get class_))
      data_slot="table-load-more-content"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Footer = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let slots = in_table "Table.Footer" in
    <div
      class_=(fun () ->
               after (Styles.Table.footer (S.get slots)) (S.get class_))
      data_slot="table-footer"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let slots =
    S.accessor (fun () ->
        Styles.Table.slots (Styles.Table.options ?variant:(S.get variant) ()))
  in
  <Slots.Provider value=(fun () -> slots)>
    <div
      class_=(fun () -> after (Styles.Table.base (S.get slots)) (S.get class_))
      data_slot="table"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  </Slots.Provider>
[@@element div]
