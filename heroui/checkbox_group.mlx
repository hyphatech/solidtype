module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

type group = {
  checked : string -> bool;
  set : string -> bool -> unit;
  variant : [ `primary | `secondary ] option S.accessor;
  disabled : bool S.accessor;
  invalid : bool S.accessor;
  read_only : bool S.accessor;
  name : string option S.accessor;
  described_by : string option S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

(* A part a group names itself by while it is there: its id, and whether one
   is. *)
let named () =
  let id = S.create_unique_id () in
  let count, set_count = S.create_signal 0 in
  let here () =
    S.set set_count (S.get count + 1);
    S.on_cleanup (fun () -> S.set set_count (S.get count - 1))
  in
  (id, here, S.accessor (fun () -> if S.get count > 0 then Some id else None))

(* What its children are drawn of: React Aria's render props for a
   checkbox group. *)
type state = {
  is_disabled : bool S.accessor;
  is_read_only : bool S.accessor;
  is_required : bool S.accessor;
  is_invalid : bool S.accessor;
}

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(value : string list option) ?(default_value : string list = [])
    ?(on_change : (string list -> unit) option) ?(is_disabled : bool option)
    ?(is_invalid : bool = false) ?(is_read_only : bool = false)
    ?(is_required : bool = false) ?(name : string option)
    ?(class_ : string option) ?(on_blur : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* A group is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with Some d -> d | None -> S.get in_fieldset)
  in
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid =
    S.accessor (fun () ->
        S.get is_invalid || Option.is_some (S.get in_form.error))
  in
  let values, choose =
    Field.controlled
      ~value:(fun () -> S.get value)
      ~default:(S.get default_value)
      ~on_change:(fun v ->
        in_form.changed ();
        on_change v)
  in
  let checked v = List.exists (String.equal v) (S.get values) in
  let set v on =
    let others = List.filter (fun w -> not (String.equal v w)) (S.get values) in
    choose (if on then others @ [ v ] else others)
  in
  let label_id, label_here, labelled_by = named () in
  let description_id, description_here, described_by = named () in
  (* A label in a group, but outside a checkbox's content, is a span that
     names the group, as React Aria's is; and a description one that
     describes it, and each checkbox's input. *)
  let label : Label.slot =
   fun classes others children ->
    label_here ();
    <span
      id=label_id class_=(fun () -> classes ()) data_slot="label" props=others>
      (fun () -> children ())
    </span>
  in
  let description : Description.slot =
   fun classes others children ->
    description_here ();
    <span
      id=description_id
      class_=(fun () -> classes ())
      slot="description"
      data_slot="description"
      props=others>
      (fun () -> children ())
    </span>
  in
  let g =
    {
      checked;
      set;
      variant;
      disabled;
      invalid;
      read_only = is_read_only;
      name;
      described_by;
    }
  in
  (* Its children are read before its element is made, the label and the
     description among them, so the element names them on the server as in the
     browser. *)
  <Context.Provider value=(fun () -> g)>
    <Label.Slot.Provider value=(fun () -> label)>
      <Description.Slot.Provider value=(fun () -> description)>
        (fun () ->
          let state =
            {
              is_disabled = disabled;
              is_read_only;
              is_required;
              is_invalid = invalid;
            }
          in
          let resolved =
            S.children (fun () -> Jsx.draw (S.get children) state)
          in
          Jsx.element
            <div
              role=`group
              ?aria_labelledby=(fun () -> S.get labelled_by)
              ?aria_describedby=(fun () -> S.get described_by)
              ?aria_disabled=(fun () ->
                               if S.get disabled then Some true else None)
              class_=(fun () ->
                       Styles.CheckboxGroup.classes
                         (Styles.CheckboxGroup.options ?variant:(S.get variant)
                            ?class_:(S.get class_) ()))
              ref=(fun e ->
                    ignore (given_ref e : unit option);
                    in_form.root e)
              on_focus_out=(fun e ->
                             ignore (on_focus_out e : unit option);
                             Field.on_leave
                               (fun e ->
                                 in_form.left ();
                                 on_blur e)
                               e)
              data_slot="checkbox-group"
              data_disabled=(fun () -> Jsx.flag (S.get disabled))
              data_invalid=(fun () -> Jsx.flag (S.get invalid))
              data_readonly=(fun () -> Jsx.flag (S.get is_read_only))
              data_required=(fun () -> Jsx.flag (S.get is_required))
              ?as_=(fun () -> Option.map (fun f p -> f p state) (S.get as_))
              props=(Props.others props)>
              (fun () ->
                Jsx.element (Jsx.fragment (S.to_array (S.get resolved))))
            </div>)
      </Description.Slot.Provider>
    </Label.Slot.Provider>
  </Context.Provider>
[@@element div]
