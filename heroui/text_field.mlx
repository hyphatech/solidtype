module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.TextField

type field = {
  variant : unit -> [ `primary | `secondary ] option;
  disabled : unit -> bool;
  invalid : unit -> bool;
  read_only : unit -> bool;
  required : unit -> bool;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = field
end)

(* Kobalte's description as the element React Aria's is, a span, by
   Kobalte's [as], which its generated check does not take. *)
module Kobalte_description = struct
  module Props = struct
    external check :
      ?as_:string Solidtype.Check.value ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Span.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]
  end

  let component = Kobalte.Description.component
end

(* A label in a field is Kobalte's, which names the field's input. *)
let label : Label.slot =
 fun[@u] classes children ->
  <Kobalte.Label class_=(fun () -> classes ()) data_slot="label">
    (fun () -> children ())
  </Kobalte.Label>

(* A description in a field is Kobalte's, which the field's input is
   described by. *)
let description : Description.slot =
 fun[@u] classes children ->
  <Kobalte_description
    as_="span"
    class_=(fun () -> classes ())
    slot="description"
    data_slot="description">
    (fun () -> children ())
  </Kobalte_description>

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(full_width : bool option) ?(value : string option)
    ?(default_value : string option) ?(on_change : (string -> unit) option)
    ?(is_required : bool = false) ?(is_invalid : bool = false)
    ?(is_disabled : bool = false) ?(is_read_only : bool = false)
    ?(name : string option) ?(class_ : string option) ~(children : Jsx.content)
    () =
  let f =
    {
      variant;
      disabled = (fun () -> is_disabled ());
      invalid = (fun () -> is_invalid ());
      read_only = (fun () -> is_read_only ());
      required = (fun () -> is_required ());
    }
  in
  <Context.Provider value=(fun () -> f)>
    <Kobalte.Root
      ?value
      ?default_value
      on_change=(fun v -> ignore (on_change v : unit option))
      validation_state=(fun () -> if is_invalid () then `invalid else `valid)
      required=(fun () -> is_required ())
      disabled=(fun () -> is_disabled ())
      read_only=(fun () -> is_read_only ())
      ?name
      class_=(fun () ->
               Styles.TextField.classes
                 (Styles.TextField.options ?full_width:(full_width ())
                    ?class_:(class_ ()) ()))
      data_slot="textfield"
      data_disabled=(fun () -> Jsx.flag (is_disabled ()))
      data_invalid=(fun () -> Jsx.flag (is_invalid ()))
      data_readonly=(fun () -> Jsx.flag (is_read_only ()))
      data_required=(fun () -> Jsx.flag (is_required ()))>
      <Label.Slot.Provider value=(fun () -> label)>
        <Description.Slot.Provider value=(fun () -> description)>
          (fun () -> children ())
        </Description.Slot.Provider>
      </Label.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
