module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Checkbox

(* What a checkbox's parts read of the checkbox they are in: its classes,
   and its state as a field. *)
type checkbox = {
  slots : Styles.Checkbox.slots S.accessor;
  field : Field.state;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = checkbox
end)

(* What a checkbox of slot=`selection is, as the part above it gives it, as
   React Aria's selection slot does: a table's row, or its header, all its
   rows. *)
type selection = {
  selected : bool S.accessor;
  indeterminate : bool S.accessor;
  set : bool -> unit;
  disabled : bool S.accessor;
}

module Selection = Solidtype.Context.Make_optional (struct
  type t = selection
end)

let within part =
  match Context.use () with
  | Some c -> c
  | None -> invalid_arg (part ^ " is used inside a Checkbox")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Field_content = Field.Content (struct
  let label = Kobalte.Label.component
  let input = Kobalte.Input.component
end)

module Content = struct
  (* What its children are drawn of: React Aria's render props for it, made
     of its field's state and its interaction. *)
  type state = {
    is_selected : bool Solidtype.Solid.accessor;
    is_indeterminate : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_read_only : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
    is_required : bool Solidtype.Solid.accessor;
  }

  let state_of (f : Field.state) =
    let i = f.interaction in
    {
      is_selected = f.selected;
      is_indeterminate = f.indeterminate;
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = S.accessor (fun () -> Interaction.pressed i);
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = f.disabled;
      is_read_only = f.read_only;
      is_invalid = f.invalid;
      is_required = f.required;
    }

  let%component make ?(class_ : string option) ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Label.props -> state -> Solidtype.Jsx.element) option)
      () =
    let c = within "Checkbox.Content" in
    let state () = state_of c.field in
    <Field_content
      field=(fun () -> c.field)
      slot="checkbox-content"
      class_=(fun () ->
               after (Styles.Checkbox.content (S.get c.slots)) (S.get class_))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state_of c.field))
    </Field_content>
  [@@element label]
end

module Control = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let c = within "Checkbox.Control" in
    <span
      class_=(fun () ->
               after (Styles.Checkbox.control (S.get c.slots)) (S.get class_))
      data_slot="checkbox-control"
      props=(Props.others props)>
      (fun () -> S.get children)
    </span>
  [@@element span]
end

module Indicator = struct
  (* HeroUI's own marks: a check drawn in as it is selected, its dash
     offset from 66 to 44, or a dash while indeterminate. *)
  let check on =
    <svg
      aria_hidden=true
      data_slot="checkbox-default-indicator--checkmark"
      fill="none"
      role=`presentation
      stroke="currentColor"
      stroke_dasharray="22"
      stroke_dashoffset=(fun () -> if S.get on then "44" else "66")
      stroke_linecap="round"
      stroke_linejoin="round"
      stroke_width="2"
      view_box="0 0 17 18">
      <polyline points="1 9 7 14 15 4" />
    </svg>

  let dash () =
    <svg
      aria_hidden=true
      data_slot="checkbox-default-indicator--indeterminate"
      fill="none"
      role=`presentation
      stroke="currentColor"
      stroke_linecap="round"
      stroke_width="3"
      view_box="0 0 24 24">
      <line x1="21" x2="3" y1="12" y2="12" />
    </svg>

  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let c = within "Checkbox.Indicator" in
    <span
      aria_hidden=true
      class_=(fun () ->
               after (Styles.Checkbox.indicator (S.get c.slots)) (S.get class_))
      data_slot="checkbox-indicator"
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some given -> given
        | None ->
            Jsx.element
              <Show
                when_=(fun () -> S.get c.field.indeterminate)
                fallback=(fun () -> check c.field.selected)>
                (fun () -> Jsx.element (dash ()))
              </Show>)
    </span>
  [@@element span]
end

module Kobalte_description = Field.As_span (struct
  let component = Kobalte.Description.component
end)

(* A description in a checkbox, but outside its content, is the checkbox's:
   Kobalte's, which its input is described by, beside its group's. *)
let description : Description.slot =
 fun classes others children ->
  <Kobalte_description
    as_="span"
    class_=(fun () -> classes ())
    slot="description"
    data_slot="description"
    props=others>
    (fun () -> children ())
  </Kobalte_description>

module Kobalte_error = Field.As_span (struct
  let component = Kobalte.ErrorMessage.component
end)

(* An error in a checkbox is the checkbox's: Kobalte's, shown while it is
   invalid and describing its input. *)
let error : Field_error.slot =
 fun classes others children ->
  <Kobalte_error
    as_="span"
    class_=(fun () -> classes ())
    slot="errorMessage"
    data_slot="field-error"
    data_visible="true"
    props=others>
    (fun () -> children ())
  </Kobalte_error>

(* What its children are drawn of: React Aria's render props for it,
   made of its state as a field. *)
type state = {
  is_selected : bool Solidtype.Solid.accessor;
  is_indeterminate : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let state_of (f : Field.state) =
  {
    is_selected = f.selected;
    is_indeterminate = f.indeterminate;
    is_disabled = f.disabled;
    is_read_only = f.read_only;
    is_invalid = f.invalid;
    is_required = f.required;
  }

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(is_selected : bool option) ?(default_selected : bool = false)
    ?(is_indeterminate : bool = false) ?(on_change : (bool -> unit) option)
    ?(is_disabled : bool = false) ?(is_invalid : bool = false)
    ?(is_read_only : bool = false) ?(is_required : bool = false)
    ?(name : string option) ?(value : string option)
    ?(aria_label : string option) ?(class_ : string option)
    ?(slot : [ `selection ] option) ?(on_blur : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* Given its slot, its state is the selection of the part above it. *)
  let slotted =
    match (S.get slot, Selection.use ()) with
    | Some `selection, Some s -> Some s
    | Some `selection, None | None, _ -> None
  in
  (* The state is the checkbox's, read by Kobalte and by every part alike: in
     a group, whether its value is checked there, and the group's state. *)
  let group = Checkbox_group.Context.use () in
  (* In a group, the group is the form's field. *)
  let in_form =
    match group with
    | Some _ -> Form.field ~name:(fun () -> None) ~invalid:(fun () -> false)
    | None ->
        Form.field
          ~name:(fun () -> S.get name)
          ~invalid:(fun () -> S.get is_invalid)
  in
  let own_on, own_change =
    Field.controlled
      ~value:(fun () -> S.get is_selected)
      ~default:(S.get default_selected) ~on_change
  in
  let in_group f own =
    S.accessor (fun () ->
        match group with Some g -> f g || S.get own | None -> S.get own)
  in
  let on, change =
    match (group, S.get value) with
    | Some g, Some v ->
        ( S.accessor (fun () -> g.checked v),
          fun now ->
            g.set v now;
            ignore (on_change now : unit option) )
    | Some _, None | None, _ ->
        ( own_on,
          fun now ->
            in_form.changed ();
            own_change now )
  in
  let on, change =
    match slotted with
    | Some s ->
        ( s.selected,
          fun now ->
            s.set now;
            ignore (on_change now : unit option) )
    | None -> (on, change)
  in
  let is_indeterminate () =
    match slotted with
    | Some s -> S.get s.indeterminate
    | None -> S.get is_indeterminate
  in
  let is_disabled =
    S.accessor (fun () ->
        match slotted with
        | Some s -> S.get s.disabled || S.get is_disabled
        | None -> S.get is_disabled)
  in
  let disabled = in_group (fun g -> S.get g.disabled) is_disabled in
  let invalid =
    in_group
      (fun g -> S.get g.invalid)
      (S.accessor (fun () ->
           S.get is_invalid || Option.is_some (S.get in_form.error)))
  in
  let read_only = in_group (fun g -> S.get g.read_only) is_read_only in
  (* A required group asks for one value checked, never each checkbox. *)
  let required = S.accessor (fun () -> S.get is_required) in
  let name =
    S.accessor (fun () ->
        match S.get name with
        | Some n -> Some n
        | None ->
            Option.bind group (fun (g : Checkbox_group.group) -> S.get g.name))
  in
  let variant () =
    match S.get variant with
    | Some v -> v
    | None -> (
        match
          Option.bind group (fun (g : Checkbox_group.group) -> S.get g.variant)
        with
        | Some v -> v
        | None -> `primary)
  in
  let c =
    {
      slots =
        S.accessor (fun () ->
            Styles.Checkbox.slots
              (Styles.Checkbox.options ~variant:(variant ()) ()));
      field =
        {
          selected = on;
          indeterminate = S.accessor (fun () -> is_indeterminate ());
          disabled;
          invalid;
          read_only;
          required;
          aria_label;
          described_by =
            S.accessor (fun () ->
                Option.bind group (fun (g : Checkbox_group.group) ->
                    S.get g.described_by));
          interaction =
            Interaction.create
              ~disabled:(fun () -> S.get disabled)
              ~no_hover:(fun () -> S.get read_only)
              ~no_pointer_press:(fun () -> S.get read_only)
              ();
        };
    }
  in
  let state () = state_of c.field in
  <Context.Provider value=(fun () -> c)>
    <Kobalte.Root
      checked=(fun () -> S.get on)
      on_change=change
      indeterminate=(fun () -> is_indeterminate ())
      disabled=(fun () -> S.get disabled)
      read_only=(fun () -> S.get read_only)
      required=(fun () -> S.get required)
      ?name
      ?value
      validation_state=(fun () -> if S.get invalid then `invalid else `valid)
      class_=(fun () ->
               after (Styles.Checkbox.base (S.get c.slots)) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            in_form.root e)
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     Field.on_leave
                       (fun e ->
                         in_form.left ();
                         on_blur e)
                       e)
      data_slot="checkbox"
      data_selected=(fun () -> Jsx.flag (S.get on))
      data_indeterminate=(fun () -> Jsx.flag (is_indeterminate ()))
      data_disabled=(fun () -> Jsx.flag (S.get disabled))
      data_readonly=(fun () -> Jsx.flag (S.get read_only))
      data_required=(fun () -> Jsx.flag (S.get required))
      data_invalid=(fun () -> Jsx.flag (S.get invalid))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Description.Slot.Provider value=(fun () -> description)>
        <Field_error.Slot.Provider value=(fun () -> error)>
          (fun () -> Jsx.draw (S.get children) (state_of c.field))
        </Field_error.Slot.Provider>
      </Description.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
