module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Checkbox

(* What a checkbox's parts read of the checkbox they are in: its classes,
   and its state as a field. *)
type checkbox = { slots : unit -> Styles.Checkbox.slots; field : Field.state }

module Context = Solidtype.Context.Make_optional (struct
  type t = checkbox
end)

let within part =
  match Context.use () with
  | Some c -> c
  | None -> invalid_arg (part ^ " is used inside a Checkbox")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Field_content = Field.Content (struct
  let label = Kobalte.Label.component
  let input = Kobalte.Input.component
end)

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let c = within "Checkbox.Content" in
    <Field_content
      field=(fun () -> c.field)
      slot="checkbox-content"
      class_=(fun () ->
               after (Styles.Checkbox.content (c.slots ())) (class_ ()))
      props=(Props.others props)>
      (fun () -> children ())
    </Field_content>
end

module Control = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let c = within "Checkbox.Control" in
    <span
      class_=(fun () ->
               after (Styles.Checkbox.control (c.slots ())) (class_ ()))
      data_slot="checkbox-control"
      props=(Props.others props)>
      (fun () -> children ())
    </span>
end

module Indicator = struct
  (* HeroUI's own marks: a check drawn in as it is selected, its dash
     offset from 66 to 44, or a dash while indeterminate. *)
  let check on =
    <svg
      aria_hidden=true
      data_slot="checkbox-default-indicator--checkmark"
      fill="none"
      role=`presentation
      stroke="currentColor"
      stroke_dasharray="22"
      stroke_dashoffset=(fun () -> if on () then "44" else "66")
      stroke_linecap="round"
      stroke_linejoin="round"
      stroke_width="2"
      view_box="0 0 17 18">
      <polyline points="1 9 7 14 15 4" />
    </svg>

  let dash () =
    <svg
      aria_hidden=true
      data_slot="checkbox-default-indicator--indeterminate"
      fill="none"
      role=`presentation
      stroke="currentColor"
      stroke_linecap="round"
      stroke_width="3"
      view_box="0 0 24 24">
      <line x1="21" x2="3" y1="12" y2="12" />
    </svg>

  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let c = within "Checkbox.Indicator" in
    <span
      aria_hidden=true
      class_=(fun () ->
               after (Styles.Checkbox.indicator (c.slots ())) (class_ ()))
      data_slot="checkbox-indicator"
      props=(Props.others props)>
      (fun () ->
        match children () with
        | Some given -> given
        | None ->
            Jsx.element
              <Show
                when_=(fun () -> c.field.indeterminate ())
                fallback=(fun () -> check c.field.selected)>
                (fun () -> Jsx.element (dash ()))
              </Show>)
    </span>
end

module Kobalte_description = Field.As_span (struct
  let component = Kobalte.Description.component
end)

(* A description in a checkbox, but outside its content, is the checkbox's:
   Kobalte's, which its input is described by, beside its group's. *)
let description : Description.slot =
 fun[@u] classes others children ->
  <Kobalte_description
    as_="span"
    class_=(fun () -> classes ())
    slot="description"
    data_slot="description"
    props=others>
    (fun () -> children ())
  </Kobalte_description>

module Kobalte_error = Field.As_span (struct
  let component = Kobalte.ErrorMessage.component
end)

(* An error in a checkbox is the checkbox's: Kobalte's, shown while it is
   invalid and describing its input. *)
let error : Field_error.slot =
 fun[@u] classes others children ->
  <Kobalte_error
    as_="span"
    class_=(fun () -> classes ())
    slot="errorMessage"
    data_slot="field-error"
    data_visible="true"
    props=others>
    (fun () -> children ())
  </Kobalte_error>

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(is_selected : bool option) ?(default_selected : bool = false)
    ?(is_indeterminate : bool = false) ?(on_change : (bool -> unit) option)
    ?(is_disabled : bool = false) ?(is_invalid : bool = false)
    ?(is_read_only : bool = false) ?(is_required : bool = false)
    ?(name : string option) ?(value : string option)
    ?(aria_label : string option) ?(class_ : string option)
    ?(on_blur : (Dom.focusEvent -> unit) option) ~(children : Jsx.content) () =
  (* The state is the checkbox's, read by Kobalte and by every part alike: in
     a group, whether its value is checked there, and the group's state. *)
  let group = Checkbox_group.Context.use () in
  (* In a group, the group is the form's field. *)
  let in_form =
    match group with
    | Some _ -> Form.field ~name:(fun () -> None) ~invalid:(fun () -> false)
    | None -> Form.field ~name ~invalid:(fun () -> is_invalid ())
  in
  let own_on, own_change =
    Field.controlled ~value:is_selected ~default:(default_selected ())
      ~on_change
  in
  let in_group f own () =
    match group with Some g -> f g || own () | None -> own ()
  in
  let on, change =
    match (group, value ()) with
    | Some g, Some v ->
        ( (fun () -> g.checked v),
          fun now ->
            g.set v now;
            ignore (on_change now : unit option) )
    | Some _, None | None, _ ->
        ( own_on,
          fun now ->
            in_form.changed ();
            own_change now )
  in
  let disabled = in_group (fun g -> g.disabled ()) is_disabled in
  let invalid =
    in_group
      (fun g -> g.invalid ())
      (fun () -> is_invalid () || Option.is_some (in_form.error ()))
  in
  let read_only = in_group (fun g -> g.read_only ()) is_read_only in
  (* A required group asks for one value checked, never each checkbox. *)
  let required () = is_required () in
  let name () =
    match name () with
    | Some n -> Some n
    | None -> Option.bind group (fun (g : Checkbox_group.group) -> g.name ())
  in
  let variant () =
    match variant () with
    | Some v -> v
    | None -> (
        match
          Option.bind group (fun (g : Checkbox_group.group) -> g.variant ())
        with
        | Some v -> v
        | None -> `primary)
  in
  let c =
    {
      slots =
        (fun () ->
          Styles.Checkbox.slots
            (Styles.Checkbox.options ~variant:(variant ()) ()));
      field =
        {
          selected = on;
          indeterminate = (fun () -> is_indeterminate ());
          disabled;
          invalid;
          read_only;
          required;
          aria_label;
          described_by =
            (fun () ->
              Option.bind group (fun (g : Checkbox_group.group) ->
                  g.described_by ()));
          interaction =
            Interaction.create
              ~disabled:(fun[@u] () -> disabled ())
              ~no_hover:(fun[@u] () -> read_only ())
              ~no_pointer_press:(fun[@u] () -> read_only ())
              ();
        };
    }
  in
  <Context.Provider value=(fun () -> c)>
    <Kobalte.Root
      checked=(fun () -> on ())
      on_change=change
      indeterminate=(fun () -> is_indeterminate ())
      disabled=(fun () -> disabled ())
      read_only=(fun () -> read_only ())
      required=(fun () -> required ())
      ?name
      ?value
      validation_state=(fun () -> if invalid () then `invalid else `valid)
      class_=(fun () -> after (Styles.Checkbox.base (c.slots ())) (class_ ()))
      ref=(fun e -> in_form.root e)
      on_focus_out=(Field.on_leave (fun e ->
                        in_form.left ();
                        on_blur e))
      data_slot="checkbox"
      data_selected=(fun () -> Jsx.flag (on ()))
      data_indeterminate=(fun () -> Jsx.flag (is_indeterminate ()))
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      data_readonly=(fun () -> Jsx.flag (read_only ()))
      data_required=(fun () -> Jsx.flag (required ()))
      data_invalid=(fun () -> Jsx.flag (invalid ()))
      props=(Props.others props)>
      <Description.Slot.Provider value=(fun () -> description)>
        <Field_error.Slot.Provider value=(fun () -> error)>
          (fun () -> children ())
        </Field_error.Slot.Provider>
      </Description.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
