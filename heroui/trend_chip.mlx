module Jsx = Solidtype.Jsx
module S = Solidtype.Solid
module Gravity = Solidtype_gravity_icons

type trend = [ `up | `down | `neutral ]
type size = [ `sm | `md | `lg ]
type variant = [ `primary | `secondary | `soft | `tertiary ]

(* A part, drawn by the chip where it belongs, whatever its place among the
   chip's children; an indicator is given the trend. *)
type part =
  | Prefix of (unit -> Jsx.element)
  | Suffix of (unit -> Jsx.element)
  | Indicator of (trend -> Jsx.element)

module Part = Jsx.Token (struct
  type t = part
end)

(* A class added after the chip's own, as React's className is: its look is
   trend-chip.css's, in the components layer, which a utility given wins over. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* The chip's own arrow, Gravity's, none for a neutral trend, given the rest of
   an indicator's props where one is given without an icon. *)
let own_arrow ?class_ ?(others = S.others (Js.Obj.empty ()) [||]) trend =
  match trend with
  | `up ->
      <Gravity.Arrow_up
        aria_hidden=true
        class_=(fun () -> after "trend-chip__indicator" class_)
        data_slot="trend-chip-indicator"
        ?as_=(fun () -> S.drawn_as others)
        props=(S.undrawn others)
      />
  | `down ->
      <Gravity.Arrow_down
        aria_hidden=true
        class_=(fun () -> after "trend-chip__indicator" class_)
        data_slot="trend-chip-indicator"
        ?as_=(fun () -> S.drawn_as others)
        props=(S.undrawn others)
      />
  | `neutral -> Jsx.nothing

module Prefix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    Part.element
      (Prefix
         (fun () ->
           <span
             class_=(fun () -> after "trend-chip__prefix" (class_ ()))
             data_slot="trend-chip-prefix"
             props=(Props.others props)>
             (fun () -> children ())
           </span>))
  [@@element span]
end

module Suffix = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    Part.element
      (Suffix
         (fun () ->
           <span
             class_=(fun () -> after "trend-chip__suffix" (class_ ()))
             data_slot="trend-chip-suffix"
             props=(Props.others props)>
             (fun () -> children ())
           </span>))
  [@@element span]
end

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    Part.element
      (Indicator
         (fun trend ->
           match children () with
           | Some icon ->
               <span
                 aria_hidden=true
                 class_=(fun () ->
                          after
                            "trend-chip__indicator trend-chip__indicator--icon"
                            (class_ ()))
                 data_slot="trend-chip-indicator"
                 props=(Props.others props)>
                 (fun () -> icon)
               </span>
           | None ->
               own_arrow ?class_:(class_ ()) ~others:(Props.others props) trend))
  [@@element span]
end

let%component make ?(trend : trend = `up) ?(size : size = `sm)
    ?(variant : variant = `soft) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let resolved = S.children (fun () -> children ()) in
  let all () = S.to_array (S.get resolved) in
  let parts () = Array.to_list (Part.read (all ())) in
  let drawn f =
    Jsx.element (Jsx.fragment (Array.of_list (List.filter_map f (parts ()))))
  in
  let indicator () =
    match
      List.find_map
        (function Indicator i -> Some i | Prefix _ | Suffix _ -> None)
        (parts ())
    with
    | Some i -> i (trend ())
    | None -> own_arrow (trend ())
  in
  <Chip
    color=(fun () ->
            match trend () with
            | `up -> `success
            | `down -> `danger
            | `neutral -> `default)
    size=(fun () -> size ())
    variant=(fun () -> variant ())
    class_=(fun () ->
             after
               (match size () with
               | `sm -> "trend-chip trend-chip--sm"
               | `md -> "trend-chip trend-chip--md"
               | `lg -> "trend-chip trend-chip--lg")
               (class_ ()))
    data_trend=(fun () ->
                 Jsx.data
                   (match trend () with
                   | `up -> "up"
                   | `down -> "down"
                   | `neutral -> "neutral"))
    props=(Props.others props)>
    (fun () -> Jsx.element (indicator ()))
    <Chip.Label>
      (fun () ->
        drawn (function
          | Prefix p -> Some (p ())
          | Suffix _ | Indicator _ -> None))
      " "
      <span class_="trend-chip__value" data_slot="trend-chip-value">
        (fun () -> Jsx.element (Jsx.fragment (Part.others (all ()))))
      </span>
      " "
      (fun () ->
        drawn (function
          | Suffix s -> Some (s ())
          | Prefix _ | Indicator _ -> None))
    </Chip.Label>
  </Chip>
[@@element span]
