module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

type variant = [ `opaque | `blur | `transparent ]
type placement = [ `auto | `center | `top | `bottom ]
type scroll = [ `inside | `outside ]
type size = [ `xs | `sm | `md | `lg | `cover | `full ]

(* What the dialog and its body read of their container. *)
type container = {
  placement : placement S.accessor;
  scroll : scroll S.accessor;
  size : size S.accessor;
}

module Container_context = Solidtype.Context.Make_optional (struct
  type t = container
end)

let within part = Dialog_frame.within part ~backdrop:"Modal.Backdrop"

let container () =
  match Container_context.use () with
  | Some c -> c
  | None ->
      {
        placement = S.accessor (fun () -> `auto);
        scroll = S.accessor (fun () -> `inside);
        size = S.accessor (fun () -> `md);
      }

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

let slots ?variant ?scroll ?size () =
  Styles.Modal.slots (Styles.Modal.options ?variant ?scroll ?size ())

let placement_name = function
  | `auto -> "auto"
  | `center -> "center"
  | `top -> "top"
  | `bottom -> "bottom"

module Trigger = struct
  let%component make ?(aria_label : string option) ?(class_ : string option)
      ~(children : Jsx.content) () =
    Dialog_frame.trigger ~slot:"modal-trigger"
      ~class_:(fun () -> after (Styles.Modal.trigger (slots ())) (S.get class_))
      ~aria_label:(fun () -> S.get aria_label)
      ~others:(Props.others props)
      (fun () -> S.get children)
  [@@element div]
end

module Backdrop = struct
  let%component make ?(variant : variant = `opaque)
      ?(is_dismissable : bool = true)
      ?(is_keyboard_dismiss_disabled : bool = false) ?(is_open : bool option)
      ?(default_open : bool option) ?(on_open_change : (bool -> unit) option)
      ?(portal_container : _ Dom.element_like option) ?(class_ : string option)
      ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : Dialog_frame.overlay_state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props ->
         Dialog_frame.overlay_state ->
         Solidtype.Jsx.element)
         option) () =
    Dialog_frame.backdrop ~slot:"modal-backdrop"
      ~portal_container:(fun () -> S.get portal_container)
      ~class_:(fun () ->
        after
          (Styles.Modal.backdrop (slots ~variant:(S.get variant) ()))
          (S.get class_))
      ~style:(fun () -> S.get style)
      ~ref:given_ref
      ~dismissable:(fun () -> S.get is_dismissable)
      ~keyboard_dismissable:(fun () -> not (S.get is_keyboard_dismiss_disabled))
      ~is_open:(fun () -> S.get is_open)
      ~default_open:(fun () -> S.get default_open)
      ~on_open_change:(fun o -> ignore (on_open_change o : unit option))
      ~as_:(fun () -> S.get as_)
      ~others:(Props.others props)
      (fun s -> Jsx.draw (S.get children) s)
  [@@element div]
end

module Container = struct
  let%component make ?(placement : placement = `auto)
      ?(scroll : scroll = `inside) ?(size : size = `md)
      ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : Dialog_frame.overlay_state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props ->
         Dialog_frame.overlay_state ->
         Solidtype.Jsx.element)
         option) () =
    let f = within "Modal.Container" in
    let c = { placement; scroll; size } in
    Dialog_frame.container f ~slot:"modal-container"
      ~class_:(fun () ->
        after
          (Styles.Modal.container
             (slots ~scroll:(S.get scroll) ~size:(S.get size) ()))
          (S.get class_))
      ~placement:(fun () -> placement_name (S.get placement))
      ~ref:given_ref
      ~as_:(fun () -> S.get as_)
      ~others:(Props.others props)
      (fun s ->
        Jsx.element
          <Container_context.Provider value=(fun () -> c)>
            (fun () -> Jsx.draw (S.get children) s)
          </Container_context.Provider>)
  [@@element div]
end

module Dialog = struct
  let%component make ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlElement -> unit) option)
      ?(on_focus_out : (Dom.focusEvent -> unit) option)
      ~(children : Dialog_frame.dialog_state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Section.props ->
         Dialog_frame.dialog_state ->
         Solidtype.Jsx.element)
         option) () =
    let f = within "Modal.Dialog" in
    let c = container () in
    Dialog_frame.dialog f ~slot:"modal-dialog" ~role:`dialog
      ~class_:(fun () ->
        after
          (Styles.Modal.dialog
             (slots ~scroll:(S.get c.scroll) ~size:(S.get c.size) ()))
          (S.get class_))
      ~placement:(fun () -> placement_name (S.get c.placement))
      ~ref:given_ref ~on_focus_out
      ~as_:(fun () -> S.get as_)
      ~others:(Props.others props)
      (fun s -> Jsx.draw (S.get children) s)
  [@@element section]
end

module Header = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Modal.header (slots ())) (S.get class_))
      data_slot="modal-header"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Body = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let c = container () in
    <div
      class_=(fun () ->
               after
                 (Styles.Modal.body (slots ~scroll:(S.get c.scroll) ()))
                 (S.get class_))
      data_slot="modal-body"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Footer = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Modal.footer (slots ())) (S.get class_))
      data_slot="modal-footer"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Icon = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    <div
      class_=(fun () -> after (Styles.Modal.icon (slots ())) (S.get class_))
      data_slot="modal-icon"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Heading = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    Dialog_frame.heading ~slot:"modal-heading"
      ~class_:(fun () -> after (Styles.Modal.heading (slots ())) (S.get class_))
      ~others:(Props.others props)
      (fun () -> S.get children)
  [@@element h2]
end

module Close_trigger = struct
  let%component make ?(class_ : string option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?(children : Close_button.state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Button.props ->
         Close_button.state ->
         Solidtype.Jsx.element)
         option) () =
    let f = within "Modal.Close_trigger" in
    Dialog_frame.close_trigger f ~slot:"modal-close-trigger"
      ~class_:(fun () ->
        after (Styles.Modal.close_trigger (slots ())) (S.get class_))
      ~on_click
      ~as_:(fun () -> S.get as_)
      ~others:(Props.others props)
      ~children:(fun () -> S.get children)
  [@@element button]
end

let%component make ?(is_open : bool option) ?(default_open : bool option)
    ?(on_open_change : (bool -> unit) option) ~(children : Jsx.content) () =
  Dialog_frame.root
    ~is_open:(fun () -> S.get is_open)
    ~default_open:(fun () -> S.get default_open)
    ~on_open_change:(fun o -> ignore (on_open_change o : unit option))
    (fun () -> S.get children)
