module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show

type status = [ `default | `accent | `success | `warning | `danger ]

(* What an alert's parts read of it: its classes and its status. *)
type alert = {
  slots : Styles.Alert.slots S.accessor;
  status : status S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = alert
end)

let within part =
  match Context.use () with
  | Some a -> a
  | None -> invalid_arg (part ^ " is used inside an Alert")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let a = within "Alert.Indicator" in
    <div
      class_=(fun () ->
               after (Styles.Alert.indicator (S.get a.slots)) (S.get class_))
      data_slot="alert-indicator"
      props=(Props.others props)>
      <Show
        when_=(fun () -> Option.is_some (S.get children))
        fallback=(fun () ->
                   Status_icon.svg ~slot:"alert-default-icon" (fun () ->
                       S.get a.status))>
        (fun () ->
          match S.get children with Some c -> c | None -> Jsx.string "")
      </Show>
    </div>
  [@@element div]
end

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Content" in
    <div
      class_=(fun () ->
               after (Styles.Alert.content (S.get a.slots)) (S.get class_))
      data_slot="alert-content"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Title = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Title" in
    <p
      class_=(fun () ->
               after (Styles.Alert.title (S.get a.slots)) (S.get class_))
      data_slot="alert-title"
      props=(Props.others props)>
      (fun () -> S.get children)
    </p>
  [@@element p]
end

module Description = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Description" in
    <span
      class_=(fun () ->
               after (Styles.Alert.description (S.get a.slots)) (S.get class_))
      data_slot="alert-description"
      props=(Props.others props)>
      (fun () -> S.get children)
    </span>
  [@@element span]
end

let%component make ?(status : status = `default)
    ?(role : Solidtype.Html.Div.role option) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let a =
    {
      slots =
        S.accessor (fun () ->
            Styles.Alert.slots (Styles.Alert.options ~status:(S.get status) ()));
      status;
    }
  in
  let surface = S.accessor (fun () -> `default) in
  <Context.Provider value=(fun () -> a)>
    <Surface.Context.Provider value=(fun () -> surface)>
      <div
        ?role
        class_=(fun () ->
                 after (Styles.Alert.base (S.get a.slots)) (S.get class_))
        data_slot="alert-root"
        props=(Props.others props)>
        (fun () -> S.get children)
      </div>
    </Surface.Context.Provider>
  </Context.Provider>
[@@element div]
