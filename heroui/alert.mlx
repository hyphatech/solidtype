module Jsx = Solidtype.Jsx
module Show = Solidtype.Show

type status = [ `default | `accent | `success | `warning | `danger ]

(* What an alert's parts read of it: its classes and its status. *)
type alert = { slots : unit -> Styles.Alert.slots; status : unit -> status }

module Context = Solidtype.Context.Make_optional (struct
  type t = alert
end)

let within part =
  match Context.use () with
  | Some a -> a
  | None -> invalid_arg (part ^ " is used inside an Alert")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* HeroUI's icon for each status: info for the default and accent. *)
let icon_path : status -> string = function
  | `default | `accent ->
      "M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 \
       0 0 0 14m1-9.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0m-.25 3a.75.75 0 0 0-1.5 \
       0V11a.75.75 0 0 0 1.5 0z"
  | `success ->
      "M13.5 8a5.5 5.5 0 1 1-11 0a5.5 5.5 0 0 1 11 0M15 8A7 7 0 1 1 1 8a7 7 0 \
       0 1 14 0m-3.9-1.55a.75.75 0 1 0-1.2-.9L7.419 8.858L6.03 7.47a.75.75 0 0 \
       0-1.06 1.06l2 2a.75.75 0 0 0 1.13-.08z"
  | `warning ->
      "M7.134 2.994L2.217 11.5a1 1 0 0 0 .866 1.5h9.834a1 1 0 0 0 \
       .866-1.5L8.866 2.993a1 1 0 0 0-1.732 \
       0m3.03-.75c-.962-1.665-3.366-1.665-4.329 0L.918 10.749c-.963 1.666.24 \
       3.751 2.165 3.751h9.834c1.925 0 3.128-2.085 2.164-3.751zM8 5a.75.75 0 0 \
       1 .75.75v2a.75.75 0 0 1-1.5 0v-2A.75.75 0 0 1 8 5m1 5.75a1 1 0 1 1-2 \
       0a1 1 0 0 1 2 0"
  | `danger ->
      "M8 13.5a5.5 5.5 0 1 0 0-11a5.5 5.5 0 0 0 0 11M8 15A7 7 0 1 0 8 1a7 7 0 \
       0 0 0 14m1-4.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0M8.75 5a.75.75 0 0 0-1.5 \
       0v2.5a.75.75 0 0 0 1.5 0z"

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let a = within "Alert.Indicator" in
    <div
      class_=(fun () -> after (Styles.Alert.indicator (a.slots ())) (class_ ()))
      data_slot="alert-indicator"
      props=(Props.others props)>
      <Show
        when_=(fun () -> Option.is_some (children ()))
        fallback=(<svg
                    aria_hidden=true
                    fill="none"
                    height="16"
                    role=`presentation
                    view_box="0 0 16 16"
                    width="16"
                    xmlns="http://www.w3.org/2000/svg"
                    data_slot="alert-default-icon">
                    <path
                      clip_rule="evenodd"
                      d=(fun () -> icon_path (a.status ()))
                      fill="currentColor"
                      fill_rule="evenodd"
                    />
                  </svg>)>
        (fun () -> match children () with Some c -> c | None -> Jsx.string "")
      </Show>
    </div>
end

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Content" in
    <div
      class_=(fun () -> after (Styles.Alert.content (a.slots ())) (class_ ()))
      data_slot="alert-content"
      props=(Props.others props)>
      (fun () -> children ())
    </div>
end

module Title = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Title" in
    <p
      class_=(fun () -> after (Styles.Alert.title (a.slots ())) (class_ ()))
      data_slot="alert-title"
      props=(Props.others props)>
      (fun () -> children ())
    </p>
end

module Description = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a = within "Alert.Description" in
    <span
      class_=(fun () ->
               after (Styles.Alert.description (a.slots ())) (class_ ()))
      data_slot="alert-description"
      props=(Props.others props)>
      (fun () -> children ())
    </span>
end

let%component make ?(status : status = `default)
    ?(role : Solidtype.Html.Div.role option) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let a =
    {
      slots =
        (fun () ->
          Styles.Alert.slots (Styles.Alert.options ~status:(status ()) ()));
      status = (fun () -> status ());
    }
  in
  let surface () = `default in
  <Context.Provider value=(fun () -> a)>
    <Surface.Context.Provider value=(fun () -> surface)>
      <div
        ?role
        class_=(fun () -> after (Styles.Alert.base (a.slots ())) (class_ ()))
        data_slot="alert-root"
        props=(Props.others props)>
        (fun () -> children ())
      </div>
    </Surface.Context.Provider>
  </Context.Provider>
