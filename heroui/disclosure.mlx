module Jsx = Solidtype.Jsx
module Solid = Solidtype.Solid
module Collapsible = Solidtype_kobalte.Collapsible

(* What a disclosure's parts read of it: its classes, its state, and the id
   its trigger controls. *)
type disclosure = {
  slots : Styles.Disclosure.slots;
  expanded : unit -> bool;
  expand : bool -> unit;
  disabled : unit -> bool;
  content_id : string;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = disclosure
end)

let within part =
  match Context.use () with
  | Some d -> d
  | None -> invalid_arg (part ^ " is used inside a Disclosure")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Heading = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Heading" in
    (* A button with the trigger's slot is Kobalte's trigger, as React Aria's
       disclosure gives its ButtonContext's trigger slot. *)
    let trigger =
      {
        Button.component = Collapsible.Trigger.component;
        is_disabled = Some d.disabled;
        controls = Some d.content_id;
        described_by = None;
        pressed = None;
        needs_slot = true;
        element = None;
      }
    in
    <h3
      class_=(fun () -> after (Styles.Disclosure.heading d.slots) (class_ ()))
      data_slot="disclosure-heading"
      props=(Props.others props)>
      <Button.Trigger.Provider value=(fun () -> trigger)>
        (fun () -> children ())
      </Button.Trigger.Provider>
    </h3>
  [@@element h3]
end

(* Kobalte's trigger is its button, its props the button's, though Kobalte
   declares it a div's. *)
module Collapsible_trigger = struct
  module Props = Solidtype_kobalte.Button.Root.Props

  let component = Collapsible.Trigger.component
end

module Trigger = struct
  type state = {
    is_hovered : bool Solid.accessor;
    is_pressed : bool Solid.accessor;
    is_focused : bool Solid.accessor;
    is_focus_visible : bool Solid.accessor;
    is_disabled : bool Solid.accessor;
  }

  let%component make ?(class_ : string option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ~(children : state Jsx.children) () =
    let d = within "Disclosure.Trigger" in
    let i = Interaction.create ~disabled:(fun[@u] () -> d.disabled ()) () in
    <Collapsible_trigger
      class_=(fun () -> after (Styles.Disclosure.trigger d.slots) (class_ ()))
      aria_controls=(fun () -> d.content_id)
      slot="trigger"
      ref=(fun b ->
            ignore (given_ref b : unit option);
            Interaction.watch i b)
      data_slot="disclosure-trigger"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
      props=(Props.others props)>
      (fun () ->
        Jsx.draw (children ())
          {
            is_hovered = (fun[@u] () -> Interaction.hovered i);
            is_pressed = (fun[@u] () -> Interaction.pressed i);
            is_focused = (fun[@u] () -> Interaction.focused i);
            is_focus_visible = (fun[@u] () -> Interaction.focus_visible i);
            is_disabled = (fun[@u] () -> Interaction.disabled i);
          })
    </Collapsible_trigger>
  [@@element button]
end

module Indicator = struct
  let%component make ?(class_ : string option) () =
    let d = within "Disclosure.Indicator" in
    (* HeroUI's own chevron, which its styles turn over. *)
    <svg
      aria_hidden=true
      class_=(fun () -> after (Styles.Disclosure.indicator d.slots) (class_ ()))
      fill="none"
      height="16"
      role=`presentation
      view_box="0 0 16 16"
      width="16"
      xmlns="http://www.w3.org/2000/svg"
      data_expanded=(fun () -> Jsx.flag (d.expanded ()))
      data_slot="disclosure-indicator"
      props=(Props.others props)>
      <path
        clip_rule="evenodd"
        d="M2.97 5.47a.75.75 0 0 1 1.06 0L8 9.44l3.97-3.97a.75.75 0 1 1 1.06 \
           1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 0-1.06"
        fill="currentColor"
        fill_rule="evenodd"
      />
    </svg>
  [@@element svg]
end

module Content = struct
  type state = { is_focus_visible_within : bool Solid.accessor }

  let%component make ?(class_ : string option) ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children) () =
    let d = within "Disclosure.Content" in
    (* Its focus, within it, whether or not the disclosure is disabled. *)
    let i = Interaction.create () in
    let panel =
      Panel.create ~expanded:d.expanded ~expand:(fun () -> d.expand true) ()
    in
    <Collapsible.Content
      class_=(fun () -> after (Styles.Disclosure.content d.slots) (class_ ()))
      style=(fun () ->
              match style () with
              | Some s -> Panel.style panel ^ "; " ^ s
              | None -> Panel.style panel)
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e;
            Panel.watch panel e)
      data_expanded=(fun () -> Jsx.flag (d.expanded ()))
      data_slot="disclosure-content"
      props=(Props.others props)
            (* What the trigger names it by, and whether it is shown, are the
         disclosure's, which an attribute in the rest must not replace. *)
      id=(fun () -> d.content_id)
      aria_hidden=(fun () -> not (d.expanded ()))
      ?hidden=(Jsx.attr (fun () -> Panel.hidden panel))>
      (fun () ->
        Jsx.draw (children ())
          {
            is_focus_visible_within =
              (fun[@u] () -> Interaction.focus_visible i);
          })
    </Collapsible.Content>
  [@@element div]
end

module Body = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Body" in
    <div
      class_=(fun () -> Styles.Disclosure.body d.slots)
      data_slot="disclosure-body"
      props=(Props.others props)>
      <div
        class_=(fun () ->
                 after (Styles.Disclosure.body_inner d.slots) (class_ ()))>
        (fun () -> children ())
      </div>
    </div>
  [@@element div]
end

type state = {
  is_expanded : bool Solid.accessor;
  is_focus_visible_within : bool Solid.accessor;
  is_disabled : bool Solid.accessor;
}

let%component make ?(id : string option) ?(is_expanded : bool option)
    ?(default_expanded : bool = false)
    ?(on_expanded_change : (bool -> unit) option) ?(is_disabled : bool = false)
    ?(class_ : string option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ~(children : state Jsx.children) () =
  (* In a group, expanded as the group holds its id, and its own change still
     told, as React Aria's disclosure is. *)
  let group = Disclosure_group.Context.use () in
  let expanded, expand =
    match group with
    | None ->
        Field.controlled ~value:is_expanded ~default:(default_expanded ())
          ~on_change:(fun v -> on_expanded_change v)
    | Some g ->
        let key =
          match id () with Some k -> k | None -> Solid.create_unique_id ()
        in
        ( (fun () -> g.is_expanded key),
          fun v ->
            g.toggle key;
            ignore (on_expanded_change v : unit option) )
  in
  let is_disabled () =
    is_disabled ()
    ||
    match group with
    | Some (g : Disclosure_group.group) -> g.is_disabled ()
    | None -> false
  in
  let d =
    {
      slots = Styles.Disclosure.slots (Styles.Disclosure.options ());
      expanded;
      expand;
      disabled = (fun () -> is_disabled ());
      content_id = Solid.create_unique_id ();
    }
  in
  (* Its focus, within it, whether or not it is disabled. *)
  let focus = Interaction.create () in
  (* Kobalte's content is kept on the page while collapsed, which HeroUI's
     styles shrink to nothing and find in page reaches. *)
  <Collapsible.Root
    open_=(fun () -> expanded ())
    on_open_change=expand
    disabled=(fun () -> is_disabled ())
    force_mount=true
    class_=(fun () -> after (Styles.Disclosure.base d.slots) (class_ ()))
    data_expanded=(fun () -> Jsx.flag (expanded ()))
    data_disabled=(fun () -> Jsx.flag (is_disabled ()))
    data_slot="disclosure"
    ref=(fun e ->
          ignore (given_ref e : unit option);
          Interaction.watch focus e)
    props=(Props.others props)>
    <Context.Provider value=(fun () -> d)>
      (fun () ->
        Jsx.draw (children ())
          {
            is_expanded = (fun[@u] () -> expanded ());
            is_focus_visible_within =
              (fun[@u] () -> Interaction.focus_visible focus);
            is_disabled = (fun[@u] () -> is_disabled ());
          })
    </Context.Provider>
  </Collapsible.Root>
[@@element div]
