module Jsx = Solidtype.Jsx
module Solid = Solidtype.Solid
module Collapsible = Solidtype_kobalte.Collapsible

(* What a disclosure's parts read of it: its classes, its state, and the id
   its trigger controls. *)
type disclosure = {
  slots : Styles.Disclosure.slots;
  expanded : unit -> bool;
  expand : bool -> unit;
  disabled : unit -> bool;
  content_id : string;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = disclosure
end)

let within part =
  match Context.use () with
  | Some d -> d
  | None -> invalid_arg (part ^ " is used inside a Disclosure")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Heading = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Heading" in
    (* A button with the trigger's slot is Kobalte's trigger, as React Aria's
       disclosure gives its ButtonContext's trigger slot. *)
    let trigger =
      {
        Button.component = Collapsible.Trigger.component;
        is_disabled = d.disabled;
        controls = d.content_id;
      }
    in
    <h3
      class_=(fun () -> after (Styles.Disclosure.heading d.slots) (class_ ()))
      data_slot="disclosure-heading"
      props=(Props.others props)>
      <Button.Trigger.Provider value=(fun () -> trigger)>
        (fun () -> children ())
      </Button.Trigger.Provider>
    </h3>
end

module Trigger = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Trigger" in
    let i = Interaction.create ~disabled:(fun[@u] () -> d.disabled ()) () in
    <Collapsible.Trigger
      class_=(fun () -> after (Styles.Disclosure.trigger d.slots) (class_ ()))
      aria_controls=(fun () -> d.content_id)
      slot="trigger"
      ref=(fun b -> Interaction.watch i b)
      data_slot="disclosure-trigger"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
      props=(Props.others props)>
      (fun () -> children ())
    </Collapsible.Trigger>
end

module Indicator = struct
  let%component make ?(class_ : string option) () =
    let d = within "Disclosure.Indicator" in
    (* HeroUI's own chevron, which its styles turn over. *)
    <svg
      aria_hidden=true
      class_=(fun () -> after (Styles.Disclosure.indicator d.slots) (class_ ()))
      fill="none"
      height="16"
      role=`presentation
      view_box="0 0 16 16"
      width="16"
      xmlns="http://www.w3.org/2000/svg"
      data_expanded=(fun () -> Jsx.flag (d.expanded ()))
      data_slot="disclosure-indicator"
      props=(Props.others props)>
      <path
        clip_rule="evenodd"
        d="M2.97 5.47a.75.75 0 0 1 1.06 0L8 9.44l3.97-3.97a.75.75 0 1 1 1.06 \
           1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 0 1 0-1.06"
        fill="currentColor"
        fill_rule="evenodd"
      />
    </svg>
end

type animation

external animations_of : _ Dom.element_like -> animation array = "getAnimations"
[@@mel.send]

type animations_method

(* jsdom, and a browser too old, has no getAnimations: there the content
   takes its size at once, as React Aria's does. *)
external animations_method :
  _ Dom.element_like -> animations_method Js.undefined = "getAnimations"
[@@mel.get]

external finished : animation -> animation Js.Promise.t = "finished" [@@mel.get]
external scroll_width : _ Dom.element_like -> float = "scrollWidth" [@@mel.get]

external scroll_height : _ Dom.element_like -> float = "scrollHeight"
[@@mel.get]

external request_frame : (float -> unit) -> int = "requestAnimationFrame"

external on_before_match :
  _ Dom.element_like ->
  (_[@mel.as "beforematch"]) ->
  ((Dom.event -> unit)[@mel.uncurry]) ->
  unit = "addEventListener"
[@@mel.send]

(* A size of the content's, as HeroUI's styles read it from
   --disclosure-panel-width and --disclosure-panel-height. *)
type size = { width : string; height : string }

let auto = { width = "auto"; height = "auto" }
let none = { width = "0px"; height = "0px" }

let measured e =
  let px n = Js.Float.toString n ^ "px" in
  { width = px (scroll_width e); height = px (scroll_height e) }

(* Runs [f] once the transitions running on [e] end; one interrupted, by a
   toggle before it ends, rejects, and [f] is left to the toggle after. *)
let settled e f =
  let all = Js.Promise.all (Array.map finished (animations_of e)) in
  ignore
    (all
     |> Js.Promise.then_ (fun (_ : animation array) ->
         f ();
         Js.Promise.resolve ())
     |> Js.Promise.catch (fun _ -> Js.Promise.resolve ())
      : unit Js.Promise.t)

module Content = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Content" in
    let expanded = Solid.untrack d.expanded in
    let size, set_size =
      Solid.create_signal (if expanded then auto else none)
    in
    (* Hidden until find in page reaches it, and written again as a toggle
       the disclosure refuses leaves it so. *)
    let hidden, set_hidden = Solid.create_signal ~equals:Never (not expanded) in
    let content = ref None in
    (* The content grows from none to its size, measured once it is shown,
       then takes its own as it changes; it shrinks from its size to none, and
       is hidden once it has. Each step waits a frame, so the transition
       HeroUI's styles run starts from the size before it. *)
    Solid.create_effect
      (Solid.on ~defer:true d.expanded (fun now _ ->
           match !content with
           | None -> ()
           | Some e -> (
               match (Js.Undefined.toOption (animations_method e), now) with
               | None, true ->
                   Solid.set set_hidden false;
                   Solid.set set_size auto
               | None, false ->
                   Solid.set set_size none;
                   Solid.set set_hidden true
               | Some _, true ->
                   Solid.set set_hidden false;
                   ignore
                     (request_frame (fun _ ->
                          if d.expanded () then (
                            Solid.set set_size (measured e);
                            settled e (fun () ->
                                if d.expanded () then Solid.set set_size auto)))
                       : int)
               | Some _, false ->
                   Solid.set set_size (measured e);
                   ignore
                     (request_frame (fun _ ->
                          if not (d.expanded ()) then (
                            Solid.set set_size none;
                            settled e (fun () ->
                                if not (d.expanded ()) then
                                  Solid.set set_hidden true)))
                       : int))));
    let reveal (_ : Dom.event) =
      d.expand true;
      (* The browser takes hidden away once its event is told: a disclosure
         controlled collapsed hides it again. *)
      ignore
        (request_frame (fun _ ->
             if not (d.expanded ()) then Solid.set set_hidden true)
          : int)
    in
    <Collapsible.Content
      id=(fun () -> d.content_id)
      class_=(fun () -> after (Styles.Disclosure.content d.slots) (class_ ()))
      aria_hidden=(fun () -> not (d.expanded ()))
      ?hidden=(fun () -> if Solid.get hidden then Some "until-found" else None)
      style=(fun () ->
              let s = Solid.get size in
              "--disclosure-panel-width: " ^ s.width
              ^ "; --disclosure-panel-height: " ^ s.height)
      ref=(fun e ->
            content := Some e;
            on_before_match e reveal)
      data_expanded=(fun () -> Jsx.flag (d.expanded ()))
      data_slot="disclosure-content"
      props=(Props.others props)>
      (fun () -> children ())
    </Collapsible.Content>
end

module Body = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let d = within "Disclosure.Body" in
    <div
      class_=(fun () -> Styles.Disclosure.body d.slots)
      data_slot="disclosure-body"
      props=(Props.others props)>
      <div
        class_=(fun () ->
                 after (Styles.Disclosure.body_inner d.slots) (class_ ()))>
        (fun () -> children ())
      </div>
    </div>
end

let%component make ?(id : string option) ?(is_expanded : bool option)
    ?(default_expanded : bool = false)
    ?(on_expanded_change : (bool -> unit) option) ?(is_disabled : bool = false)
    ?(class_ : string option) ~(children : Jsx.content) () =
  (* In a group, expanded as the group holds its id, and its own change still
     told, as React Aria's disclosure is. *)
  let group = Disclosure_group.Context.use () in
  let expanded, expand =
    match group with
    | None ->
        Field.controlled ~value:is_expanded ~default:(default_expanded ())
          ~on_change:(fun v -> on_expanded_change v)
    | Some g ->
        let key =
          match id () with Some k -> k | None -> Solid.create_unique_id ()
        in
        ( (fun () -> g.is_expanded key),
          fun v ->
            g.toggle key;
            ignore (on_expanded_change v : unit option) )
  in
  let is_disabled () =
    is_disabled ()
    ||
    match group with
    | Some (g : Disclosure_group.group) -> g.is_disabled ()
    | None -> false
  in
  let d =
    {
      slots = Styles.Disclosure.slots (Styles.Disclosure.options ());
      expanded;
      expand;
      disabled = (fun () -> is_disabled ());
      content_id = Solid.create_unique_id ();
    }
  in
  (* Kobalte's content is kept on the page while collapsed, which HeroUI's
     styles shrink to nothing and find in page reaches. *)
  <Collapsible.Root
    open_=(fun () -> expanded ())
    on_open_change=expand
    disabled=(fun () -> is_disabled ())
    force_mount=true
    class_=(fun () -> after (Styles.Disclosure.base d.slots) (class_ ()))
    data_expanded=(fun () -> Jsx.flag (expanded ()))
    data_disabled=(fun () -> Jsx.flag (is_disabled ()))
    data_slot="disclosure"
    props=(Props.others props)>
    <Context.Provider value=(fun () -> d)>
      (fun () -> children ())
    </Context.Provider>
  </Collapsible.Root>
