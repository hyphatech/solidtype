module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Progress
module I18n = Solidtype_kobalte.I18n
module Types = Solidtype_kobalte.Types

(* What a bar's parts read of it: its classes, and how far along its range
   its value is, from 0 to 100, unless it is indeterminate. *)
type bar = {
  slots : Styles.ProgressBar.slots S.accessor;
  percent : float option S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = bar
end)

let within part =
  match Context.use () with
  | Some m -> m
  | None -> invalid_arg (part ^ " is used inside a Progress_bar")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Kobalte_label = Field.As_span (struct
  let component = Kobalte.Label.component
end)

module Kobalte_value = Field.As_span (struct
  let component = Kobalte.ValueLabel.component
end)

(* A label in a bar is Kobalte's, a span, which names it. *)
let label : Label.slot =
 fun classes others children ->
  <Kobalte_label
    as_="span" class_=(fun () -> classes ()) data_slot="label" props=others>
    (fun () -> children ())
  </Kobalte_label>

module Output = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let m = within "Progress_bar.Output" in
    let classes () =
      after (Styles.ProgressBar.output (S.get m.slots)) (S.get class_)
    in
    <Show
      when_=(fun () -> Option.is_some (S.get children))
      fallback=(<Kobalte_value
                  as_="span"
                  class_=(fun () -> classes ())
                  data_slot="progress-bar-output"
                  props=(Props.others props)
                />)>
      <span
        class_=(fun () -> classes ())
        data_slot="progress-bar-output"
        props=(Props.others props)>
        (fun () ->
          match S.get children with Some c -> c | None -> Jsx.string "")
      </span>
    </Show>
  [@@element span]
end

module Track = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let m = within "Progress_bar.Track" in
    <div
      class_=(fun () ->
               after (Styles.ProgressBar.track (S.get m.slots)) (S.get class_))
      data_slot="progress-bar-track"
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  [@@element div]
end

module Fill = struct
  let%component make ?(class_ : string option) ?(style : string option) () =
    let m = within "Progress_bar.Fill" in
    <div
      class_=(fun () ->
               after (Styles.ProgressBar.fill (S.get m.slots)) (S.get class_))
      ?style=(fun () ->
               match (S.get m.percent, S.get style) with
               | Some p, given ->
                   let own = "width: " ^ Js.Float.toString p ^ "%;" in
                   Some
                     (match given with Some s -> own ^ " " ^ s | None -> own)
               | None, given -> given)
      data_slot="progress-bar-fill"
      props=(Props.others props)
    />
  [@@element div]
end

(* What its children are drawn of: React Aria's render props for a progress
   bar, neither a share nor a text while it is indeterminate. *)
type state = {
  percentage : float option Solidtype.Solid.accessor;
  value_text : string option Solidtype.Solid.accessor;
  is_indeterminate : bool Solidtype.Solid.accessor;
}

let%component make ?(value : float = 0.) ?(is_indeterminate : bool = false)
    ?(min_value : float = 0.) ?(max_value : float = 100.)
    ?(color : [ `default | `accent | `success | `warning | `danger ] option)
    ?(size : [ `sm | `md | `lg ] option) ?(aria_label : string option)
    ?(class_ : string option)
    ?(format_options : Types.NumberFormatOptions.t option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* HeroUI's formatOptions as it reads them, a percent by default: a percent
     is the value's share of its range, any other style the value itself. *)
  let options () =
    match S.get format_options with
    | Some o -> o
    | None -> Types.NumberFormatOptions.make ~style:`percent ()
  in
  let formatter =
    I18n.create_number_formatter
      (Types.Either.right (S.accessor (fun () -> options ())))
  in
  let text ~value ~min ~max =
    let range = max -. min in
    let shown =
      match Types.NumberFormatOptions.style (options ()) with
      | Some `percent -> if range <= 0. then 0. else (value -. min) /. range
      | Some (`decimal | `currency | `unit) | None -> value
    in
    Types.NumberFormat.format (Solidtype.Solid.get formatter) shown
  in
  let value_label params =
    text
      ~value:(Types.GetValueLabelParams.value params)
      ~min:(Types.GetValueLabelParams.min params)
      ~max:(Types.GetValueLabelParams.max params)
  in
  let m =
    {
      slots =
        S.accessor (fun () ->
            Styles.ProgressBar.slots
              (Styles.ProgressBar.options ?color:(S.get color)
                 ?size:(S.get size) ()));
      percent =
        S.accessor (fun () ->
            let range = S.get max_value -. S.get min_value in
            if S.get is_indeterminate then None
            else if range <= 0. then Some 0.
            else
              Some
                (Float.min 100.
                   (Float.max 0.
                      ((S.get value -. S.get min_value) /. range *. 100.))));
    }
  in
  let state () =
    {
      percentage = m.percent;
      value_text =
        S.accessor (fun () ->
            if S.get is_indeterminate then None
            else
              Some
                (text ~value:(S.get value) ~min:(S.get min_value)
                   ~max:(S.get max_value)));
      is_indeterminate;
    }
  in
  <Context.Provider value=(fun () -> m)>
    <Kobalte.Root
      value=(fun () -> S.get value)
      indeterminate=(fun () -> S.get is_indeterminate)
      min_value=(fun () -> S.get min_value)
      max_value=(fun () -> S.get max_value)
      ?aria_label
      get_value_label=value_label
      class_=(fun () ->
               after (Styles.ProgressBar.base (S.get m.slots)) (S.get class_))
      data_slot="progress-bar"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Label.Slot.Provider value=(fun () -> label)>
        (fun () -> Jsx.draw (S.get children) (state ()))
      </Label.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
