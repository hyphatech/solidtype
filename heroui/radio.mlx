module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.RadioGroup

(* What a radio's parts read of the radio they are in: its classes, and its
   state as a field. *)
type radio = { slots : Styles.Radio.slots S.accessor; field : Field.state }

module Context = Solidtype.Context.Make_optional (struct
  type t = radio
end)

let within part =
  match Context.use () with
  | Some r -> r
  | None -> invalid_arg (part ^ " is used inside a Radio")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Field_content = Field.Content (struct
  let label = Kobalte.ItemLabel.component
  let input = Kobalte.ItemInput.component
end)

module Content = struct
  (* What its children are drawn of: React Aria's render props for it, made
     of its field's state and its interaction. *)
  type state = {
    is_selected : bool Solidtype.Solid.accessor;
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_read_only : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
    is_required : bool Solidtype.Solid.accessor;
  }

  let state_of (f : Field.state) =
    let i = f.interaction in
    {
      is_selected = f.selected;
      is_hovered = S.accessor (fun () -> Interaction.hovered i);
      is_pressed = S.accessor (fun () -> Interaction.pressed i);
      is_focused = S.accessor (fun () -> Interaction.focused i);
      is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
      is_disabled = f.disabled;
      is_read_only = f.read_only;
      is_invalid = f.invalid;
      is_required = f.required;
    }

  let%component make ?(class_ : string option) ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Label.props -> state -> Solidtype.Jsx.element) option)
      () =
    let r = within "Radio.Content" in
    let state () = state_of r.field in
    <Field_content
      field=(fun () -> r.field)
      slot="radio-content"
      class_=(fun () ->
               after (Styles.Radio.content (S.get r.slots)) (S.get class_))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state_of r.field))
    </Field_content>
  [@@element label]
end

module Control = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let r = within "Radio.Control" in
    <span
      class_=(fun () ->
               after (Styles.Radio.control (S.get r.slots)) (S.get class_))
      data_slot="radio-control"
      props=(Props.others props)>
      (fun () -> S.get children)
    </span>
  [@@element span]
end

module Indicator = struct
  let%component make ?(class_ : string option)
      ?(children : Content.state Jsx.children option)
      ?(as_ :
         (Solidtype.Html.Span.props -> Content.state -> Solidtype.Jsx.element)
         option) () =
    let r = within "Radio.Indicator" in
    <span
      aria_hidden=true
      class_=(fun () ->
               after (Styles.Radio.indicator (S.get r.slots)) (S.get class_))
      data_slot="radio-indicator"
      ?as_=(fun () ->
             Option.map (fun f p -> f p (Content.state_of r.field)) (S.get as_))
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some given -> Jsx.draw given (Content.state_of r.field)
        | None -> Jsx.string "")
    </span>
  [@@element span]
end

(* A description in a radio is the radio's: Kobalte's, which its input is
   described by. *)
let description : Description.slot =
 fun classes others children ->
  <Kobalte.ItemDescription
    class_=(fun () -> classes ())
    slot="description"
    data_slot="description"
    props=others>
    (fun () -> children ())
  </Kobalte.ItemDescription>

(* What its children are drawn of: React Aria's render props for it,
   made of its state as a field. *)
type state = {
  is_selected : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let state_of (f : Field.state) =
  {
    is_selected = f.selected;
    is_disabled = f.disabled;
    is_read_only = f.read_only;
    is_invalid = f.invalid;
    is_required = f.required;
  }

let%component make ~(value : string) ?(is_disabled : bool = false)
    ?(aria_label : string option) ?(class_ : string option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let g =
    match Radio_group.Context.use () with
    | Some g -> g
    | None -> invalid_arg "Radio is used inside a Radio_group"
  in
  let selected =
    S.accessor (fun () ->
        match S.get g.value with
        | Some v -> String.equal v (S.get value)
        | None -> false)
  in
  let disabled = S.accessor (fun () -> S.get g.disabled || S.get is_disabled) in
  let r =
    {
      slots =
        S.accessor (fun () -> Styles.Radio.slots (Styles.Radio.options ()));
      field =
        {
          selected;
          indeterminate = S.accessor (fun () -> false);
          disabled;
          invalid = g.invalid;
          read_only = g.read_only;
          required = g.required;
          aria_label;
          described_by = S.accessor (fun () -> None);
          interaction =
            Interaction.create
              ~disabled:(fun () -> S.get disabled)
              ~no_hover:(fun () -> S.get g.read_only)
              ~keys:`element ();
        };
    }
  in
  let state () = state_of r.field in
  <Context.Provider value=(fun () -> r)>
    <Kobalte.Item
      value=(fun () -> S.get value)
      disabled=(fun () -> S.get is_disabled)
      class_=(fun () ->
               after (Styles.Radio.base (S.get r.slots)) (S.get class_))
      data_slot="radio"
      data_selected=(fun () -> Jsx.flag (S.get selected))
      data_disabled=(fun () -> Jsx.flag (S.get disabled))
      data_invalid=(fun () -> Jsx.flag (S.get g.invalid))
      data_readonly=(fun () -> Jsx.flag (S.get g.read_only))
      data_required=(fun () -> Jsx.flag (S.get g.required))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Description.Slot.Provider value=(fun () -> description)>
        (fun () -> Jsx.draw (S.get children) (state_of r.field))
      </Description.Slot.Provider>
    </Kobalte.Item>
  </Context.Provider>
[@@element div]
