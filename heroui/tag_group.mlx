module Jsx = Solidtype.Jsx
module Headless = Solidtype_headless.Tag_group

type group = {
  size : unit -> [ `sm | `md | `lg ] option;
  variant : unit -> [ `default | `surface ] option;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

let use_context part =
  match Context.use () with
  | Some g -> g
  | None -> invalid_arg (part ^ " is used inside a Tag_group")

external listen : _ Dom.element_like -> string -> (Dom.event -> unit) -> unit
  = "addEventListener"
[@@mel.send]

(* Whether [element] itself has the focus, not a tag inside it, kept as it
   gains and loses it. *)
let self_focus () =
  let on, set_on = Solidtype.Solid.create_signal false in
  let watch e =
    listen e "focus" (fun _ -> Solidtype.Solid.set set_on true);
    listen e "blur" (fun _ -> Solidtype.Solid.set set_on false)
  in
  ((fun () -> Solidtype.Solid.get on), watch)

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base
let slots () = Styles.TagGroup.slots (Styles.TagGroup.options ())

module List = struct
  let%component make ?(render_empty_state : (unit -> Jsx.element) option)
      ?(class_ : string option) ~(children : Jsx.content) () =
    ignore (use_context "Tag_group.List" : group);
    let h = Headless.use_context () in
    let self, watch_self = self_focus () in
    <Headless.List
      class_=(fun () -> after (Styles.TagGroup.list (slots ())) (class_ ()))
      data_slot="tag-group-list"
      data_empty=(fun () -> Jsx.flag (h.is_empty ()))
      data_focused=(fun () -> Jsx.flag (self ()))
      data_focus_visible=(fun () -> Jsx.flag (self () && Interaction.keyed ()))
      ref=(fun e -> watch_self e)
      props=(Props.omit props [| Props.Class_; Props.Children |])>
      (fun () -> children ())
    </Headless.List>
  [@@element div]
end

let%component make ?(size : [ `sm | `md | `lg ] option)
    ?(variant : [ `default | `surface ] option)
    ?(selection_mode : [ `none | `single | `multiple ] option)
    ?(selected_keys : string array option)
    ?(default_selected_keys : string array option)
    ?(on_selection_change : (string array -> unit) option)
    ?(disabled_keys : string array option) ?(is_disabled : bool option)
    ?(on_remove : (string array -> unit) option) ?(aria_label : string option)
    ?(aria_labelledby : string option) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let g = { size = (fun () -> size ()); variant = (fun () -> variant ()) } in
  (* Its label names its list and is a span, its description and error
     describe the list, as React Aria's tag group gives them their
     elements. *)
  let label : Label.slot =
   fun[@u] classes others children ->
    <Headless.Label
      class_=(fun () -> classes ()) data_slot="label" props=others>
      (fun () -> children ())
    </Headless.Label>
  in
  let description : Description.slot =
   fun[@u] classes others children ->
    <Headless.Description
      class_=(fun () -> classes ())
      slot="description"
      data_slot="description"
      props=others>
      (fun () -> children ())
    </Headless.Description>
  in
  let error : Error_message.slot =
   fun[@u] classes others children ->
    <Headless.Error_message
      class_=(fun () -> classes ())
      slot="errorMessage"
      data_slot="error-message"
      props=others>
      (fun () -> children ())
    </Headless.Error_message>
  in
  <Context.Provider value=(fun () -> g)>
    <Headless.Root
      class_=(fun () -> after (Styles.TagGroup.base (slots ())) (class_ ()))
      data_slot="tag-group"
      props=(Props.omit props
               [| Props.Size; Props.Variant; Props.Class_; Props.Children |])>
      <Label.Slot.Provider value=(fun () -> label)>
        <Description.Slot.Provider value=(fun () -> description)>
          <Error_message.Slot.Provider value=(fun () -> error)>
            (fun () -> children ())
          </Error_message.Slot.Provider>
        </Description.Slot.Provider>
      </Label.Slot.Provider>
    </Headless.Root>
  </Context.Provider>
[@@element div]
