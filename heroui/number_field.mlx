module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_headless.Number_field
module I18n = Solidtype_kobalte.I18n
module Types = Solidtype_kobalte.Types
module Gravity = Solidtype_gravity_icons

type part = [ `root | `group | `input | `increment | `decrement ]

module Look = struct
  type t = { classes : part -> string; slot : string }

  include Solidtype.Context.Make_optional (struct
    type nonrec t = t
  end)
end

(* What a field's parts read of it: its classes and its state. *)
type field = {
  classes : part -> string;
  slot : string;
  look_given : bool;
  aria_label : string option S.accessor;
  format_options : Types.NumberFormatOptions.t option S.accessor;
  disabled : bool S.accessor;
  invalid : bool S.accessor;
  label_id : string;
  current : float S.accessor;
  can_increment : bool S.accessor;
  can_decrement : bool S.accessor;
  typed : unit -> unit;
  commit : unit -> unit;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = field
end)

external queue_microtask : (unit -> unit) -> unit = "queueMicrotask"

(* The decimals [x] is written with, a 1e-7 as a 0.0000001: the precision a
   value on a grid of its step, counted from its minimum, is rounded to. *)
let decimals x =
  let s = Js.Float.toString (Float.abs x) in
  let after_point m =
    match String.index_opt m '.' with
    | Some i -> String.length m - i - 1
    | None -> 0
  in
  match String.index_opt s 'e' with
  | Some i -> (
      let mantissa = String.sub s 0 i in
      match
        int_of_string_opt (String.sub s (i + 1) (String.length s - i - 1))
      with
      | Some e when e < 0 -> after_point mantissa - e
      | Some _ | None -> after_point mantissa)
  | None -> after_point s

(* A value on its step's grid, counted from the minimum, within the range: to
   the nearer step, a value halfway to the step away from the minimum, and
   below the maximum to the last step that fits. A count of steps is a float
   divided, so it is first rounded to nine decimals, which drops a division's
   noise and keeps any count a field reaches; the value is then written with
   the decimals of its step and its minimum, so a tenth added to 0.2 is 0.3.
   A step that is not positive is no grid: the value is kept within the
   range alone. *)
let snap ~min ~max ~step value =
  let within v =
    match (min, max) with
    | Some m, _ when v < m -> m
    | _, Some m when v > m -> m
    | _ -> v
  in
  if not (step > 0.) then within value
  else
    let base = Option.value min ~default:0. in
    let precision = Int.max (decimals step) (decimals base) in
    let written x =
      Js.Float.fromString (Js.Float.toFixed ~digits:precision x)
    in
    let steps x =
      Js.Float.fromString (Js.Float.toFixed ~digits:9 ((x -. base) /. step))
    in
    let near = written (base +. (Float.round (steps value) *. step)) in
    match (min, max) with
    | Some m, _ when near < m -> m
    | _, Some m when near > m ->
        written (base +. (Float.floor (steps m) *. step))
    | _ -> near

let within part =
  match Context.use () with
  | Some f -> f
  | None -> invalid_arg (part ^ " is used inside a Number_field")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Shown = struct
  type t = {
    value : float S.accessor;
    format_options : Types.NumberFormatOptions.t option S.accessor;
    disabled : bool S.accessor;
  }

  let use part =
    let f = within part in
    {
      value = f.current;
      format_options = f.format_options;
      disabled = f.disabled;
    }
end

module Parts = Field.Slots (struct
  let label = Kobalte.Label.component
  let description = Kobalte.Description.component
  let error = Kobalte.ErrorMessage.component
end)

module Group = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_focus_within : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option) ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let f = within "Number_field.Group" in
    (* Hovered and focused within as React Aria's group is, which HeroUI's
       styles ring. *)
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_focus_within = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = f.disabled;
        is_invalid = f.invalid;
      }
    in
    <div
      role=`group
      ?aria_invalid=(if S.get f.invalid then Some "true" else None)
      ref=(fun e -> Interaction.watch i e)
      data_hovered=(Jsx.flag (Interaction.hovered i))
      data_focus_within=(Jsx.flag (Interaction.focused i))
      class_=(after (f.classes `group) (S.get class_))
      data_slot=(Jsx.data (f.slot ^ "-group"))
      data_disabled=(Jsx.flag (S.get f.disabled))
      data_invalid=(Jsx.flag (S.get f.invalid))
      ?as_=(Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (Jsx.draw (S.get children) (state ()))
    </div>
  [@@element div]
end

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]

module Input = struct
  let%component make ?(placeholder : string option) ?(class_ : string option)
      ?(on_input : (Dom.inputEvent -> unit) option)
      ?(on_key_down : (Dom.keyboardEvent -> unit) option)
      ?(on_focus_out : (Dom.focusEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlInputElement -> unit) option) () =
    let f = within "Number_field.Input" in
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    (* Under a look that shows the value elsewhere, the input is shown while
       the text in it is typed, and not as the keys or the buttons step it. *)
    let editing, set_editing = S.create_signal false in
    let stepping e =
      ignore (on_key_down e : unit option);
      match key e with
      | "Enter" ->
          f.commit ();
          S.set set_editing false
      | "ArrowUp" | "ArrowDown" | "PageUp" | "PageDown" | "Home" | "End"
      | "Escape" ->
          S.set set_editing false
      | _ -> ()
    in
    (* Kobalte's input tells its value now as the text it shows once the value
       changes, a "51%"; React Aria's tells the number. *)
    <Kobalte.Input
      ?placeholder=(S.get placeholder)
      ?aria_label=(S.get f.aria_label)
      class_=(after (f.classes `input) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      ?aria_valuenow=(let v = S.get f.current in
                      if Float.is_nan v then None
                      else Some (Js.Float.toString v))
      data_slot=(Jsx.data (f.slot ^ "-input"))
      data_editing=(Jsx.flag (f.look_given && S.get editing))
      on_input=(fun e ->
                 ignore (on_input e : unit option);
                 f.typed ();
                 S.set set_editing true)
      on_key_down=stepping
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     f.commit ();
                     S.set set_editing false)
      data_hovered=(Jsx.flag (Interaction.hovered i))
      data_focused=(Jsx.flag (Interaction.focused i))
      data_focus_visible=(Jsx.flag (Interaction.focus_visible i))
      data_disabled=(Jsx.flag (S.get f.disabled))
      data_invalid=(Jsx.flag (S.get f.invalid))
      props=(Props.others props)
    />
  [@@element input]
end

module Increment_button = struct
  let%component make ?(class_ : string option) ?(children : Jsx.element option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option) () =
    let f = within "Number_field.Increment_button" in
    let disabled = S.accessor (fun () -> not (S.get f.can_increment)) in
    let i = Interaction.create ~disabled:(fun () -> S.get disabled) () in
    (* Named "Increase" and by the field's label, as React Aria's is, or by its
       aria-label where it has no label. *)
    let id = Solidtype.Solid.create_unique_id () in
    <Kobalte.IncrementTrigger
      aria_label=(match S.get f.aria_label with
                 | Some name -> "Increase " ^ name
                 | None -> "Increase")
      ?aria_labelledby=(match S.get f.aria_label with
                       | Some _ -> None
                       | None -> Some (id ^ " " ^ f.label_id))
      class_=(after (f.classes `increment) (S.get class_))
      slot="increment"
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      data_slot=(Jsx.data (f.slot ^ "-increment-button"))
      data_hovered=(Jsx.flag (Interaction.hovered i))
      data_pressed=(Jsx.flag (Interaction.pressed i))
      data_focused=(Jsx.flag (Interaction.focused i))
      data_focus_visible=(Jsx.flag (Interaction.focus_visible i))
      data_disabled=(Jsx.flag (Interaction.disabled i))
      props=(Props.others props)
      id
      disabled=(S.get disabled)>
      <Show
        when_=(Option.is_some (S.get children))
        fallback=(<Gravity.Plus
                    aria_hidden=true
                    role=`presentation
                    data_slot=(Jsx.data (f.slot ^ "-increment-button-icon"))
                  />)>
        (match S.get children with Some c -> c | None -> Jsx.string "")
      </Show>
    </Kobalte.IncrementTrigger>
  [@@element button]
end

module Decrement_button = struct
  let%component make ?(class_ : string option) ?(children : Jsx.element option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option) () =
    let f = within "Number_field.Decrement_button" in
    let disabled = S.accessor (fun () -> not (S.get f.can_decrement)) in
    let i = Interaction.create ~disabled:(fun () -> S.get disabled) () in
    (* Named "Decrease" and by the field's label, as React Aria's is, or by its
       aria-label where it has no label. *)
    let id = Solidtype.Solid.create_unique_id () in
    <Kobalte.DecrementTrigger
      aria_label=(match S.get f.aria_label with
                 | Some name -> "Decrease " ^ name
                 | None -> "Decrease")
      ?aria_labelledby=(match S.get f.aria_label with
                       | Some _ -> None
                       | None -> Some (id ^ " " ^ f.label_id))
      class_=(after (f.classes `decrement) (S.get class_))
      slot="decrement"
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      data_slot=(Jsx.data (f.slot ^ "-decrement-button"))
      data_hovered=(Jsx.flag (Interaction.hovered i))
      data_pressed=(Jsx.flag (Interaction.pressed i))
      data_focused=(Jsx.flag (Interaction.focused i))
      data_focus_visible=(Jsx.flag (Interaction.focus_visible i))
      data_disabled=(Jsx.flag (Interaction.disabled i))
      props=(Props.others props)
      id
      disabled=(S.get disabled)>
      <Show
        when_=(Option.is_some (S.get children))
        fallback=(<Gravity.Minus
                    aria_hidden=true
                    role=`presentation
                    data_slot=(Jsx.data (f.slot ^ "-decrement-button-icon"))
                  />)>
        (match S.get children with Some c -> c | None -> Jsx.string "")
      </Show>
    </Kobalte.DecrementTrigger>
  [@@element button]
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  is_disabled : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(full_width : bool option) ?(value : float option)
    ?(default_value : float option) ?(on_change : (float -> unit) option)
    ?(min_value : float option) ?(max_value : float option)
    ?(step : float option) ?(is_disabled : bool option)
    ?(is_invalid : bool = false) ?(is_read_only : bool = false)
    ?(is_wheel_disabled : bool = false) ?(is_required : bool = false)
    ?(name : string option) ?(aria_label : string option)
    ?(class_ : string option)
    ?(format_options : Types.NumberFormatOptions.t option)
    ?(on_blur : (Dom.focusEvent -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* A field is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with Some d -> d | None -> S.get in_fieldset)
  in
  (* A value is on the grid of a step it is given, else within its range
     alone, as React Aria keeps it; a button steps it by the step, else by 1,
     or by a percent's hundredth. *)
  let snapped v =
    if Float.is_nan v then v
    else
      snap ~min:(S.get min_value) ~max:(S.get max_value)
        ~step:(Option.value (S.get step) ~default:0.)
        v
  in
  let by () =
    match (S.get step, S.get format_options) with
    | Some s, _ -> s
    | None, Some o -> (
        match Types.NumberFormatOptions.style o with
        | Some `percent -> 0.01
        | Some (`decimal | `currency | `unit) | None -> 1.)
    | None, None -> 1.
  in
  (* The value is the field's, on its step's grid within its range, as
     HeroUI's field keeps it, and Kobalte is given it: Kobalte snaps nothing,
     nor stops at a bound. Empty is not a number. *)
  let current, set =
    Field.controlled
      ~value:(fun () -> Option.map snapped (S.get value))
      ~default:(snapped (Option.value (S.get default_value) ~default:Float.nan))
      ~on_change
  in
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid =
    S.accessor (fun () ->
        S.get is_invalid || Option.is_some (S.get in_form.error))
  in
  let committed v =
    let v = snapped v in
    let now = S.get current in
    if not (Float.equal v now || (Float.is_nan v && Float.is_nan now)) then (
      in_form.changed ();
      set v)
  in
  (* Text typed is the value once it is committed, by Enter or as the focus
     leaves, as React Aria's field commits it; a step, by the keys, a button
     or the wheel, at once. The input marks the change its typing makes, which
     Kobalte tells within the same event, and a key it refuses makes none. *)
  let typing = ref false in
  let pending = ref None in
  let change v =
    if !typing then (
      typing := false;
      pending := Some v)
    else (
      pending := None;
      committed v)
  in
  let commit () =
    match !pending with
    | Some v ->
        pending := None;
        committed v
    | None -> ()
  in
  (* A button steps the value while its step would move it. *)
  let can moved =
    S.accessor (fun () ->
        (not (S.get disabled || S.get is_read_only))
        &&
        let now = S.get current in
        Float.is_nan now || not (Float.equal (snapped (moved now)) now))
  in
  (* Kobalte shows the value as its options say but tells a reader the bare
     number; a formatted field tells it as it shows it. *)
  let formatter =
    I18n.create_number_formatter
      (Types.Either.right
         (S.accessor (fun () ->
              match S.get format_options with
              | Some o -> o
              | None -> Types.NumberFormatOptions.make ())))
  in
  let text_value =
    S.accessor (fun () ->
        let now = S.get current in
        match S.get format_options with
        | Some _ when not (Float.is_nan now) ->
            Some (Types.NumberFormat.format (Solidtype.Solid.get formatter) now)
        | Some _ | None -> None)
  in
  let label_id = Solidtype.Solid.create_unique_id () in
  let slots =
    S.accessor (fun () ->
        Styles.NumberField.slots
          (Styles.NumberField.options ?full_width:(S.get full_width)
             ?variant:(S.get variant) ()))
  in
  let look = Look.use () in
  let f =
    {
      label_id;
      current;
      classes =
        (match look with
        | Some l -> l.classes
        | None -> (
            function
            | `root -> Styles.NumberField.base (S.get slots)
            | `group -> Styles.NumberField.group (S.get slots)
            | `input -> Styles.NumberField.input (S.get slots)
            | `increment -> Styles.NumberField.increment_button (S.get slots)
            | `decrement -> Styles.NumberField.decrement_button (S.get slots)));
      slot = (match look with Some l -> l.slot | None -> "number-field");
      look_given = Option.is_some look;
      aria_label;
      format_options;
      disabled;
      invalid;
      can_increment = can (fun v -> v +. by ());
      can_decrement = can (fun v -> v -. by ());
      typed =
        (fun () ->
          typing := true;
          queue_microtask (fun () -> typing := false));
      commit;
    }
  in
  let state () =
    { is_disabled = disabled; is_invalid = invalid; is_read_only; is_required }
  in
  (* A button given slot=`increment or `decrement steps the field as its own
     buttons do, and is named as they are. *)
  let stepper component ~word ~can =
    {
      Button.trigger =
        {
          Button.component;
          is_disabled = Some (fun () -> not (S.get can));
          controls = None;
          described_by = None;
          pressed = None;
          needs_slot = true;
          element = None;
        };
      label =
        (fun () ->
          match S.get aria_label with
          | Some name -> word ^ " " ^ name
          | None -> word);
      labelled_by =
        (fun id ->
          match S.get aria_label with
          | Some _ -> None
          | None -> Some (id ^ " " ^ label_id));
    }
  in
  let steppers =
    {
      Button.increment =
        stepper Kobalte.IncrementTrigger.component ~word:"Increase"
          ~can:f.can_increment;
      decrement =
        stepper Kobalte.DecrementTrigger.component ~word:"Decrease"
          ~can:f.can_decrement;
    }
  in
  <Context.Provider value=f>
    <Kobalte.Root
      raw_value=(S.get current)
      on_raw_value_change=change
      ?min_value=(S.get min_value)
      ?max_value=(S.get max_value)
      step=(by ())
      validation_state=(if S.get invalid then `invalid else `valid)
      required=(S.get is_required)
      disabled=(S.get disabled)
      read_only=(S.get is_read_only)
      change_on_wheel=(not (S.get is_wheel_disabled))
      ?name=(S.get name)
      ?format_options=(S.get format_options)
      ?text_value=(S.get text_value)
      class_=(after (f.classes `root) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            in_form.root e)
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     Field.on_leave
                       (fun e ->
                         in_form.left ();
                         on_blur e)
                       e)
      data_slot=(Jsx.data f.slot)
      data_disabled=(Jsx.flag (S.get disabled))
      data_invalid=(Jsx.flag (S.get invalid))
      data_readonly=(Jsx.flag (S.get is_read_only))
      data_required=(Jsx.flag (S.get is_required))
      ?as_=(Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Kobalte.HiddenInput />
      <Field_error.Message.Provider value=in_form.error>
        <Button.Step.Provider value=steppers>
          <Parts label_id>(Jsx.draw (S.get children) (state ()))</Parts>
        </Button.Step.Provider>
      </Field_error.Message.Provider>
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
