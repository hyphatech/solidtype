module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.NumberField
module I18n = Solidtype_kobalte.I18n
module Types = Solidtype_kobalte.Types

(* What a field's parts read of it: its classes and its state. *)
type field = {
  slots : unit -> Styles.NumberField.slots;
  disabled : unit -> bool;
  invalid : unit -> bool;
  label_id : string;
  current : unit -> float;
  can_increment : unit -> bool;
  can_decrement : unit -> bool;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = field
end)

(* The decimals [x] is written with, a 1e-7 as a 0.0000001: the precision a
   value on a grid of its step, counted from its minimum, is rounded to. *)
let decimals x =
  let s = Js.Float.toString (Float.abs x) in
  let after_point m =
    match String.index_opt m '.' with
    | Some i -> String.length m - i - 1
    | None -> 0
  in
  match String.index_opt s 'e' with
  | Some i -> (
      let mantissa = String.sub s 0 i in
      match
        int_of_string_opt (String.sub s (i + 1) (String.length s - i - 1))
      with
      | Some e when e < 0 -> after_point mantissa - e
      | Some _ | None -> after_point mantissa)
  | None -> after_point s

(* A value on its step's grid, counted from the minimum, within the range: to
   the nearer step, a value halfway to the step away from the minimum, and
   below the maximum to the last step that fits. A count of steps is a float
   divided, so it is first rounded to nine decimals, which drops a division's
   noise and keeps any count a field reaches; the value is then written with
   the decimals of its step and its minimum, so a tenth added to 0.2 is 0.3.
   A step that is not positive is no grid: the value is kept within the
   range alone. *)
let snap ~min ~max ~step value =
  let within v =
    match (min, max) with
    | Some m, _ when v < m -> m
    | _, Some m when v > m -> m
    | _ -> v
  in
  if not (step > 0.) then within value
  else
    let base = Option.value min ~default:0. in
    let precision = Int.max (decimals step) (decimals base) in
    let written x =
      Js.Float.fromString (Js.Float.toFixed ~digits:precision x)
    in
    let steps x =
      Js.Float.fromString (Js.Float.toFixed ~digits:9 ((x -. base) /. step))
    in
    let near = written (base +. (Float.round (steps value) *. step)) in
    match (min, max) with
    | Some m, _ when near < m -> m
    | _, Some m when near > m ->
        written (base +. (Float.floor (steps m) *. step))
    | _ -> near

let within part =
  match Context.use () with
  | Some f -> f
  | None -> invalid_arg (part ^ " is used inside a Number_field")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Parts = Field.Slots (struct
  let label = Kobalte.Label.component
  let description = Kobalte.Description.component
  let error = Kobalte.ErrorMessage.component
end)

module Group = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let f = within "Number_field.Group" in
    (* Hovered and focused within as React Aria's group is, which HeroUI's
       styles ring. *)
    let i = Interaction.create ~disabled:(fun[@u] () -> f.disabled ()) () in
    <div
      role=`group
      ?aria_invalid=(fun () -> if f.invalid () then Some "true" else None)
      ref=(fun e -> Interaction.watch i e)
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_focus_within=(fun () -> Jsx.flag (Interaction.focused i))
      class_=(fun () ->
               after (Styles.NumberField.group (f.slots ())) (class_ ()))
      data_slot="number-field-group"
      data_disabled=(fun () -> Jsx.flag (f.disabled ()))
      data_invalid=(fun () -> Jsx.flag (f.invalid ()))
      props=(Props.others props)>
      (fun () -> children ())
    </div>
end

module Input = struct
  let%component make ?(placeholder : string option) ?(class_ : string option) ()
      =
    let f = within "Number_field.Input" in
    let i = Interaction.create ~disabled:(fun[@u] () -> f.disabled ()) () in
    (* Kobalte's input tells its value now as the text it shows once the value
       changes, a "51%"; React Aria's tells the number. *)
    <Kobalte.Input
      ?placeholder
      class_=(fun () ->
               after (Styles.NumberField.input (f.slots ())) (class_ ()))
      ref=(fun e -> Interaction.watch i e)
      ?aria_valuenow=(fun () ->
                       let v = f.current () in
                       if Float.is_nan v then None
                       else Some (Js.Float.toString v))
      data_slot="number-field-input"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (f.disabled ()))
      data_invalid=(fun () -> Jsx.flag (f.invalid ()))
      props=(Props.others props)
    />
end

(* HeroUI's own plus and minus, drawn where a button is given no children. *)
let icon ~slot ~d =
  <svg
    aria_hidden=true
    fill="none"
    height="16"
    role=`presentation
    view_box="0 0 16 16"
    width="16"
    xmlns="http://www.w3.org/2000/svg"
    data_slot=(fun () -> Jsx.data slot)>
    <path
      clip_rule="evenodd"
      d=(fun () -> d)
      fill="currentColor"
      fill_rule="evenodd"
    />
  </svg>

let plus =
  "M8 1.75a.75.75 0 0 1 .75.75v4.75h4.75a.75.75 0 0 1 0 1.5H8.75v4.75a.75.75 0 \
   0 1-1.5 0V8.75H2.5a.75.75 0 0 1 0-1.5h4.75V2.5A.75.75 0 0 1 8 1.75"

let minus =
  "M1.75 8a.75.75 0 0 1 .75-.75h11a.75.75 0 0 1 0 1.5h-11A.75.75 0 0 1 1.75 8"

module Increment_button = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let f = within "Number_field.Increment_button" in
    let disabled () = not (f.can_increment ()) in
    let i = Interaction.create ~disabled:(fun[@u] () -> disabled ()) () in
    (* Named "Increase" and by the field's label, as React Aria's is. *)
    let id = Solidtype.Solid.create_unique_id () in
    <Kobalte.IncrementTrigger
      id=(fun () -> id)
      aria_label="Increase"
      aria_labelledby=(fun () -> id ^ " " ^ f.label_id)
      class_=(fun () ->
               after
                 (Styles.NumberField.increment_button (f.slots ()))
                 (class_ ()))
      slot="increment"
      ref=(fun e -> Interaction.watch i e)
      data_slot="number-field-increment-button"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      disabled=(fun () -> disabled ())
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
      props=(Props.others props)>
      <Show
        when_=(fun () -> Option.is_some (children ()))
        fallback=(fun () ->
                   icon ~slot:"number-field-increment-button-icon" ~d:plus)>
        (fun () -> match children () with Some c -> c | None -> Jsx.string "")
      </Show>
    </Kobalte.IncrementTrigger>
end

module Decrement_button = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let f = within "Number_field.Decrement_button" in
    let disabled () = not (f.can_decrement ()) in
    let i = Interaction.create ~disabled:(fun[@u] () -> disabled ()) () in
    (* Named "Decrease" and by the field's label, as React Aria's is. *)
    let id = Solidtype.Solid.create_unique_id () in
    <Kobalte.DecrementTrigger
      id=(fun () -> id)
      aria_label="Decrease"
      aria_labelledby=(fun () -> id ^ " " ^ f.label_id)
      class_=(fun () ->
               after
                 (Styles.NumberField.decrement_button (f.slots ()))
                 (class_ ()))
      slot="decrement"
      ref=(fun e -> Interaction.watch i e)
      data_slot="number-field-decrement-button"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      disabled=(fun () -> disabled ())
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
      props=(Props.others props)>
      <Show
        when_=(fun () -> Option.is_some (children ()))
        fallback=(fun () ->
                   icon ~slot:"number-field-decrement-button-icon" ~d:minus)>
        (fun () -> match children () with Some c -> c | None -> Jsx.string "")
      </Show>
    </Kobalte.DecrementTrigger>
end

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(full_width : bool option) ?(value : float option)
    ?(default_value : float option) ?(on_change : (float -> unit) option)
    ?(min_value : float option) ?(max_value : float option)
    ?(step : float option) ?(is_disabled : bool option)
    ?(is_invalid : bool = false) ?(is_read_only : bool = false)
    ?(is_required : bool = false) ?(name : string option)
    ?(aria_label : string option) ?(class_ : string option)
    ?(format_options : Types.NumberFormatOptions.t option)
    ?(on_blur : (Dom.focusEvent -> unit) option) ~(children : Jsx.content) () =
  (* A field is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let disabled () =
    match is_disabled () with Some d -> d | None -> in_fieldset ()
  in
  (* A value is on the grid of a step it is given, else within its range
     alone, as React Aria keeps it; a button steps it by the step, else by 1,
     or by a percent's hundredth. *)
  let snapped v =
    if Float.is_nan v then v
    else
      snap ~min:(min_value ()) ~max:(max_value ())
        ~step:(Option.value (step ()) ~default:0.)
        v
  in
  let by () =
    match (step (), format_options ()) with
    | Some s, _ -> s
    | None, Some o -> (
        match Types.NumberFormatOptions.style o with
        | Some `percent -> 0.01
        | Some (`decimal | `currency | `unit) | None -> 1.)
    | None, None -> 1.
  in
  (* The value is the field's, on its step's grid within its range, as
     HeroUI's field keeps it, and Kobalte is given it: Kobalte snaps nothing,
     nor stops at a bound. Empty is not a number. *)
  let current, set =
    Field.controlled
      ~value:(fun () -> Option.map snapped (value ()))
      ~default:(snapped (Option.value (default_value ()) ~default:Float.nan))
      ~on_change
  in
  let in_form = Form.field ~name ~invalid:(fun () -> is_invalid ()) in
  let invalid () = is_invalid () || Option.is_some (in_form.error ()) in
  let change v =
    let v = snapped v in
    let now = current () in
    if not (Float.equal v now || (Float.is_nan v && Float.is_nan now)) then (
      in_form.changed ();
      set v)
  in
  (* A button steps the value while its step would move it. *)
  let can moved () =
    (not (disabled () || is_read_only ()))
    &&
    let now = current () in
    Float.is_nan now || not (Float.equal (snapped (moved now)) now)
  in
  (* Kobalte shows the value as its options say but tells a reader the bare
     number; a formatted field tells it as it shows it. *)
  let formatter =
    I18n.create_number_formatter
      (Types.Either.right (fun[@u] () ->
           match format_options () with
           | Some o -> o
           | None -> Types.NumberFormatOptions.make ()))
  in
  let text_value () =
    let now = current () in
    match format_options () with
    | Some _ when not (Float.is_nan now) ->
        Some (Types.NumberFormat.format (Solidtype.Solid.get formatter) now)
    | Some _ | None -> None
  in
  let label_id = Solidtype.Solid.create_unique_id () in
  let f =
    {
      label_id;
      current;
      slots =
        (fun () ->
          Styles.NumberField.slots
            (Styles.NumberField.options ?full_width:(full_width ())
               ?variant:(variant ()) ()));
      disabled;
      invalid;
      can_increment = can (fun v -> v +. by ());
      can_decrement = can (fun v -> v -. by ());
    }
  in
  <Context.Provider value=(fun () -> f)>
    <Kobalte.Root
      raw_value=(fun () -> current ())
      on_raw_value_change=change
      ?min_value
      ?max_value
      step=(fun () -> by ())
      validation_state=(fun () -> if invalid () then `invalid else `valid)
      required=(fun () -> is_required ())
      disabled=(fun () -> disabled ())
      read_only=(fun () -> is_read_only ())
      ?name
      ?aria_label
      ?format_options
      ?text_value
      class_=(fun () ->
               after (Styles.NumberField.base (f.slots ())) (class_ ()))
      ref=(fun e -> in_form.root e)
      on_focus_out=(Field.on_leave (fun e ->
                        in_form.left ();
                        on_blur e))
      data_slot="number-field"
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      data_invalid=(fun () -> Jsx.flag (invalid ()))
      data_readonly=(fun () -> Jsx.flag (is_read_only ()))
      data_required=(fun () -> Jsx.flag (is_required ()))
      props=(Props.others props)>
      <Kobalte.HiddenInput />
      <Field_error.Message.Provider value=(fun () -> in_form.error)>
        <Parts label_id=(fun () -> label_id)>(fun () -> children ())</Parts>
      </Field_error.Message.Provider>
    </Kobalte.Root>
  </Context.Provider>
