module Jsx = Solidtype.Jsx
module Solid = Solidtype.Solid
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.Accordion
module Types = Solidtype_kobalte.Types
module Gravity = Solidtype_gravity_icons

(* What an accordion's parts read of it: its classes, the keys expanded, and
   each item's own change, told by its key. *)
type accordion = {
  slots : Styles.Accordion.slots Solid.accessor;
  hide_separator : bool Solid.accessor;
  is_expanded : string -> bool;
  expand : string -> unit;
  disabled : bool Solid.accessor;
  told : (string, bool -> unit) Hashtbl.t;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = accordion
end)

(* What an item's parts read of it: its state, and the id its trigger
   controls. *)
type item = {
  key : string;
  expanded : bool Solid.accessor;
  item_disabled : bool Solid.accessor;
  content_id : string;
  disable_trigger : bool -> unit;
      (* Tells the item its trigger is disabled of its own, which Kobalte's
         list skips by the arrows only as the item's. *)
}

module Item_context = Solidtype.Context.Make_optional (struct
  type t = item
end)

let within part =
  match Context.use () with
  | Some a -> a
  | None -> invalid_arg (part ^ " is used inside an Accordion")

let within_item part =
  match (Context.use (), Item_context.use ()) with
  | Some a, Some i -> (a, i)
  | None, _ | _, None -> invalid_arg (part ^ " is used inside an Accordion.Item")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

module Item = struct
  type state = {
    is_expanded : bool Solid.accessor;
    is_focus_visible_within : bool Solid.accessor;
    is_disabled : bool Solid.accessor;
  }

  let%component make ?(id : string option) ?(is_disabled : bool = false)
      ?(on_expanded_change : (bool -> unit) option) ?(class_ : string option)
      ?(on_focus_in : (Dom.focusEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let a = within "Accordion.Item" in
    let key =
      match Solid.get id with Some k -> k | None -> Solid.create_unique_id ()
    in
    Hashtbl.replace a.told key (fun v ->
        ignore (on_expanded_change v : unit option));
    Solid.on_cleanup (fun () -> Hashtbl.remove a.told key);
    let disabled =
      Solid.accessor (fun () -> Solid.get is_disabled || Solid.get a.disabled)
    in
    (* Kobalte names an item's panel after the item, and takes no id given the
       panel itself. *)
    let item_id = Solid.create_unique_id () in
    (* Kobalte's triggers take focus by the arrows only while its list knows it
       has focus, which its root never tells it: each item does, as focus comes
       in, and the root's own focus out takes it back. *)
    let list =
      Types.AccordionContextValue.list_state (Kobalte.use_accordion_context ())
    in
    let focus_in e =
      ignore (on_focus_in e : unit option);
      Types.SelectionManager.set_focused
        (Solid.get (Types.ListState.selection_manager (Solid.get list)))
        true
    in
    let trigger_disabled, disable_trigger = Solid.create_signal false in
    (* Its focus, within it, whether or not it is disabled. *)
    let focus = Interaction.create () in
    let i =
      {
        key;
        expanded = Solid.accessor (fun () -> a.is_expanded key);
        item_disabled = disabled;
        content_id = item_id ^ "-content";
        disable_trigger = Solid.set disable_trigger;
      }
    in
    (* Kobalte's panel is kept on the page while collapsed, which HeroUI's
       styles shrink to nothing and find in page reaches. *)
    let state () =
      {
        is_expanded = i.expanded;
        is_focus_visible_within =
          Solid.accessor (fun () -> Interaction.focus_visible focus);
        is_disabled = disabled;
      }
    in
    <Kobalte.Item
      id=(fun () -> item_id)
      value=(fun () -> key)
      disabled=(fun () -> Solid.get disabled || Solid.get trigger_disabled)
      force_mount=true
      on_focus_in=focus_in
      class_=(fun () ->
               after
                 (Styles.Accordion.item (Solid.get a.slots))
                 (Solid.get class_))
      data_expanded=(fun () -> Jsx.flag (Solid.get i.expanded))
      data_disabled=(fun () -> Jsx.flag (Solid.get disabled))
      data_hide_separator=(fun () -> Jsx.flag (Solid.get a.hide_separator))
      data_slot="accordion-item"
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch focus e)
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (Solid.get as_))
      props=(Props.others props)>
      <Item_context.Provider value=(fun () -> i)>
        (fun () -> Jsx.draw (Solid.get children) (state ()))
      </Item_context.Provider>
    </Kobalte.Item>
  [@@element div]
end

module Heading = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a, i = within_item "Accordion.Heading" in
    (* A button with the trigger's slot is Kobalte's trigger, as React Aria's
       disclosure gives its ButtonContext's trigger slot. *)
    let trigger =
      {
        Button.component = Kobalte.Trigger.component;
        is_disabled = Some (fun () -> Solid.get i.item_disabled);
        controls = Some i.content_id;
        described_by = None;
        pressed = None;
        needs_slot = true;
        element = None;
      }
    in
    <Kobalte.Header
      class_=(fun () ->
               after
                 (Styles.Accordion.heading (Solid.get a.slots))
                 (Solid.get class_))
      data_slot="accordion-heading"
      props=(Props.others props)>
      <Button.Trigger.Provider value=(fun () -> trigger)>
        (fun () -> Solid.get children)
      </Button.Trigger.Provider>
    </Kobalte.Header>
  [@@element h3]
end

external queue_microtask : (unit -> unit) -> unit = "queueMicrotask"
external detail : Dom.mouseEvent -> int = "detail" [@@mel.get]
external key : Dom.keyboardEvent -> string = "key" [@@mel.get]
external repeat : Dom.keyboardEvent -> bool = "repeat" [@@mel.get]

module Trigger = struct
  type state = {
    is_hovered : bool Solid.accessor;
    is_pressed : bool Solid.accessor;
    is_focused : bool Solid.accessor;
    is_focus_visible : bool Solid.accessor;
    is_disabled : bool Solid.accessor;
  }

  let%component make ?(on_press : (unit -> unit) option)
      ?(is_disabled : bool = false) ?(class_ : string option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?(on_key_down : (Dom.keyboardEvent -> unit) option)
      ?(on_key_up : (Dom.keyboardEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
      () =
    let a, i = within_item "Accordion.Trigger" in
    let disabled =
      Solid.accessor (fun () ->
          Solid.get i.item_disabled || Solid.get is_disabled)
    in
    Solid.create_computed (fun () -> i.disable_trigger (Solid.get is_disabled));
    let n = Interaction.create ~disabled:(fun () -> Solid.get disabled) () in
    (* A press as React Aria tells it: a pointer's click, after Kobalte has
       toggled the item, or Enter or Space let go where it went down, which
       Kobalte toggles by as it goes down, keeping the browser's click. *)
    let press () = ignore (on_press () : unit option) in
    let key_down = ref None in
    let state () =
      {
        is_hovered = Solid.accessor (fun () -> Interaction.hovered n);
        is_pressed = Solid.accessor (fun () -> Interaction.pressed n);
        is_focused = Solid.accessor (fun () -> Interaction.focused n);
        is_focus_visible =
          Solid.accessor (fun () -> Interaction.focus_visible n);
        is_disabled = Solid.accessor (fun () -> Interaction.disabled n);
      }
    in
    <Kobalte.Trigger
      disabled=(fun () -> Solid.get disabled)
      on_click=(fun e ->
                 ignore (on_click e : unit option);
                 if detail e > 0 then queue_microtask press)
      on_key_down=(fun e ->
                    ignore (on_key_down e : unit option);
                    match key e with
                    | ("Enter" | " ") as k when not (repeat e) ->
                        key_down := Some k
                    | _ -> ())
      on_key_up=(fun e ->
                  ignore (on_key_up e : unit option);
                  match !key_down with
                  | Some k when String.equal k (key e) ->
                      key_down := None;
                      press ()
                  | Some _ | None -> ())
      class_=(fun () ->
               after
                 (Styles.Accordion.trigger (Solid.get a.slots))
                 (Solid.get class_))
      aria_controls=(fun () -> i.content_id)
      slot="trigger"
      ref=(fun b ->
            ignore (given_ref b : unit option);
            Interaction.watch n b)
      data_slot="accordion-trigger"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered n))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed n))
      data_focused=(fun () -> Jsx.flag (Interaction.focused n))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible n))
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled n))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (Solid.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (Solid.get children) (state ()))
    </Kobalte.Trigger>
  [@@element button]
end

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let a, i = within_item "Accordion.Indicator" in
    let classes () =
      after (Styles.Accordion.indicator (Solid.get a.slots)) (Solid.get class_)
    in
    (* HeroUI gives an icon of the user's its classes; a Solid component cannot
       add them to an element already made, so the span around it takes them,
       and turns over in its place. *)
    <Show
      when_=(fun () -> Option.is_some (Solid.get children))
      fallback=(<Gravity.Chevron_down
                  aria_hidden=true
                  class_=(fun () -> classes ())
                  role=`presentation
                  data_expanded=(fun () -> Jsx.flag (Solid.get i.expanded))
                  data_slot="accordion-indicator"
                  props=(Props.others props)
                />)>
      <span
        class_=(fun () -> classes ())
        data_expanded=(fun () -> Jsx.flag (Solid.get i.expanded))
        data_slot="accordion-indicator"
        props=(Props.others props)>
        (fun () ->
          match Solid.get children with Some c -> c | None -> Jsx.string "")
      </span>
    </Show>
  [@@element svg]
end

module Panel = struct
  type state = { is_focus_visible_within : bool Solid.accessor }

  let%component make ?(class_ : string option) ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let a, i = within_item "Accordion.Panel" in
    (* Its focus, within it. *)
    let focus = Interaction.create () in
    let panel =
      Panel.create
        ~expanded:(fun () -> Solid.get i.expanded)
        ~expand:(fun () -> a.expand i.key)
        ()
    in
    let state () =
      {
        is_focus_visible_within =
          Solid.accessor (fun () -> Interaction.focus_visible focus);
      }
    in
    <Kobalte.Content
      class_=(fun () ->
               after
                 (Styles.Accordion.panel (Solid.get a.slots))
                 (Solid.get class_))
      aria_hidden=(fun () -> not (Solid.get i.expanded))
      ?hidden=(Jsx.attr (fun () -> Panel.hidden panel))
      style=(fun () ->
              match Solid.get style with
              | Some s -> Panel.style panel ^ "; " ^ s
              | None -> Panel.style panel)
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch focus e;
            Panel.watch panel e)
      data_expanded=(fun () -> Jsx.flag (Solid.get i.expanded))
      data_slot="accordion-panel"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (Solid.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (Solid.get children) (state ()))
    </Kobalte.Content>
  [@@element div]
end

module Body = struct
  let%component make ?(class_ : string option) ~(children : Jsx.content) () =
    let a, (_ : item) = within_item "Accordion.Body" in
    <div
      class_=(fun () -> Styles.Accordion.body (Solid.get a.slots))
      data_slot="accordion-body"
      props=(Props.others props)>
      <div
        class_=(fun () ->
                 after
                   (Styles.Accordion.body_inner (Solid.get a.slots))
                   (Solid.get class_))>
        (fun () -> Solid.get children)
      </div>
    </div>
  [@@element div]
end

type state = { is_disabled : bool Solid.accessor }

let%component make ?(expanded_keys : string array option)
    ?(default_expanded_keys : string array = [||])
    ?(on_expanded_change : (string array -> unit) option)
    ?(allows_multiple_expanded : bool = false) ?(is_disabled : bool = false)
    ?(variant : [ `default | `surface ] = `default)
    ?(hide_separator : bool = false) ?(class_ : string option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  let keys, set_keys =
    Field.controlled
      ~value:(fun () -> Solid.get expanded_keys)
      ~default:(Solid.get default_expanded_keys)
      ~on_change:(fun k -> on_expanded_change k)
  in
  let has keys key = Array.exists (String.equal key) keys in
  let told = Hashtbl.create 8 in
  (* The item a change expands, else the one it collapses, is told after the
     accordion, as React Aria tells the disclosure whose trigger was pressed
     and no other. *)
  let change now =
    let before = Solid.get keys in
    set_keys now;
    let tell key expanded =
      match Hashtbl.find_opt told key with Some f -> f expanded | None -> ()
    in
    match
      ( Array.find_opt (fun k -> not (has before k)) now,
        Array.find_opt (fun k -> not (has now k)) before )
    with
    | Some k, _ -> tell k true
    | None, Some k -> tell k false
    | None, None -> ()
  in
  let expand key =
    let now = Solid.get keys in
    if not (has now key) then
      change
        (if Solid.get allows_multiple_expanded then Array.append now [| key |]
         else [| key |])
  in
  let a =
    {
      slots =
        Solid.accessor (fun () ->
            Styles.Accordion.slots
              (Styles.Accordion.options ~variant:(Solid.get variant) ()));
      hide_separator;
      is_expanded = (fun key -> has (Solid.get keys) key);
      expand;
      disabled = is_disabled;
      told;
    }
  in
  let state () = { is_disabled } in
  (* Collapsible, since HeroUI's every item collapses as it expands; made
     where it is shown, so it reads the surface given there. *)
  let accordion () =
    <Kobalte.Root
      class_=(fun () ->
               after
                 (Styles.Accordion.base (Solid.get a.slots))
                 (Solid.get class_))
      data_disabled=(fun () -> Jsx.flag (Solid.get is_disabled))
      data_slot="accordion"
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (Solid.get as_))
      props=(Props.others props)
            (* Kobalte's options come after the rest, which may hold a DOM
         attribute of the same name, on_change, that would replace them. *)
      value=(fun () -> Solid.get keys)
      on_change=change
      multiple=(fun () -> Solid.get allows_multiple_expanded)
      collapsible=true>
      <Context.Provider value=(fun () -> a)>
        (fun () -> Jsx.draw (Solid.get children) (state ()))
      </Context.Provider>
    </Kobalte.Root>
  in
  let surface = Solid.accessor (fun () -> `default) in
  (* A surface accordion is a surface to what is inside it, as HeroUI's is. *)
  <Show
    when_=(fun () ->
            match Solid.get variant with `surface -> true | `default -> false)
    fallback=(fun () -> accordion ())>
    <Surface.Context.Provider value=(fun () -> surface)>
      (fun () -> Jsx.element (accordion ()))
    </Surface.Context.Provider>
  </Show>
[@@element div]
