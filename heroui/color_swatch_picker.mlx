module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Headless = Solidtype_headless.Color_swatch_picker
module Color = Solidtype_kobalte.Types.Color

module Context = Solidtype.Context.Make_optional (struct
  type t = Styles.ColorSwatchPicker.slots S.accessor
end)

let within part =
  match Context.use () with
  | Some slots -> slots
  | None -> invalid_arg (part ^ " is used inside a Color_swatch_picker")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* How light a colour is, from black at 0 to white at 1, by its channels'
   weights for the eye; what HeroUI draws a checkmark black over, past a
   half. *)
let luminance c =
  match Color.to_format_opt c `rgb with
  | None -> 0.
  | Some rgb -> (
      let channel name =
        Option.value (Color.get_channel_value_opt rgb name) ~default:0.
      in
      match (channel `red, channel `green, channel `blue) with
      | r, g, b -> ((0.2126 *. r) +. (0.7152 *. g) +. (0.0722 *. b)) /. 255.)

module Item = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_selected : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    color : Color.t Solidtype.Solid.accessor;
  }

  let%component make ~(color : Color.t) ?(is_disabled : bool option)
      ?(class_ : string option) ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let slots = within "Color_swatch_picker.Item" in
    let disabled () = Option.value (S.get is_disabled) ~default:false in
    let i = Interaction.create ~disabled:(fun () -> disabled ()) () in
    (* HeroUI's styles border a chosen swatch in its colour, read from a
       variable of their own. *)
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_pressed = S.accessor (fun () -> Interaction.pressed i);
        is_selected =
          S.accessor (fun () ->
              S.get (Headless.Item.Context.use ()).is_selected);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = S.accessor (fun () -> disabled ());
        color;
      }
    in
    <Headless.Item
      color=(fun () -> S.get color)
      is_disabled=(fun () -> disabled ())
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(fun () ->
               after
                 (Styles.ColorSwatchPicker.item (S.get slots))
                 (S.get class_))
      style=(fun () ->
              "--color-swatch-current: "
              ^ Color.to_string (S.get color) ~format:`rgba ()
              ^ match S.get style with Some s -> "; " ^ s | None -> "")
      data_slot="color-swatch-picker-item"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focused=(fun () -> Jsx.flag (Interaction.focused i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_selected=(fun () ->
                      Jsx.flag
                        (S.get (Headless.Item.Context.use ()).is_selected))
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </Headless.Item>
  [@@element div]
end

module Swatch = struct
  let%component make ?(color_name : string option) ?(class_ : string option) ()
      =
    let slots = within "Color_swatch_picker.Swatch" in
    <Headless.Swatch
      ?color_name
      class_=(fun () ->
               after
                 (Styles.ColorSwatchPicker.swatch (S.get slots))
                 (S.get class_))
      data_slot="color-swatch-picker-swatch"
      props=(Props.others props)
    />
  [@@element div]
end

module Indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let slots = within "Color_swatch_picker.Indicator" in
    let item = Headless.Item.Context.use () in
    <span
      aria_hidden=true
      class_=(fun () ->
               after
                 (Styles.ColorSwatchPicker.indicator (S.get slots))
                 (S.get class_))
      data_light_color=(fun () -> Jsx.flag (luminance (S.get item.color) > 0.5))
      data_slot="color-swatch-picker-indicator"
      props=(Props.others props)>
      (fun () ->
        match S.get children with
        | Some given -> given
        | None ->
            Jsx.element
              <svg
                aria_hidden=true
                data_slot="color-swatch-picker-checkmark"
                fill="none"
                role=`presentation
                stroke="currentColor"
                stroke_linecap="round"
                stroke_linejoin="round"
                stroke_width="1.5"
                view_box="0 0 12 12">
                <polyline points="2.5 6 5 8.5 9.5 3" />
              </svg>)
    </span>
  [@@element span]
end

let%component make ?(value : Color.t option) ?(default_value : Color.t option)
    ?(on_change : (Color.t -> unit) option)
    ?(size : [ `xs | `sm | `md | `lg | `xl ] option)
    ?(variant : [ `circle | `square ] option)
    ?(layout : [ `grid | `stack ] option) ?(aria_label : string option)
    ?(aria_labelledby : string option) ?(class_ : string option)
    ~(children : Jsx.content) () =
  let slots =
    S.accessor (fun () ->
        Styles.ColorSwatchPicker.slots
          (Styles.ColorSwatchPicker.options ?layout:(S.get layout)
             ?size:(S.get size) ?variant:(S.get variant) ()))
  in
  <Context.Provider value=(fun () -> slots)>
    <Headless.Root
      ?value
      ?default_value
      on_change=(fun c -> ignore (on_change c : unit option))
      ?layout
      ?aria_label
      ?aria_labelledby
      class_=(fun () ->
               after
                 (Styles.ColorSwatchPicker.base (S.get slots))
                 (S.get class_))
      data_slot="color-swatch-picker"
      props=(Props.others props)>
      (fun () -> S.get children)
    </Headless.Root>
  </Context.Provider>
[@@element div]
