include Date_root

module Trigger = struct
  let%component make ?(class_ : string option) ~(children : Jsx.element)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option) () =
    let p = Headless.Context.use () in
    let l = look () in
    let disabled () = S.get p.is_disabled || S.get p.is_read_only in
    let i = Interaction.create ~disabled () in
    <Headless.Trigger
      ref=(fun e ->
            ignore (given_ref e : unit option);
            Interaction.watch i e)
      class_=(after l.trigger (S.get class_))
      data_slot=(Jsx.data (l.name ^ "-trigger"))
      data_hovered=(Jsx.flag (Interaction.hovered i))
      data_pressed=(Jsx.flag (Interaction.pressed i || S.get p.is_open))
      data_focused=(Jsx.flag (Interaction.focused i))
      data_focus_visible=(Jsx.flag (Interaction.focus_visible i))
      data_disabled=(Jsx.flag (disabled ()))
      ?tabindex=(if disabled () then None else Some "0")
      props=(Props.others props)>
      (S.get children)
    </Headless.Trigger>
  [@@element button]
end

module Trigger_indicator = struct
  let%component make ?(class_ : string option) ?(children : Jsx.element option)
      () =
    <span
      aria_hidden=true
      class_=(after (look ()).trigger_indicator (S.get class_))
      data_slot=(Jsx.data ((look ()).name ^ "-trigger-indicator"))
      props=(Props.others props)>
      (match S.get children with
      | Some c -> c
      | None ->
          <svg
            aria_hidden=true
            fill="none"
            height="1em"
            role=`presentation
            view_box="0 0 13 14"
            width="1em"
            xmlns="http://www.w3.org/2000/svg">
            <path
              clip_rule="evenodd"
              d="M3.75 4.5A.75.75 0 0 1 3 3.75v-.748a1.5 1.5 0 0 0-1.5 \
                 1.5v1h10v-1a1.5 1.5 0 0 0-1.5-1.5v.75a.75.75 0 1 1-1.5 \
                 0v-.75h-4v.747a.75.75 0 0 1-.75.75ZM8.5 1.501h-4V.75a.75.75 0 \
                 0 0-1.5 0v.752a3 3 0 0 0-3 3v6a3 3 0 0 0 3 3h7a3 3 0 0 0 \
                 3-3v-6a3 3 0 0 0-3-3v-.75a.75.75 0 0 0-1.5 0v.75Zm-7 \
                 5.5v3.5a1.5 1.5 0 0 0 1.5 1.5h7a1.5 1.5 0 0 0 \
                 1.5-1.5v-3.5h-10Z"
              fill="currentColor"
              fill_rule="evenodd"
            />
          </svg>)
    </span>
  [@@element span]
end

module Popover = struct
  let%component make ?(placement : [ `top | `bottom | `left | `right ] option)
      ?(offset : float option) ?(class_ : string option)
      ?(style : string option)
      ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
      ~(children : Jsx.element) () =
    let p = Headless.Context.use () in
    let l = look () in
    let o = Overlay.create ~is_open:(fun () -> S.get p.is_open) () in
    let kobalte_placement () =
      match Option.value (S.get placement) ~default:`bottom with
      | `top -> "top"
      | `bottom -> "bottom"
      | `left -> "left"
      | `right -> "right"
    in
    let side, watch_side =
      Overlay.placed_side ~placement:kobalte_placement ()
    in
    <Surface.Context.Provider value=(S.accessor (fun () -> `default))>
      <Headless.Content
        placement=(kobalte_placement ())
        ?offset=(S.get offset)
        kept=(Overlay.present o)
        class_=(after l.popover (S.get class_))
        style=("--trigger-width: var(--kb-popper-anchor-width); \
                --trigger-anchor-point: \
                var(--kb-popover-content-transform-origin);"
              ^ match S.get style with Some s -> " " ^ s | None -> "")
        ref=(fun e ->
              ignore (given_ref e : unit option);
              Overlay.watch o e;
              watch_side e)
        data_slot=(Jsx.data (l.name ^ "-popover"))
        data_placement=(Jsx.data (S.get side))
        data_entering=(Jsx.flag (Overlay.entering o))
        data_exiting=(Jsx.flag (Overlay.exiting o))
        props=(Props.others props)>
        (S.get children)
      </Headless.Content>
    </Surface.Context.Provider>
  [@@element div]
end
