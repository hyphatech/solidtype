module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

type variant = [ `default | `secondary | `tertiary | `transparent ]

module Context = Solidtype.Context.Make_optional (struct
  type t = variant S.accessor
end)

let%component make ?(variant : variant = `default) ?(class_ : string option)
    ~(children : Jsx.element) () =
  <Context.Provider value=variant>
    <div
      class_=(Styles.Surface.classes
                (Styles.Surface.options ~variant:(S.get variant)
                   ?class_:(S.get class_) ()))
      data_slot="surface"
      props=(Props.others props)>
      (S.get children)
    </div>
  </Context.Provider>
[@@element div]
