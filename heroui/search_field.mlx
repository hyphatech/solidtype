module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Kobalte = Solidtype_kobalte.TextField
module Kobalte_button = Solidtype_kobalte.Button
module Kobalte_combo_box = Solidtype_kobalte.Combobox
module Gravity = Solidtype_gravity_icons

external prevent_default : Dom.keyboardEvent -> unit = "preventDefault"
[@@mel.send]

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]
external focus : Dom.htmlInputElement -> unit = "focus" [@@mel.send]

external prevent_pointer : Dom.pointerEvent -> unit = "preventDefault"
[@@mel.send]

(* What a field's parts read of it: its classes, its value and state, and its
   input, which a clear gives the focus back to. *)
type field = {
  slots : Styles.SearchField.slots S.accessor;
  value : string S.accessor;
  clear : unit -> unit;
  submit : unit -> unit;
  disabled : bool S.accessor;
  invalid : bool S.accessor;
  read_only : bool S.accessor;
  input : Dom.htmlInputElement option ref;
  search : Autocomplete.Search.t option;
  name : string option S.accessor;
  aria_label : string option S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = field
end)

let within part =
  match Context.use () with
  | Some f -> f
  | None -> invalid_arg (part ^ " is used inside a Search_field")

(* A class added after HeroUI's own, as React's className is. *)
let after base = function Some c -> base ^ " " ^ c | None -> base

(* Whether an option of an autocomplete holds the focus, which stays in its
   search: React Aria's search shows it is not focused meanwhile. *)
let elsewhere f =
  match f.search with
  | Some (s : Autocomplete.Search.t) -> S.get s.elsewhere
  | None -> false

let returned f =
  match f.search with
  | Some (s : Autocomplete.Search.t) -> S.get s.returned
  | None -> false

module Parts = Field.Slots (struct
  let label = Kobalte.Label.component
  let description = Kobalte.Description.component
  let error = Kobalte.ErrorMessage.component
end)

module Group = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_focus_within : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
    is_invalid : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option) ~(children : state Jsx.children)
      ?(as_ :
         (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option) ()
      =
    let f = within "Search_field.Group" in
    (* Hovered, focused within and focus-visible as React Aria's group is,
       which HeroUI's styles ring. *)
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_focus_within =
          S.accessor (fun () -> Interaction.focused i && not (elsewhere f));
        is_focus_visible =
          S.accessor (fun () ->
              (Interaction.focus_visible i
              || (Interaction.focused i && returned f))
              && not (elsewhere f));
        is_disabled = f.disabled;
        is_invalid = f.invalid;
      }
    in
    <div
      role=`group
      ref=(fun e -> Interaction.watch i e)
      class_=(fun () ->
               after (Styles.SearchField.group (S.get f.slots)) (S.get class_))
      data_slot="search-field-group"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_focus_within=(fun () ->
                          Jsx.flag (Interaction.focused i && not (elsewhere f)))
      data_focus_visible=(fun () ->
                           Jsx.flag
                             ((Interaction.focus_visible i
                              || (Interaction.focused i && returned f))
                             && not (elsewhere f)))
      data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
      data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      (fun () -> Jsx.draw (S.get children) (state ()))
    </div>
  [@@element div]
end

module Search_icon = struct
  let%component make ?(class_ : string option) ?(children : Jsx.content option)
      () =
    let f = within "Search_field.Search_icon" in
    let classes () =
      after (Styles.SearchField.search_icon (S.get f.slots)) (S.get class_)
    in
    <Show
      when_=(fun () -> Option.is_some (S.get children))
      fallback=(<Gravity.Magnifier
                  aria_hidden=true
                  class_=(fun () -> classes ())
                  role=`presentation
                  data_slot="search-field-search-icon"
                  props=(Props.others props)
                />)>
      <span
        class_=(fun () -> classes ())
        data_slot="search-field-search-icon"
        props=(Props.others props)>
        (fun () ->
          match S.get children with Some c -> c | None -> Jsx.string "")
      </span>
    </Show>
  [@@element svg]
end

module Input = struct
  let%component make ?(placeholder : string option) ?(class_ : string option)
      ?(on_key_down : (Dom.keyboardEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlInputElement -> unit) option) () =
    let f = within "Search_field.Input" in
    let i = Interaction.create ~disabled:(fun () -> S.get f.disabled) () in
    let classes () =
      after (Styles.SearchField.input (S.get f.slots)) (S.get class_)
    in
    let watched e =
      ignore (given_ref e : unit option);
      f.input := Some e;
      Interaction.watch i e
    in
    match f.search with
    | Some s ->
        (* An autocomplete's search: Kobalte's combo box input, whose keys
           move through the list and choose, and Escape closes it. *)
        <Kobalte_combo_box.Input
          ?placeholder=(fun () -> S.get placeholder)
          ?name=(fun () -> S.get f.name)
          ?aria_label=(fun () -> S.get f.aria_label)
          enterkeyhint="go"
          title=""
          type_="search"
          class_=(fun () -> classes ())
          ref=watched
          on_key_down=(fun e -> ignore (on_key_down e : unit option))
          data_slot="search-field-input"
          data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
          data_focused=(fun () ->
                         Jsx.flag
                           (Interaction.focused i && not (S.get s.elsewhere)))
          data_focus_visible=(fun () ->
                               Jsx.flag
                                 ((Interaction.focus_visible i
                                  || (Interaction.focused i && S.get s.returned)
                                  )
                                 && not (S.get s.elsewhere)))
          data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
          data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
          props=(Props.others props)
        />
    | None ->
        (* Escape clears a search, and Enter submits it, as React Aria's
           does. *)
        let keyed e =
          ignore (on_key_down e : unit option);
          match key e with
          | "Escape"
            when not (String.equal (S.get f.value) "" || S.get f.read_only) ->
              prevent_default e;
              f.clear ()
          | "Enter" -> f.submit ()
          | _ -> ()
        in
        <Kobalte.Input
          ?placeholder=(fun () -> S.get placeholder)
          type_="search"
          class_=(fun () -> classes ())
          ref=watched
          on_key_down=keyed
          data_slot="search-field-input"
          data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
          data_focused=(fun () -> Jsx.flag (Interaction.focused i))
          data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
          data_disabled=(fun () -> Jsx.flag (S.get f.disabled))
          data_invalid=(fun () -> Jsx.flag (S.get f.invalid))
          props=(Props.others props)
        />
  [@@element input]
end

module Clear_button = struct
  (* What its children are drawn of: React Aria's render props for it. *)
  type state = {
    is_hovered : bool Solidtype.Solid.accessor;
    is_pressed : bool Solidtype.Solid.accessor;
    is_focused : bool Solidtype.Solid.accessor;
    is_focus_visible : bool Solidtype.Solid.accessor;
    is_disabled : bool Solidtype.Solid.accessor;
  }

  let%component make ?(class_ : string option)
      ?(children : state Jsx.children option)
      ?(on_pointer_down : (Dom.pointerEvent -> unit) option)
      ?(on_click : (Dom.mouseEvent -> unit) option)
      ?ref:(given_ref : (Dom.htmlButtonElement -> unit) option)
      ?(as_ :
         (Solidtype.Html.Button.props -> state -> Solidtype.Jsx.element) option)
      () =
    let f = within "Search_field.Clear_button" in
    let disabled =
      S.accessor (fun () -> S.get f.disabled || S.get f.read_only)
    in
    let i = Interaction.create ~disabled:(fun () -> S.get disabled) () in
    let state () =
      {
        is_hovered = S.accessor (fun () -> Interaction.hovered i);
        is_pressed = S.accessor (fun () -> Interaction.pressed i);
        is_focused = S.accessor (fun () -> Interaction.focused i);
        is_focus_visible = S.accessor (fun () -> Interaction.focus_visible i);
        is_disabled = S.accessor (fun () -> Interaction.disabled i);
      }
    in
    <Kobalte_button.Root
      aria_label="Close"
      class_=(fun () ->
               after
                 (Styles.CloseButton.classes (Styles.CloseButton.options ())
                 ^ " "
                 ^ Styles.SearchField.clear_button (S.get f.slots))
                 (S.get class_))
      slot="clear"
      ?tab_index=(fun () -> if S.get disabled then None else Some "-1")
      type_=`button
      ref=(fun b ->
            ignore (given_ref b : unit option);
            Interaction.watch i b)
          (* A press keeps the focus where it is, in the input. *)
      on_pointer_down=(fun e ->
                        ignore (on_pointer_down e : unit option);
                        prevent_pointer e)
      on_click=(fun e ->
                 ignore (on_click e : unit option);
                 f.clear ();
                 Option.iter focus !(f.input))
      data_slot="search-field-clear-button"
      data_hovered=(fun () -> Jsx.flag (Interaction.hovered i))
      data_pressed=(fun () -> Jsx.flag (Interaction.pressed i))
      data_focus_visible=(fun () -> Jsx.flag (Interaction.focus_visible i))
      data_disabled=(fun () -> Jsx.flag (Interaction.disabled i))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)
      disabled=(fun () -> S.get disabled)>
      (fun () ->
        match S.get children with
        | Some c -> Jsx.draw c (state ())
        | None -> Jsx.element <Close_button.Icon />)
    </Kobalte_button.Root>
  [@@element button]
end

(* What its children are drawn of: React Aria's render props for it. *)
type state = {
  is_empty : bool Solidtype.Solid.accessor;
  is_disabled : bool Solidtype.Solid.accessor;
  is_invalid : bool Solidtype.Solid.accessor;
  is_read_only : bool Solidtype.Solid.accessor;
  is_required : bool Solidtype.Solid.accessor;
}

let%component make ?(variant : [ `primary | `secondary ] option)
    ?(full_width : bool option) ?(value : string option)
    ?(default_value : string = "") ?(on_change : (string -> unit) option)
    ?(on_submit : (string -> unit) option) ?(on_clear : (unit -> unit) option)
    ?(is_disabled : bool option) ?(is_invalid : bool = false)
    ?(is_read_only : bool = false) ?(is_required : bool = false)
    ?(name : string option) ?(aria_label : string option)
    ?(class_ : string option) ?(on_blur : (Dom.focusEvent -> unit) option)
    ?(on_focus_out : (Dom.focusEvent -> unit) option)
    ?ref:(given_ref : (Dom.htmlDivElement -> unit) option)
    ~(children : state Jsx.children)
    ?(as_ : (Solidtype.Html.Div.props -> state -> Solidtype.Jsx.element) option)
    () =
  (* A field is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let disabled =
    S.accessor (fun () ->
        match S.get is_disabled with Some d -> d | None -> S.get in_fieldset)
  in
  let in_form =
    Form.field
      ~name:(fun () -> S.get name)
      ~invalid:(fun () -> S.get is_invalid)
  in
  let invalid =
    S.accessor (fun () ->
        S.get is_invalid || Option.is_some (S.get in_form.error))
  in
  let search = Autocomplete.Search.use () in
  (* An autocomplete's search is its text, which its combo box keeps. *)
  let current, set =
    match search with
    | Some s -> (s.text, s.set)
    | None ->
        Field.controlled
          ~value:(fun () -> S.get value)
          ~default:(S.get default_value)
          ~on_change:(fun v ->
            in_form.changed ();
            on_change v)
  in
  let f =
    {
      slots =
        S.accessor (fun () ->
            Styles.SearchField.slots
              (Styles.SearchField.options ?full_width:(S.get full_width)
                 ?variant:(S.get variant) ()));
      value = current;
      clear =
        (fun () ->
          set "";
          ignore (on_clear () : unit option));
      submit = (fun () -> ignore (on_submit (S.get current) : unit option));
      disabled;
      invalid;
      read_only = is_read_only;
      input = ref None;
      search;
      name;
      aria_label;
    }
  in
  let state () =
    {
      is_empty = S.accessor (fun () -> String.equal (S.get current) "");
      is_disabled = disabled;
      is_invalid = invalid;
      is_read_only;
      is_required;
    }
  in
  <Context.Provider value=(fun () -> f)>
    <Kobalte.Root
      value=(fun () -> S.get current)
      on_change=(fun v -> if not (String.equal v (S.get current)) then set v)
      validation_state=(fun () -> if S.get invalid then `invalid else `valid)
      required=(fun () -> S.get is_required)
      disabled=(fun () -> S.get disabled)
      read_only=(fun () -> S.get is_read_only)
      ?name=(fun () -> if Option.is_some search then None else S.get name)
      ?aria_label=(fun () ->
                    if Option.is_some search then None else S.get aria_label)
      class_=(fun () ->
               after (Styles.SearchField.base (S.get f.slots)) (S.get class_))
      ref=(fun e ->
            ignore (given_ref e : unit option);
            in_form.root e)
      on_focus_out=(fun e ->
                     ignore (on_focus_out e : unit option);
                     Field.on_leave
                       (fun e ->
                         in_form.left ();
                         on_blur e)
                       e)
      data_slot="search-field"
      data_empty=(fun () -> Jsx.flag (String.equal (S.get current) ""))
      data_disabled=(fun () -> Jsx.flag (S.get disabled))
      data_invalid=(fun () -> Jsx.flag (S.get invalid))
      data_readonly=(fun () -> Jsx.flag (S.get is_read_only))
      data_required=(fun () -> Jsx.flag (S.get is_required))
      ?as_=(fun () -> Option.map (fun f p -> f p (state ())) (S.get as_))
      props=(Props.others props)>
      <Field_error.Message.Provider value=(fun () -> in_form.error)>
        <Parts>(fun () -> Jsx.draw (S.get children) (state ()))</Parts>
      </Field_error.Message.Provider>
    </Kobalte.Root>
  </Context.Provider>
[@@element div]
