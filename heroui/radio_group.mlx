module Jsx = Solidtype.Jsx
module Kobalte = Solidtype_kobalte.RadioGroup

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]

external current_target : Dom.keyboardEvent -> Dom.element = "currentTarget"
[@@mel.get]

external prevent_default : Dom.keyboardEvent -> unit = "preventDefault"
[@@mel.send]

external radios : Dom.element -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]
external focus : Dom.element -> unit = "focus" [@@mel.send]
external click_target : Dom.mouseEvent -> Dom.element = "target" [@@mel.get]
external cancel_click : Dom.mouseEvent -> unit = "preventDefault" [@@mel.send]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

external query : Dom.element -> string -> Dom.element Js.null = "querySelector"
[@@mel.send]

(* A click in a read-only group chooses nothing: cancelled, which a browser
   reverts for a radio, so no input is left unchecked as Kobalte undoes the
   browser's own; and a click on a radio's content focuses its radio, as
   React Aria's press does. *)
let keep_choice e =
  cancel_click e;
  match
    Js.Null.toOption (closest (click_target e) "[data-slot=radio-content]")
  with
  | Some content -> (
      match Js.Null.toOption (query content "input[type=radio]") with
      | Some input -> focus input
      | None -> ())
  | None -> ()

(* An arrow key in a read-only group moves the focus to the next radio, or the
   one before, wrapping, and chooses nothing, as React Aria's does; the
   browser's own would check the radio it reaches, which Kobalte then unchecks,
   leaving none checked. *)
let move_focus e =
  let step =
    match key e with
    | "ArrowDown" | "ArrowRight" -> 1
    | "ArrowUp" | "ArrowLeft" -> -1
    | _ -> 0
  in
  if step <> 0 then begin
    prevent_default e;
    let all =
      Js.Array.from
        (radios (current_target e) "input[type=radio]:not(:disabled)")
    in
    let n = Array.length all in
    match Js.Null.toOption active with
    | Some focused when n > 0 -> (
        match Js.Array.findIndex ~f:(fun r -> r == focused) all with
        | -1 -> ()
        | at -> focus all.((at + step + n) mod n))
    | _ -> ()
  end

(* What a group's radios read of it: the value chosen, and whether it is
   disabled or invalid. *)
type group = {
  value : unit -> string option;
  disabled : unit -> bool;
  invalid : unit -> bool;
  read_only : unit -> bool;
  required : unit -> bool;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

(* A label in a group, but outside a radio's content, is the group's: Kobalte's
   label, which names it. *)
let label : Label.slot =
 fun[@u] classes children ->
  <Kobalte.Label class_=(fun () -> classes ()) data_slot="label">
    (fun () -> children ())
  </Kobalte.Label>

(* A description in a group, but outside a radio, is the group's: Kobalte's
   description, which it is described by. *)
let description : Description.slot =
 fun[@u] classes children ->
  <Kobalte.Description
    class_=(fun () -> classes ()) slot="description" data_slot="description">
    (fun () -> children ())
  </Kobalte.Description>

let%component make ?(variant : [ `primary | `secondary ] = `primary)
    ?(value : string option) ?(default_value : string option)
    ?(on_change : (string -> unit) option)
    ?(orientation : [ `horizontal | `vertical ] = `vertical)
    ?(is_disabled : bool option) ?(is_invalid : bool = false)
    ?(is_read_only : bool = false) ?(is_required : bool = false)
    ?(name : string option) ?(class_ : string option)
    ?(on_blur : (Dom.focusEvent -> unit) option) ~(children : Jsx.content) () =
  (* A group is disabled as it says, else as its fieldset is. *)
  let in_fieldset = Fieldset.disabled () in
  let is_disabled () =
    match is_disabled () with Some d -> d | None -> in_fieldset ()
  in
  let in_form = Form.field ~name ~invalid:(fun () -> is_invalid ()) in
  let invalid () = is_invalid () || Option.is_some (in_form.error ()) in
  (* The value is the group's, read by Kobalte and by every radio alike;
     none is Kobalte's own empty value, as a form's reset leaves it. *)
  let chosen, choose =
    Field.controlled
      ~value:(fun () -> Option.map Option.some (value ()))
      ~default:(default_value ())
      ~on_change:
        (Option.iter (fun v ->
             in_form.changed ();
             ignore (on_change v : unit option)))
  in
  let g =
    {
      value = chosen;
      disabled = (fun () -> is_disabled ());
      invalid;
      read_only = (fun () -> is_read_only ());
      required = (fun () -> is_required ());
    }
  in
  <Context.Provider value=(fun () -> g)>
    <Kobalte.Root
      value=(fun () -> Option.value (chosen ()) ~default:"")
      on_change=(fun v -> choose (Some v))
      orientation=(fun () -> orientation ())
      disabled=(fun () -> is_disabled ())
      read_only=(fun () -> is_read_only ())
      required=(fun () -> is_required ())
      ?name
      on_key_down=(fun e -> if is_read_only () then move_focus e)
      on_click=(fun e -> if is_read_only () then keep_choice e)
      validation_state=(fun () -> if invalid () then `invalid else `valid)
      class_=(fun () ->
               Styles.RadioGroup.classes
                 (Styles.RadioGroup.options ~variant:(variant ())
                    ?class_:(class_ ()) ()))
      ref=(fun e -> in_form.root e)
      on_focus_out=(Field.on_leave (fun e ->
                        in_form.left ();
                        on_blur e))
      data_slot="radio-group"
      data_orientation=(fun () ->
                         Jsx.data
                           (match orientation () with
                           | `horizontal -> "horizontal"
                           | `vertical -> "vertical"))
      data_disabled=(fun () -> Jsx.flag (is_disabled ()))
      data_invalid=(fun () -> Jsx.flag (invalid ()))
      data_readonly=(fun () -> Jsx.flag (is_read_only ()))
      data_required=(fun () -> Jsx.flag (is_required ()))>
      <Label.Slot.Provider value=(fun () -> label)>
        <Description.Slot.Provider value=(fun () -> description)>
          (fun () -> children ())
        </Description.Slot.Provider>
      </Label.Slot.Provider>
    </Kobalte.Root>
  </Context.Provider>
