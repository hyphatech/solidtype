module S = Solidtype.Solid
module Jsx = Solidtype.Jsx

type group = {
  variant :
    [ `primary
    | `secondary
    | `tertiary
    | `outline
    | `ghost
    | `danger
    | `danger_soft ]
    option
    S.accessor;
  size : [ `sm | `md | `lg ] option S.accessor;
  is_disabled : bool option S.accessor;
  full_width : bool option S.accessor;
}

module Context = Solidtype.Context.Make_optional (struct
  type t = group
end)

module Separator = struct
  let%component make ?(class_ : string option) () =
    <span
      aria_hidden=true
      class_=(fun () ->
               let separator =
                 Styles.ButtonGroup.separator
                   (Styles.ButtonGroup.slots (Styles.ButtonGroup.options ()))
               in
               match S.get class_ with
               | Some c -> separator ^ " " ^ c
               | None -> separator)
      data_slot="button-group-separator"
      props=(Props.others props)
    />
  [@@element span]
end

let%component make
    ?(variant :
       [ `primary
       | `secondary
       | `tertiary
       | `outline
       | `ghost
       | `danger
       | `danger_soft ]
       option) ?(size : [ `sm | `md | `lg ] option)
    ?(orientation : [ `horizontal | `vertical ] = `horizontal)
    ?(full_width : bool option) ?(is_disabled : bool option)
    ?(class_ : string option) ~(children : Jsx.content) () =
  let g = { variant; size; is_disabled; full_width } in
  let disabled () = Option.value (S.get is_disabled) ~default:false in
  <Context.Provider value=(fun () -> g)>
    <div
      role=`group
      class_=(fun () ->
               let base =
                 Styles.ButtonGroup.base
                   (Styles.ButtonGroup.slots
                      (Styles.ButtonGroup.options ?full_width:(S.get full_width)
                         ~orientation:(S.get orientation) ()))
               in
               (* A slot's class takes no class of the caller's, so it is
                  added after HeroUI's, as React's className is. *)
               match S.get class_ with
               | Some c -> base ^ " " ^ c
               | None -> base)
      data_slot="button-group"
      data_disabled=(fun () -> Jsx.flag (disabled ()))
      props=(Props.others props)>
      (fun () -> S.get children)
    </div>
  </Context.Provider>
[@@element div]
