      ~default_value:(S.untrack (fun () -> Props.default_value props))
      ~on_change:(fun v -> Jsx.call (Props.on_change props) v)
      ~placeholder_value:(S.accessor (fun () -> Props.placeholder_value props))
      ~min_value:(S.accessor (fun () -> Props.min_value props))
      ~max_value:(S.accessor (fun () -> Props.max_value props))
      ~is_date_unavailable:
        (S.accessor (fun () ->
             Option.map
               (fun _ d -> Props.is_date_unavailable props d)
               (Props.unavailable_given props)))
      ~children:(fun () -> Props.children props)
      ~as_:(fun state ->
        S.accessor (fun () ->
            Option.map
              (fun _ p -> Props.draw_as props p state)
              (Props.as_given props)))
      props
      ~field:(fun ~value ~on_change ~as_ child ->
        <Date_field.Root_range_zoned
          placeholder_value=(Props.placeholder_value_given props)
          value=(S.get value)
          on_change
          ?as_=(S.get as_)
          data_open=(Jsx.flag (S.get (within "Date_picker").open_))
          props=(S.omit props Common.own)>
          (child ())
        </Date_field.Root_range_zoned>)

  let component = Jsx.component make
end

(* The field's group of segments and the button that opens the popover, as
   React Aria's date picker names it. *)
module Group = struct
  module Props = struct
    type t

    external check :
      ?as_:(Solidtype.Html.Div.props -> Solidtype.Jsx.element) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `elements ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external children : t -> Jsx.element = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlDivElement -> unit)[@u]) option = "ref"
    [@@mel.get]

    external on_key_down : t -> ((Dom.keyboardEvent -> unit)[@u]) option
      = "onKeyDown"
    [@@mel.get]

    external on_key_up : t -> ((Dom.keyboardEvent -> unit)[@u]) option
      = "onKeyUp"
    [@@mel.get]
  end

  let make (props : Props.t) =
    let p = within "Date_picker.Group" in
    let f = Date_field.Context.use () in
    <div
      role=`group
      ?aria_labelledby=(S.get f.labelled_by)
      ?aria_describedby=(S.get f.described_by)
      ?aria_disabled=(if S.get p.disabled then Some true else None)
      ref=(fun e ->
            p.set_group (as_html_element e);
            Jsx.call (Props.ref props) e)
      on_key_down=(fun e ->
                    (* The keys go to the popover while it is open. *)
                    if not (S.get p.open_) then
                      Jsx.call (Props.on_key_down props) e)
      on_key_up=(fun e ->
                  if not (S.get p.open_) then Jsx.call (Props.on_key_up props) e)
      ?as_=(S.drawn_as props)
      props=(S.undrawn
               (S.omit props [| "children"; "ref"; "onKeyDown"; "onKeyUp" |]))>
      (Props.children props)
    </div>

  let component = Jsx.component make
end

module Trigger = struct
  module Props = struct
    type t

    external check :
      ?as_:(Solidtype.Html.Button.props -> Solidtype.Jsx.element) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `elements ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Button.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external children : t -> Jsx.element = "children" [@@mel.get]
  end

  let make (props : Props.t) =
    let p = within "Date_picker.Trigger" in
    let f = Date_field.Context.use () in
    <Popover.Trigger
      id=p.button_id
      aria_label=(S.get p.words).calendar
      aria_labelledby=(match S.get f.labelled_by with
                      | Some l -> p.button_id ^ " " ^ l
                      | None -> p.button_id)
      ?aria_describedby=(S.get f.described_by)
      disabled=(S.get p.disabled || S.get p.read_only)
      ?as_=(S.drawn_as props)
      props=(S.undrawn (S.omit props [| "children" |]))>
      (Props.children props)
    </Popover.Trigger>

  let component = Jsx.component make
end

module Content = struct
  module Props = struct
    type t

    external check :
      ?placement:string Solidtype.Check.value ->
      ?offset:float Solidtype.Check.value ->
      ?kept:bool Solidtype.Check.value ->
      ?as_:(Solidtype.Html.Div.props -> Solidtype.Jsx.element) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `elements ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external placement : t -> string option = "placement" [@@mel.get]
    external offset : t -> float option = "offset" [@@mel.get]
    external kept : t -> bool option = "kept" [@@mel.get]
    external children : t -> Jsx.element = "children" [@@mel.get]

    external on_open_auto_focus : t -> ((Dom.event -> unit)[@u]) option
      = "onOpenAutoFocus"
    [@@mel.get]
  end

  let make (props : Props.t) =
    let p = within "Date_picker.Content" in
    let f = Date_field.Context.use () in
    S.create_computed (fun () ->
        p.set_placement (Option.value (Props.placement props) ~default:"bottom"));
    S.create_computed (fun () ->
        p.set_gutter (Option.value (Props.offset props) ~default:8.));
    <Show
      when_=(S.get p.open_ || Option.value (Props.kept props) ~default:false)>
      <Popover.Portal ref=(fun e -> Top_layer.place e)>
        <Popover.Content
          id=p.dialog_id
          aria_labelledby=(match S.get f.labelled_by with
                          | Some l -> p.button_id ^ " " ^ l
                          | None -> p.button_id)
          on_open_auto_focus=(fun e ->
                               Jsx.call (Props.on_open_auto_focus props) e;
                               (* The calendar inside takes the focus, as it
                                is drawn, on its focused day. *)
                               prevent e)
          ?as_=(S.drawn_as props)
          props=(S.undrawn
                   (S.omit props
                      [|
                        "placement";
                        "offset";
                        "kept";
                        "children";
                        "onOpenAutoFocus";
                      |]))>
          (Props.children props)
        </Popover.Content>
      </Popover.Portal>
    </Show>

  let component = Jsx.component make
end
