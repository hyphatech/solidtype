module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Selection = Solidtype_kobalte.Selection
module I18n = Solidtype_kobalte.I18n
module Types = Solidtype_kobalte.Types
module Either = Types.Either
module Delegate = Types.KeyboardDelegate
module List_state = Types.ListState
module Manager = Types.MultipleSelectionManager
module Selectable_list = Types.Selection_CreateSelectableList

(* Whether [other] follows [e] on the page, by DOM's bit for it. *)
external position : _ Dom.element_like -> _ Dom.element_like -> int
  = "compareDocumentPosition"
[@@mel.send]

type rect

external bounds : _ Dom.element_like -> rect = "getBoundingClientRect"
[@@mel.send]

external top : rect -> float = "top" [@@mel.get]

external client_height : _ Dom.element_like -> float = "clientHeight"
[@@mel.get]

external pressed : Dom.keyboardEvent -> string = "key" [@@mel.get]
external shift : Dom.keyboardEvent -> bool = "shiftKey" [@@mel.get]
external composing : Dom.keyboardEvent -> bool = "isComposing" [@@mel.get]
external prevent : Dom.keyboardEvent -> unit = "preventDefault" [@@mel.send]
external prevent_mouse : Dom.mouseEvent -> unit = "preventDefault" [@@mel.send]

external input_target : Dom.inputEvent -> Dom.htmlInputElement = "target"
[@@mel.get]

external input_value : Dom.htmlInputElement -> string = "value" [@@mel.get]

(* How the text changed, an InputEvent's; [undefined] where the event is not
   one, which is no typing forward. *)
external input_type : Dom.inputEvent -> string Js.undefined = "inputType"
[@@mel.get]

external focus : Dom.htmlInputElement -> unit = "focus" [@@mel.send]
external pointer_type : Dom.pointerEvent -> string = "pointerType" [@@mel.get]

(* Kobalte's state, an attribute present and empty, or none. *)
let state on = if on then Jsx.data "" else Jsx.flag false

