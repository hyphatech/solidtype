[@@mel.send]

(* A format's part as Intl names it, which names kinds the binding's part does
   not: relatedYear, yearName. *)
external part_type : Dt.DateTimeFormatPart.t -> string = "type" [@@mel.get]

type segment_type =
  [ `era
  | `year
  | `month
  | `day
  | `hour
  | `minute
  | `second
  | `dayPeriod
  | `timeZoneName
  | `literal ]

type segment = {
  type_ : segment_type;
  text : string;
  value : int option;
  min_value : int option;
  max_value : int option;
  is_placeholder : bool;
  placeholder : string;
  is_editable : bool;
}

type translations = {
  selected_date_description : string -> string;
  start_date : string;
  end_date : string;
  selected_range_description : string -> string -> string;
}

let english =
  {
    selected_date_description = (fun d -> "Selected Date: " ^ d);
    start_date = "Start Date";
    end_date = "End Date";
    selected_range_description =
      (fun s e -> "Selected Range: " ^ s ^ " to " ^ e);
  }

type 'v range = { start : 'v; end_ : 'v }

type field = {
  segments : segment array S.accessor;
  is_disabled : bool S.accessor;
  is_read_only : bool S.accessor;
  is_required : bool S.accessor;
  is_invalid : bool S.accessor;
  labelled_by : string option S.accessor;
  described_by : string option S.accessor;
}

(* Kobalte's state, an attribute present and empty, or none. *)
let state on = if on then Jsx.data "" else Jsx.flag false

(* A part of a date a segment edits. *)
type part =
  [ `era | `year | `month | `day | `hour | `dayPeriod | `minute | `second ]

type cycle = [ `h11 | `h12 | `h23 | `h24 ]

(* An hour of the day on a clock, and whether it is after noon where the clock
   has two halves, as React Stately's IncompleteDate turns them. *)
let to_clock hour (cycle : cycle) =
  let period = Some (if hour >= 12 then 1 else 0) in
  match cycle with
  | `h11 -> (period, if hour >= 12 then hour - 12 else hour)
  | `h12 ->
      (period, if hour = 0 then 12 else if hour > 12 then hour - 12 else hour)
  | `h23 -> (None, hour)
  | `h24 -> (None, hour + 1)

let of_clock hour period (cycle : cycle) =
  match cycle with
  | `h11 -> if period = 1 then hour + 12 else hour
  | `h12 ->
      let hour = if hour = 12 then 0 else hour in
      if period = 1 then hour + 12 else hour
  | `h23 -> hour
  | `h24 -> hour - 1

let twelve (cycle : cycle) =
  match cycle with `h11 | `h12 -> true | `h23 | `h24 -> false

(* A date as the field edits it, each part none until it is given: React
   Stately's IncompleteDate, its hour on the field's clock. *)
type parts = {
  era : string option;
  year : int option;
  month : int option;
  day : int option;
  hour : int option;
  day_period : int option;
  minute : int option;
  second : int option;
  millisecond : int option;
  offset : int option;
}

let none =
  {
    era = None;
    year = None;
    month = None;
    day = None;
    hour = None;
    day_period = None;
    minute = None;
    second = None;
    millisecond = None;
    offset = None;
  }

(* Every part of a value, the time's zero on a date alone. *)
type whole = {
  w_era : string;
  w_year : int;
  w_month : int;
  w_day : int;
  w_hour : int;
  w_minute : int;
  w_second : int;
  w_millisecond : int;
}

(* What the field reads and writes of a kind of value. *)
type 'v kind = {
  read : 'v -> whole;
  timed : bool;
  offset : 'v -> int option;
  write : 'v -> whole -> 'v;  (** Its parts set, constrained to a date. *)
  shift : 'v -> int -> 'v;  (** Moved by milliseconds. *)
  zone : 'v -> string option;
  calendar : 'v -> Dt.Calendar.t;
  convert : 'v -> Dt.Calendar.t -> 'v;
  to_date : 'v -> string -> Js.Date.t;
  compare : 'v -> 'v -> float;
  to_string : 'v -> string;
  cycle_hour : ('v -> int -> twelve:bool -> 'v) option;
      (** The hour stepped by its zone's rules. *)
}

let date_kind : Dt.CalendarDate.t kind =
  let module V = Dt.CalendarDate in
  {
    read =
      (fun v ->
        {
          w_era = V.era v;
          w_year = V.year v;
          w_month = V.month v;
          w_day = V.day v;
          w_hour = 0;
          w_minute = 0;
          w_second = 0;
          w_millisecond = 0;
        });
    timed = false;
    offset = (fun _ -> None);
    write =
      (fun v w ->
        V.set v
          (Dt.DateFields.make ~era:w.w_era ~year:w.w_year ~month:w.w_month
             ~day:w.w_day ()));
    shift = (fun v _ -> v);
    zone = (fun _ -> None);
    calendar = V.calendar;
    convert = D.to_calendar;
    to_date = V.to_date;
    compare = V.compare;
    to_string = (fun v -> V.to_string v ());
    cycle_hour = None;
  }

let time_fields w =
  Dt.ZonedDateTime_Set.make ~era:w.w_era ~year:w.w_year ~month:w.w_month
    ~day:w.w_day ~hour:w.w_hour ~minute:w.w_minute ~second:w.w_second
    ~millisecond:w.w_millisecond ()

let date_time_kind : Dt.CalendarDateTime.t kind =
  let module V = Dt.CalendarDateTime in
  {
    read =
      (fun v ->
        {
          w_era = V.era v;
          w_year = V.year v;
          w_month = V.month v;
          w_day = V.day v;
          w_hour = V.hour v;
          w_minute = V.minute v;
          w_second = V.second v;
          w_millisecond = V.millisecond v;
        });
    timed = true;
    offset = (fun _ -> None);
    write = (fun v w -> V.set v (time_fields w));
    shift = (fun v _ -> v);
    zone = (fun _ -> None);
    calendar = V.calendar;
    convert = D.to_calendar;
    to_date = (fun v zone -> V.to_date v zone ());
    compare = V.compare;
    to_string = (fun v -> V.to_string v ());
    cycle_hour = None;
  }

let zoned_kind : Dt.ZonedDateTime.t kind =
  let module V = Dt.ZonedDateTime in
  {
    read =
      (fun v ->
        {
          w_era = V.era v;
          w_year = V.year v;
          w_month = V.month v;
          w_day = V.day v;
          w_hour = V.hour v;
          w_minute = V.minute v;
          w_second = V.second v;
          w_millisecond = V.millisecond v;
        });
    timed = true;
    offset = (fun v -> Some (V.offset v));
    (* A time its zone's clocks skip is the one after it: [`compatible] reads
       every time so, and never throws. *)
    write = (fun v w -> V.set v (time_fields w) ~disambiguation:`compatible ());
    shift = (fun v ms -> V.add v (Dt.DateTimeDuration.make ~milliseconds:ms ()));
    zone = (fun v -> Some (V.time_zone v));
    calendar = V.calendar;
    convert = D.to_calendar;
    to_date = (fun v _ -> V.to_date v ());
    compare = V.compare;
    to_string = (fun v -> V.to_string v ());
    cycle_hour =
      Some
        (fun v amount ~twelve ->
          V.cycle v `hour amount
            ~options:
              (Dt.CycleTimeOptions.make
                 ~hour_cycle:(if twelve then 12 else 24)
                 ~round:false ())
            ());
  }

let parts_of (kind : _ kind) cycle v =
  let w = kind.read v in
  let day_period, hour =
    if kind.timed then
      let period, hour = to_clock w.w_hour cycle in
      (period, Some hour)
    else (None, None)
  in
  {
    era = Some w.w_era;
    year = Some w.w_year;
    month = Some w.w_month;
    day = Some w.w_day;
    hour;
    day_period;
    minute = (if kind.timed then Some w.w_minute else None);
    second = (if kind.timed then Some w.w_second else None);
    millisecond = (if kind.timed then Some w.w_millisecond else None);
    offset = kind.offset v;
  }

let has (p : parts) (part : part) =
  match part with
  | `era -> Option.is_some p.era
  | `year -> Option.is_some p.year
  | `month -> Option.is_some p.month
  | `day -> Option.is_some p.day
  | `hour -> Option.is_some p.hour
  | `dayPeriod -> Option.is_some p.day_period
  | `minute -> Option.is_some p.minute
  | `second -> Option.is_some p.second

let same (a : part) (b : part) =
  match (a, b) with
  | `era, `era
  | `year, `year
  | `month, `month
  | `day, `day
  | `hour, `hour
  | `dayPeriod, `dayPeriod
  | `minute, `minute
  | `second, `second ->
      true
  | _ -> false

let complete p parts = List.for_all (has p) parts
let cleared p parts = not (List.exists (has p) parts)

(* The date [p] makes on [base], each part it lacks [base]'s, a zoned value
   kept at the offset it was typed at. *)
let to_value (kind : 'v kind) cycle (p : parts) (base : 'v) : 'v =
  let b = kind.read base in
  let get o d = Option.value o ~default:d in
  let hour =
    match p.hour with
    | Some h -> of_clock h (get p.day_period 0) cycle
    | None when kind.timed && twelve cycle ->
        if Option.equal Int.equal p.day_period (Some 1) then 12 else 0
    | None -> b.w_hour
  in
  let v =
    kind.write base
      {
        w_era = get p.era b.w_era;
        w_year = get p.year b.w_year;
        w_month = get p.month b.w_month;
        w_day = get p.day b.w_day;
        w_hour = (if kind.timed then hour else b.w_hour);
        w_minute = get p.minute b.w_minute;
        w_second = get p.second b.w_second;
        w_millisecond = get p.millisecond b.w_millisecond;
      }
  in
  match (kind.offset v, p.offset) with
  | Some now, Some typed when now <> typed -> kind.shift v (now - typed)
  | _ -> v

(* Whether [v] is the date [p] says, each part of [parts] alike. *)
let matches (kind : 'v kind) cycle (p : parts) (v : 'v) parts =
  let w = kind.read v in
  List.for_all
    (fun (part : part) ->
      match part with
      | `hour | `dayPeriod ->
          let period, hour = to_clock w.w_hour cycle in
          Option.equal Int.equal p.day_period period
          && Option.equal Int.equal p.hour (Some hour)
      | `era -> Option.equal String.equal p.era (Some w.w_era)
      | `year -> Option.equal Int.equal p.year (Some w.w_year)
      | `month -> Option.equal Int.equal p.month (Some w.w_month)
      | `day -> Option.equal Int.equal p.day (Some w.w_day)
      | `minute -> Option.equal Int.equal p.minute (Some w.w_minute)
      | `second -> Option.equal Int.equal p.second (Some w.w_second))
    parts

(* A part's least and greatest, and where it stands. *)
let limits calendar cycle (p : parts) (part : part) =
  match part with
  | `era ->
      let eras = Dt.Calendar.get_eras calendar () in
      let at =
        match p.era with
        | Some e -> Js.Array.findIndex ~f:(String.equal e) eras
        | None -> Array.length eras - 1
      in
      (Some at, 0, Array.length eras - 1)
  | `year -> (p.year, 1, 9999)
  | `month -> (p.month, 1, Dt.Calendar.get_maximum_months_in_year calendar ())
  | `day -> (p.day, 1, Dt.Calendar.get_maximum_days_in_month calendar ())
  | `dayPeriod -> (p.day_period, 0, 1)
  | `hour -> (
      match (cycle : cycle) with
      | `h12 -> (p.hour, 1, 12)
      | `h11 -> (p.hour, 0, 11)
      | `h23 | `h24 -> (p.hour, 0, 23))
  | `minute -> (p.minute, 0, 59)
  | `second -> (p.second, 0, 59)

let cycle_value value amount least greatest ~round =
  if round then
    let value =
      value + if amount > 0 then 1 else if amount < 0 then -1 else 0
    in
    let value = if value < least then greatest else value in
    let step = abs amount in
    let value =
      if amount > 0 then
        int_of_float (Float.ceil (float_of_int value /. float_of_int step))
        * step
      else
        int_of_float (Float.floor (float_of_int value /. float_of_int step))
        * step
    in
    if value > greatest then least else value
  else
    let value = value + amount in
    if value < least then greatest - (least - value - 1)
    else if value > greatest then least + (value - greatest - 1)
    else value

(* [p] with [part] set; an hour set takes its half of the day from the
   placeholder where it has none, a year its era. *)
let set (kind : 'v kind) cycle (p : parts) (part : part) value
    ~(placeholder : 'v) =
  let w = kind.read placeholder in
  let p = match part with `second -> p | _ -> { p with offset = None } in
  match part with
  | `era -> p
  | `year ->
      {
        p with
        year = Some value;
        era = (match p.era with Some e -> Some e | None -> Some w.w_era);
      }
  | `month -> { p with month = Some value }
  | `day -> { p with day = Some value }
  | `hour ->
      {
        p with
        hour = Some value;
        day_period =
          (match p.day_period with
          | Some d -> Some d
          | None when kind.timed -> fst (to_clock w.w_hour cycle)
          | None -> None);
      }
  | `dayPeriod -> { p with day_period = Some value }
  | `minute -> { p with minute = Some value }
  | `second -> { p with second = Some value }

let clear (p : parts) (part : part) =
  let p = { p with offset = None } in
  match part with
  | `era -> { p with era = None }
  | `year -> { p with year = None; era = None }
  | `month -> { p with month = None }
  | `day -> { p with day = None }
  | `hour -> { p with hour = None }
  | `dayPeriod -> { p with day_period = None }
  | `minute -> { p with minute = None }
  | `second -> { p with second = None }

(* [p] with [part] stepped by [amount], as React Stately's IncompleteDate
   cycles it: a part with none takes the placeholder's. *)
let step (kind : 'v kind) calendar cycle (p : parts) (part : part) amount
    ~(placeholder : 'v) ~shown =
  let w = kind.read placeholder in
  match part with
  | (`year | `month | `day | `hour | `minute | `second) when not (has p part)
    -> (
      match part with
      | `hour ->
          let period, hour = to_clock w.w_hour cycle in
          { p with hour = Some hour; day_period = period }
      | `year ->
          {
            p with
            year = Some w.w_year;
            era = (match p.era with Some e -> Some e | None -> Some w.w_era);
          }
      | `month -> { p with month = Some w.w_month }
      | `day -> { p with day = Some w.w_day }
      | `minute -> { p with minute = Some w.w_minute }
      | `second -> { p with second = Some w.w_second }
      | `era | `dayPeriod -> p)
  | `era ->
      let eras = Dt.Calendar.get_eras calendar () in
      let at =
        match p.era with
        | Some e -> Js.Array.findIndex ~f:(String.equal e) eras
        | None -> -1
      in
      let at = cycle_value at amount 0 (Array.length eras - 1) ~round:false in
      { p with era = Some eras.(at) }
  | `year ->
      (* A CalendarDate steps the year, so 1 AD steps back to 1 BC. *)
      let era = Option.value p.era ~default:w.w_era in
      let date =
        Dt.CalendarDate.set
          (D.to_calendar (Dt.CalendarDate.make 1 1 1) calendar)
          (Dt.DateFields.make ~era
             ~year:(Option.value p.year ~default:w.w_year)
             ~month:(Option.value p.month ~default:1)
             ~day:(Option.value p.day ~default:1)
             ())
      in
      let date =
        Dt.CalendarDate.cycle date `year amount
          ~options:(Dt.CycleOptions.make ~round:true ())
          ()
      in
      {
        p with
        era = Some (Dt.CalendarDate.era date);
        year = Some (Dt.CalendarDate.year date);
      }
  | `month ->
      {
        p with
        month =
          Some
            (cycle_value
               (Option.value p.month ~default:1)
               amount 1
               (Dt.Calendar.get_maximum_months_in_year calendar ())
               ~round:false);
      }
  | `day ->
      {
        p with
        day =
          Some
            (cycle_value
               (Option.value p.day ~default:1)
               amount 1
               (Dt.Calendar.get_maximum_days_in_month calendar ())
               ~round:false);
      }
  | `hour -> (
      let dated =
        List.exists
          (fun (s : part) ->
            match s with `year | `month | `day -> true | _ -> false)
          shown
      in
      let whole_date = has p `year && has p `month && has p `day in
      match kind.cycle_hour with
      | Some cycle_hour when (not dated) || whole_date ->
          let v = to_value kind cycle p placeholder in
          let v = cycle_hour v amount ~twelve:(twelve cycle) in
          let period, hour = to_clock (kind.read v).w_hour cycle in
          {
            p with
            hour = Some hour;
            day_period = period;
            offset = kind.offset v;
          }
      | Some _ | None ->
          let _, least, greatest = limits calendar cycle p `hour in
          {
            p with
            hour =
              Some
                (cycle_value
                   (Option.value p.hour ~default:0)
                   amount least greatest ~round:false);
            day_period =
              (match p.day_period with
              | Some d -> Some d
              | None -> fst (to_clock w.w_hour cycle));
          })
  | `dayPeriod ->
      {
        p with
        day_period =
          Some
            (cycle_value
               (Option.value p.day_period ~default:0)
               amount 0 1 ~round:false);
      }
  | `minute ->
      {
        p with
        minute =
          Some
            (cycle_value
               (Option.value p.minute ~default:0)
               amount 0 59 ~round:true);
      }
  | `second ->
      {
        p with
        second =
          Some
            (cycle_value
               (Option.value p.second ~default:0)
               amount 0 59 ~round:true);
      }

(* How far Page Up and Page Down step a part, as React Stately's do. *)
let page (part : part) =
  match part with
  | `year -> 5
  | `month -> 2
  | `day -> 7
  | `hour -> 2
  | `minute | `second -> 15
  | `era | `dayPeriod -> 1

(* What a date's segment shows while it has no part, by the reader's language,
   as Chrome and Firefox write a date input's: React Stately's table. *)
let placeholders =
  [
    ("ach", ("mwaka", "dwe", "nino"));
    ("af", ("jjjj", "mm", "dd"));
    ("am", ({js|ዓዓዓዓ|js}, {js|ሚሜ|js}, {js|ቀቀ|js}));
    ("an", ("aaaa", "mm", "dd"));
    ("ar", ({js|سنة|js}, {js|شهر|js}, {js|يوم|js}));
    ("ast", ("aaaa", "mm", "dd"));
    ("az", ("iiii", "aa", "gg"));
    ("be", ({js|гггг|js}, {js|мм|js}, {js|дд|js}));
    ("bg", ({js|гггг|js}, {js|мм|js}, {js|дд|js}));
    ("bn", ("yyyy", {js|মিমি|js}, "dd"));
    ("br", ("bbbb", "mm", "dd"));
    ("bs", ("gggg", "mm", "dd"));
    ("ca", ("aaaa", "mm", "dd"));
    ("cak", ("jjjj", "ii", "q'q'"));
    ("ckb", ({js|ساڵ|js}, {js|مانگ|js}, {js|ڕۆژ|js}));
    ("cs", ("rrrr", "mm", "dd"));
    ("cy", ("bbbb", "mm", "dd"));
    ("da", ({js|åååå|js}, "mm", "dd"));
    ("de", ("jjjj", "mm", "tt"));
