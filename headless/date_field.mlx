(* A part that names the field's input by its id: a label, a description, an
   error, each a [<span>]. *)
module Named = struct
  module Props = struct
    type t

    external check :
      ?as_:(Solidtype.Html.Span.props -> Solidtype.Jsx.element) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `elements ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Span.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external children : t -> Jsx.element = "children" [@@mel.get]

    external on_click : t -> ((Dom.mouseEvent -> unit)[@u]) option = "onClick"
    [@@mel.get]
  end

  (* Its id is the one the input names, so a caller's is left out. *)
  let make ~id ~here ?on_click (props : Props.t) =
    here ();
    <span
      id
      on_click=(fun e ->
                 Jsx.call (Props.on_click props) e;
                 match on_click with Some f -> f () | None -> ())
      ?as_=(S.drawn_as props)
      props=(S.undrawn (S.omit props [| "children"; "id"; "onClick" |]))>
      (Props.children props)
    </span>
end

