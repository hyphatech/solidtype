let empty_of locale = localized empties locale ~default:"Empty"

let placeholder_of locale (t : segment_type) shown =
  let year, month, day = placeholders_of locale in
  match t with
  | `era | `dayPeriod -> shown
  | `year -> year
  | `month -> month
  | `day -> day
  | `hour | `minute | `second | `timeZoneName | `literal -> {js|––|js}

let part_of (t : segment_type) : part option =
  match t with
  | `era -> Some `era
  | `year -> Some `year
  | `month -> Some `month
  | `day -> Some `day
  | `hour -> Some `hour
  | `dayPeriod -> Some `dayPeriod
  | `minute -> Some `minute
  | `second -> Some `second
  | `timeZoneName | `literal -> None

let segment_type_of = function
  | "era" -> `era
  | "year" | "relatedYear" -> `year
  | "month" -> `month
  | "day" -> `day
  | "hour" -> `hour
  | "minute" -> `minute
  | "second" -> `second
  | "dayPeriod" | "dayperiod" -> `dayPeriod
  | "timeZoneName" -> `timeZoneName
  | _ -> `literal

let literal text =
  {
    type_ = `literal;
    text;
    value = None;
    min_value = None;
    max_value = None;
    is_placeholder = false;
    placeholder = "";
    is_editable = false;
  }

(* Whether the page runs on iOS, whose VoiceOver cannot focus a spin button. *)
let ios () =
  match Js.Undefined.toOption navigator with
  | None -> false
  | Some n -> (
      match platform n with
      | "iPhone" | "iPad" | "iPod" -> true
      | "MacIntel" -> touch_points n > 1
      | _ -> false)

(* What the field's parts read of it, beyond what a style reads. *)
type inner = {
  public : field;
  confirm : unit -> unit;
  set_root : Dom.element -> unit;
  hidden : unit -> Jsx.element;
  spoken : (Dt.DateFormatter.t * Js.Date.t) option S.accessor;
  own_described_by : string option S.accessor;
  locale : string S.accessor;
  direction : [ `ltr | `rtl ] S.accessor;
  cycle : cycle S.accessor;
  date : Js.Date.t S.accessor;
  time_zone : string S.accessor;
  calendar : Dt.Calendar.t S.accessor;
  set_part : part -> int -> unit;
  set_era : string -> unit;
  clear_part : part -> unit;
  step_part : part -> int -> unit;
  to_least : part -> unit;
  to_greatest : part -> unit;
  set_input : Dom.element option -> unit;
  input : Dom.element option S.accessor;
  label_id : string;
  label_here : unit -> unit;
  description_id : string;
  description_here : unit -> unit;
  error_id : string;
  error_here : unit -> unit;
  aria_label : string option S.accessor;
  labelled_by : string option S.accessor;
  described_by : string option S.accessor;
  input_role : [ `group | `presentation ] S.accessor;
}

module Field_context = Solidtype.Context.Make_optional (struct
  type t = inner
end)

(* A range's two fields, which an Input names by its slot. *)
module Slots_context = Solidtype.Context.Make_optional (struct
  type t = (string * inner) list
end)

let within part =
  match Field_context.use () with
  | Some f -> f
  | None -> invalid_arg (part ^ " is used inside a Date_field root")

module Context = struct
  let use () = (within "Date_field.Context.use").public
end

(* An id on the page while the part that carries it is: a part counts itself
   in as it is made and out as it goes. *)
let named id =
  let count, set_count = S.create_signal 0 in
  let here () =
    S.set set_count (S.get count + 1);
    S.on_cleanup (fun () -> S.set set_count (S.get count - 1))
  in
  (here, fun () -> if S.get count > 0 then Some id else None)

(* The segments Tab reaches, in the page's order. *)
let focusable input =
  Js.Array.from (query_all input "[data-type][tabindex=\"0\"]")

let focus_first input =
  match focusable input with [||] -> () | all -> focus all.(0)

let index_of all e = Js.Array.findIndex ~f:(fun s -> s == e) all

(* The segment after the one focused, or before it. *)
let focus_by input amount =
  let all = focusable input in
  match Js.Null.toOption active with
  | Some a ->
      let at = index_of all a in
      let next = at + amount in
      if at >= 0 && next >= 0 && next < Array.length all then (
        focus all.(next);
        true)
      else false
  | None -> false

(* The segment nearest [from] on the side [sign] says, by where each is
   drawn, as React Aria moves through a right-to-left field. *)
let focus_beside input (from : Dom.element) sign =
  let x = rect_left (rect from) in
  let nearest =
    Array.fold_left
      (fun best s ->
        let d = rect_left (rect s) -. x in
        if d *. sign > 0. then
          match best with
          | Some (_, bd) when Float.abs bd <= Float.abs d -> best
          | Some _ | None -> Some (s, d)
        else best)
      None (focusable input)
  in
  match nearest with Some (s, _) -> focus s | None -> ()

(* The first segment with no part of those that end the field, or its last,
   as a press on the field outside a segment focuses. *)
let focus_last input =
  let all = focusable input in
  let n = Array.length all in
  if n > 0 then
    let rec back i =
      if
        i > 0
        && Option.is_some
             (Js.Null.toOption (closest all.(i - 1) "[data-placeholder]"))
        && Option.is_some
             (Js.Null.toOption (closest all.(i) "[data-placeholder]"))
      then back (i - 1)
      else i
    in
    focus all.(back (n - 1))

let format_options ~granularity ~time_zone ~hide_time_zone ~hour_cycle ~show_era
    ~leading_zeros ?(month = "numeric") () =
  let two = leading_zeros in
  let until =
    match granularity with
    | `day -> 2
    | `hour -> 3
    | `minute -> 4
    | `second -> 5
  in
  (* Each key's place among a format's, from the year to the second. *)
  let shown k =
    let at =
      match k with
      | `year -> 0
      | `month -> 1
      | `day -> 2
      | `hour -> 3
      | `minute -> 4
      | `second -> 5
    in
    at <= until
  in
  let pick k numeric = if shown k then Some numeric else None in
  let timed = until >= 3 in
  Dt.DateTimeFormatOptions.make ?year:(pick `year "numeric")
    ?month:
      (pick `month
         (if String.equal month "numeric" && two then "2-digit" else month))
    ?day:(pick `day (if two then "2-digit" else "numeric"))
    ?hour:(pick `hour (if two then "2-digit" else "numeric"))
    ?minute:(pick `minute "2-digit") ?second:(pick `second "2-digit")
    ?hour12:
      (Option.map
         (fun (c : [ `h12 | `h24 ]) ->
           match c with `h12 -> true | `h24 -> false)
         hour_cycle)
    ~time_zone:(Option.value time_zone ~default:"UTC")
    ?time_zone_name:
      (match time_zone with
      | Some _ when timed && not hide_time_zone -> Some `short
      | Some _ | None -> None)
    ?era:(if show_era then Some `short else None)
    ()

(* A field of any kind of value: what each root is, given its kind. *)
let field (type v) ~(kind : v kind) ~(value : v Js.Nullable.t option S.accessor)
    ~(default_value : v option) ~(on_change : v option -> unit)
    ~(placeholder_value : v option S.accessor)
    ~(today : string -> Dt.Calendar.t -> v) ~(min_value : v option S.accessor)
    ~(max_value : v option S.accessor)
    ~(is_date_unavailable : (v -> bool) option S.accessor)
    ~(granularity : [ `day | `hour | `minute | `second ] S.accessor)
    ~(hour_cycle : [ `h12 | `h24 ] option S.accessor)
    ~(hide_time_zone : bool S.accessor) ~(leading_zeros : bool S.accessor)
    ~(is_required : bool S.accessor) ~(is_invalid : bool S.accessor)
    ~(is_disabled : bool S.accessor) ~(is_read_only : bool S.accessor)
    ~(name : string option S.accessor) ~(auto_focus : bool)
    ~(aria_label : string option S.accessor)
    ~(aria_labelledby : string option S.accessor)
    ~(aria_describedby : string option S.accessor)
    ~(input_role : [ `group | `presentation ] S.accessor)
    ~(translations : translations option S.accessor) ~(draw : inner -> 'r) : 'r
    =
  let i18n = I18n.use_locale () in
  (* A provider's locale, or en-GB, day before month as most of the world
     writes a date, never the browser's: Kobalte gives a provider's own locale
     each time it is asked, and where there is none a new one, the
     browser's. *)
  let provided = I18n.use_locale () == i18n in
  let locale =
    S.accessor (fun () ->
        if provided then K.I18n_UseLocale.locale i18n () else "en-GB")
  in
  let direction =
    S.accessor (fun () -> I18n.get_reading_direction (S.get locale))
  in
  let translations =
    S.accessor (fun () ->
        match S.get translations with
        | Some t -> t
        | None -> translations_for (S.get locale))
  in
  (* The locale's calendar and clock, or the clock [hour_cycle] asks for. *)
  let resolved =
    S.create_memo (fun () ->
        Dt.DateFormatter.resolved_options
          (Dt.DateFormatter.make (S.get locale)
             ~options:
               (Dt.DateTimeFormatOptions.make ~date_style:`short
                  ~time_style:`short
                  ?hour12:
                    (Option.map
                       (fun (c : [ `h12 | `h24 ]) ->
                         match c with `h12 -> true | `h24 -> false)
                       (S.get hour_cycle))
                  ())
             ())
          ())
  in
  let calendar =
    S.create_memo (fun () ->
        D.create_calendar
          (Dt.ResolvedDateTimeFormatOptions.calendar (S.get resolved)))
  in
  let cycle =
    S.create_memo (fun () ->
        match Dt.ResolvedDateTimeFormatOptions.hour_cycle (S.get resolved) with
        | Some c -> (c :> cycle)
        | None -> (
            match S.get hour_cycle with
            | Some `h12 -> `h12
            | Some `h24 | None -> `h23))
  in
  (* The value, given or kept. *)
  let kept, set_kept = S.create_signal default_value in
  let controlled () = Option.is_some (S.get value) in
  let current =
    S.create_memo (fun () ->
        match S.get value with
        | Some v -> Js.Nullable.toOption v
        | None -> S.get kept)
  in
  let set_value v =
    if not (controlled ()) then S.set set_kept v;
    on_change v
  in
  (* What a value given is written in: its own calendar, or the placeholder's,
     else the Gregorian. *)
  let own_calendar () =
    match (S.get current, S.get placeholder_value) with
    | Some v, _ | None, Some v -> kind.calendar v
    | None, None -> D.create_calendar "gregory"
  in
  let zone () =
    match (S.get current, S.get placeholder_value) with
    | Some v, _ | None, Some v -> kind.zone v
    | None, None -> None
  in
  let time_zone =
    S.accessor (fun () -> Option.value (zone ()) ~default:"UTC")
  in
  let in_calendar v = kind.convert v (S.get calendar) in
  let calendar_value =
    S.create_memo (fun () -> Option.map in_calendar (S.get current))
  in
  let placeholder =
    S.create_memo (fun () ->
        match S.get placeholder_value with
        | Some p -> in_calendar p
        | None -> today (D.get_local_time_zone ()) (S.get calendar))
  in
  let base () =
    match S.get calendar_value with Some v -> v | None -> S.get placeholder
  in
  (* A date partly typed, or not yet a date, the field's alone until it is
     one; reset as the value is given again. *)
  let typed, set_typed = S.create_signal None in
  S.create_effect (fun () ->
      ignore (S.get calendar_value : v option);
      ignore (S.get cycle : cycle);
      S.set set_typed None);
  let shown =
    S.create_memo (fun () ->
        match S.get typed with
        | Some p -> p
        | None -> (
            match S.get calendar_value with
            | Some v -> parts_of kind (S.get cycle) v
            | None -> none))
  in
  let show_era () =
    String.equal (Dt.Calendar.identifier (S.get calendar)) "gregory"
    && Option.equal String.equal (S.get shown).era (Some "BC")
  in
  let shown_parts =
    S.create_memo (fun () : part list ->
        let all : part list =
          [ `era; `year; `month; `day; `hour ]
          @ (if twelve (S.get cycle) then [ `dayPeriod ] else [])
          @ [ `minute; `second ]
        in
        let last : part =
          match S.get granularity with
          | `day -> `day
          | `hour -> if twelve (S.get cycle) then `dayPeriod else `hour
          | `minute -> `minute
          | `second -> `second
        in
        let rec until = function
          | [] -> []
          | p :: rest -> if same p last then [ p ] else p :: until rest
        in
        until all)
  in
  let options ?month () =
    format_options ~granularity:(S.get granularity) ~time_zone:(zone ())
      ~hide_time_zone:(S.get hide_time_zone) ~hour_cycle:(S.get hour_cycle)
      ~show_era:(show_era ()) ~leading_zeros:(S.get leading_zeros) ?month ()
  in
  let formatter =
    S.create_memo (fun () ->
        Dt.DateFormatter.make (S.get locale) ~options:(options ()) ())
  in
  let format_resolved =
    S.create_memo (fun () ->
        Dt.DateFormatter.resolved_options (S.get formatter) ())
  in
  let date =
    S.create_memo (fun () ->
        kind.to_date
          (to_value kind (S.get cycle) (S.get shown) (base ()))
          (S.get time_zone))
  in
  let plain =
    S.create_memo (fun () ->
        number_format (S.get locale)
          (K.NumberFormatOptions.make ~use_grouping:(K.Either.right false) ()))
  in
  let two_digit =
    S.create_memo (fun () ->
        number_format (S.get locale)
          (K.NumberFormatOptions.make ~use_grouping:(K.Either.right false)
             ~minimum_integer_digits:2. ()))
  in
  let segments =
    S.create_memo (fun () ->
        let p = S.get shown in
        let cal = S.get calendar and cycle = S.get cycle in
        let opts = S.get format_resolved in
        let two t =
          let o =
            match t with
            | `year -> Dt.ResolvedDateTimeFormatOptions.year opts
            | `month -> Dt.ResolvedDateTimeFormatOptions.month opts
            | `day -> Dt.ResolvedDateTimeFormatOptions.day opts
            | `hour -> Dt.ResolvedDateTimeFormatOptions.hour opts
          in
          Option.equal String.equal o (Some "2-digit")
        in
        let number t n =
          K.NumberFormat.format
            (S.get (if two t then two_digit else plain))
            (float_of_int n)
        in
        let granularity_type : segment_type =
          match S.get granularity with
          | `day -> `day
          | `hour -> `hour
          | `minute -> `minute
          | `second -> `second
        in
        Dt.DateFormatter.format_to_parts (S.get formatter) (S.get date)
        |> Array.to_list
        |> List.concat_map (fun part ->
            let t = segment_type_of (part_type part) in
            let written = Dt.DateTimeFormatPart.value part in
            let written =
              match t with
              | `year -> number `year (Option.value p.year ~default:0)
              | `month -> number `month (Option.value p.month ~default:0)
              | `day -> number `day (Option.value p.day ~default:0)
              | `hour -> number `hour (Option.value p.hour ~default:0)
              | `era | `minute | `second | `dayPeriod | `timeZoneName | `literal
                ->
                  written
            in
            let s =
              match part_of t with
              | None -> { (literal written) with type_ = t; placeholder = "" }
              | Some part ->
                  let value, least, greatest = limits cal cycle p part in
                  let empty = not (has p part) in
                  let ph = placeholder_of (S.get locale) t written in
                  {
                    type_ = t;
                    text = (if empty then ph else written);
                    value;
                    min_value = Some least;
                    max_value = Some greatest;
                    is_placeholder = empty;
                    placeholder = ph;
                    is_editable =
                      (match part with
                      | `era -> Array.length (Dt.Calendar.get_eras cal ()) > 1
                      | `year | `month | `day | `hour | `dayPeriod | `minute
                      | `second ->
                          true);
                  }
            in
            (* React Aria isolates a time's digits, from the hour to its last
               part, so they read left to right in any language. *)
            match (t, granularity_type) with
            | `hour, `hour -> [ literal {js|⁦|js}; s; literal {js|⁩|js} ]
            | `hour, _ -> [ literal {js|⁦|js}; s ]
            | `minute, `minute | `second, `second -> [ s; literal {js|⁩|js} ]
            | _ -> [ s ])
        |> Array.of_list)
  in
  (* A change of the parts: a value once they make a date, which differs from
     the one it has; else the field's own. *)
  let change (p : parts) =
    if not (S.get is_disabled || S.get is_read_only) then
      let parts = S.get shown_parts in
      if cleared p parts then (
        S.set set_typed None;
        if Option.is_some (S.get current) then set_value None)
      else if complete p parts then
        let v = to_value kind (S.get cycle) p (base ()) in
        if matches kind (S.get cycle) p v parts then (
          let v = kind.convert v (own_calendar ()) in
          match S.get current with
          | Some c when Float.equal (kind.compare v c) 0. ->
              S.set set_typed (Some p)
          | Some _ | None ->
              S.set set_typed None;
              set_value (Some v))
        else S.set set_typed (Some p)
      else S.set set_typed (Some p)
  in
  (* As focus leaves the field, a whole date that is not one is made one. *)
  let confirm () =
    if not (S.get is_disabled || S.get is_read_only) then
      let p = S.get shown in
      if complete p (S.get shown_parts) then (
        let v =
          kind.convert
            (to_value kind (S.get cycle) p (base ()))
            (own_calendar ())
        in
        S.set set_typed None;
        match S.get current with
        | Some c when Float.equal (kind.compare v c) 0. -> ()
        | Some _ | None -> set_value (Some v))
  in
  let invalid =
    S.create_memo (fun () ->
        S.get is_invalid
        ||
        match S.get current with
        | None -> false
        | Some v -> (
            (match S.get min_value with
              | Some m -> kind.compare v m < 0.
              | None -> false)
            || (match S.get max_value with
              | Some m -> kind.compare v m > 0.
              | None -> false)
            ||
            match S.get is_date_unavailable with
            | Some f -> f v
            | None -> false))
  in
  let input, set_input = S.create_signal None in
  let label_id = S.create_unique_id () in
  let description_id = S.create_unique_id () in
  let error_id = S.create_unique_id () in
  let value_id = S.create_unique_id () in
  let label_here, labelled = named label_id in
  let description_here, described = named description_id in
  let error_here, errored = named error_id in
  let ids l =
    match List.filter_map Fun.id l with
    | [] -> None
    | some -> Some (String.concat " " some)
  in
  (* The value as a reader is told it, its month in words. *)
  let spoken =
    S.create_memo (fun () ->
        match S.get calendar_value with
        | None -> None
        | Some _ ->
            Some
              ( Dt.DateFormatter.make (S.get locale)
                  ~options:(options ~month:"long" ()) (),
                S.get date ))
  in
  let value_text =
    S.create_memo (fun () ->
        Option.map
          (fun (format, d) ->
            (S.get translations).selected_date_description
              (Dt.DateFormatter.format format d))
          (S.get spoken))
  in
  let labelled_by =
    S.accessor (fun () -> ids [ labelled (); S.get aria_labelledby ])
  in
  let described_by =
    S.accessor (fun () ->
        ids [ described (); errored (); S.get aria_describedby ])
  in
  let root, set_root = S.create_signal None in
  let f =
    {
      public =
        {
          segments;
          is_disabled;
          is_read_only;
          is_required;
          is_invalid = invalid;
          labelled_by;
          described_by =
            S.accessor (fun () ->
                match (S.get value_text, S.get described_by) with
                | Some _, Some d -> Some (value_id ^ " " ^ d)
                | Some _, None -> Some value_id
                | None, d -> d);
        };
      input_role;
      confirm;
      spoken;
      own_described_by = described_by;
      set_root = (fun e -> S.set set_root (Some e));
      hidden =
        (fun () ->
          Jsx.fragment
            [|
              <Solidtype.Show.Some some=(S.get value_text)>
                (fun text ->
                  <span id=value_id style="display: none">
                    (Jsx.string (S.get text))
                  </span>)
              </Solidtype.Show.Some>;
              <input
                type_="hidden"
                ?name=(S.get name)
                value=(match S.get current with
                      | Some v -> kind.to_string v
                      | None -> "")
                disabled=(S.get is_disabled)
              />;
            |]);
      locale;
      direction;
      cycle;
      date;
      time_zone;
      calendar;
      set_part =
        (fun part n ->
          change
            (set kind (S.get cycle) (S.get shown) part n
               ~placeholder:(S.get placeholder)));
      set_era =
        (fun e -> change { (S.get shown) with era = Some e; offset = None });
      clear_part = (fun part -> change (clear (S.get shown) part));
      step_part =
        (fun part amount ->
          change
            (step kind (S.get calendar) (S.get cycle) (S.get shown) part amount
               ~placeholder:(S.get placeholder) ~shown:(S.get shown_parts)));
      to_least =
        (fun part ->
          let _, least, _ =
            limits (S.get calendar) (S.get cycle) (S.get shown) part
          in
          let least =
            match (part, S.get cycle) with `hour, `h12 -> 12 | _ -> least
          in
          change
            (match part with
            | `era ->
                {
                  (S.get shown) with
                  era = Some (Dt.Calendar.get_eras (S.get calendar) ()).(least);
                }
            | _ ->
                set kind (S.get cycle) (S.get shown) part least
                  ~placeholder:(S.get placeholder)));
      to_greatest =
        (fun part ->
          let _, _, greatest =
            limits (S.get calendar) (S.get cycle) (S.get shown) part
          in
          let greatest =
            match (part, S.get cycle) with `hour, `h12 -> 11 | _ -> greatest
          in
          change
            (match part with
            | `era ->
                {
                  (S.get shown) with
                  era =
                    Some (Dt.Calendar.get_eras (S.get calendar) ()).(greatest);
                }
            | _ ->
                set kind (S.get cycle) (S.get shown) part greatest
                  ~placeholder:(S.get placeholder)));
      set_input = S.set set_input;
      input;
      label_id;
      label_here;
      description_id;
      description_here;
      error_id;
      error_here;
      aria_label;
      labelled_by;
      described_by;
    }
  in
  S.on_mount (fun () ->
      (if auto_focus then
         match S.get input with Some i -> focus_first i | None -> ());
      (* A form reset gives the field its first value back, as Kobalte's
         fields take it. *)
      match
        Option.bind (S.get root) (fun r -> Js.Null.toOption (closest r "form"))
      with
      | Some form ->
          let reset (_ : Dom.event) =
            S.set set_typed None;
            if not (controlled ()) then S.set set_kept default_value;
            on_change default_value
          in
          listen form "reset" reset;
          S.on_cleanup (fun () -> unlisten form "reset" reset)
      | None -> ());
  draw f

(* A field's root: a [<div>] around its parts, which confirms a date typed
   whole as the focus leaves it. *)
let draw_root ~others ~children (f : inner) =
  let root = ref None in
  <Field_context.Provider value=f>
    <div
      ref=(fun e ->
            let e = as_element e in
            root := Some e;
            f.set_root e)
      on_focus_out=(fun e ->
                     match (Js.Null.toOption (related e), !root) with
                     | Some to_, Some r when contains r to_ -> ()
                     | _ -> f.confirm ())
      data_invalid=(state (S.get f.public.is_invalid))
      data_disabled=(state (S.get f.public.is_disabled))
      data_readonly=(state (S.get f.public.is_read_only))
      data_required=(state (S.get f.public.is_required))
      ?as_=(S.drawn_as others)
      props=(S.undrawn others)>
      (children ()) (f.hidden ())
    </div>
  </Field_context.Provider>

(* The props every root takes beside its value. *)
module Common = struct
  type t
  type predicate

  external should_force_leading_zeros : t -> bool option
    = "shouldForceLeadingZeros"
  [@@mel.get]

  external is_required : t -> bool option = "isRequired" [@@mel.get]
  external is_invalid : t -> bool option = "isInvalid" [@@mel.get]
  external is_disabled : t -> bool option = "isDisabled" [@@mel.get]
  external is_read_only : t -> bool option = "isReadOnly" [@@mel.get]
  external name : t -> string option = "name" [@@mel.get]
  external auto_focus : t -> bool option = "autoFocus" [@@mel.get]
  external aria_label : t -> string option = "aria-label" [@@mel.get]
  external aria_labelledby : t -> string option = "aria-labelledby" [@@mel.get]

  external aria_describedby : t -> string option = "aria-describedby"
  [@@mel.get]

  external translations : t -> translations option = "translations" [@@mel.get]
  external children : t -> Jsx.element = "children" [@@mel.get]

  external granularity : t -> [ `day | `hour | `minute | `second ] option
    = "granularity"
  [@@mel.get]

  external hour_cycle : t -> [ `h12 | `h24 ] option = "hourCycle" [@@mel.get]
  external hide_time_zone : t -> bool option = "hideTimeZone" [@@mel.get]

  external input_role : t -> [ `group | `presentation ] option = "inputRole"
  [@@mel.get]

  (* The props a root takes for itself; the rest it passes on. *)
  let own =
    [|
      "value";
      "defaultValue";
      "onChange";
      "placeholderValue";
      "minValue";
      "maxValue";
      "isDateUnavailable";
      "granularity";
      "hourCycle";
      "hideTimeZone";
      "shouldForceLeadingZeros";
      "isRequired";
      "isInvalid";
      "isDisabled";
      "isReadOnly";
      "name";
      "autoFocus";
      "aria-label";
      "aria-labelledby";
      "aria-describedby";
      "translations";
      "inputRole";
      "children";
    |]

  external start_name : t -> string option = "startName" [@@mel.get]
  external end_name : t -> string option = "endName" [@@mel.get]

  let flag get props =
    S.accessor (fun () -> Option.value (get props) ~default:false)

  let make (type v) ~(kind : v kind) ~value ~default_value ~on_change
      ~placeholder_value ~today ~min_value ~max_value ~is_date_unavailable
      ~(granularity : [ `day | `hour | `minute | `second ] S.accessor)
      (props : t) ~others =
    field ~kind ~value ~default_value ~on_change ~placeholder_value ~today
      ~min_value ~max_value ~is_date_unavailable ~granularity
      ~hour_cycle:(S.accessor (fun () -> hour_cycle props))
      ~hide_time_zone:(flag hide_time_zone props)
      ~leading_zeros:(flag should_force_leading_zeros props)
      ~is_required:(flag is_required props) ~is_invalid:(flag is_invalid props)
      ~is_disabled:(flag is_disabled props)
      ~is_read_only:(flag is_read_only props)
      ~name:(S.accessor (fun () -> name props))
      ~auto_focus:
        (S.untrack (fun () -> Option.value (auto_focus props) ~default:false))
      ~aria_label:(S.accessor (fun () -> aria_label props))
      ~aria_labelledby:(S.accessor (fun () -> aria_labelledby props))
      ~aria_describedby:(S.accessor (fun () -> aria_describedby props))
      ~input_role:
        (S.accessor (fun () -> Option.value (input_role props) ~default:`group))
      ~translations:(S.accessor (fun () -> translations props))
      ~draw:(draw_root ~others ~children:(fun () -> children props))
end

(* What a root does of a value it is given: a value given, an empty one
   [Js.Nullable.null], or none, the root keeping its own. *)
let given value props = S.accessor (fun () -> value props)

(* Two dates as a reader is told them, split at the last literal their
   formatted range shares, as React Aria tells a range. *)
let told_range format a b =
  match Dt.DateFormatter.format_range_to_parts format a b with
  | exception Js.Exn.Error _ ->
      (Dt.DateFormatter.format format a, Dt.DateFormatter.format format b)
  | parts ->
      let separator = ref (-1) in
      (try
         Array.iteri
           (fun i p ->
             match
               (Dt.DateRangeFormatPart.source p, Dt.DateRangeFormatPart.type_ p)
             with
             | `shared, `literal -> separator := i
             | `endRange, _ -> raise Exit
             | _ -> ())
           parts
       with Exit -> ());
      let first = Buffer.create 16 and last = Buffer.create 16 in
      Array.iteri
        (fun i p ->
          if i < !separator then
            Buffer.add_string first (Dt.DateRangeFormatPart.value p)
          else if i > !separator then
            Buffer.add_string last (Dt.DateRangeFormatPart.value p))
        parts;
      (Buffer.contents first, Buffer.contents last)

(* A range's two fields under one root, as React Stately's range picker keeps
   them: each its end of the range, the range told once both are there and
   [None] as one is erased, invalid together, and described as a range. *)
let range_field (type v) ~(kind : v kind)
    ~(value : v range Js.Nullable.t option S.accessor)
    ~(default_value : v range option) ~(on_change : v range option -> unit)
    ~(placeholder_value : v option S.accessor)
    ~(today : string -> Dt.Calendar.t -> v) ~(min_value : v option S.accessor)
    ~(max_value : v option S.accessor)
    ~(is_date_unavailable : (v -> bool) option S.accessor)
    ~(granularity : [ `day | `hour | `minute | `second ] S.accessor)
    (props : Common.t) ~others =
  let i18n = I18n.use_locale () in
  let provided = I18n.use_locale () == i18n in
  let locale =
    S.accessor (fun () ->
        if provided then K.I18n_UseLocale.locale i18n () else "en-GB")
  in
  let words () =
    match Common.translations props with
    | Some t -> t
    | None -> translations_for (S.get locale)
  in
  let ends = function
    | Some r -> (Some r.start, Some r.end_)
    | None -> (None, None)
  in
  let partial, set_partial = S.create_signal (ends default_value) in
  let shown =
    S.create_memo (fun () ->
        match S.get value with
        | Some n -> (
            match Js.Nullable.toOption n with
            | Some r -> (Some r.start, Some r.end_)
            | None -> (
                (* A range controlled empty forgets one typed whole. *)
                match S.get partial with
                | Some _, Some _ -> (None, None)
                | p -> p))
        | None -> S.get partial)
  in
  let set (s, e) =
    let was = S.untrack (fun () -> S.get shown) in
    S.set set_partial (s, e);
    match ((s, e), was) with
    | (Some start, Some end_), _ -> on_change (Some { start; end_ })
    | _, (Some _, Some _) -> on_change None
    | _, _ -> ()
  in
  let out v =
    (match S.get min_value with
      | Some m -> kind.compare v m < 0.
      | None -> false)
    || (match S.get max_value with
      | Some m -> kind.compare v m > 0.
      | None -> false)
    || match S.get is_date_unavailable with Some f -> f v | None -> false
  in
  let invalid =
    S.create_memo (fun () ->
        Option.value (Common.is_invalid props) ~default:false
        ||
        match S.get shown with
        | Some s, Some e -> kind.compare e s < 0. || out s || out e
        | Some v, None | None, Some v -> out v
        | None, None -> false)
  in
  let flag get =
    S.accessor (fun () -> Option.value (get props) ~default:false)
  in
  let range_id = S.create_unique_id () in
  let engine ~name ~label ~labelled_by ~described_by ~auto_focus ~pick ~put =
    field ~kind
      ~value:
        (S.accessor (fun () ->
             Some (Js.Nullable.fromOption (pick (S.get shown)))))
      ~default_value:None
      ~on_change:(fun v -> put v (S.untrack (fun () -> S.get shown)))
      ~placeholder_value ~today ~min_value ~max_value ~is_date_unavailable
      ~granularity
      ~hour_cycle:(S.accessor (fun () -> Common.hour_cycle props))
      ~hide_time_zone:(flag Common.hide_time_zone)
      ~leading_zeros:(flag Common.should_force_leading_zeros)
      ~is_required:(flag Common.is_required) ~is_invalid:invalid
      ~is_disabled:(flag Common.is_disabled)
      ~is_read_only:(flag Common.is_read_only) ~name ~auto_focus
      ~aria_label:(S.accessor (fun () -> Some (label (words ()))))
      ~aria_labelledby:labelled_by ~aria_describedby:described_by
      ~input_role:(S.accessor (fun () -> `presentation))
      ~translations:(S.accessor (fun () -> Common.translations props))
      ~draw:(fun f -> f)
  in
  let joined l =
    match List.filter_map Fun.id l with
    | [] -> None
    | some -> Some (String.concat " " some)
  in
  let description, set_description = S.create_signal None in
  let described_by own =
    S.accessor (fun () ->
        joined [ Option.map (fun _ -> range_id) (S.get description); S.get own ])
  in
  let start =
    engine
      ~name:(S.accessor (fun () -> Common.start_name props))
      ~label:(fun w -> w.start_date)
      ~labelled_by:(S.accessor (fun () -> Common.aria_labelledby props))
      ~described_by:
        (described_by (S.accessor (fun () -> Common.aria_describedby props)))
      ~auto_focus:
        (S.untrack (fun () ->
             Option.value (Common.auto_focus props) ~default:false))
      ~pick:fst
      ~put:(fun v (_, e) -> set (v, e))
  in
  let end_ =
    engine
      ~name:(S.accessor (fun () -> Common.end_name props))
      ~label:(fun w -> w.end_date)
      ~labelled_by:start.labelled_by
      ~described_by:(described_by start.own_described_by)
      ~auto_focus:false ~pick:snd
      ~put:(fun v (s, _) -> set (s, v))
  in
  S.create_computed (fun () ->
      S.set set_description
        (match (S.get start.spoken, S.get end_.spoken) with
        | Some (format, a), Some (_, b) ->
            let first, last = told_range format a b in
            Some ((words ()).selected_range_description first last)
        | _ -> None));
  (* The parts above the fields -- the label, the description, a group and
     a picker's trigger -- read the range: named as its label names it,
     described by the range and its description, invalid as it is. *)
  let whole =
    {
      start with
      public =
        {
          start.public with
          is_invalid = invalid;
          labelled_by = start.labelled_by;
          described_by = described_by start.own_described_by;
        };
    }
  in
  <Field_context.Provider value=whole>
    <Slots_context.Provider value=[ ("start", start); ("end", end_) ]>
      <div
        data_invalid=(state (S.get invalid))
        data_disabled=(state (S.get start.public.is_disabled))
        data_readonly=(state (S.get start.public.is_read_only))
        data_required=(state (S.get start.public.is_required))
        ?as_=(S.drawn_as others)
        props=(S.undrawn others)>
        (Common.children props)
        <Solidtype.Show.Some some=(S.get description)>
          (fun text ->
            <span id=range_id style="display: none">
              (Jsx.string (S.get text))
            </span>)
        </Solidtype.Show.Some>
        (start.hidden ())
        (end_.hidden ())
      </div>
    </Slots_context.Provider>
  </Field_context.Provider>

module Root = struct
  module V = Dt.CalendarDate

  module Props = struct
    type t = Common.t

    external check :
      ?value:V.t Js.Nullable.t Solidtype.Check.value ->
      ?default_value:V.t Solidtype.Check.value ->
      ?on_change:(V.t option -> unit) ->
      ?placeholder_value:V.t Solidtype.Check.value ->
      ?min_value:V.t Solidtype.Check.value ->
      ?max_value:V.t Solidtype.Check.value ->
      ?is_date_unavailable:(V.t -> bool) ->
      ?should_force_leading_zeros:bool Solidtype.Check.value ->
      ?is_required:bool Solidtype.Check.value ->
      ?is_invalid:bool Solidtype.Check.value ->
      ?is_disabled:bool Solidtype.Check.value ->
      ?is_read_only:bool Solidtype.Check.value ->
      ?name:string Solidtype.Check.value ->
      ?auto_focus:bool Solidtype.Check.value ->
      ?aria_label:string Solidtype.Check.value ->
      ?aria_labelledby:string Solidtype.Check.value ->
      ?aria_describedby:string Solidtype.Check.value ->
      ?translations:translations Solidtype.Check.value ->
      ?input_role:[ `group | `presentation ] Solidtype.Check.value ->
      ?as_:(Solidtype.Html.Div.props -> Solidtype.Jsx.element) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `elements ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external value : t -> V.t Js.Nullable.t option = "value" [@@mel.get]
    external default_value : t -> V.t option = "defaultValue" [@@mel.get]

    external on_change : t -> ((V.t option -> unit)[@u]) option = "onChange"
    [@@mel.get]

    external placeholder_value : t -> V.t option = "placeholderValue"
    [@@mel.get]

    external min_value : t -> V.t option = "minValue" [@@mel.get]
    external max_value : t -> V.t option = "maxValue" [@@mel.get]

    external unavailable_given : t -> Common.predicate option
      = "isDateUnavailable"
    [@@mel.get]

    external is_date_unavailable : t -> V.t -> bool = "isDateUnavailable"
    [@@mel.send]
  end

  let make (props : Props.t) =
    Common.make ~kind:date_kind ~value:(given Props.value props)
      ~default_value:(S.untrack (fun () -> Props.default_value props))
      ~on_change:(fun v -> Jsx.call (Props.on_change props) v)
      ~placeholder_value:(given Props.placeholder_value props)
      ~today:(fun zone calendar -> D.to_calendar (D.today zone) calendar)
      ~min_value:(given Props.min_value props)
      ~max_value:(given Props.max_value props)
      ~is_date_unavailable:
        (S.accessor (fun () ->
             Option.map
               (fun _ v -> Props.is_date_unavailable props v)
               (Props.unavailable_given props)))
      ~granularity:(S.accessor (fun () -> `day))
      props ~others:(S.omit props Common.own)

  let component = Jsx.component make
end

