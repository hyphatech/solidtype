(* Any element as the element it is, which DOM's every element is. *)
external as_element : _ Dom.element_like -> Dom.element = "%identity"
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]
external focus_element : _ Dom.element_like -> unit = "focus" [@@mel.send]

external contains : _ Dom.element_like -> Dom.element -> bool = "contains"
[@@mel.send]

external query : _ Dom.element_like -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]
external shift_key : Dom.keyboardEvent -> bool = "shiftKey" [@@mel.get]
external alt : Dom.keyboardEvent -> bool = "altKey" [@@mel.get]
external ctrl : Dom.keyboardEvent -> bool = "ctrlKey" [@@mel.get]
external meta : Dom.keyboardEvent -> bool = "metaKey" [@@mel.get]
external prevent_key : Dom.keyboardEvent -> unit = "preventDefault" [@@mel.send]
external prevent_mouse : Dom.mouseEvent -> unit = "preventDefault" [@@mel.send]

external related : Dom.focusEvent -> Dom.element Js.null = "relatedTarget"
[@@mel.get]

external closest : _ Dom.element_like -> string -> Dom.element Js.null
  = "closest"
[@@mel.send]

external window_listen : string -> (Dom.event -> unit) -> unit
  = "addEventListener"
[@@mel.scope "window"]

external window_unlisten : string -> (Dom.event -> unit) -> unit
  = "removeEventListener"
[@@mel.scope "window"]

type listening

external listening : passive:bool -> capture:bool -> listening = "" [@@mel.obj]

external listen :
  Dom.element -> string -> (Dom.event -> unit) -> listening -> unit
  = "addEventListener"
[@@mel.send]

external unlisten :
  Dom.element -> string -> (Dom.event -> unit) -> listening -> unit
  = "removeEventListener"
[@@mel.send]

external event_target : Dom.event -> Dom.element Js.null = "target" [@@mel.get]

external event_related : Dom.event -> Dom.element Js.null = "relatedTarget"
[@@mel.get]

external prevent : Dom.event -> unit = "preventDefault" [@@mel.send]

(* A pointer of no size is a screen reader's, which clicks after it. *)
external width : Dom.event -> float Js.undefined = "width" [@@mel.get]
external height : Dom.event -> float Js.undefined = "height" [@@mel.get]

external pointer_type : Dom.pointerEvent -> string Js.undefined = "pointerType"
[@@mel.get]

external button : Dom.pointerEvent -> int = "button" [@@mel.get]
external pointer_id : Dom.pointerEvent -> int = "pointerId" [@@mel.get]

external pointer_element : Dom.pointerEvent -> Dom.element = "currentTarget"
[@@mel.get]

type capture

external capture : Dom.element -> capture Js.undefined = "releasePointerCapture"
[@@mel.get]

external has_capture : Dom.element -> int -> bool = "hasPointerCapture"
[@@mel.send]

external release_capture : Dom.element -> int -> unit = "releasePointerCapture"
[@@mel.send]

external prevent_pointer : Dom.pointerEvent -> unit = "preventDefault"
[@@mel.send]

external detail : Dom.mouseEvent -> int = "detail" [@@mel.get]

type timer

external set_timeout : (unit -> unit) -> int -> timer = "setTimeout"
external clear_timeout : timer -> unit = "clearTimeout"

type duration = Months of int | Weeks of int | Days of int
type day_of_week = [ `sun | `mon | `tue | `wed | `thu | `fri | `sat ]
type range = { start : C.t; end_ : C.t }

