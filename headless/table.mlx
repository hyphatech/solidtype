module S = Solidtype.Solid
module Jsx = Solidtype.Jsx
module Show = Solidtype.Show
module Selection = Solidtype_kobalte.Selection
module Types = Solidtype_kobalte.Types
module Either = Types.Either
module List_state = Types.ListState
module Manager = Types.MultipleSelectionManager
module Selectable_list = Types.Selection_CreateSelectableList
module Selectable_item = Types.Selection_CreateSelectableItem

external focus : Dom.element -> unit = "focus" [@@mel.send]

external parent : Dom.element -> Dom.element Js.null = "parentElement"
[@@mel.get]

external text_content : _ Dom.element_like -> string = "textContent" [@@mel.get]
external active : Dom.element Js.null = "activeElement" [@@mel.scope "document"]

external attribute : Dom.element -> string -> string Js.null = "getAttribute"
[@@mel.send]

external query_all :
  _ Dom.element_like -> string -> Dom.element Js.Array.array_like
  = "querySelectorAll"
[@@mel.send]

external closest : Dom.element -> string -> Dom.element Js.null = "closest"
[@@mel.send]

(* Whether [other] follows [e] on the page, by DOM's bit for it. *)
external position : _ Dom.element_like -> _ Dom.element_like -> int
  = "compareDocumentPosition"
[@@mel.send]

external key : Dom.keyboardEvent -> string = "key" [@@mel.get]

(* A key's name, where a part's own [key] names something else. *)
let key_name = key

external event_target : _ Dom.event_like -> Dom.element = "target" [@@mel.get]

external prevent_default : Dom.keyboardEvent -> unit = "preventDefault"
[@@mel.send]

(* Whether an event began in a control inside a row, whose press is its own,
   as a pressable element inside React Aria's row keeps its press. *)
let in_control e =
  Js.Null.toOption
    (closest (event_target e)
       "input, button, select, textarea, a[href], label, [role=checkbox], \
        [role=button]")
  <> None

(* Columns, or a row's cells, each placed in order: by the order they were
   made until it is on the page -- the server's only order, which the
   browser's agrees with as it hydrates -- then by where it is, so one added
   between two, or one gone, moves those after it. *)
type placing = {
  made : int ref;
  on_page : Dom.htmlTableCellElement list S.accessor;
  set_on_page : Dom.htmlTableCellElement list S.setter;
  alive : int S.accessor;
  set_alive : int S.setter;
}

let placing () =
  let on_page, set_on_page = S.create_signal [] in
  let alive, set_alive = S.create_signal 0 in
  { made = ref 0; on_page; set_on_page; alive; set_alive }

(* Where a part made now is, given what will be its element. *)
let place p element =
  let made = !(p.made) in
  incr p.made;
  S.update p.set_alive succ;
  let placed = ref None in
  S.on_mount (fun () ->
      Option.iter
        (fun e ->
          placed := Some e;
          S.update p.set_on_page (fun l -> e :: l))
        (S.get element));
  S.on_cleanup (fun () ->
      S.update p.set_alive pred;
      Option.iter
        (fun e -> S.update p.set_on_page (List.filter (fun o -> o != e)))
        !placed);
  fun () ->
    let on_page = S.get p.on_page in
    match !placed with
    | Some e ->
        List.length
          (List.filter (fun o -> o != e && position e o land 2 <> 0) on_page)
    | None -> made

(* How many there are. *)
let count p () = S.get p.alive

(* A row as the table keeps it: its key, and its element, which says where it
   is on the page. *)
type row = { key : string; element : Dom.htmlTableRowElement }

type sort_descriptor = {
  column : string;
  direction : [ `ascending | `descending ];
}

type context = {
  selection_mode : unit -> [ `none | `single | `multiple ];
  sort : unit -> sort_descriptor option;
  sort_by : string -> unit;
  is_selected : string -> bool;
  is_disabled : string -> bool;
  toggle : string -> unit;
  is_select_all : unit -> bool;
  is_empty : unit -> bool;
  select_all : unit -> unit;
  clear_selection : unit -> unit;
  resizing_column : unit -> string option;
}

type column_size = Pixels of float | Percent of float | Fraction of float

(* A column as a resizable table lays it out: how wide it asks to be, and
   within what. *)
type flex_item = {
  base : float;
  flex : float;
  min : float;
  max : float;
  mutable frozen : bool;
  mutable target : float;
  mutable violation : float;
}

let sign x = if x > 0. then 1 else if x < 0. then -1 else 0

(* JavaScript's Math.round, which rounds a half up. *)
let round x = Float.floor (x +. 0.5)

(* Each column's width in pixels, as React Stately lays a resizable table's
   columns out: CSS's flex algorithm (CSS Flexible Box Layout, 9.7), every
   basis zero and always growing, fixed sizes and percentages frozen at once,
   then rounded so the widths add up to the table's. *)
let column_widths ~available (columns : (column_size * float * float) array) =
  let whole = Float.floor available in
  let items =
    Array.map
      (fun (size, min, max) ->
        let fixed width =
          let clamped = Float.max min (Float.min width max) in
          {
            base = width;
            flex = 0.;
            min;
            max;
            frozen = true;
            target = clamped;
            violation = 0.;
          }
        in
        match size with
        | Pixels p -> fixed p
        | Percent p -> fixed (whole *. p /. 100.)
        | Fraction f when f <= 0. -> fixed 0.
        | Fraction f ->
            {
              base = 0.;
              flex = f;
              min;
              max;
              frozen = false;
              target = 0.;
              violation = 0.;
            })
      columns
  in
  let unfrozen () = Array.exists (fun i -> not i.frozen) items in
  while unfrozen () do
    let used = ref 0. and factors = ref 0. in
    Array.iter
      (fun i ->
        if i.frozen then used := !used +. i.target
        else begin
          used := !used +. i.base;
          factors := !factors +. i.flex
        end)
      items;
    let free = whole -. !used in
    if free > 0. then
      Array.iter
        (fun i ->
          if not i.frozen then i.target <- i.base +. (i.flex /. !factors *. free))
        items;
    let total = ref 0. in
    Array.iter
      (fun i ->
        i.violation <- 0.;
        if not i.frozen then begin
          let clamped = Float.max i.min (Float.min i.target i.max) in
          i.violation <- clamped -. i.target;
          i.target <- clamped;
          total := !total +. i.violation
        end)
      items;
    Array.iter
      (fun i ->
        if Float.equal !total 0. || sign !total = sign i.violation then
          i.frozen <- true)
      items
  done;
  let exact = ref 0. and rounded = ref 0. in
  let widths =
    Array.map
      (fun i ->
        let width = round (i.target +. !exact) -. !rounded in
        exact := !exact +. i.target;
        rounded := !rounded +. width;
        width)
      items
  in
  let n = Array.length widths in
  if n > 0 && available > whole then
    widths.(n - 1) <- widths.(n - 1) +. (available -. whole);
  widths

(* What a resizable container tells the table inside it: how wide it is, and
   whom a resize is told. *)
type container = {
  width : unit -> float;
  on_resize_start : (string * column_size) array -> unit;
  on_resize : (string * column_size) array -> unit;
  on_resize_end : (string * column_size) array -> unit;
}

module Container_context = Solidtype.Context.Make_optional (struct
  type t = container
end)

(* A column as the table lays it out: its key, its element, which says where
   it is, and the sizes it asks for. *)
type column_spec = {
  column_key : string;
  header : Dom.htmlTableCellElement;
  width : unit -> column_size option;
  default_width : column_size option;
  min_width : unit -> float option;
  max_width : unit -> float option;
}

(* What the parts of a resizable table read of its layout, and how a resize
   changes it. *)
type sizing = {
  width_of : string -> float;
  min_of : string -> float;
  max_of : string -> float;
  resizing : unit -> string option;
  set_resizing : string option -> unit;
  resize_to : string -> float -> (string * column_size) array;
      (** A column given a width: every column's size after it. *)
  told : container;
}

(* What the parts read of their table beside what a style reads: its rows in
   the page's order, Kobalte's selection of them, its columns, and their
   layout where it is resizable. *)
type table = {
  context : context;
  rows : unit -> row list;
  add : row -> unit;
  remove : string -> unit;
  manager : Manager.t S.accessor;
  row_header : unit -> int;
  set_row_header : (unit -> int) option -> unit;
  columns : placing;
  add_column : column_spec -> unit;
  remove_column : string -> unit;
  sizing : sizing option;
}

module Table_context = Solidtype.Context.Make_optional (struct
  type t = table
end)

let in_table part =
  match Table_context.use () with
  | Some t -> t
  | None -> invalid_arg (part ^ " is used inside a Table.Root")

let use_context () = (in_table "Table.use_context").context

(* What a row's cells read of it: where they are, and the id of the one that
   names the row. *)
type row_cells = { cells : placing; header_id : string }

module Row_context = Solidtype.Context.Make_optional (struct
  type t = row_cells
end)

let role e = Js.Null.toOption (attribute e "role")

let has_role e name =
  match role e with Some r -> String.equal r name | None -> false

(* A row's cells, in order: a header's columns, or a body row's cells. *)
let cells row =
  Js.Array.from
    (query_all row
       ":scope > [role=gridcell], :scope > [role=rowheader], :scope > \
        [role=columnheader]")

let index_of e items =
  let rec find i =
    if i >= Array.length items then None
    else if items.(i) == e then Some i
    else find (i + 1)
  in
  find 0

(* Where a key moves focus from a cell, as an accessible grid moves it: along
   its row, back to the row from its first cell, and to the cell of the same
   column in the row above or below, the header's included. *)
let from_cell table cell k =
  match Js.Null.toOption (parent cell) with
  | None -> None
  | Some row -> (
      let along = cells row in
      let last = Array.length along - 1 in
      let i = Option.value (index_of cell along) ~default:0 in
      let body_row = Js.Null.toOption (attribute row "data-key") <> None in
      let vertical step =
        (* The header's row and the body's, never a row no key reaches: an
           empty state's or a loader's. *)
        let rows =
          Js.Array.from
            (query_all table "thead > tr[role=row], tr[role=row][data-key]")
        in
        match index_of row rows with
        | Some r when r + step >= 0 && r + step < Array.length rows ->
            let next = cells rows.(r + step) in
            if Array.length next = 0 then None
            else Some next.(min i (Array.length next - 1))
        | Some _ | None -> None
      in
      match k with
      | "ArrowRight" ->
          if i < last then Some along.(i + 1)
          else if body_row then Some row
          else None
      | "ArrowLeft" ->
          if i > 0 then Some along.(i - 1)
          else if body_row then Some row
          else None
      | "ArrowDown" -> vertical 1
      | "ArrowUp" -> vertical (-1)
      | "Home" -> if last >= 0 then Some along.(0) else None
      | "End" -> if last >= 0 then Some along.(last) else None
      | _ -> None)

(* From a row, the arrows across reach its first cell, or its last. *)
let from_row row k =
  let along = cells row in
  let last = Array.length along - 1 in
  match k with
  | "ArrowRight" when last >= 0 -> Some along.(0)
  | "ArrowLeft" when last >= 0 -> Some along.(last)
  | _ -> None

(* What a column may be at most: JavaScript's Number.MAX_SAFE_INTEGER, as a
   range's [max] reads it. *)
let max_safe = 9007199254740991.

external shift_key : Dom.keyboardEvent -> bool = "shiftKey" [@@mel.get]

external query_in : _ Dom.element_like -> string -> Dom.element Js.null
  = "querySelector"
[@@mel.send]

let tabindex = function Some i -> Js.Float.toString i | None -> "-1"

(* Kobalte's state, an attribute present and empty, or none. *)
let state on = if on then Jsx.data "" else Jsx.flag false

(* A handler or a ref the caller gave, called beside the part's own, as
   Kobalte's parts call theirs. *)
let call f x = match f with Some f -> f x [@u] | None -> ()

external client_width : _ Dom.element_like -> float = "clientWidth" [@@mel.get]

external same : _ Dom.element_like -> _ Dom.element_like -> bool = "isSameNode"
[@@mel.send]

type style

external computed : _ Dom.element_like -> style = "getComputedStyle"
[@@mel.scope "window"]

external overflow : style -> string = "overflow" [@@mel.get]
external overflow_x : style -> string = "overflowX" [@@mel.get]
external overflow_y : style -> string = "overflowY" [@@mel.get]
external cursor : style -> string = "cursor" [@@mel.get]

let scrolls e =
  let style = computed e in
  List.exists
    (fun o -> String.equal o "auto" || String.equal o "scroll")
    [ overflow style; overflow_x style; overflow_y style ]

type resize_observer

external resize_observer : ((unit -> unit)[@mel.uncurry]) -> resize_observer
  = "ResizeObserver"
[@@mel.new]

external watch_size : resize_observer -> _ Dom.element_like -> unit = "observe"
[@@mel.send]

external stop_watching : resize_observer -> unit = "disconnect" [@@mel.send]

module Resizable_container = struct
  module Props = struct
    type t

    external check :
      ?on_resize_start:((string * column_size) array -> unit) ->
      ?on_resize:((string * column_size) array -> unit) ->
      ?on_resize_end:((string * column_size) array -> unit) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external on_resize_start :
      t -> (((string * column_size) array -> unit)[@u]) option = "onResizeStart"
    [@@mel.get]

    external on_resize :
      t -> (((string * column_size) array -> unit)[@u]) option = "onResize"
    [@@mel.get]

    external on_resize_end :
      t -> (((string * column_size) array -> unit)[@u]) option = "onResizeEnd"
    [@@mel.get]

    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlDivElement -> unit)[@u]) option = "ref"
    [@@mel.get]
  end

  let make (props : Props.t) =
    let width, set_width = S.create_signal 0. in
    let container = ref None in
    (* What is measured is what scrolls the table: the first element from the
       table up that scrolls, else the container, as React Aria measures it,
       since a scrollbar takes from the width. *)
    S.on_mount (fun () ->
        Option.iter
          (fun (c : Dom.htmlDivElement) ->
            let rec up e =
              if same e c || scrolls e then e
              else
                match Js.Null.toOption (parent e) with
                | Some p -> up p
                | None -> e
            in
            let watch measured =
              let measure () = S.set set_width (client_width measured) in
              measure ();
              let o = resize_observer measure in
              watch_size o measured;
              S.on_cleanup (fun () -> stop_watching o)
            in
            match Js.Null.toOption (query_in c "table") with
            | Some table -> watch (up table)
            | None -> watch c)
          !container);
    let told =
      {
        width = (fun () -> S.get width);
        on_resize_start =
          (fun sizes -> call (Props.on_resize_start props) sizes);
        on_resize = (fun sizes -> call (Props.on_resize props) sizes);
        on_resize_end = (fun sizes -> call (Props.on_resize_end props) sizes);
      }
    in
    <Container_context.Provider value=(fun () -> told)>
      <div
        ref=(fun e ->
              container := Some e;
              call (Props.ref props) e)
        props=(S.omit props
                 [|
                   "onResizeStart"; "onResize"; "onResizeEnd"; "children"; "ref";
                 |])>
        (fun () -> Props.children props)
      </div>
    </Container_context.Provider>

  let component = Jsx.component make
end

module Root = struct
  module Props = struct
    type t

    external check :
      ?selection_mode:[ `none | `single | `multiple ] Solidtype.Check.value ->
      ?selection_behavior:[ `toggle | `replace ] Solidtype.Check.value ->
      ?selected_keys:string array Solidtype.Check.value ->
      ?default_selected_keys:string array Solidtype.Check.value ->
      ?on_selection_change:(string array -> unit) ->
      ?disabled_keys:string array Solidtype.Check.value ->
      ?disallow_empty_selection:bool Solidtype.Check.value ->
      ?sort_descriptor:sort_descriptor Solidtype.Check.value ->
      ?on_sort_change:(sort_descriptor -> unit) ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Table.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external selection_mode : t -> [ `none | `single | `multiple ] option
      = "selectionMode"
    [@@mel.get]

    external selection_behavior : t -> [ `toggle | `replace ] option
      = "selectionBehavior"
    [@@mel.get]

    external selected_keys : t -> string array option = "selectedKeys"
    [@@mel.get]

    external default_selected_keys : t -> string array option
      = "defaultSelectedKeys"
    [@@mel.get]

    external on_selection_change : t -> ((string array -> unit)[@u]) option
      = "onSelectionChange"
    [@@mel.get]

    external disabled_keys : t -> string array option = "disabledKeys"
    [@@mel.get]

    external disallow_empty_selection : t -> bool option
      = "disallowEmptySelection"
    [@@mel.get]

    external sort_descriptor : t -> sort_descriptor option = "sortDescriptor"
    [@@mel.get]

    external on_sort_change : t -> ((sort_descriptor -> unit)[@u]) option
      = "onSortChange"
    [@@mel.get]

    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlTableElement -> unit)[@u]) option = "ref"
    [@@mel.get]

    external on_key_down : t -> ((Dom.keyboardEvent -> unit)[@u]) option
      = "onKeyDown"
    [@@mel.get]

    external on_mouse_down : t -> ((Dom.mouseEvent -> unit)[@u]) option
      = "onMouseDown"
    [@@mel.get]

    external on_focus_in : t -> ((Dom.focusEvent -> unit)[@u]) option
      = "onFocusIn"
    [@@mel.get]

    external on_focus_out : t -> ((Dom.focusEvent -> unit)[@u]) option
      = "onFocusOut"
    [@@mel.get]
  end

  (* The props the table takes for itself; the rest it passes on. *)
  let own =
    [|
      "selectionMode";
      "selectionBehavior";
      "selectedKeys";
      "defaultSelectedKeys";
      "onSelectionChange";
      "disabledKeys";
      "disallowEmptySelection";
      "sortDescriptor";
      "onSortChange";
      "children";
      "ref";
      "onKeyDown";
      "onMouseDown";
      "onFocusIn";
      "onFocusOut";
    |]

  let make (props : Props.t) =
    let selection_mode () =
      Option.value (Props.selection_mode props) ~default:`none
    in
    let rows, set_rows = S.create_signal [] in
    let ordered () =
      List.sort
        (fun a b -> if position a.element b.element land 4 <> 0 then -1 else 1)
        (S.get rows)
    in
    let keys =
      S.create_memo (fun () ->
          Array.of_list (List.map (fun r -> r.key) (ordered ())))
    in
    let disabled k =
      match Props.disabled_keys props with
      | Some keys -> Array.exists (String.equal k) keys
      | None -> false
    in
    let text k =
      match List.find_opt (fun r -> String.equal r.key k) (S.get rows) with
      | Some r -> text_content r.element
      | None -> ""
    in
    let state =
      Selection.create_list_state
        (Types.CreateListStateProps.make ~data_source:(Either.right keys)
           ~get_key:(Either.left Fun.id) ~get_text_value:(Either.left text)
           ~get_disabled:(Either.left disabled)
           ~selection_mode:
             (Either.right (S.create_memo (fun () -> Some (selection_mode ()))))
           ~selection_behavior:
             (Either.right
                (S.create_memo (fun () -> Props.selection_behavior props)))
           ~disallow_empty_selection:
             (Either.right
                (S.create_memo (fun () -> Props.disallow_empty_selection props)))
           ~selected_keys:
             (Either.right
                (S.create_memo (fun () -> Props.selected_keys props)))
           ?default_selected_keys:
             (Option.map Either.left
                (S.untrack (fun () -> Props.default_selected_keys props)))
           ~on_selection_change:(fun keys ->
             call (Props.on_selection_change props) (Js.Set.toArray keys))
           ())
    in
    let manager =
      S.create_memo (fun () ->
          Types.SelectionManager.to_multiple_selection_manager
            (S.get (List_state.selection_manager state)))
    in
    let element, set_element = S.create_signal None in
    let list =
      Selection.create_selectable_list
        (Types.CreateSelectableListProps.make
           ~collection:(List_state.collection state)
           ~selection_manager:(Either.right manager) ())
        element ()
    in
    let row_header, set_row_header = S.create_signal None in
    let m () = S.get manager in
    let specs, set_specs = S.create_signal [] in
    let ordered_columns () =
      List.sort
        (fun a b -> if position a.header b.header land 4 <> 0 then -1 else 1)
        (S.get specs)
    in
    let sizing =
      Option.map
        (fun (told : container) ->
          let kept, set_kept = S.create_signal [] in
          let resizing, set_resizing = S.create_signal None in
          let kept_size key =
            List.find_map
              (fun (k, size) -> if String.equal k key then Some size else None)
              (S.get kept)
          in
          let asked c =
            match c.width () with
            | Some w -> w
            | None -> (
                match kept_size c.column_key with
                | Some w -> w
                | None -> Option.value c.default_width ~default:(Fraction 1.))
          in
          let narrowest c = Option.value (c.min_width ()) ~default:75. in
          let widest c = Option.value (c.max_width ()) ~default:max_safe in
          let layout =
            S.create_memo (fun () ->
                let columns = Array.of_list (ordered_columns ()) in
                let widths =
                  column_widths ~available:(told.width ())
                    (Array.map
                       (fun c -> (asked c, narrowest c, widest c))
                       columns)
                in
                Array.mapi
                  (fun i c -> (c.column_key, widths.(i), narrowest c, widest c))
                  columns)
          in
          let laid key =
            Array.find_opt
              (fun (k, _, _, _) -> String.equal k key)
              (S.get layout)
          in
          let width_of key =
            match laid key with Some (_, w, _, _) -> w | None -> 0.
          in
          let min_of key =
            match laid key with Some (_, _, w, _) -> w | None -> 0.
          in
          let max_of key =
            match laid key with Some (_, _, _, w) -> w | None -> max_safe
          in
          (* As React Stately resizes: the columns before it keep the pixels
             they have, and those after it the sizes they ask for. *)
          let resize_to key wanted =
            let width =
              Float.max (min_of key)
                (Float.min (max_of key) (Float.floor wanted))
            in
            let before = ref true in
            let sizes =
              Array.of_list
                (List.map
                   (fun c ->
                     if String.equal c.column_key key then begin
                       before := false;
                       (key, Pixels width)
                     end
                     else if !before then
                       (c.column_key, Pixels (width_of c.column_key))
                     else (c.column_key, asked c))
                   (ordered_columns ()))
            in
            S.set set_kept
              ((key, Pixels wanted)
              :: List.filter_map
                   (fun c ->
                     match c.width () with
                     | Some _ -> None
                     | None ->
                         Array.find_opt
                           (fun (k, _) -> String.equal k c.column_key)
                           sizes)
                   (List.filter
                      (fun c -> not (String.equal c.column_key key))
                      (ordered_columns ())));
            sizes
          in
          {
            width_of;
            min_of;
            max_of;
            resizing = (fun () -> S.get resizing);
            set_resizing = S.set set_resizing;
            resize_to;
            told;
          })
        (Container_context.use ())
    in
    let t =
      {
        context =
          {
            selection_mode;
            sort = (fun () -> Props.sort_descriptor props);
            (* A column pressed is sorted ascending, or turned if it was. *)
            sort_by =
              (fun column ->
                let direction =
                  match Props.sort_descriptor props with
                  | Some { column = sorted; direction = `ascending }
                    when String.equal sorted column ->
                      `descending
                  | Some _ | None -> `ascending
                in
                call (Props.on_sort_change props) { column; direction });
            is_selected = (fun k -> Manager.is_selected (m ()) k);
            is_disabled = disabled;
            toggle = (fun k -> Manager.toggle_selection (m ()) k);
            is_select_all = (fun () -> S.get (Manager.is_select_all (m ())));
            is_empty = (fun () -> S.get (Manager.is_empty (m ())));
            select_all = (fun () -> Manager.select_all (m ()) ());
            clear_selection = (fun () -> Manager.clear_selection (m ()) ());
            resizing_column =
              (fun () ->
                match sizing with Some s -> s.resizing () | None -> None);
          };
        rows = ordered;
        add = (fun r -> S.set set_rows (r :: S.get rows));
        remove =
          (fun k ->
            S.set set_rows
              (List.filter (fun r -> not (String.equal r.key k)) (S.get rows)));
        manager;
        row_header =
          (fun () ->
            match S.get row_header with Some index -> index () | None -> 0);
        set_row_header = S.set set_row_header;
        columns = placing ();
        add_column = (fun c -> S.set set_specs (c :: S.get specs));
        remove_column =
          (fun k ->
            S.set set_specs
              (List.filter
                 (fun c -> not (String.equal c.column_key k))
                 (S.get specs)));
        sizing;
      }
    in
    (* The arrows across a row and through its cells are the table's, which
       Kobalte's list of rows does not know; the rest are the list's. From a
       cell, an arrow, Home and End are the grid's even where they reach
       nothing, as an accessible grid's are, or the list would move a row. *)
    let on_key_down e =
      call (Props.on_key_down props) e;
      let resizing =
        match sizing with
        | Some s -> Option.is_some (s.resizing ())
        | None -> false
      in
      let moved =
        match (Js.Null.toOption active, S.get element) with
        | _ when resizing -> `own
        (* Tab from a column's header reaches its resizer, as the page's
           order has it, where the list would leave the table. *)
        | Some focused, Some _
          when String.equal (key e) "Tab"
               && (not (shift_key e))
               && has_role focused "columnheader"
               && Option.is_some (Js.Null.toOption (query_in focused "input"))
          ->
            `own
        | Some focused, Some table -> (
            match role focused with
            | Some ("gridcell" | "rowheader" | "columnheader") -> (
                match key e with
                | "ArrowUp" | "ArrowDown" | "ArrowLeft" | "ArrowRight" | "Home"
                | "End" ->
                    `grid (from_cell table focused (key e))
                | _ -> `list)
            | Some "row" -> (
                match from_row focused (key e) with
                | Some target -> `grid (Some target)
                | None -> `list)
            | Some _ | None -> `list)
        | _ -> `list
      in
      match moved with
      | `grid target ->
          prevent_default e;
          Option.iter focus target
      | `own -> ()
      | `list -> Selectable_list.on_key_down list e
    in
    <Table_context.Provider value=(fun () -> t)>
      <table
        role=`grid
        ref=(fun e ->
              S.set set_element (Some e);
              call (Props.ref props) e)
        ?aria_multiselectable=(fun () ->
                                match selection_mode () with
                                | `multiple -> Some true
                                | `single | `none -> None)
        tabindex=(fun () -> tabindex (S.get (Selectable_list.tab_index list)))
        ?style=(fun () ->
                 match sizing with
                 | Some _ -> Some "table-layout: fixed; width: min-content;"
                 | None -> None)
        on_key_down
        on_mouse_down=(fun e ->
                        call (Props.on_mouse_down props) e;
                        Selectable_list.on_mouse_down list e)
        on_focus_in=(fun e ->
                      call (Props.on_focus_in props) e;
                      (* Kobalte's list, focused from outside, moves focus to
                         a row of its choosing, and a row whose key it is
                         given focuses itself: focus given a cell, or a
                         part inside one, a resizer's input, stays there, the
                         list only told it has focus. *)
                      match
                        Js.Null.toOption
                          (closest (event_target e)
                             "[role=gridcell], [role=rowheader], \
                              [role=columnheader]")
                      with
                      | Some _ -> Manager.set_focused (m ()) true
                      | None -> Selectable_list.on_focus_in list e)
        on_focus_out=(fun e ->
                       call (Props.on_focus_out props) e;
                       Selectable_list.on_focus_out list e)
        props=(S.omit props own)>
        (fun () -> Props.children props)
      </table>
    </Table_context.Provider>

  let component = Jsx.component make
end

module Header = struct
  module Props = struct
    type t

    external check :
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Thead.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external children : t -> Jsx.content = "children" [@@mel.get]
  end

  let make (props : Props.t) =
    let (_ : table) = in_table "Table.Header" in
    <thead role=`rowgroup props=(S.omit props [| "children" |])>
      <tr role=`row>(fun () -> Props.children props)</tr>
    </thead>

  let component = Jsx.component make
end

(* What a part inside a column reads of it: how it is sorted, and whether it
   is being resized. *)
type column = {
  direction : unit -> [ `ascending | `descending ] option;
  resizing : unit -> bool;
}

module Column_context = Solidtype.Context.Make_optional (struct
  type t = column
end)

(* What a resizer reads of its column: its key, and the id that names it. *)
type resized = { resized_key : string; header_id : string }

module Resized_context = Solidtype.Context.Make_optional (struct
  type t = resized
end)

let use_column_context () =
  match Column_context.use () with
  | Some c -> c
  | None -> invalid_arg "Table.use_column_context is used inside a Table.Column"

module Column = struct
  module Props = struct
    type t

    external check :
      ?id:string Solidtype.Check.value ->
      ?allows_sorting:bool Solidtype.Check.value ->
      ?is_row_header:bool Solidtype.Check.value ->
      ?width:column_size Solidtype.Check.value ->
      ?default_width:column_size Solidtype.Check.value ->
      ?min_width:float Solidtype.Check.value ->
      ?max_width:float Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Th.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external id : t -> string option = "id" [@@mel.get]
    external allows_sorting : t -> bool option = "allowsSorting" [@@mel.get]
    external is_row_header : t -> bool option = "isRowHeader" [@@mel.get]
    external width : t -> column_size option = "width" [@@mel.get]

    external default_width : t -> column_size option = "defaultWidth"
    [@@mel.get]

    external min_width : t -> float option = "minWidth" [@@mel.get]
    external max_width : t -> float option = "maxWidth" [@@mel.get]
    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlTableCellElement -> unit)[@u]) option = "ref"
    [@@mel.get]

    external on_click : t -> ((Dom.mouseEvent -> unit)[@u]) option = "onClick"
    [@@mel.get]

    external on_key_down : t -> ((Dom.keyboardEvent -> unit)[@u]) option
      = "onKeyDown"
    [@@mel.get]
  end

  (* The props the column takes for itself; the rest it passes on. *)
  let own =
    [|
      "id";
      "allowsSorting";
      "isRowHeader";
      "width";
      "defaultWidth";
      "minWidth";
      "maxWidth";
      "children";
      "ref";
      "onClick";
      "onKeyDown";
    |]

  let make (props : Props.t) =
    let t = in_table "Table.Column" in
    let element, set_element = S.create_signal None in
    let index = place t.columns element in
    let names_rows =
      S.untrack (fun () ->
          Option.value (Props.is_row_header props) ~default:false)
    in
    if names_rows then begin
      t.set_row_header (Some index);
      S.on_cleanup (fun () -> t.set_row_header None)
    end;
    let key =
      match S.untrack (fun () -> Props.id props) with
      | Some k -> k
      | None -> S.create_unique_id ()
    in
    let sortable () =
      Option.value (Props.allows_sorting props) ~default:false
    in
    let direction () =
      match t.context.sort () with
      | Some s when String.equal s.column key -> Some s.direction
      | Some _ | None -> None
    in
    (* A sortable column is pressed, by a pointer, Enter or Space, to be
       sorted by. *)
    let press () = if sortable () then t.context.sort_by key in
    let header_id = S.create_unique_id () in
    (* A resizable table lays its columns out once they are on the page. *)
    S.on_mount (fun () ->
        Option.iter
          (fun header ->
            t.add_column
              {
                column_key = key;
                header;
                width = (fun () -> Props.width props);
                default_width = S.untrack (fun () -> Props.default_width props);
                min_width = (fun () -> Props.min_width props);
                max_width = (fun () -> Props.max_width props);
              })
          (S.get element));
    S.on_cleanup (fun () -> t.remove_column key);
    let resizing () =
      match t.sizing with
      | Some s -> (
          match s.resizing () with
          | Some k -> String.equal k key
          | None -> false)
      | None -> false
    in
    <Column_context.Provider value=(fun () -> { direction; resizing })>
      <Resized_context.Provider
        value=(fun () -> { resized_key = key; header_id })>
        <th
          role=`columnheader
          id=(fun () -> header_id)
          tabindex="-1"
          aria_colindex=(fun () -> string_of_int (index () + 1))
          ?style=(fun () ->
                   Option.map
                     (fun s ->
                       "width: " ^ Js.Float.toString (s.width_of key) ^ "px;")
                     t.sizing)
          data_resizing=(fun () -> state (resizing ()))
          ref=(fun e ->
                S.set set_element (Some e);
                call (Props.ref props) e)
          ?aria_sort=(fun () ->
                       if sortable () then
                         Some
                           (match direction () with
                           | Some `ascending -> `ascending
                           | Some `descending -> `descending
                           | None -> `none)
                       else None)
          on_click=(fun e ->
                     call (Props.on_click props) e;
                     press ())
          on_key_down=(fun e ->
                        call (Props.on_key_down props) e;
                        (* A key in a part inside it, a resizer's, is the
                         part's. *)
                        match key_name e with
                        | ("Enter" | " ")
                          when sortable ()
                               && has_role (event_target e) "columnheader" ->
                            prevent_default e;
                            press ()
                        | _ -> ())
          props=(S.omit props own)>
          (fun () -> Props.children props)
        </th>
      </Resized_context.Provider>
    </Column_context.Provider>

  let component = Jsx.component make
end

module Body = struct
  module Props = struct
    type t

    external check :
      ?empty_state:Jsx.element Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Tbody.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external empty_state : t -> Jsx.element option = "emptyState" [@@mel.get]
    external children : t -> Jsx.content = "children" [@@mel.get]
  end

  let make (props : Props.t) =
    let t = in_table "Table.Body" in
    let empty () =
      match t.rows () with [] -> Props.empty_state props | _ :: _ -> None
    in
    <tbody role=`rowgroup props=(S.omit props [| "emptyState"; "children" |])>
      (fun () -> Props.children props)
      <Show.Some some=(fun () -> empty ())>
        (fun shown ->
          <tr role=`row>
            <td
              role=`rowheader
              colspan=(fun () -> string_of_int (count t.columns ()))>
              (fun () -> Jsx.element (S.get shown))
            </td>
          </tr>)
      </Show.Some>
    </tbody>

  let component = Jsx.component make
end

module Row = struct
  module Props = struct
    type t

    external check :
      id:string Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Tr.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external id : t -> string = "id" [@@mel.get]
    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlTableRowElement -> unit)[@u]) option = "ref"
    [@@mel.get]

    external on_pointer_down : t -> ((Dom.pointerEvent -> unit)[@u]) option
      = "onPointerDown"
    [@@mel.get]

    external on_pointer_up : t -> ((Dom.pointerEvent -> unit)[@u]) option
      = "onPointerUp"
    [@@mel.get]

    external on_click : t -> ((Dom.mouseEvent -> unit)[@u]) option = "onClick"
    [@@mel.get]

    external on_key_down : t -> ((Dom.keyboardEvent -> unit)[@u]) option
      = "onKeyDown"
    [@@mel.get]

    external on_mouse_down : t -> ((Dom.mouseEvent -> unit)[@u]) option
      = "onMouseDown"
    [@@mel.get]

    external on_focus : t -> ((Dom.focusEvent -> unit)[@u]) option = "onFocus"
    [@@mel.get]
  end

  (* The props the row takes for itself; the rest it passes on. *)
  let own =
    [|
      "id";
      "children";
      "ref";
      "onPointerDown";
      "onPointerUp";
      "onClick";
      "onKeyDown";
      "onMouseDown";
      "onFocus";
    |]

  let make (props : Props.t) =
    let t = in_table "Table.Row" in
    let key = S.untrack (fun () -> Props.id props) in
    let element, set_element = S.create_signal None in
    let item =
      Selection.create_selectable_item
        (Types.CreateSelectableItemProps.make
           ~selection_manager:(Either.right t.manager) ~key:(Either.left key) ())
        element
    in
    let r = { cells = placing (); header_id = S.create_unique_id () } in
    (* A row joins the list once it is on the page, where its place among the
       others is read. *)
    S.on_mount (fun () ->
        Option.iter (fun e -> t.add { key; element = e }) (S.get element));
    S.on_cleanup (fun () -> t.remove key);
    let selected () = t.context.is_selected key in
    let disabled () = t.context.is_disabled key in
    (* A press that began in a control is the control's. *)
    let pressed given own e =
      call given e;
      if not (in_control e) then own e
    in
    <Row_context.Provider value=(fun () -> r)>
      <tr
        role=`row
        ref=(fun e ->
              S.set set_element (Some e);
              call (Props.ref props) e)
        tabindex=(fun () -> tabindex (S.get (Selectable_item.tab_index item)))
        aria_labelledby=(fun () -> r.header_id)
        ?aria_selected=(fun () ->
                         match t.context.selection_mode () with
                         | `none -> None
                         | `single | `multiple -> Some (selected ()))
        ?aria_disabled=(fun () -> if disabled () then Some true else None)
        data_key=(fun () -> Jsx.data key)
        data_selected=(fun () -> state (selected ()))
        data_disabled=(fun () -> state (disabled ()))
        on_pointer_down=(pressed
                           (Props.on_pointer_down props)
                           (Selectable_item.on_pointer_down item))
        on_pointer_up=(pressed
                         (Props.on_pointer_up props)
                         (Selectable_item.on_pointer_up item))
        on_click=(pressed (Props.on_click props)
                    (Selectable_item.on_click item))
        on_key_down=(pressed (Props.on_key_down props)
                       (Selectable_item.on_key_down item))
        on_mouse_down=(fun e ->
                        call (Props.on_mouse_down props) e;
                        Selectable_item.on_mouse_down item e)
        on_focus=(fun e ->
                   call (Props.on_focus props) e;
                   Selectable_item.on_focus item e)
        props=(S.omit props own)>
        (fun () -> Props.children props)
      </tr>
    </Row_context.Provider>

  let component = Jsx.component make
end

module Cell = struct
  module Props = struct
    type t

    external check :
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Td.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlTableCellElement -> unit)[@u]) option = "ref"
    [@@mel.get]
  end

  let make (props : Props.t) =
    let t = in_table "Table.Cell" in
    let r =
      match Row_context.use () with
      | Some r -> r
      | None -> invalid_arg "Table.Cell is used inside a Table.Row"
    in
    let element, set_element = S.create_signal None in
    let index = place r.cells element in
    let names_row () = index () = t.row_header () in
    <td
      role=(fun () -> if names_row () then `rowheader else `gridcell)
      ?id=(fun () -> if names_row () then Some r.header_id else None)
      tabindex="-1"
      data_column_index=(fun () -> Jsx.data (string_of_int (index ())))
      ref=(fun e ->
            S.set set_element (Some e);
            call (Props.ref props) e)
      props=(S.omit props [| "children"; "ref" |])>
      (fun () -> Props.children props)
    </td>

  let component = Jsx.component make
end

module Load_more = struct
  module Props = struct
    type t

    external check :
      ?is_loading:bool Solidtype.Check.value ->
      ?on_load_more:(unit -> unit) ->
      ?scroll_offset:float Solidtype.Check.value ->
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Tr.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external is_loading : t -> bool option = "isLoading" [@@mel.get]

    external on_load_more : t -> ((unit -> unit)[@u]) option = "onLoadMore"
    [@@mel.get]

    external scroll_offset : t -> float option = "scrollOffset" [@@mel.get]
    external children : t -> Jsx.content = "children" [@@mel.get]
  end

  let make (props : Props.t) =
    let t = in_table "Table.Load_more" in
    let is_loading () = Option.value (Props.is_loading props) ~default:false in
    (* The sentinel's row has no height and is out of the page's reach, so it
       moves nothing and nothing reaches it; the loading row joins no list, so
       no key reaches it either. *)
    Jsx.fragment
      [|
        <tr style="height: 0px;" inert=true>
          <td style="padding: 0px; border: 0px;">
            <Load_more_sentinel
              is_loading=(fun () -> is_loading ())
              on_load_more=(fun _ ->
                             match Props.on_load_more props with
                             | Some f -> f () [@u]
                             | None -> ())
              ?scroll_offset=(fun () -> Props.scroll_offset props)
              style="position: relative; height: 1px; width: 1px;"
            />
          </td>
        </tr>;
        <Show when_=(fun () -> is_loading ())>
          <tr
            role=`row
            props=(S.omit props
                     [| "isLoading"; "onLoadMore"; "scrollOffset"; "children" |])>
            <td
              role=`rowheader
              colspan=(fun () -> string_of_int (count t.columns ()))>
              (fun () -> Props.children props)
            </td>
          </tr>
        </Show>;
      |]

  let component = Jsx.component make
end

external stop_propagation : _ Dom.event_like -> unit = "stopPropagation"
[@@mel.send]

external prevent : _ Dom.event_like -> unit = "preventDefault" [@@mel.send]
external client_x : Dom.pointerEvent -> float = "clientX" [@@mel.get]
external button : Dom.pointerEvent -> int = "button" [@@mel.get]
external pointer_id : Dom.pointerEvent -> int = "pointerId" [@@mel.get]
external pointer_type : Dom.pointerEvent -> string = "pointerType" [@@mel.get]
external ctrl_key : Dom.pointerEvent -> bool = "ctrlKey" [@@mel.get]
external alt_key : Dom.pointerEvent -> bool = "altKey" [@@mel.get]
external meta_key : Dom.pointerEvent -> bool = "metaKey" [@@mel.get]
external pointer_shift : Dom.pointerEvent -> bool = "shiftKey" [@@mel.get]

external capture : Dom.htmlDivElement -> int -> unit = "setPointerCapture"
[@@mel.send]

external input_value : Dom.htmlInputElement -> string = "value" [@@mel.get]

type inline_style

external inline_style : Dom.htmlDivElement -> inline_style = "style" [@@mel.get]
external user_select : inline_style -> string = "userSelect" [@@mel.get]

external set_user_select : inline_style -> string -> unit = "userSelect"
[@@mel.set]

external focus_input : Dom.htmlInputElement -> unit = "focus" [@@mel.send]

(* What a visually hidden element is styled, as React Aria's VisuallyHidden
   is: read by a reader, drawn nowhere. *)
let visually_hidden =
  "border: 0px; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); height: \
   1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; \
   width: 1px; white-space: nowrap;"

module Column_resizer = struct
  module Props = struct
    type t

    external check :
      ?props:'spread Solidtype.Solid.rest ->
      (?children:('f, [ `nodes ]) Solidtype.Check.children -> unit -> unit)
      Solidtype.Html.Div.check = "check"
    [@@mel.module "vite-plugin-solidtype/markers"]

    external aria_label : t -> string option = "aria-label" [@@mel.get]
    external children : t -> Jsx.content = "children" [@@mel.get]

    external ref : t -> ((Dom.htmlDivElement -> unit)[@u]) option = "ref"
    [@@mel.get]

    external on_pointer_down : t -> ((Dom.pointerEvent -> unit)[@u]) option
      = "onPointerDown"
    [@@mel.get]

    external on_pointer_move : t -> ((Dom.pointerEvent -> unit)[@u]) option
      = "onPointerMove"
    [@@mel.get]

    external on_pointer_up : t -> ((Dom.pointerEvent -> unit)[@u]) option
      = "onPointerUp"
    [@@mel.get]

    external on_click : t -> ((Dom.mouseEvent -> unit)[@u]) option = "onClick"
    [@@mel.get]
  end

  let own =
    [|
      "aria-label";
      "children";
      "ref";
      "onPointerDown";
      "onPointerMove";
      "onPointerUp";
      "onClick";
    |]

  let make (props : Props.t) =
    let t = in_table "Table.Column_resizer" in
    let s =
      match t.sizing with
      | Some s -> s
      | None ->
          invalid_arg
            "Table.Column_resizer is used inside a Table.Resizable_container"
    in
    let c =
      match Resized_context.use () with
      | Some c -> c
      | None -> invalid_arg "Table.Column_resizer is used inside a Table.Column"
    in
    let key = c.resized_key in
    let input_id = S.create_unique_id () in
    let input = ref None in
    let handle = ref None in
    let editing () =
      match s.resizing () with Some k -> String.equal k key | None -> false
    in
    (* A resize begun, and the sizes it last made, which its end is told. *)
    let started = ref false in
    let last = ref None in
    let start () =
      if not !started then begin
        let sizes = s.resize_to key (s.width_of key) in
        last := Some sizes;
        s.set_resizing (Some key);
        s.told.on_resize_start sizes
      end;
      started := true
    in
    let resize width =
      let sizes = s.resize_to key width in
      s.told.on_resize sizes;
      last := Some sizes
    in
    let finish () =
      if !started then begin
        let sizes =
          match !last with
          | Some sizes -> sizes
          | None -> s.resize_to key (s.width_of key)
        in
        s.set_resizing None;
        s.told.on_resize_end sizes;
        started := false
      end;
      last := None
    in
    (* A key's step, and a reader's, is 10 pixels, as React Aria's is. *)
    let step by = resize (s.width_of key +. by) in
    let dragging = ref None in
    let mouse_cursor, set_mouse_cursor = S.create_signal None in
    let direction () =
      let width = s.width_of key in
      if s.min_of key >= width then "left"
      else if s.max_of key <= width then "right"
      else "both"
    in
    let whole x = Js.Float.toString (Float.floor x) in
    (* No text is selected while the handle is pressed, and none by the
       click that ends it: its selection comes back 300 milliseconds later, as
       React Aria's press gives it back. *)
    let selection = ref None in
    let unselectable h =
      let style = inline_style h in
      if Option.is_none !selection then selection := Some (user_select style);
      set_user_select style "none"
    in
    let selectable h =
      ignore
        (Js.Global.setTimeout
           ~f:(fun () ->
             Option.iter (set_user_select (inline_style h)) !selection;
             selection := None)
           300
          : Js.Global.timeoutId)
    in
    let stop_drag () =
      if Option.is_some !dragging then begin
        dragging := None;
        S.set set_mouse_cursor None;
        Option.iter selectable !handle;
        finish ()
      end
    in
    <div
      role=`presentation
      ref=(fun e ->
            handle := Some e;
            call (Props.ref props) e)
      style="touch-action: none;"
      data_resizing=(fun () -> state (editing ()))
      data_resizable_direction=(fun () -> Jsx.data (direction ()))
      on_pointer_down=(fun e ->
                        call (Props.on_pointer_down props) e;
                        if
                          button e = 0
                          && not
                               (ctrl_key e || alt_key e || meta_key e
                              || pointer_shift e)
                        then begin
                          (* Focus goes to the resizer's input, never the
                             column's header. *)
                          prevent e;
                          Option.iter (fun i -> focus_input i) !input;
                          start ();
                          Option.iter
                            (fun h ->
                              capture h (pointer_id e);
                              unselectable h)
                            !handle;
                          dragging :=
                            Some (client_x e, s.width_of key, pointer_type e)
                        end)
      on_pointer_move=(fun e ->
                        call (Props.on_pointer_move props) e;
                        match !dragging with
                        | Some (from, width, kind) ->
                            (* A mouse's drag holds its cursor over the page. *)
                            if
                              String.equal kind "mouse"
                              && Option.is_none (S.get mouse_cursor)
                            then
                              Option.iter
                                (fun h ->
                                  S.set set_mouse_cursor
                                    (Some (cursor (computed h))))
                                !handle;
                            resize (width +. client_x e -. from)
                        | None -> ())
      on_pointer_up=(fun e ->
                      call (Props.on_pointer_up props) e;
                      stop_drag ())
      on_pointer_cancel=(fun _ -> stop_drag ())
      on_click=(fun e ->
                 call (Props.on_click props) e;
                 (* A press on the resizer is never its column's. *)
                 stop_propagation e)
      props=(S.omit props own)>
      (fun () -> Props.children props)
      <input
        ref=(fun e -> input := Some e)
        id=(fun () -> input_id)
        type_="range"
        aria_label=(fun () ->
                     Option.value (Props.aria_label props) ~default:"Resizer")
        aria_orientation=`horizontal
        aria_labelledby=(fun () -> input_id ^ " " ^ c.header_id)
        aria_valuetext=(fun () -> whole (s.width_of key) ^ " pixels")
        min=(fun () -> whole (s.min_of key))
        max=(fun () -> whole (s.max_of key))
        value=(fun () -> whole (s.width_of key))
        style=visually_hidden
        on_key_down=(fun e ->
                      let own () =
                        prevent e;
                        stop_propagation e
                      in
                      match key_name e with
                      | "Enter" ->
                          own ();
                          if editing () then finish () else start ()
                      | ("Escape" | " ") when editing () ->
                          own ();
                          finish ()
                      | "Tab" when editing () -> finish ()
                      | "ArrowRight" | "ArrowUp" | "End" | "PageUp" ->
                          own ();
                          step 10.
                      | "ArrowLeft" | "ArrowDown" | "Home" | "PageDown" ->
                          own ();
                          step (-10.)
                      | _ -> ())
        on_input=(fun _ ->
                   (* A reader's step, up or down. *)
                   match !input with
                   | Some i
                     when Js.Float.fromString (input_value i) > s.width_of key
                     ->
                       step 10.
                   | Some _ | None -> step (-10.))
        on_blur=(fun _ -> finish ())
      />
      <Show.Some some=(fun () -> S.get mouse_cursor)>
        (fun shown ->
          <Solidtype.Portal>
            <div
              style=(fun () ->
                      "position: fixed; top: 0px; left: 0px; bottom: 0px; \
                       right: 0px; cursor: " ^ S.get shown ^ ";")
              data_testid="cursor-overlay"
            />
          </Solidtype.Portal>)
      </Show.Some>
    </div>

  let component = Jsx.component make
end
